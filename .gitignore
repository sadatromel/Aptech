# ERP System .gitignore

# Database files
*.db
*.sqlite
*.sqlite3
data/
!data/.gitkeep

# Configuration files with sensitive data
config/config.local.php

# Uploads directory
uploads/*
!uploads/.gitkeep

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
cache/
tmp/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Backup files
*.bak
*.backup
*.bak_*

# Test files
test_*
debug_*
check_*

# Environment specific
.env
.env.local
.env.production

# Composer (if using)
/vendor/
composer.lock

# Node modules (if using)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
/build/
/dist/

# Documentation build
/docs/build/

# PHP specific
.php_cs.cache
.phpunit.result.cache

# User uploaded files
uploads/visitor_photos/*
uploads/documents/*
uploads/import_files/*
