{% extends "layouts/app.twig" %}

{% block title %}{{ pageName }} | HRMS Enterprise{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #4f46e5 0%, #2563eb 100%);">
        <div>
            <span class="badge bg-white text-indigo mb-2 font-monospace" style="color: #4f46e5;"><i class="fas fa-sitemap me-1"></i> HR MODULE &bull; {{ sectionName }}</span>
            <h2 class="mb-1 font-weight-bold">{{ pageName }}</h2>
            <p class="mb-0 opacity-75">Enterprise workforce management module for {{ pageName }}.</p>
        </div>
        <div>
            <a href="{{ BASE_URL }}/hr/dashboard" class="btn btn-light rounded-pill px-4 font-weight-bold text-indigo shadow-sm" style="color: #4f46e5;"><i class="fas fa-arrow-left me-2"></i>HR Dashboard</a>
        </div>
    </div>

    <!-- Main Card -->
    <div class="card shadow-lg border-0 rounded-4 glass-card mb-4">
        <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-indigo-400"><i class="fas fa-table me-2"></i>{{ mockData.title }}</h5>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-success btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#addRecordModal">
                    <i class="fas fa-plus me-1"></i> Add Entry
                </button>
                <button type="button" class="btn btn-outline-light btn-sm rounded-circle action-btn" onclick="exportData()" title="Export PDF/Excel"><i class="fas fa-download"></i></button>
            </div>
        </div>
        <div class="card-body p-4">
            <!-- Search & Filter Controls -->
            <div class="row g-3 mb-4">
                <div class="col-md-6 col-lg-4">
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary border-opacity-25 text-muted"><i class="fas fa-search"></i></span>
                        <input type="text" id="searchInput" class="form-control bg-dark text-white border-secondary border-opacity-25" placeholder="Search entries..." onkeyup="filterTable()">
                    </div>
                </div>
                <div class="col-md-4 col-lg-3">
                    <select class="form-select bg-dark text-white border-secondary border-opacity-25" id="statusFilter" onchange="filterStatus(this.value)">
                        <option value="">All Statuses</option>
                        <option value="Active">Active / Approved</option>
                        <option value="Pending">Pending / Under Review</option>
                        <option value="Selected">Selected</option>
                        <option value="Yes">Eligible</option>
                    </select>
                </div>
            </div>

            <!-- Data Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="showcaseTable" style="border-color: rgba(255,255,255,0.08);">
                    <thead>
                        <tr class="text-indigo-400 fs-7 border-bottom">
                            {% for head in mockData.headers %}
                            <th>{{ head }}</th>
                            {% endfor %}
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        {% for row in mockData.rows %}
                        <tr class="table-row text-value" data-id="{{ row.id }}">
                            {% for col in row.cols %}
                            <td>
                                {% if col == 'Active' or col == 'Approved' or col == 'Selected' or col == 'Yes' or col == 'Published' %}
                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 px-2.5 py-1">{{ col }}</span>
                                {% elseif col == 'Pending Approval' or col == 'Pending' or col == 'Interviewing' or col == 'Under Review' or col == 'Special Approval' or col == 'Draft' %}
                                <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50 px-2.5 py-1">{{ col }}</span>
                                {% elseif col == 'Rejected' or col == 'Hold' or col == 'Closed' %}
                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 px-2.5 py-1">{{ col }}</span>
                                {% else %}
                                {{ col }}
                                {% endif %}
                            </td>
                            {% endfor %}
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-info rounded-circle me-1" onclick="alert('Viewing details for this record.')" title="View details"><i class="fas fa-eye"></i></button>
                                <button class="btn btn-sm btn-outline-danger rounded-circle" onclick="deleteRow(this)" title="Delete"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Record Modal -->
<div class="modal fade" id="addRecordModal" tabindex="-1" aria-labelledby="addRecordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card border border-secondary border-opacity-25" style="backdrop-filter: blur(25px);">
            <div class="modal-header border-bottom border-secondary border-opacity-25">
                <h5 class="modal-title fw-bold text-indigo-400" id="addRecordModalLabel"><i class="fas fa-plus-circle me-2"></i>Add New Record</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addRecordForm" onsubmit="submitForm(event)">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        {% for head in mockData.headers %}
                        <div class="col-md-6">
                            <label class="form-label text-indigo-400 fs-7 fw-bold">{{ head }}</label>
                            {% if head == 'Status' or head == 'Eligible' or head == 'NID Verification' or head == 'Birth Cert Status' %}
                            <select class="form-select bg-dark text-white border-secondary border-opacity-25" name="field_{{ loop.index0 }}" required>
                                <option value="Active">Active</option>
                                <option value="Approved">Approved</option>
                                <option value="Pending">Pending</option>
                                <option value="Selected">Selected</option>
                                <option value="Yes">Yes</option>
                                <option value="Draft">Draft</option>
                            </select>
                            {% else %}
                            <input type="text" class="form-control bg-dark text-white border-secondary border-opacity-25" name="field_{{ loop.index0 }}" placeholder="Enter {{ head }}" required>
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="modal-footer border-top border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-light rounded-pill px-3 btn-sm action-btn" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 btn-sm">Insert Entry</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* Theme Adaptability styles */
    .page-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        color: var(--text-primary);
        transition: background 0.3s ease, color 0.3s ease;
    }
    .page-title {
        color: #0f172a;
    }
    .text-value {
        color: #0f172a;
    }
    .glass-card {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(0, 0, 0, 0.08) !important;
        color: var(--text-primary);
    }
    .action-btn {
        color: #4f46e5;
        border-color: rgba(79, 70, 229, 0.4);
    }
    .action-btn:hover {
        background: #4f46e5;
        color: #fff;
        border-color: #4f46e5;
    }

    /* Dark Mode overrides */
    [data-theme="dark"] .page-container {
        background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
        color: #f1f5f9;
    }
    [data-theme="dark"] .page-title {
        color: #ffffff;
    }
    [data-theme="dark"] .text-value {
        color: #ffffff;
    }
    [data-theme="dark"] .glass-card {
        background: rgba(30, 41, 59, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        color: #f1f5f9;
    }
    [data-theme="dark"] .action-btn {
        color: #f1f5f9;
        border-color: rgba(255, 255, 255, 0.4);
    }
    [data-theme="dark"] .action-btn:hover {
        background: #f1f5f9;
        color: #0f172a;
    }
    
    .fs-7 {
        font-size: 0.85rem;
    }
    .fs-8 {
        font-size: 0.75rem;
    }
</style>

<script>
    function filterTable() {
        const input = document.getElementById("searchInput");
        const filter = input.value.toLowerCase();
        const table = document.getElementById("showcaseTable");
        const tr = table.getElementsByClassName("table-row");

        for (let i = 0; i < tr.length; i++) {
            let rowText = tr[i].textContent.toLowerCase();
            if (rowText.indexOf(filter) > -1) {
                tr[i].style.display = "";
            } else {
                tr[i].style.display = "none";
            }
        }
    }

    function filterStatus(status) {
        const table = document.getElementById("showcaseTable");
        const tr = table.getElementsByClassName("table-row");

        for (let i = 0; i < tr.length; i++) {
            if (status === "") {
                tr[i].style.display = "";
                continue;
            }
            let rowText = tr[i].textContent;
            if (rowText.includes(status)) {
                tr[i].style.display = "";
            } else {
                tr[i].style.display = "none";
            }
        }
    }

    function deleteRow(btn) {
        const row = btn.closest('tr');
        const id = row.getAttribute('data-id');
        if (!id) {
            row.remove();
            return;
        }
        
        if(confirm('Are you sure you want to delete this record from the database?')) {
            fetch('{{ BASE_URL }}/hr/showcase/' + id, {
                method: 'DELETE',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    row.remove();
                    Swal.fire({
                        icon: 'success',
                        title: 'Deleted',
                        text: 'Record deleted from database.',
                        timer: 1500,
                        showConfirmButton: false
                    });
                } else {
                    alert('Failed to delete record.');
                }
            })
            .catch(err => {
                console.error(err);
                alert('Connection error occurred.');
            });
        }
    }

    function exportData() {
        alert("Preparing document download...\nSuccessfully exported simulated data sheet for Audit submission.");
    }

    function submitForm(event) {
        event.preventDefault();
        const form = document.getElementById('addRecordForm');
        const formData = new FormData(form);
        
        // Send AJAX POST request to backend
        fetch('{{ BASE_URL }}/hr/showcase/{{ section }}/{{ pageCode }}', {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Add to table
                const newRow = document.createElement('tr');
                newRow.className = 'table-row text-value';
                newRow.setAttribute('data-id', data.id);
                
                const headersCount = {{ mockData.headers|length }};
                for(let i = 0; i < headersCount; i++) {
                    const val = formData.get('field_' + i);
                    const td = document.createElement('td');
                    
                    if (val === 'Active' || val === 'Approved' || val === 'Selected' || val === 'Yes' || val === 'Published') {
                        td.innerHTML = '<span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 px-2.5 py-1">' + val + '</span>';
                    } else if (val === 'Pending Approval' || val === 'Pending' || val === 'Interviewing' || val === 'Under Review' || val === 'Special Approval' || val === 'Draft') {
                        td.innerHTML = '<span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50 px-2.5 py-1">' + val + '</span>';
                    } else if (val === 'Rejected' || val === 'Hold' || val === 'Closed') {
                        td.innerHTML = '<span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 px-2.5 py-1">' + val + '</span>';
                    } else {
                        td.textContent = val;
                    }
                    newRow.appendChild(td);
                }
                
                // Actions cell
                const actionTd = document.createElement('td');
                actionTd.className = 'text-end';
                actionTd.innerHTML = `
                    <button class="btn btn-sm btn-outline-info rounded-circle me-1" onclick="alert('Viewing details for this record.')" title="View details"><i class="fas fa-eye"></i></button>
                    <button class="btn btn-sm btn-outline-danger rounded-circle" onclick="deleteRow(this)" title="Delete"><i class="fas fa-trash"></i></button>
                `;
                newRow.appendChild(actionTd);
                
                document.getElementById('tableBody').appendChild(newRow);
                
                // Hide modal
                const modalEl = document.getElementById('addRecordModal');
                const modal = bootstrap.Modal.getInstance(modalEl);
                modal.hide();
                
                form.reset();
                
                Swal.fire({
                    icon: 'success',
                    title: 'Record Added',
                    text: 'The entry has been saved to the database successfully.',
                    timer: 2000,
                    showConfirmButton: false
                });
            } else {
                alert('Error: ' + data.message);
            }
        })
        .catch(err => {
            console.error(err);
            alert('Failed to insert record.');
        });
    }
</script>
{% endblock %}
