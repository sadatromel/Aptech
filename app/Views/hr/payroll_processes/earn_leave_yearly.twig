{% extends "layouts/app.twig" %}

{% block title %}Earn Leave Payment Process Yearly | HR Payroll{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #d97706 0%, #b45309 100%);">
        <div>
            <span class="badge bg-white text-warning mb-2 font-monospace" style="color: #b45309;"><i class="fas fa-coins me-1"></i> ANNUAL LEAVE ENCASHMENT</span>
            <h2 class="mb-1 font-weight-bold">Earn Leave Payment Process (Yearly Encashment)</h2>
            <p class="mb-0 opacity-75">Statutory annual encashment of unused leave balance for financial year-end closing.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-award fa-3x opacity-50"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <!-- Encashment Split Visual Card -->
    <div class="card border-0 shadow-sm rounded-3 p-4 bg-white mb-4">
        <h5 class="fw-bold text-warning mb-3" style="color: #b45309;"><i class="fas fa-balance-scale me-2"></i>Statutory 50% Encashment vs 50% Carry Forward Rule</h5>
        <div class="row align-items-center">
            <div class="col-md-6 mb-3 mb-md-0">
                <div class="d-flex justify-content-between mb-1">
                    <span class="fw-bold text-dark"><i class="fas fa-money-bill-wave text-warning me-1"></i> Encashed to Cash (50%)</span>
                    <span class="fw-bold text-warning" style="color: #d97706;">9 Days Avg / Worker</span>
                </div>
                <div class="progress" style="height: 12px;">
                    <div class="progress-bar bg-warning" style="width: 50%;"></div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="d-flex justify-content-between mb-1">
                    <span class="fw-bold text-dark"><i class="fas fa-history text-info me-1"></i> Rolled Over to Next Year (50%)</span>
                    <span class="fw-bold text-info">9 Days Avg / Worker</span>
                </div>
                <div class="progress" style="height: 12px;">
                    <div class="progress-bar bg-info" style="width: 50%;"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold" style="color: #b45309;"><i class="fas fa-calendar-alt me-2"></i>Annual Encashment Register</h5>
            <form action="{{ BASE_URL }}/hr/payroll/earn-leave-yearly" method="POST" class="d-flex gap-2">
                {{ csrf_field() | raw }}
                <select name="year" class="form-select form-select-sm" required>
                    <option value="2026">Financial Year 2026</option>
                    <option value="2025">Financial Year 2025</option>
                </select>
                <button type="submit" class="btn text-white btn-sm px-4 rounded-pill text-nowrap shadow-sm" style="background-color: #d97706;"><i class="fas fa-calculator me-1"></i> Execute Annual Encashment</button>
            </form>
        </div>
        <div class="card-body p-4">
            <table id="datatablesSimple" class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Emp Code</th>
                        <th>Employee Name</th>
                        <th>Fiscal Year</th>
                        <th>Total Balance</th>
                        <th>Encashed Days</th>
                        <th>Rollover Days</th>
                        <th>Daily Rate</th>
                        <th>Total Encashment</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for rec in records %}
                    <tr>
                        <td><span class="badge bg-light text-dark border font-monospace">{{ rec.employee_code }}</span></td>
                        <td class="fw-bold">{{ rec.employee_name }}</td>
                        <td>{{ rec.year_month }}</td>
                        <td>18 Days</td>
                        <td><span class="badge bg-warning-subtle text-warning border border-warning rounded-pill px-3">{{ rec.leave_days }} Days</span></td>
                        <td><span class="badge bg-info-subtle text-info border border-info rounded-pill px-3">9 Days</span></td>
                        <td>৳ {{ rec.daily_rate|number_format(2) }}</td>
                        <td class="fw-bold text-success">৳ {{ rec.total_payout|number_format(2) }}</td>
                        <td><span class="badge bg-success rounded-pill px-3">{{ rec.status|capitalize }}</span></td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="fas fa-coins fa-2x mb-2 text-warning opacity-50"></i><br>
                            No annual encashment batch created yet for this year.<br>Click "Execute Annual Encashment" to initiate.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
