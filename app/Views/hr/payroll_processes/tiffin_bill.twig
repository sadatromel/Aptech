{% extends "layouts/app.twig" %}

{% block title %}Tiffin Bill Process | HR Payroll{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #ea580c 0%, #c2410c 100%);">
        <div>
            <span class="badge bg-white text-warning mb-2 font-monospace" style="color: #ea580c;"><i class="fas fa-cookie-bite me-1"></i> OVERTIME TIFFIN ALLOWANCE</span>
            <h2 class="mb-1 font-weight-bold">Tiffin Bill Process</h2>
            <p class="mb-0 opacity-75">Process daily tiffin allowance for workers completing post-shift extended overtime.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-cookie-bite fa-3x opacity-50"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold" style="color: #ea580c;"><i class="fas fa-list me-2"></i>Tiffin Bill Execution Register</h5>
            <form action="{{ BASE_URL }}/hr/payroll/tiffin-bill" method="POST" class="d-flex gap-2">
                {{ csrf_field() | raw }}
                <input type="month" name="year_month" class="form-control form-control-sm" value="2026-07" required>
                <button type="submit" class="btn text-white btn-sm px-4 rounded-pill text-nowrap shadow-sm" style="background-color: #ea580c;"><i class="fas fa-play me-1"></i> Process Tiffin Bills</button>
            </form>
        </div>
        <div class="card-body p-4">
            <div class="alert alert-warning py-2 small mb-4 border-warning">
                <i class="fas fa-info-circle me-1"></i> Tiffin bill rate: ৳ 35.00 / day for operators working >2 hours of overtime beyond regular 8-hour shifts.
            </div>

            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Month</th>
                        <th>Department</th>
                        <th>Eligible Operators</th>
                        <th>Daily Rate</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>2026-07</td>
                        <td>Production / Sewing</td>
                        <td><span class="badge bg-warning text-dark rounded-pill px-3">120 Workers</span></td>
                        <td>৳ 35.00 / OT Day</td>
                        <td class="fw-bold text-success">৳ 84,000.00</td>
                        <td><span class="badge bg-success rounded-pill px-3">Processed</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
