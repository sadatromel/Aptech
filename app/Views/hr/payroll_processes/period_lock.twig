{% extends "layouts/app.twig" %}

{% block title %}Salary Period Lock | HR Payroll{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #be123c 0%, #881337 100%);">
        <div>
            <span class="badge bg-white text-danger mb-2 font-monospace"><i class="fas fa-lock me-1"></i> AUDIT & PAYROLL SECURITY</span>
            <h2 class="mb-1 font-weight-bold">Salary Period Lock / Freeze</h2>
            <p class="mb-0 opacity-75">Freeze finalized payroll periods to prevent illegal modifications or retroactive edits.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-user-shield fa-3x opacity-50"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <div class="row">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 mb-4 border-top border-4 border-danger">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 text-danger fw-bold"><i class="fas fa-key me-2"></i>Lock / Unlock Period Control</h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning py-2 small mb-3 border-warning">
                        <i class="fas fa-exclamation-triangle me-1"></i> Locking a period disables all manual salary edits, OT adjustments, and leave status changes.
                    </div>
                    <form action="{{ BASE_URL }}/hr/payroll/period-lock" method="POST">
                        {{ csrf_field() | raw }}
                        <div class="mb-3">
                            <label for="year_month" class="form-label fw-bold">Target Payroll Month *</label>
                            <input type="month" class="form-control form-control-lg border-danger fw-bold" id="year_month" name="year_month" value="2026-07" required>
                        </div>
                        <div class="mb-3">
                            <label for="department_id" class="form-label fw-semibold">Target Scope</label>
                            <select class="form-select" id="department_id" name="department_id">
                                <option value="">Entire Company (All Departments)</option>
                                {% for dept in departments %}
                                <option value="{{ dept.department_id }}">{{ dept.department_name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="lock_status" class="form-label fw-bold">Action *</label>
                            <select class="form-select border-danger text-danger fw-bold" id="lock_status" name="lock_status" required>
                                <option value="locked" selected>🔒 Lock Period (Freeze Data)</option>
                                <option value="unlocked">🔓 Unlock Period (Enable Edits)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="remarks" class="form-label fw-semibold">Audit Approval Reference</label>
                            <input type="text" class="form-control" id="remarks" name="remarks" placeholder="e.g. Audit ref #2026-07-FIN">
                        </div>
                        <button type="submit" class="btn btn-danger w-100 rounded-pill py-3 text-white fw-bold shadow-sm"><i class="fas fa-shield-alt me-2"></i> Update Lock Status</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-history me-2"></i>Period Lock Audit Log</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Month</th>
                                    <th>Scope</th>
                                    <th>Lock Status</th>
                                    <th>Locked At</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for rec in records %}
                                <tr>
                                    <td class="fw-bold font-monospace">{{ rec.year_month }}</td>
                                    <td>{{ rec.department_name|default('Company Wide') }}</td>
                                    <td>
                                        <span class="badge bg-{{ rec.lock_status == 'locked' ? 'danger' : 'success' }} rounded-pill px-3"><i class="fas fa-{{ rec.lock_status == 'locked' ? 'lock' : 'unlock' }} me-1"></i>{{ rec.lock_status|capitalize }}</span>
                                    </td>
                                    <td><small class="text-muted">{{ rec.locked_at }}</small></td>
                                    <td><small>{{ rec.remarks }}</small></td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <i class="fas fa-lock fa-2x mb-2 text-danger opacity-50"></i><br>
                                        No period locks active yet.
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
