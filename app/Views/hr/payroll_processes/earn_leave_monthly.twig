{% extends "layouts/app.twig" %}

{% block title %}Earn Leave Payment Process Monthly | HR Payroll{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #059669 0%, #047857 100%);">
        <div>
            <span class="badge bg-white text-success mb-2 font-monospace"><i class="fas fa-calendar-check me-1"></i> MONTHLY LEAVE PAYOUT</span>
            <h2 class="mb-1 font-weight-bold">Monthly Earn Leave Payment Process</h2>
            <p class="mb-0 opacity-75">Calculate & disburse monthly earned leave encashments per worker attendance records.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-leaf fa-3x opacity-50"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <!-- Top KPI Widgets -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-success">
                <div class="small text-muted font-weight-bold text-uppercase">Monthly EL Accrual Rate</div>
                <div class="h3 font-weight-bold text-success my-1">1 Day per 18 Days</div>
                <div class="small text-muted"><i class="fas fa-gavel me-1"></i> Bangladesh Labor Act Sec. 117</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-emerald" style="border-color: #10b981 !important;">
                <div class="small text-muted font-weight-bold text-uppercase">Total Monthly Payout</div>
                <div class="h3 font-weight-bold text-emerald my-1" style="color: #047857;">৳ 385,400</div>
                <div class="small text-success"><i class="fas fa-check-circle me-1"></i> July 2026 Batch Ready</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-info">
                <div class="small text-muted font-weight-bold text-uppercase">Active Beneficiaries</div>
                <div class="h3 font-weight-bold text-info my-1">820 Workers</div>
                <div class="small text-muted"><i class="fas fa-user-check me-1"></i> 100% Verified</div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-success"><i class="fas fa-list me-2"></i>Monthly Earn Leave Payout Register</h5>
            <form action="{{ BASE_URL }}/hr/payroll/earn-leave-monthly" method="POST" class="d-flex gap-2">
                {{ csrf_field() | raw }}
                <input type="month" name="year_month" class="form-control form-control-sm" value="2026-07" required>
                <button type="submit" class="btn btn-success btn-sm px-4 rounded-pill text-nowrap shadow-sm"><i class="fas fa-play me-1"></i> Process Monthly Batch</button>
            </form>
        </div>
        <div class="card-body p-4">
            <table id="datatablesSimple" class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Emp Code</th>
                        <th>Employee Name</th>
                        <th>Period</th>
                        <th>Accrued Days</th>
                        <th>Daily Rate</th>
                        <th>Total Payout</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    {% for rec in records %}
                    <tr>
                        <td><span class="badge bg-light text-dark border font-monospace">{{ rec.employee_code }}</span></td>
                        <td class="fw-bold">{{ rec.employee_name }}</td>
                        <td>{{ rec.year_month }}</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-3">{{ rec.leave_days }} Days</span></td>
                        <td>৳ {{ rec.daily_rate|number_format(2) }}</td>
                        <td class="fw-bold text-success">৳ {{ rec.total_payout|number_format(2) }}</td>
                        <td><span class="badge bg-success rounded-pill px-3">{{ rec.status|capitalize }}</span></td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fas fa-info-circle fa-2x mb-2 text-success opacity-50"></i><br>
                            No monthly earn leave records generated yet for this period.<br>Click "Process Monthly Batch" to calculate.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
