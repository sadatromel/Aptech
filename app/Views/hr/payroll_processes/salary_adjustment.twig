{% extends "layouts/app.twig" %}

{% block title %}Salary Adjustment Entry | HR Payroll{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);">
        <div>
            <span class="badge bg-white text-warning mb-2 font-monospace" style="color: #d97706;"><i class="fas fa-sliders-h me-1"></i> ARREARS & DEDUCTIONS</span>
            <h2 class="mb-1 font-weight-bold">Salary Adjustment Entry</h2>
            <p class="mb-0 opacity-75">Record positive arrear adjustments or negative salary deductions for current payroll.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-balance-scale-right fa-3x opacity-50"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <div class="row">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold" style="color: #d97706;"><i class="fas fa-edit me-2"></i>New Salary Adjustment Voucher</h5>
                </div>
                <div class="card-body p-4">
                    <form action="{{ BASE_URL }}/hr/payroll/salary-adjustment" method="POST">
                        {{ csrf_field() | raw }}
                        <div class="mb-3">
                            <label for="employee_id" class="form-label fw-bold">Select Employee *</label>
                            <select class="form-select" id="employee_id" name="employee_id" required>
                                <option value="">Select Employee</option>
                                {% for emp in employees %}
                                <option value="{{ emp.employee_id }}">{{ emp.employee_code }} - {{ emp.first_name }} {{ emp.last_name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="year_month" class="form-label fw-semibold">Target Payroll Month *</label>
                            <input type="month" class="form-control" id="year_month" name="year_month" value="2026-07" required>
                        </div>
                        <div class="mb-3">
                            <label for="adjustment_type" class="form-label fw-bold">Adjustment Direction *</label>
                            <select class="form-select fw-bold" id="adjustment_type" name="adjustment_type" required>
                                <option value="addition" class="text-success">➕ Addition (Arrears, Incentives, Extra Pay)</option>
                                <option value="deduction" class="text-danger">➖ Deduction (Advance Loan, Damage, Fine)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="amount" class="form-label fw-semibold">Amount (৳) *</label>
                            <input type="number" step="0.01" class="form-control form-control-lg fw-bold" id="amount" name="amount" placeholder="e.g. 1500.00" required>
                        </div>
                        <div class="mb-3">
                            <label for="reason" class="form-label fw-semibold">Particulars / Reason *</label>
                            <input type="text" class="form-control" id="reason" name="reason" placeholder="e.g. June arrear bonus correction" required>
                        </div>
                        <button type="submit" class="btn text-white w-100 rounded-pill py-3 fw-bold shadow-sm" style="background-color: #d97706;"><i class="fas fa-save me-2"></i> Save Adjustment Entry</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-list-ul me-2"></i>Adjustment Register History</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Emp Code</th>
                                    <th>Employee</th>
                                    <th>Month</th>
                                    <th>Type</th>
                                    <th>Amount</th>
                                    <th>Reason</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for rec in records %}
                                <tr>
                                    <td><span class="badge bg-light text-dark border font-monospace">{{ rec.employee_code }}</span></td>
                                    <td class="fw-bold">{{ rec.employee_name }}</td>
                                    <td>{{ rec.year_month }}</td>
                                    <td>
                                        <span class="badge bg-{{ rec.adjustment_type == 'addition' ? 'success' : 'danger' }} rounded-pill px-3">{{ rec.adjustment_type|capitalize }}</span>
                                    </td>
                                    <td class="fw-bold">৳ {{ rec.amount|number_format(2) }}</td>
                                    <td><small class="text-muted">{{ rec.reason }}</small></td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fas fa-sliders-h fa-2x mb-2 text-warning opacity-50"></i><br>
                                        No adjustment entries posted yet.
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
