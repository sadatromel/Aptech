{% extends "layouts/app.twig" %}

{% block title %}Holiday Allowance Process | HR Payroll{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);">
        <div>
            <span class="badge bg-white text-purple mb-2 font-monospace" style="color: #7c3aed;"><i class="fas fa-umbrella-beach me-1"></i> WEEKEND & FESTIVAL OVERTIME</span>
            <h2 class="mb-1 font-weight-bold">Holiday Allowance Process</h2>
            <p class="mb-0 opacity-75">Process holiday overtime and festival extra duty allowance for factory operators.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-glass-cheers fa-3x opacity-50"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold" style="color: #7c3aed;"><i class="fas fa-calendar-day me-2"></i>Holiday Overtime Processing Batch</h5>
            <button class="btn text-white rounded-pill px-4 shadow-sm fw-bold" style="background-color: #7c3aed;" data-bs-toggle="modal" data-bs-target="#holidayModal"><i class="fas fa-play me-2"></i> Execute Holiday Allowance</button>
        </div>
        <div class="card-body p-4">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Batch Code</th>
                        <th>Month / Period</th>
                        <th>Eligible Operators</th>
                        <th>Rate Multiplier</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span class="badge bg-light text-dark border font-monospace">HOL-202607</span></td>
                        <td>2026-07</td>
                        <td><span class="badge bg-purple-subtle text-purple rounded-pill px-3">38 Workers</span></td>
                        <td><span class="badge bg-danger rounded-pill">2.0x Basic Hourly</span></td>
                        <td class="fw-bold text-success">৳ 145,000.00</td>
                        <td><span class="badge bg-success rounded-pill px-3">Completed</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="holidayModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-3 border-0 shadow-lg">
            <form action="{{ BASE_URL }}/hr/payroll/holiday-allowance" method="POST">
                {{ csrf_field() | raw }}
                <div class="modal-header text-white" style="background-color: #7c3aed;">
                    <h5 class="modal-title font-weight-bold"><i class="fas fa-glass-cheers me-1"></i> Holiday Allowance Execution</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Period *</label>
                        <input type="month" name="year_month" class="form-control" value="2026-07" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Allowance Rate Multiplier *</label>
                        <select name="multiplier" class="form-select border-purple text-purple fw-bold">
                            <option value="2.0">🔥 Double Rate (200% Basic Hourly)</option>
                            <option value="1.5">⚡ 1.5x Basic Hourly</option>
                            <option value="fixed">💵 Fixed Daily Flat Rate (৳300/day)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top py-3">
                    <button type="button" class="btn btn-light rounded-pill border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn text-white rounded-pill px-4 fw-bold" style="background-color: #7c3aed;">Execute Process</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
