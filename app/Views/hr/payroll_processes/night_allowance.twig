{% extends "layouts/app.twig" %}

{% block title %}Night Allowance Process | HR Payroll{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
        <div>
            <span class="badge bg-indigo text-white mb-2 font-monospace" style="background-color: #6366f1;"><i class="fas fa-moon me-1"></i> NIGHT SHIFT EXTRA ALLOWANCE</span>
            <h2 class="mb-1 font-weight-bold">Night Allowance Process</h2>
            <p class="mb-0 opacity-75">Automated night shift duty allowance calculation for 10 PM - 6 AM factory punches.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-moon fa-3x text-warning opacity-75"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-user-clock me-2"></i>Night Shift Punch Audit & Payout</h5>
            <form action="{{ BASE_URL }}/hr/payroll/night-allowance" method="POST" class="d-flex gap-2">
                {{ csrf_field() | raw }}
                <input type="month" name="year_month" class="form-control form-control-sm" value="2026-07" required>
                <button type="submit" class="btn btn-dark btn-sm px-4 rounded-pill text-nowrap shadow-sm"><i class="fas fa-play me-1"></i> Process Night Allowance</button>
            </form>
        </div>
        <div class="card-body p-4">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Month</th>
                        <th>Department</th>
                        <th>Night Shift Workers</th>
                        <th>Rate Per Night Shift</th>
                        <th>Total Processed</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>2026-07</td>
                        <td>Security & Maintenance</td>
                        <td><span class="badge bg-dark rounded-pill px-3">18 Workers</span></td>
                        <td><span class="badge bg-warning text-dark rounded-pill">৳ 150.00 / night</span></td>
                        <td class="fw-bold text-success">৳ 48,600.00</td>
                        <td><span class="badge bg-success rounded-pill px-3">Completed</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
