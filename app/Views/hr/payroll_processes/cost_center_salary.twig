{% extends "layouts/app.twig" %}

{% block title %}Cost Center Wise Salary Process | HR Payroll{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #0d9488 0%, #115e59 100%);">
        <div>
            <span class="badge bg-white text-teal mb-2 font-monospace" style="color: #0d9488;"><i class="fas fa-calculator me-1"></i> FINANCIAL COST CENTER ALLOCATION</span>
            <h2 class="mb-1 font-weight-bold">Cost Center Wise Salary Process</h2>
            <p class="mb-0 opacity-75">Allocate payroll overhead expenses across factory operational cost centers & manufacturing lines.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-chart-pie fa-3x opacity-50"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <!-- Cost Center Cards Grid -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-top border-4" style="border-color: #0d9488 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="small text-muted font-monospace">CC-PRD-01</span>
                    <span class="badge bg-teal-subtle text-teal" style="background-color: #ccfbf1; color: #0f766e;">58% Share</span>
                </div>
                <div class="small fw-bold text-dark mt-2">Production & Sewing Floor</div>
                <div class="h3 font-weight-bold text-teal my-2" style="color: #0d9488;">৳ 2,450,000</div>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar" style="width: 58%; background-color: #0d9488;"></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-top border-4" style="border-color: #2563eb !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="small text-muted font-monospace">CC-ADM-02</span>
                    <span class="badge bg-primary-subtle text-primary">20% Share</span>
                </div>
                <div class="small fw-bold text-dark mt-2">Commercial & Admin</div>
                <div class="h3 font-weight-bold text-primary my-2">৳ 850,000</div>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-primary" style="width: 20%;"></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-top border-4" style="border-color: #d97706 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="small text-muted font-monospace">CC-MER-03</span>
                    <span class="badge bg-warning-subtle text-warning">15% Share</span>
                </div>
                <div class="small fw-bold text-dark mt-2">Merchandising & CAD</div>
                <div class="h3 font-weight-bold text-warning my-2">৳ 620,000</div>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-warning" style="width: 15%;"></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-top border-4" style="border-color: #6b7280 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="small text-muted font-monospace">CC-LOG-04</span>
                    <span class="badge bg-secondary-subtle text-secondary">7% Share</span>
                </div>
                <div class="small fw-bold text-dark mt-2">Logistics & Utilities</div>
                <div class="h3 font-weight-bold text-secondary my-2">৳ 310,000</div>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-secondary" style="width: 7%;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Table -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold" style="color: #0f766e;"><i class="fas fa-sitemap me-2"></i>Cost Center Allocation Breakdown Table</h5>
            <button class="btn rounded-pill px-4 text-white font-weight-bold shadow-sm" style="background-color: #0d9488;" data-bs-toggle="modal" data-bs-target="#processModal"><i class="fas fa-play me-2"></i> Process Cost Center Payroll</button>
        </div>
        <div class="card-body p-4">
            <table id="datatablesSimple" class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Cost Center Name</th>
                        <th>Department</th>
                        <th>Headcount</th>
                        <th>Gross Salary</th>
                        <th>Overtime & Bills</th>
                        <th>Net Payable</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span class="badge font-monospace text-dark border bg-light">CC-PRD-01</span></td>
                        <td class="fw-bold">Sewing Production Floor</td>
                        <td>Production</td>
                        <td><span class="badge bg-info text-dark rounded-pill">145 Employees</span></td>
                        <td>৳ 1,850,000.00</td>
                        <td>৳ 120,000.00</td>
                        <td class="fw-bold text-teal" style="color: #0d9488;">৳ 1,720,000.00</td>
                        <td><span class="badge bg-success rounded-pill px-3">Processed</span></td>
                    </tr>
                    <tr>
                        <td><span class="badge font-monospace text-dark border bg-light">CC-CUT-02</span></td>
                        <td class="fw-bold">Cutting & Pattern Section</td>
                        <td>Production</td>
                        <td><span class="badge bg-info text-dark rounded-pill">42 Employees</span></td>
                        <td>৳ 600,000.00</td>
                        <td>৳ 45,000.00</td>
                        <td class="fw-bold text-teal" style="color: #0d9488;">৳ 558,000.00</td>
                        <td><span class="badge bg-success rounded-pill px-3">Processed</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="processModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-3 border-0 shadow-lg">
            <form action="{{ BASE_URL }}/hr/payroll/cost-center-salary" method="POST">
                {{ csrf_field() | raw }}
                <div class="modal-header text-white" style="background-color: #0d9488;">
                    <h5 class="modal-title font-weight-bold"><i class="fas fa-cogs me-1"></i> Process Cost Center Salary</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Salary Period *</label>
                        <input type="month" class="form-control" name="year_month" value="2026-07" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Target Cost Center</label>
                        <select class="form-select" name="department_id">
                            <option value="">All Cost Centers</option>
                            {% for dept in departments %}
                            <option value="{{ dept.department_id }}">{{ dept.department_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top py-3">
                    <button type="button" class="btn btn-light rounded-pill border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn rounded-pill px-4 text-white fw-bold" style="background-color: #0d9488;"><i class="fas fa-check me-1"></i> Confirm & Execute</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
