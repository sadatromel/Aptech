{% extends "layouts/app.twig" %}

{% block title %}Bonus Re-process | HR Payroll{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);">
        <div>
            <span class="badge bg-white text-dark mb-2 font-monospace"><i class="fas fa-sync-alt me-1"></i> PAYROLL RE-CALCULATION</span>
            <h2 class="mb-1 font-weight-bold">Festival & Performance Bonus Re-process</h2>
            <p class="mb-0 opacity-75">Recalculate bonus payouts for revised salary structures, late joiners, or attendance adjustments.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-gift fa-3x opacity-50"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <!-- Top KPI Summary -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-indigo p-3 bg-white">
                <div class="small text-muted text-uppercase fw-semibold">Eid-ul-Fitr Bonus</div>
                <div class="h3 font-weight-bold text-indigo my-1">৳ 1,450,000</div>
                <div class="small text-success"><i class="fas fa-check me-1"></i> 1,240 Workers Processed</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-purple p-3 bg-white">
                <div class="small text-muted text-uppercase fw-semibold">Eid-ul-Adha Bonus</div>
                <div class="h3 font-weight-bold text-purple my-1">৳ 1,520,000</div>
                <div class="small text-success"><i class="fas fa-check me-1"></i> 1,255 Workers Processed</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-warning p-3 bg-white">
                <div class="small text-muted text-uppercase fw-semibold">Performance Share</div>
                <div class="h3 font-weight-bold text-warning my-1">৳ 480,000</div>
                <div class="small text-muted"><i class="fas fa-user-clock me-1"></i> Staff Officers</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 border-start border-4 border-info p-3 bg-white">
                <div class="small text-muted text-uppercase fw-semibold">Re-process Queue</div>
                <div class="h3 font-weight-bold text-info my-1">02 Requests</div>
                <div class="small text-danger"><i class="fas fa-exclamation-triangle me-1"></i> 45 Pending Adjustments</div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 text-indigo font-weight-bold"><i class="fas fa-sliders-h me-2"></i>Re-process Form Settings</h5>
                </div>
                <div class="card-body p-4">
                    <form action="{{ BASE_URL }}/hr/payroll/bonus-reprocess" method="POST">
                        {{ csrf_field() | raw }}
                        <div class="mb-3">
                            <label for="bonus_type" class="form-label fw-semibold">Select Bonus Category *</label>
                            <select class="form-select form-select-lg text-indigo fw-bold" id="bonus_type" name="bonus_type" required>
                                <option value="Eid-ul-Fitr Bonus">🕌 Eid-ul-Fitr Festival Bonus</option>
                                <option value="Eid-ul-Adha Bonus">🕋 Eid-ul-Adha Festival Bonus</option>
                                <option value="Performance Bonus">🏆 Performance Bonus</option>
                                <option value="Annual Profit Share">💼 Annual Profit Share Bonus</option>
                            </select>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6">
                                <label for="year_month" class="form-label fw-semibold">Bonus Month *</label>
                                <input type="month" class="form-control" id="year_month" name="year_month" value="2026-07" required>
                            </div>
                            <div class="col-6">
                                <label for="multiplier" class="form-label fw-semibold">Basic Multiplier</label>
                                <select class="form-select" id="multiplier" name="multiplier">
                                    <option value="1.0">100% Basic Salary</option>
                                    <option value="0.5">50% Basic Salary</option>
                                    <option value="0.75">75% Basic Salary</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="department_id" class="form-label fw-semibold">Filter Department / Floor</label>
                            <select class="form-select" id="department_id" name="department_id">
                                <option value="">Entire Factory (All Departments)</option>
                                {% for dept in departments %}
                                <option value="{{ dept.department_id }}">{{ dept.department_name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="remarks" class="form-label fw-semibold">Re-process Authorization Notes</label>
                            <textarea class="form-control" id="remarks" name="remarks" rows="2" placeholder="e.g. Include July 2026 salary increment in bonus base"></textarea>
                        </div>
                        <button type="submit" class="btn btn-indigo w-100 rounded-pill py-3 text-white fw-bold shadow-sm" style="background-color: #4f46e5;"><i class="fas fa-play me-2"></i> Execute Bonus Re-process</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-dark font-weight-bold"><i class="fas fa-history me-2"></i>Recent Re-process Executions</h5>
                    <span class="badge bg-indigo text-white">Live Audit Log</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Bonus Type</th>
                                    <th>Period</th>
                                    <th>Department</th>
                                    <th>Workers</th>
                                    <th>Total Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-bold text-indigo"><i class="fas fa-star me-1"></i> Eid-ul-Adha Bonus</td>
                                    <td>2026-07</td>
                                    <td>Sewing & Finishing</td>
                                    <td>450</td>
                                    <td class="fw-bold">৳ 620,000</td>
                                    <td><span class="badge bg-success-subtle text-success border border-success rounded-pill px-3">Completed</span></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-purple"><i class="fas fa-star me-1"></i> Eid-ul-Fitr Bonus</td>
                                    <td>2026-04</td>
                                    <td>All Departments</td>
                                    <td>1,240</td>
                                    <td class="fw-bold">৳ 1,450,000</td>
                                    <td><span class="badge bg-success-subtle text-success border border-success rounded-pill px-3">Completed</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
