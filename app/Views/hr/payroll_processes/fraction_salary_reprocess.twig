{% extends "layouts/app.twig" %}

{% block title %}Fraction Month Salary Re-process | HR Payroll{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);">
        <div>
            <span class="badge bg-white text-info mb-2 font-monospace" style="color: #0284c7;"><i class="fas fa-divide me-1"></i> MID-MONTH SALARY PRORATION</span>
            <h2 class="mb-1 font-weight-bold">Fraction Month Salary Re-process</h2>
            <p class="mb-0 opacity-75">Recalculate partial month salaries for new hires, resignations, or mid-month transfers.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-calculator fa-3x opacity-50"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <div class="row">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 text-info fw-bold" style="color: #0284c7;"><i class="fas fa-cogs me-2"></i>Prorate Rule Simulator</h5>
                </div>
                <div class="card-body p-4">
                    <form action="{{ BASE_URL }}/hr/payroll/fraction-salary-reprocess" method="POST">
                        {{ csrf_field() | raw }}
                        <div class="mb-3">
                            <label class="form-label fw-bold">Target Salary Month *</label>
                            <input type="month" name="year_month" class="form-control form-control-lg border-info" value="2026-07" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Target Department</label>
                            <select name="department_id" class="form-select">
                                <option value="">Entire Factory (All Departments)</option>
                                {% for dept in departments %}
                                <option value="{{ dept.department_id }}">{{ dept.department_name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Prorate Calculation Rule *</label>
                            <select name="rule" class="form-select border-info text-info fw-bold">
                                <option value="calendar_days">📅 Actual Calendar Days (e.g. 31 Days in July)</option>
                                <option value="fixed_30">⚖️ Fixed 30 Standard Days Rule</option>
                                <option value="working_days">👔 Actual Working Days (Excluding Offdays)</option>
                            </select>
                        </div>
                        <button type="submit" class="btn text-white w-100 rounded-pill py-3 fw-bold shadow-sm" style="background-color: #0284c7;"><i class="fas fa-redo me-2"></i> Re-process Fraction Salaries</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-info-circle me-2"></i>Prorate Calculation Standard Formula</h5>
                </div>
                <div class="card-body p-4">
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <div class="fw-bold text-dark mb-1">Formula 1: Calendar Days Rule</div>
                        <code class="text-primary font-monospace">Prorated Salary = (Gross Salary / Total Days in Month) * Active Working Days</code>
                    </div>
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <div class="fw-bold text-dark mb-1">Formula 2: Fixed 30 Days Rule</div>
                        <code class="text-primary font-monospace">Prorated Salary = (Gross Salary / 30) * Active Working Days</code>
                    </div>

                    <div class="alert alert-info py-2 small mb-0">
                        <i class="fas fa-shield-alt me-1"></i> Mid-month joiners receive basic salary, house rent, and statutory allowances calculated precisely according to their attendance punches.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
