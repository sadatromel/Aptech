{% extends "layouts/app.twig" %}

{% block title %}Final Settlement Process | HR Payroll{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);">
        <div>
            <span class="badge bg-white text-danger mb-2 font-monospace"><i class="fas fa-user-minus me-1"></i> SEPARATION & RELEASE</span>
            <h2 class="mb-1 font-weight-bold">Final Settlement Process</h2>
            <p class="mb-0 opacity-75">Calculate full and final separation benefits, gratuity, encashments, and clearance dues.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-file-invoice-dollar fa-3x opacity-50"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <div class="row">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 text-danger fw-bold"><i class="fas fa-calculator me-2"></i>Settlement Calculator Form</h5>
                </div>
                <div class="card-body p-4">
                    <form action="{{ BASE_URL }}/hr/payroll/final-settlement" method="POST">
                        {{ csrf_field() | raw }}
                        <div class="mb-3">
                            <label for="employee_id" class="form-label fw-bold">Separating Employee *</label>
                            <select class="form-select form-select-lg border-danger text-danger fw-bold" id="employee_id" name="employee_id" required>
                                <option value="">Select Resigned / Released Employee</option>
                                {% for emp in employees %}
                                <option value="{{ emp.employee_id }}">{{ emp.employee_code }} - {{ emp.first_name }} {{ emp.last_name }} (Basic: ৳{{ emp.basic_salary }})</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6">
                                <label for="resignation_date" class="form-label fw-semibold">Resignation Date *</label>
                                <input type="date" class="form-control" id="resignation_date" name="resignation_date" value="2026-07-01" required>
                            </div>
                            <div class="col-6">
                                <label for="release_date" class="form-label fw-semibold">Release Date *</label>
                                <input type="date" class="form-control" id="release_date" name="release_date" value="2026-07-31" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="service_length_years" class="form-label fw-semibold">Total Length of Service (Years)</label>
                            <input type="number" step="0.1" class="form-control" id="service_length_years" name="service_length_years" placeholder="e.g. 3.5">
                        </div>

                        <div class="bg-light p-3 rounded-3 mb-3 border">
                            <div class="small fw-bold text-uppercase text-muted mb-2"><i class="fas fa-plus-circle text-success me-1"></i> Additions & Entitlements</div>
                            <div class="row mb-2">
                                <div class="col-6">
                                    <label class="form-label small">EL Encashment (৳)</label>
                                    <input type="number" step="0.01" class="form-control form-control-sm" name="encashment_amount" value="0.00">
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">Gratuity Benefit (৳)</label>
                                    <input type="number" step="0.01" class="form-control form-control-sm" name="gratuity_amount" value="0.00">
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small">Notice Pay / Arrears (৳)</label>
                                <input type="number" step="0.01" class="form-control form-control-sm" name="notice_pay" value="0.00">
                            </div>

                            <div class="small fw-bold text-uppercase text-muted mt-3 mb-2"><i class="fas fa-minus-circle text-danger me-1"></i> Deductions & Adjustments</div>
                            <div>
                                <label class="form-label small">Store/PF/Advance Deductions (৳)</label>
                                <input type="number" step="0.01" class="form-control form-control-sm border-danger" name="deductions" value="0.00">
                            </div>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 rounded-pill py-3 text-white fw-bold shadow-sm"><i class="fas fa-check-circle me-2"></i> Save & Generate Settlement Slip</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-history me-2"></i>Settlement Records & Status</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Emp Code</th>
                                    <th>Employee</th>
                                    <th>Release Date</th>
                                    <th>Net Settlement</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for rec in records %}
                                <tr>
                                    <td><span class="badge bg-light text-dark border font-monospace">{{ rec.employee_code }}</span></td>
                                    <td class="fw-bold">{{ rec.employee_name }}</td>
                                    <td>{{ rec.release_date }}</td>
                                    <td class="fw-bold text-success">৳ {{ rec.net_settlement|number_format(2) }}</td>
                                    <td><span class="badge bg-success rounded-pill px-3">{{ rec.status|capitalize }}</span></td>
                                    <td><button class="btn btn-sm btn-outline-danger rounded-circle" title="Print Settlement Slip"><i class="fas fa-print"></i></button></td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fas fa-user-clock fa-2x mb-2 text-danger opacity-50"></i><br>
                                        No employee final settlement records found.
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
