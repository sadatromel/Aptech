{% extends "layouts/app.twig" %}

{% block title %}Monthly Bill Process | HR Payroll{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);">
        <div>
            <span class="badge bg-white text-primary mb-2 font-monospace"><i class="fas fa-receipt me-1"></i> REIMBURSEMENTS & BILLS</span>
            <h2 class="mb-1 font-weight-bold">Monthly Bill Process</h2>
            <p class="mb-0 opacity-75">Process mobile, conveyance, internet, and executive allowance bills.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-money-bill-wave fa-3x opacity-50"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <!-- Bill Category Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-primary">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-primary-subtle text-primary p-3 me-3"><i class="fas fa-mobile-alt fa-2x"></i></div>
                    <div>
                        <div class="small text-muted fw-bold">Mobile Allowance</div>
                        <div class="h4 font-weight-bold text-primary mb-0">৳ 45,500</div>
                        <div class="small text-muted">65 Staff Members</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-info">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-info-subtle text-info p-3 me-3"><i class="fas fa-car fa-2x"></i></div>
                    <div>
                        <div class="small text-muted fw-bold">Conveyance Bill</div>
                        <div class="h4 font-weight-bold text-info mb-0">৳ 72,000</div>
                        <div class="small text-muted">24 Officers</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-success">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-success-subtle text-success p-3 me-3"><i class="fas fa-wifi fa-2x"></i></div>
                    <div>
                        <div class="small text-muted fw-bold">Internet Allowance</div>
                        <div class="h4 font-weight-bold text-success mb-0">৳ 28,000</div>
                        <div class="small text-muted">18 Executives</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-primary"><i class="fas fa-list-alt me-2"></i>Monthly Allowance Processing Register</h5>
            <button class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#billModal"><i class="fas fa-play me-2"></i> Process Monthly Bills</button>
        </div>
        <div class="card-body p-4">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Month</th>
                        <th>Category</th>
                        <th>Eligible Beneficiaries</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>2026-07</td>
                        <td><span class="badge bg-primary-subtle text-primary border border-primary rounded-pill px-3"><i class="fas fa-mobile-alt me-1"></i> Mobile Allowance</span></td>
                        <td>65 Staff</td>
                        <td class="fw-bold text-success">৳ 45,500.00</td>
                        <td><span class="badge bg-success rounded-pill px-3">Processed</span></td>
                    </tr>
                    <tr>
                        <td>2026-07</td>
                        <td><span class="badge bg-info-subtle text-info border border-info rounded-pill px-3"><i class="fas fa-car me-1"></i> Conveyance Bill</span></td>
                        <td>24 Officers</td>
                        <td class="fw-bold text-success">৳ 72,000.00</td>
                        <td><span class="badge bg-success rounded-pill px-3">Processed</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="billModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-3 border-0 shadow-lg">
            <form action="{{ BASE_URL }}/hr/payroll/monthly-bill-process" method="POST">
                {{ csrf_field() | raw }}
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title font-weight-bold"><i class="fas fa-file-invoice-dollar me-1"></i> Process Monthly Bills</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Month *</label>
                        <input type="month" name="year_month" class="form-control" value="2026-07" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Bill Category *</label>
                        <select name="bill_category" class="form-select border-primary text-primary fw-bold">
                            <option value="mobile">📱 Mobile Allowance</option>
                            <option value="conveyance">🚗 Conveyance Allowance</option>
                            <option value="internet">🌐 Internet Allowance</option>
                            <option value="all">⚡ All Combined Monthly Bills</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top py-3">
                    <button type="button" class="btn btn-light rounded-pill border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Execute Process</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
