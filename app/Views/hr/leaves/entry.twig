{% extends "layouts/app.twig" %}

{% block title %}Leave Entry | HR Module{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-3">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-2 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #059669 0%, #10b981 100%);">
        <div>
            <span class="badge bg-white mb-2 font-monospace fw-bold" style="color: #059669;"><i class="fas fa-file-signature me-1"></i> LEAVE APPLICATION & ENTITLEMENT</span>
            <h2 class="mb-1 font-weight-bold">Leave Entry</h2>
            <p class="mb-0 opacity-75">Apply for employee leaves, check real-time entitlement balances, and record leave details.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="{{ BASE_URL }}/hr/leave" class="btn btn-light rounded-pill px-4 font-weight-bold shadow-sm" style="color: #059669;"><i class="fas fa-list me-1"></i> Leave Register</a>
            <a href="{{ BASE_URL }}/hr/leave-delete" class="btn btn-outline-light rounded-pill px-4 font-weight-bold shadow-sm"><i class="fas fa-calendar-minus me-1"></i> Leave Delete</a>
        </div>
    </div>

    <!-- Alert Notifications -->
    {% if flash_success %}
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2 fs-5 align-middle"></i>
            <span>{{ flash_success }}</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endif %}

    {% if flash_error %}
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4 shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2 fs-5 align-middle"></i>
            <span>{{ flash_error }}</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endif %}

    <form id="leaveEntryForm" method="POST" action="{{ BASE_URL }}/hr/leave-entry" enctype="multipart/form-data">
        {{ csrf_field() | raw }}

        <!-- Card 1: Employee & Org Info (Leave Entry Header Box) -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-success fw-bold"><i class="fas fa-user-check me-2"></i>Leave Entry - Employee Information</h5>
                <span class="badge bg-success-subtle text-success border">Employee Lookup</span>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <!-- Row 1: Emp Code, Emp ID, Emp Name -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-success">Emp Code <span class="text-muted fw-normal">(Browse or Write)</span> *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="fas fa-barcode text-muted"></i></span>
                            <input type="text" class="form-control font-monospace border-success-subtle" id="entry_emp_code" name="emp_code" placeholder="Type or select code..." list="entry_employee_codes" autocomplete="off" required>
                            <datalist id="entry_employee_codes">
                                {% for emp in employees %}
                                    <option value="{{ emp.employee_code }}">{{ emp.first_name }} {{ emp.last_name }} ({{ emp.department_name|default('N/A') }})</option>
                                {% endfor %}
                            </datalist>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-success">Emp ID <span class="text-muted fw-normal">(Browse or Write)</span> *</label>
                        <select class="form-select border-success-subtle" id="entry_emp_id" name="employee_id" required>
                            <option value="">-- Browse or Select --</option>
                            {% for emp in employees %}
                                <option value="{{ emp.employee_id }}" 
                                        data-code="{{ emp.employee_code }}" 
                                        data-name="{{ emp.first_name }} {{ emp.last_name }}" 
                                        data-dept="{{ emp.department_id }}" 
                                        data-sec="{{ emp.section_id }}" 
                                        data-pos="{{ emp.position_id }}">
                                    #{{ emp.employee_id }} - {{ emp.employee_code }} ({{ emp.first_name }} {{ emp.last_name }})
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-secondary">Emp Name</label>
                        <input type="text" class="form-control bg-light" id="entry_emp_name" readonly placeholder="Auto-populated on selection">
                    </div>

                    <!-- Row 2: Category, Company, Location -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-dark">Category</label>
                        <select class="form-select" name="category">
                            <option value="">-- Select --</option>
                            {% for cat in categories %}
                                <option value="{{ cat }}">{{ cat }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-dark">Company</label>
                        <select class="form-select" name="company">
                            <option value="">-- Select --</option>
                            {% for comp in companies %}
                                <option value="{{ comp.factory_id }}">{{ comp.factory_name }} ({{ comp.factory_code }})</option>
                            {% else %}
                                <option value="1">Aptech Caswier Ltd.</option>
                                <option value="2">Big Boss Corporation Ltd.</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-dark">Location</label>
                        <select class="form-select" name="location">
                            <option value="">-- Select --</option>
                            {% for loc in locations %}
                                <option value="{{ loc }}" {{ loop.first ? 'selected' : '' }}>{{ loc }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <!-- Row 3: Division, Department, Section -->
                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-dark">Division</label>
                        <select class="form-select" name="division">
                            <option value="">-- Select --</option>
                            {% for div in divisions %}
                                <option value="{{ div }}">{{ div }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-dark">Department</label>
                        <select class="form-select" id="entry_department" name="department_id">
                            <option value="">-- Select --</option>
                            {% for dept in departments %}
                                <option value="{{ dept.department_id }}">{{ dept.department_name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-dark">Section</label>
                        <select class="form-select" id="entry_section" name="section_id">
                            <option value="">-- Select --</option>
                            {% for sec in sections %}
                                <option value="{{ sec.section_id }}">{{ sec.section_name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <!-- Row 4: Subsection, Designation -->
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-dark">Subsection</label>
                        <select class="form-select" name="subsection">
                            <option value="">-- Select --</option>
                            {% for sub in subsections %}
                                <option value="{{ sub }}">{{ sub }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-dark">Designation</label>
                        <select class="form-select" id="entry_position" name="position_id">
                            <option value="">-- Select --</option>
                            {% for pos in positions %}
                                <option value="{{ pos.position_id }}">{{ pos.position_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Leave Balance Info Grid Table -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-primary fw-bold">
                    <i class="fas fa-calculator me-2"></i>Leave Balance Info
                    <span id="balance_emp_badge" class="badge bg-primary-subtle text-primary border ms-2 fs-7 fw-semibold">Select an Employee</span>
                </h5>
                <small class="text-muted"><i class="fas fa-info-circle me-1"></i>Auto-calculated dynamically on employee selection</small>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered align-middle text-center mb-0" id="leaveBalanceTable">
                        <thead class="table-light">
                            <tr class="align-middle">
                                <th class="text-start px-3" style="width: 220px;">Leave Status</th>
                                <th>CL (Days)</th>
                                <th>SL (Days)</th>
                                <th>LWP (Days)</th>
                                <th>RL (Days)</th>
                                <th>SPL (Days)</th>
                                <th>EL (Days)</th>
                                <th>EDL (Days)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th class="text-start px-3 bg-light text-secondary">Leave Entitlement</th>
                                <td id="cell_ent_CL" class="fw-semibold text-dark">10.0</td>
                                <td id="cell_ent_SL" class="fw-semibold text-dark">14.0</td>
                                <td id="cell_ent_LWP" class="fw-semibold text-dark">0.0</td>
                                <td id="cell_ent_RL" class="fw-semibold text-dark">5.0</td>
                                <td id="cell_ent_SPL" class="fw-semibold text-dark">5.0</td>
                                <td id="cell_ent_EL" class="fw-semibold text-dark">18.0</td>
                                <td id="cell_ent_EDL" class="fw-semibold text-dark">10.0</td>
                            </tr>
                            <tr>
                                <th class="text-start px-3 bg-light text-secondary">Leave Taken/Enjoyed</th>
                                <td id="cell_taken_CL" class="text-muted">0.0</td>
                                <td id="cell_taken_SL" class="text-muted">0.0</td>
                                <td id="cell_taken_LWP" class="text-muted">0.0</td>
                                <td id="cell_taken_RL" class="text-muted">0.0</td>
                                <td id="cell_taken_SPL" class="text-muted">0.0</td>
                                <td id="cell_taken_EL" class="text-muted">0.0</td>
                                <td id="cell_taken_EDL" class="text-muted">0.0</td>
                            </tr>
                            <tr>
                                <th class="text-start px-3 bg-light text-primary">Balance of Leave</th>
                                <td id="cell_bal_CL" class="fw-bold text-primary">10.0</td>
                                <td id="cell_bal_SL" class="fw-bold text-primary">14.0</td>
                                <td id="cell_bal_LWP" class="fw-bold text-primary">0.0</td>
                                <td id="cell_bal_RL" class="fw-bold text-primary">5.0</td>
                                <td id="cell_bal_SPL" class="fw-bold text-primary">5.0</td>
                                <td id="cell_bal_EL" class="fw-bold text-primary">18.0</td>
                                <td id="cell_bal_EDL" class="fw-bold text-primary">10.0</td>
                            </tr>
                            <tr>
                                <th class="text-start px-3 bg-light text-warning">Leave Applied</th>
                                <td id="cell_app_CL" class="text-warning fw-semibold">0.0</td>
                                <td id="cell_app_SL" class="text-warning fw-semibold">0.0</td>
                                <td id="cell_app_LWP" class="text-warning fw-semibold">0.0</td>
                                <td id="cell_app_RL" class="text-warning fw-semibold">0.0</td>
                                <td id="cell_app_SPL" class="text-warning fw-semibold">0.0</td>
                                <td id="cell_app_EL" class="text-warning fw-semibold">0.0</td>
                                <td id="cell_app_EDL" class="text-warning fw-semibold">0.0</td>
                            </tr>
                            <tr>
                                <th class="text-start px-3 bg-light text-success">Balance of Leave after Approved</th>
                                <td id="cell_aft_CL" class="fw-bold text-success">10.0</td>
                                <td id="cell_aft_SL" class="fw-bold text-success">14.0</td>
                                <td id="cell_aft_LWP" class="fw-bold text-success">0.0</td>
                                <td id="cell_aft_RL" class="fw-bold text-success">5.0</td>
                                <td id="cell_aft_SPL" class="fw-bold text-success">5.0</td>
                                <td id="cell_aft_EL" class="fw-bold text-success">18.0</td>
                                <td id="cell_aft_EDL" class="fw-bold text-success">10.0</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Card 3: Application Form & During-Leave Time -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-success fw-bold"><i class="fas fa-file-pen me-2"></i>Application Form</h5>
                <span class="badge bg-light text-dark border">Leave Specifications</span>
            </div>
            <div class="card-body p-4">

                <!-- Application Form Parameters Grid -->
                <div class="row g-3 align-items-end mb-4">
                    <div class="col-lg-2 col-md-4">
                        <label class="form-label fw-bold small text-success">Leave Type *</label>
                        <select class="form-select border-success-subtle fw-bold" name="leave_type" id="entry_leave_type" required>
                            <option value="">--Select--</option>
                            {% for lt in leaveTypes %}
                                <option value="{{ lt }}">{{ lt }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-lg-2 col-md-4">
                        <label class="form-label fw-bold small text-dark">Day's Part</label>
                        <select class="form-select" name="days_part" id="entry_days_part">
                            <option value="Full Day">Full Day</option>
                            <option value="1st Half">1st Half</option>
                            <option value="2nd Half">2nd Half</option>
                        </select>
                    </div>

                    <div class="col-lg-2 col-md-4">
                        <label class="form-label fw-bold small text-dark">Adjust Leave Type</label>
                        <select class="form-select" name="adjust_leave_type">
                            <option value="">--Select--</option>
                            {% for lt in leaveTypes %}
                                <option value="{{ lt }}">{{ lt }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <label class="form-label fw-bold small text-dark">Leave Date Range *</label>
                        <div class="input-group">
                            <input type="date" class="form-control" name="start_date" id="entry_start_date" required>
                            <span class="input-group-text bg-light">To</span>
                            <input type="date" class="form-control" name="end_date" id="entry_end_date" required>
                        </div>
                    </div>

                    <div class="col-lg-1 col-md-3">
                        <label class="form-label fw-bold small text-dark">Days</label>
                        <input type="text" class="form-control text-center fw-bold bg-light" id="entry_days_count" readonly value="1">
                    </div>

                    <div class="col-lg-2 col-md-3">
                        <label class="form-label fw-bold small text-dark">Attachment Document</label>
                        <input type="file" class="form-control" name="attachment_file" id="entry_file">
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold small text-dark">Reason for Leave</label>
                        <input type="text" class="form-control" name="reason" placeholder="State explicit reason for leave request...">
                    </div>
                </div>

                <!-- Sub-panel: During Leave Time -->
                <div class="border rounded-3 p-3 bg-light-subtle mb-4">
                    <legend class="float-none w-auto px-2 fs-6 fw-bold text-success mb-3">
                        <i class="fas fa-location-dot me-1"></i> During Leave Time Details
                    </legend>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark">Destination Address</label>
                            <input type="text" class="form-control" name="during_destination" placeholder="Address during leave period...">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark">Contact Person</label>
                            <input type="text" class="form-control" name="during_contact_person" placeholder="Emergency contact person name...">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark">Contact No</label>
                            <input type="text" class="form-control" name="during_contact_no" placeholder="Emergency contact phone number...">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark">Job Responsible (Substitute)</label>
                            <select class="form-select" name="job_responsible_id">
                                <option value="">-- Browse or Select Substitute --</option>
                                {% for emp in employees %}
                                    <option value="{{ emp.employee_id }}">{{ emp.first_name }} {{ emp.last_name }} ({{ emp.employee_code }})</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold small text-dark">Special Instruction</label>
                            <textarea class="form-control" name="special_instruction" rows="2" placeholder="Handover notes or special instructions during leave..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- Action Button Controls -->
                <div class="d-flex justify-content-center gap-3 pt-3 border-top">
                    <button type="submit" class="btn btn-success rounded-pill px-4 font-weight-bold shadow-sm">
                        <i class="fas fa-save me-1"></i> Save Entry
                    </button>
                    <button type="reset" class="btn btn-outline-secondary rounded-pill px-4 font-weight-bold">
                        <i class="fas fa-rotate-right me-1"></i> Refresh
                    </button>
                </div>

            </div>
        </div>
    </form>

    <!-- Recent Leaves Register Data Table -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-success fw-bold"><i class="fas fa-clock-rotate-left me-2"></i>Recent Leave Submissions</h5>
            <span class="badge bg-light text-dark border">Latest Register</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#ID</th>
                            <th>Employee</th>
                            <th>Department</th>
                            <th>Leave Type</th>
                            <th>Dates</th>
                            <th>Duration</th>
                            <th>Status</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for rec in recentLeaves %}
                        <tr>
                            <td><span class="badge bg-light text-dark border font-monospace">#{{ rec.id }}</span></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-circle me-2 bg-success-subtle text-success fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                                        {{ rec.first_name|first }}{{ rec.last_name|first }}
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">{{ rec.first_name }} {{ rec.last_name }}</div>
                                        <span class="badge bg-light text-dark border font-monospace">{{ rec.employee_code }}</span>
                                    </div>
                                </div>
                            </td>
                            <td>{{ rec.department_name|default('N/A') }}</td>
                            <td>
                                <span class="badge bg-success-subtle text-success fw-bold px-2 py-1 rounded">
                                    {{ rec.leave_type }}
                                </span>
                            </td>
                            <td>
                                <small class="fw-semibold text-dark">{{ rec.start_date|date("M j, Y") }}</small>
                                <span class="text-muted">to</span>
                                <small class="fw-semibold text-dark">{{ rec.end_date|date("M j, Y") }}</small>
                            </td>
                            <td><span class="badge bg-light text-dark border font-monospace">{{ rec.total_days|default(1) }} Day(s)</span></td>
                            <td>
                                {% if rec.status == 'Approved' %}
                                    <span class="badge bg-success rounded-pill px-3"><i class="fas fa-check-circle me-1"></i>Approved</span>
                                {% elseif rec.status == 'Pending' %}
                                    <span class="badge bg-warning text-dark rounded-pill px-3"><i class="fas fa-clock me-1"></i>Pending</span>
                                {% else %}
                                    <span class="badge bg-secondary rounded-pill px-3">{{ rec.status }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <small class="text-muted d-inline-block text-truncate" style="max-width: 180px;" title="{{ rec.reason }}">
                                    {{ rec.reason|default('N/A') }}
                                </small>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No recent leave records submitted.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const baseUrl = "{{ BASE_URL }}";

    const empCodeInput = document.getElementById('entry_emp_code');
    const empIdSelect = document.getElementById('entry_emp_id');
    const empNameInput = document.getElementById('entry_emp_name');
    const departmentSelect = document.getElementById('entry_department');
    const sectionSelect = document.getElementById('entry_section');
    const positionSelect = document.getElementById('entry_position');

    const startDateInput = document.getElementById('entry_start_date');
    const endDateInput = document.getElementById('entry_end_date');
    const daysPartSelect = document.getElementById('entry_days_part');
    const daysCountInput = document.getElementById('entry_days_count');

    // Auto-calculate total days
    function calculateDays() {
        if (daysPartSelect.value === '1st Half' || daysPartSelect.value === '2nd Half') {
            daysCountInput.value = '0.5';
            return;
        }

        if (startDateInput.value && endDateInput.value) {
            const d1 = new Date(startDateInput.value);
            const d2 = new Date(endDateInput.value);
            if (d2 >= d1) {
                const diffTime = Math.abs(d2 - d1);
                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
                daysCountInput.value = diffDays.toString();
            } else {
                daysCountInput.value = '1';
            }
        }
    }

    if (startDateInput) startDateInput.addEventListener('change', calculateDays);
    if (endDateInput) endDateInput.addEventListener('change', calculateDays);
    if (daysPartSelect) daysPartSelect.addEventListener('change', calculateDays);

    const balanceBadge = document.getElementById('balance_emp_badge');

    // Instantly update employee info fields & badge from select data attributes
    function updateFieldsFromSelectOption(opt) {
        if (!opt || !opt.value) {
            empNameInput.value = '';
            if (balanceBadge) {
                balanceBadge.textContent = 'Select an Employee';
                balanceBadge.className = 'badge bg-primary-subtle text-primary border ms-2 fs-7 fw-semibold';
            }
            return;
        }

        const name = opt.dataset.name || '';
        const code = opt.dataset.code || '';
        const dept = opt.dataset.dept || '';
        const sec = opt.dataset.sec || '';
        const pos = opt.dataset.pos || '';

        if (name) empNameInput.value = name;
        if (code && !empCodeInput.value) empCodeInput.value = code;
        if (dept && departmentSelect) departmentSelect.value = dept;
        if (sec && sectionSelect) sectionSelect.value = sec;
        if (pos && positionSelect) positionSelect.value = pos;

        if (balanceBadge) {
            balanceBadge.textContent = `Balance for: ${name} (${code || '#' + opt.value})`;
            balanceBadge.className = 'badge bg-success-subtle text-success border ms-2 fs-7 fw-semibold';
        }
    }

    // Fetch Employee info & Live Leave Balance Grid
    function loadEmployeeAndBalance(code, id) {
        if (!code && !id) {
            updateFieldsFromSelectOption(null);
            return;
        }

        let empUrl = `${baseUrl}/api/hr/employee-details?`;
        if (code) empUrl += `code=${encodeURIComponent(code)}`;
        else if (id) empUrl += `id=${encodeURIComponent(id)}`;

        fetch(empUrl)
            .then(res => res.json())
            .then(data => {
                if (data.success && data.employee) {
                    const emp = data.employee;
                    empNameInput.value = emp.name;
                    if (emp.code) empCodeInput.value = emp.code;
                    if (emp.id && (!empIdSelect.value || empIdSelect.value != emp.id)) empIdSelect.value = emp.id;
                    if (emp.department_id && departmentSelect) departmentSelect.value = emp.department_id;
                    if (emp.section_id && sectionSelect) sectionSelect.value = emp.section_id;
                    if (emp.position_id && positionSelect) positionSelect.value = emp.position_id;

                    if (balanceBadge) {
                        balanceBadge.textContent = `Balance for: ${emp.name} (${emp.code || '#' + emp.id})`;
                        balanceBadge.className = 'badge bg-success-subtle text-success border ms-2 fs-7 fw-semibold';
                    }

                    // Fetch Leave Balance Grid for this employee
                    fetchLeaveBalance(emp.id);
                }
            })
            .catch(err => console.error("Error fetching employee details:", err));
    }

    function fetchLeaveBalance(employeeId) {
        if (!employeeId) return;

        fetch(`${baseUrl}/api/hr/leave-balance?employee_id=${employeeId}`)
            .then(res => res.json())
            .then(data => {
                if (data.success && data.grid) {
                    const grid = data.grid;
                    const codes = ['CL', 'SL', 'LWP', 'RL', 'SPL', 'EL', 'EDL'];
                    codes.forEach(code => {
                        if (grid[code]) {
                            const info = grid[code];
                            document.getElementById(`cell_ent_${code}`).textContent = info.entitlement.toFixed(1);
                            document.getElementById(`cell_taken_${code}`).textContent = info.taken.toFixed(1);
                            document.getElementById(`cell_bal_${code}`).textContent = info.balance.toFixed(1);
                            document.getElementById(`cell_app_${code}`).textContent = info.applied.toFixed(1);
                            document.getElementById(`cell_aft_${code}`).textContent = info.balance_after.toFixed(1);
                        }
                    });
                }
            })
            .catch(err => console.error("Error fetching leave balance grid:", err));
    }

    // Attach listeners for Employee selection
    if (empIdSelect) {
        ['change', 'input'].forEach(evt => {
            empIdSelect.addEventListener(evt, function () {
                const opt = this.options[this.selectedIndex];
                updateFieldsFromSelectOption(opt);
                if (this.value) {
                    fetchLeaveBalance(this.value);
                }
            });
        });
    }

    if (empCodeInput) {
        ['change', 'input'].forEach(evt => {
            empCodeInput.addEventListener(evt, function () {
                const codeVal = this.value.trim();
                if (codeVal.length >= 2) {
                    // Search in select options first
                    let foundOpt = null;
                    if (empIdSelect) {
                        for (let i = 0; i < empIdSelect.options.length; i++) {
                            const opt = empIdSelect.options[i];
                            if (opt.dataset.code && opt.dataset.code.toLowerCase() === codeVal.toLowerCase()) {
                                foundOpt = opt;
                                break;
                            }
                        }
                    }
                    if (foundOpt) {
                        empIdSelect.value = foundOpt.value;
                        updateFieldsFromSelectOption(foundOpt);
                        fetchLeaveBalance(foundOpt.value);
                    } else {
                        loadEmployeeAndBalance(codeVal, '');
                    }
                }
            });
        });
    }

    // Department, Section, Position filter handler
    [departmentSelect, sectionSelect, positionSelect].forEach(sel => {
        if (sel) {
            sel.addEventListener('change', function () {
                const deptId = departmentSelect ? departmentSelect.value : '';
                const secId = sectionSelect ? sectionSelect.value : '';
                const posId = positionSelect ? positionSelect.value : '';

                if (empIdSelect) {
                    let firstMatchingValue = null;
                    for (let i = 0; i < empIdSelect.options.length; i++) {
                        const opt = empIdSelect.options[i];
                        if (!opt.value) continue;

                        let match = true;
                        if (deptId && opt.dataset.dept != deptId) match = false;
                        if (secId && opt.dataset.sec != secId) match = false;
                        if (posId && opt.dataset.pos != posId) match = false;

                        opt.hidden = !match;
                        if (match && !firstMatchingValue) {
                            firstMatchingValue = opt.value;
                        }
                    }

                    // Auto-select first matching employee if current selection doesn't match filter
                    const currentOpt = empIdSelect.options[empIdSelect.selectedIndex];
                    if (currentOpt && currentOpt.hidden && firstMatchingValue) {
                        empIdSelect.value = firstMatchingValue;
                        const newOpt = empIdSelect.options[empIdSelect.selectedIndex];
                        updateFieldsFromSelectOption(newOpt);
                        fetchLeaveBalance(firstMatchingValue);
                    }
                }
            });
        }
    });

    // Auto-trigger load if employee is pre-selected on load
    if (empIdSelect && empIdSelect.value) {
        const opt = empIdSelect.options[empIdSelect.selectedIndex];
        updateFieldsFromSelectOption(opt);
        fetchLeaveBalance(empIdSelect.value);
    } else if (empCodeInput && empCodeInput.value) {
        loadEmployeeAndBalance(empCodeInput.value.trim(), '');
    }
});
</script>
{% endblock %}
