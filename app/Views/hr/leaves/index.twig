{% extends "layouts/app.twig" %}

{% block title %}Leave Management | HR Module{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #2563eb 0%, #06b6d4 100%);">
        <div>
            <span class="badge bg-white text-primary mb-2 font-monospace"><i class="fas fa-calendar-alt me-1"></i> LEAVE & ABSENCE WORKFLOW</span>
            <h2 class="mb-1 font-weight-bold">Leave Management Portal</h2>
            <p class="mb-0 opacity-75">Process employee leave applications, check Casual/Sick/Earned balances, and manage approvals.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-light rounded-pill px-4 font-weight-bold text-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#applyLeaveModal"><i class="fas fa-plus me-1"></i> Apply for Leave</button>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-muted font-weight-bold text-uppercase">Total Applications</div>
                        <div class="h3 font-weight-bold text-primary my-1">{{ stats.total|default(0) }}</div>
                        <div class="small text-muted"><i class="fas fa-folder-open me-1"></i> All Time Requests</div>
                    </div>
                    <div class="p-3 bg-primary-subtle text-primary rounded-circle"><i class="fas fa-folder-open fa-2x"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-muted font-weight-bold text-uppercase">Pending Approval</div>
                        <div class="h3 font-weight-bold text-warning my-1">{{ stats.pending|default(0) }}</div>
                        <div class="small text-warning"><i class="fas fa-clock me-1"></i> Awaiting Action</div>
                    </div>
                    <div class="p-3 bg-warning-subtle text-warning rounded-circle"><i class="fas fa-clock fa-2x"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-muted font-weight-bold text-uppercase">Approved</div>
                        <div class="h3 font-weight-bold text-success my-1">{{ stats.approved|default(0) }}</div>
                        <div class="small text-success"><i class="fas fa-check-circle me-1"></i> Sanctioned Leaves</div>
                    </div>
                    <div class="p-3 bg-success-subtle text-success rounded-circle"><i class="fas fa-check-circle fa-2x"></i></div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-danger">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small text-muted font-weight-bold text-uppercase">Rejected</div>
                        <div class="h3 font-weight-bold text-danger my-1">{{ stats.rejected|default(0) }}</div>
                        <div class="small text-muted"><i class="fas fa-times-circle me-1"></i> Declined Requests</div>
                    </div>
                    <div class="p-3 bg-danger-subtle text-danger rounded-circle"><i class="fas fa-times-circle fa-2x"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Table Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-primary fw-bold"><i class="fas fa-list me-2"></i>Leave Applications Register</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Employee</th>
                            <th>Leave Type</th>
                            <th>Duration</th>
                            <th>Dates</th>
                            <th>Status</th>
                            <th>Applied Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for leave in leaves %}
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-circle me-3 bg-primary-subtle text-primary fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                        {{ leave.first_name|first }}{{ leave.last_name|first }}
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">{{ leave.first_name }} {{ leave.last_name }}</div>
                                        <div class="small text-muted">{{ leave.department_name }}</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge bg-light text-dark border fw-bold">{{ leave.leave_type }}</span></td>
                            <td>
                                {% set start = date(leave.start_date) %}
                                {% set end = date(leave.end_date) %}
                                <span class="badge bg-primary-subtle text-primary rounded-pill px-3">{{ end.diff(start).days + 1 }} Days</span>
                            </td>
                            <td>
                                <div class="small fw-semibold text-dark">{{ leave.start_date|date("M j, Y") }}</div>
                                <div class="small text-muted">to {{ leave.end_date|date("M j, Y") }}</div>
                            </td>
                            <td>
                                {% set statusClass = {
                                    'Approved': 'bg-success text-white',
                                    'Rejected': 'bg-danger text-white',
                                    'Pending': 'bg-warning text-dark'
                                } %}
                                <span class="badge {{ statusClass[leave.status] }} rounded-pill px-3">
                                    {{ leave.status }}
                                </span>
                            </td>
                            <td><small class="text-muted">{{ leave.created_at|date("M j, Y") }}</small></td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fas fa-calendar-minus fa-2x mb-2 text-primary opacity-50"></i><br>
                                No leave applications found in register.
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Apply Leave Modal -->
<div class="modal fade" id="applyLeaveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-3 border-0 shadow-lg">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-paper-plane me-1"></i> Apply for Leave</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="applyLeaveForm" action="{{ BASE_URL }}/hr/leaves" method="POST">
                    {{ csrf_field() | raw }}
                    <div class="mb-3">
                        <label class="form-label fw-bold">Employee *</label>
                        <select class="form-select border-primary" name="employee_id" required>
                            <option value="">Select Employee</option>
                            {% for employee in employees %}
                                <option value="{{ employee.employee_id }}">{{ employee.first_name }} {{ employee.last_name }} ({{ employee.employee_code }})</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Leave Type *</label>
                        <select class="form-select border-primary fw-bold" name="leave_type" required>
                            <option value="Annual Leave">🌴 Annual / Earned Leave</option>
                            <option value="Sick Leave">🏥 Sick Leave (SL)</option>
                            <option value="Casual Leave">☕ Casual Leave (CL)</option>
                            <option value="Unpaid Leave">⚠️ Unpaid Leave (LWP)</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Start Date *</label>
                            <input type="date" class="form-control" name="start_date" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">End Date *</label>
                            <input type="date" class="form-control" name="end_date" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Reason for Absence</label>
                        <textarea class="form-control" name="reason" rows="3" placeholder="Brief reason for leave..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top py-3">
                <button type="button" class="btn btn-light rounded-pill border" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="applyLeaveForm" class="btn btn-primary rounded-pill px-4 fw-bold"><i class="fas fa-paper-plane me-1"></i> Submit Application</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}
