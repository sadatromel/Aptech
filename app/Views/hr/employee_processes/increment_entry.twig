{% extends "layouts/app.twig" %}

{% block title %}Increment Entry | HR Employees{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #10b981 0%, #047857 100%);">
        <div>
            <span class="badge bg-white text-success mb-2 font-monospace"><i class="fas fa-arrow-up me-1"></i> SINGLE EMPLOYEE SALARY REVISION</span>
            <h2 class="mb-1 font-weight-bold">Increment Entry</h2>
            <p class="mb-0 opacity-75">Apply annual, performance, or special salary increment to individual staff.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-chart-line fa-3x opacity-50"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <div class="row">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 text-success fw-bold"><i class="fas fa-plus-circle me-2"></i>Increment Input Form</h5>
                </div>
                <div class="card-body p-4">
                    <form action="{{ BASE_URL }}/hr/employees/increment-entry" method="POST">
                        {{ csrf_field() | raw }}
                        <div class="mb-3">
                            <label for="employee_id" class="form-label fw-bold">Select Employee *</label>
                            <select class="form-select form-select-lg border-success text-success fw-bold" id="employee_id" name="employee_id" required onchange="updatePreviousGross(this)">
                                <option value="">Select Employee</option>
                                {% for emp in employees %}
                                <option value="{{ emp.employee_id }}" data-gross="{{ emp.basic_salary }}">{{ emp.employee_code }} - {{ emp.first_name }} {{ emp.last_name }} (Current: ৳{{ emp.basic_salary }})</option>
                                {% endfor %}
                            </select>
                        </div>

                        <!-- Visualizer Box -->
                        <div class="p-3 bg-light rounded-3 mb-3 border text-center">
                            <div class="small text-muted font-monospace mb-1">SALARY UPGRADE VISUALIZER</div>
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="small text-muted">Previous</div>
                                    <input type="number" step="0.01" class="form-control form-control-sm text-center border-0 bg-transparent font-weight-bold" id="previous_gross" name="previous_gross" value="0.00" readonly>
                                </div>
                                <i class="fas fa-arrow-right text-success"></i>
                                <div>
                                    <div class="small text-muted">Increment</div>
                                    <input type="number" step="0.01" class="form-control form-control-sm text-center border-success fw-bold" id="increment_amount" name="increment_amount" placeholder="+ ৳" required oninput="calculateNewSalary()">
                                </div>
                                <i class="fas fa-equals text-success"></i>
                                <div>
                                    <div class="small text-muted">New Gross</div>
                                    <div class="fw-bold text-success" id="new_salary_display">৳ 0.00</div>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <label for="effective_date" class="form-label fw-semibold">Effective Date *</label>
                                <input type="date" class="form-control" id="effective_date" name="effective_date" value="2026-08-01" required>
                            </div>
                            <div class="col-6">
                                <label for="increment_type" class="form-label fw-semibold">Category *</label>
                                <select class="form-select" id="increment_type" name="increment_type" required>
                                    <option value="annual">Annual Yearly</option>
                                    <option value="special">Special Award</option>
                                    <option value="performance">Performance</option>
                                </select>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success w-100 rounded-pill py-3 text-white fw-bold shadow-sm"><i class="fas fa-save me-2"></i> Submit & Update Salary</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-history me-2"></i>Recent Increment History</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Emp Code</th>
                                    <th>Employee</th>
                                    <th>Effective Date</th>
                                    <th>Previous</th>
                                    <th>Increment</th>
                                    <th>New Gross</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for rec in records %}
                                <tr>
                                    <td><span class="badge bg-light text-dark border font-monospace">{{ rec.employee_code }}</span></td>
                                    <td class="fw-bold">{{ rec.employee_name }}</td>
                                    <td>{{ rec.effective_date }}</td>
                                    <td>৳ {{ rec.previous_gross|number_format(2) }}</td>
                                    <td class="fw-bold text-success">+ ৳ {{ rec.increment_amount|number_format(2) }}</td>
                                    <td class="fw-bold text-primary">৳ {{ rec.new_gross|number_format(2) }}</td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fas fa-arrow-up fa-2x mb-2 text-success opacity-50"></i><br>
                                        No individual increment records logged yet.
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function updatePreviousGross(select) {
    const opt = select.options[select.selectedIndex];
    const gross = opt ? opt.getAttribute('data-gross') : '0.00';
    document.getElementById('previous_gross').value = gross || '0.00';
    calculateNewSalary();
}

function calculateNewSalary() {
    const prev = parseFloat(document.getElementById('previous_gross').value) || 0;
    const inc = parseFloat(document.getElementById('increment_amount').value) || 0;
    const total = prev + inc;
    document.getElementById('new_salary_display').innerText = '৳ ' + total.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
}
</script>
{% endblock %}
