{% extends "layouts/app.twig" %}

{% block title %}Lay Off Employee | HR Administration{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #b91c1c 0%, #7f1d1d 100%);">
        <div>
            <span class="badge bg-white text-danger mb-2 font-monospace"><i class="fas fa-user-slash me-1"></i> TEMPORARY LAYOFF & RECALL</span>
            <h2 class="mb-1 font-weight-bold">Lay Off Employee Management</h2>
            <p class="mb-0 opacity-75">Declare temporary layoff orders and manage 50% statutory compensation per Labor Law.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-exclamation-triangle fa-3x opacity-50"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <div class="row">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 mb-4 border-top border-4 border-danger">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 text-danger fw-bold"><i class="fas fa-gavel me-2"></i>Declare Layoff Order</h5>
                </div>
                <div class="card-body p-4">
                    <form action="{{ BASE_URL }}/hr/employees/lay-off" method="POST">
                        {{ csrf_field() | raw }}
                        <div class="mb-3">
                            <label for="employee_id" class="form-label fw-bold">Select Employee *</label>
                            <select class="form-select form-select-lg border-danger text-danger fw-bold" id="employee_id" name="employee_id" required>
                                <option value="">Select Employee</option>
                                {% for emp in employees %}
                                <option value="{{ emp.employee_id }}">{{ emp.employee_code }} - {{ emp.first_name }} {{ emp.last_name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6">
                                <label for="start_date" class="form-label fw-semibold">Layoff Start Date *</label>
                                <input type="date" class="form-control" id="start_date" name="start_date" value="2026-08-01" required>
                            </div>
                            <div class="col-6">
                                <label for="end_date" class="form-label fw-semibold">Expected End Date</label>
                                <input type="date" class="form-control" id="end_date" name="end_date">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="compensation_percentage" class="form-label fw-bold">Statutory Compensation (%) *</label>
                            <input type="number" step="0.1" class="form-control form-control-lg border-warning text-warning fw-bold" id="compensation_percentage" name="compensation_percentage" value="50.0">
                            <small class="text-muted"><i class="fas fa-gavel me-1"></i> Sec 16 Labor Act: 50% basic salary during 1st 45 days.</small>
                        </div>
                        <div class="mb-3">
                            <label for="layoff_reason" class="form-label fw-semibold">Reason for Layoff *</label>
                            <textarea class="form-control" id="layoff_reason" name="layoff_reason" rows="2" placeholder="e.g. Raw material shortage, Machine breakdown, Temporary order reduction" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-danger w-100 rounded-pill py-3 text-white fw-bold shadow-sm"><i class="fas fa-exclamation-circle me-2"></i> Register Layoff Order</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-list-ul me-2"></i>Layoff Register & Recall Status</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Emp Code</th>
                                    <th>Employee</th>
                                    <th>Start Date</th>
                                    <th>Compensation %</th>
                                    <th>Reason</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for rec in records %}
                                <tr>
                                    <td><span class="badge bg-light text-dark border font-monospace">{{ rec.employee_code }}</span></td>
                                    <td class="fw-bold">{{ rec.employee_name }}</td>
                                    <td>{{ rec.start_date }}</td>
                                    <td><span class="badge bg-warning-subtle text-warning border border-warning rounded-pill px-3">{{ rec.compensation_percentage }}% Basic</span></td>
                                    <td><small class="text-muted">{{ rec.layoff_reason }}</small></td>
                                    <td><span class="badge bg-danger rounded-pill px-3">{{ rec.status|capitalize }}</span></td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fas fa-user-slash fa-2x mb-2 text-danger opacity-50"></i><br>
                                        No active layoff orders in register.
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
