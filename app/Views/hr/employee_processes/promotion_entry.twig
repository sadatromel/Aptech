{% extends "layouts/app.twig" %}

{% block title %}Promotion Entry | HR Employees{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #6d28d9 0%, #4c1d95 100%);">
        <div>
            <span class="badge bg-white text-purple mb-2 font-monospace" style="color: #6d28d9;"><i class="fas fa-award me-1"></i> CAREER PROGRESSION</span>
            <h2 class="mb-1 font-weight-bold">Single Employee Promotion Entry</h2>
            <p class="mb-0 opacity-75">Record designation upgrades, grade escalations, and promotional salary revisions.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-user-graduate fa-3x opacity-50"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <div class="row">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold" style="color: #6d28d9;"><i class="fas fa-crown me-2"></i>Promotion Form</h5>
                </div>
                <div class="card-body p-4">
                    <form action="{{ BASE_URL }}/hr/employees/promotion-entry" method="POST">
                        {{ csrf_field() | raw }}
                        <div class="mb-3">
                            <label for="employee_id" class="form-label fw-bold">Select Employee *</label>
                            <select class="form-select form-select-lg border-purple text-purple fw-bold" id="employee_id" name="employee_id" required>
                                <option value="">Select Employee</option>
                                {% for emp in employees %}
                                <option value="{{ emp.employee_id }}">{{ emp.employee_code }} - {{ emp.first_name }} {{ emp.last_name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="effective_date" class="form-label fw-semibold">Effective Date *</label>
                            <input type="date" class="form-control" id="effective_date" name="effective_date" value="2026-08-01" required>
                        </div>
                        
                        <!-- Career Path Progression Box -->
                        <div class="p-3 bg-light rounded-3 mb-3 border">
                            <div class="small fw-bold text-muted text-uppercase mb-2"><i class="fas fa-level-up-alt text-purple me-1"></i> Designation Upgrade Path</div>
                            <div class="mb-2">
                                <label for="previous_designation" class="form-label small">Previous Title *</label>
                                <input type="text" class="form-control form-control-sm" id="previous_designation" name="previous_designation" placeholder="e.g. Junior Sewing Operator" required>
                            </div>
                            <div class="text-center my-1"><i class="fas fa-arrow-down text-purple"></i></div>
                            <div>
                                <label for="new_designation" class="form-label small">New Title *</label>
                                <select class="form-select form-select-sm border-purple fw-bold" id="new_designation" name="new_designation" required>
                                    <option value="">Select New Designation</option>
                                    {% for des in designations %}
                                    <option value="{{ des.designation_name }}">{{ des.designation_name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="salary_increment" class="form-label fw-semibold">Promotional Increment (৳)</label>
                            <input type="number" step="0.01" class="form-control" id="salary_increment" name="salary_increment" placeholder="e.g. 2500.00">
                        </div>
                        <div class="mb-3">
                            <label for="remarks" class="form-label fw-semibold">Appraisal Score / Remarks</label>
                            <textarea class="form-control" id="remarks" name="remarks" rows="2" placeholder="e.g. Score: 92/100 Annual Review"></textarea>
                        </div>
                        <button type="submit" class="btn text-white w-100 rounded-pill py-3 fw-bold shadow-sm" style="background-color: #6d28d9;"><i class="fas fa-award me-2"></i> Save Promotion Record</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-list-ul me-2"></i>Promotion History Register</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Emp Code</th>
                                    <th>Employee</th>
                                    <th>Effective Date</th>
                                    <th>Previous Title</th>
                                    <th>New Title</th>
                                    <th>Increment</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for rec in records %}
                                <tr>
                                    <td><span class="badge bg-light text-dark border font-monospace">{{ rec.employee_code }}</span></td>
                                    <td class="fw-bold">{{ rec.employee_name }}</td>
                                    <td>{{ rec.effective_date }}</td>
                                    <td><small class="text-muted">{{ rec.previous_designation }}</small></td>
                                    <td><span class="badge bg-purple-subtle text-purple border border-purple rounded-pill px-3" style="color: #6d28d9;"><i class="fas fa-level-up-alt me-1"></i> {{ rec.new_designation }}</span></td>
                                    <td class="fw-bold text-success">৳ {{ rec.salary_increment|number_format(2) }}</td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fas fa-award fa-2x mb-2 text-purple opacity-50" style="color: #6d28d9;"></i><br>
                                        No promotion records saved yet.
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
