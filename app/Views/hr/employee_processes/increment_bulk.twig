{% extends "layouts/app.twig" %}

{% block title %}Increment Entry [Bulk] | HR Employees{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #0284c7 0%, #1e40af 100%);">
        <div>
            <span class="badge bg-white text-primary mb-2 font-monospace"><i class="fas fa-layer-group me-1"></i> MASS SALARY REVISION</span>
            <h2 class="mb-1 font-weight-bold">Increment Entry [Bulk]</h2>
            <p class="mb-0 opacity-75">Execute annual minimum wage percentage adjustments company-wide or department-wise.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-users fa-3x opacity-50"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="mb-0 text-primary fw-bold"><i class="fas fa-percent me-2"></i>Statutory Annual Increment Batch Processing</h5>
        </div>
        <div class="card-body p-4">
            <form action="{{ BASE_URL }}/hr/employees/increment-bulk" method="POST">
                {{ csrf_field() | raw }}
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Target Department</label>
                        <select name="department_id" class="form-select border-primary">
                            <option value="">Entire Factory (All Departments)</option>
                            {% for dept in departments %}
                            <option value="{{ dept.department_id }}">{{ dept.department_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Effective Date *</label>
                        <input type="date" name="effective_date" class="form-control" value="2026-08-01" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Statutory Increment Percentage (%) *</label>
                        <input type="number" step="0.1" name="increment_percentage" class="form-control form-control-lg border-primary text-primary fw-bold" value="5.0" required>
                    </div>
                </div>

                <div class="p-3 bg-light rounded-3 mb-4 border">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-gavel fa-2x text-primary me-3"></i>
                        <div>
                            <div class="fw-bold text-dark">Bangladesh Labor Act Statutory Standard</div>
                            <div class="small text-muted">A mandatory minimum 5% annual basic salary increment applies to all registered RMG garment operators annually.</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary rounded-pill px-5 py-3 text-white fw-bold shadow-sm"><i class="fas fa-play me-2"></i> Process Bulk Increment Batch</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
