{% extends "layouts/app.twig" %}

{% block title %}Employee Promotion Entry Bulk | HR Employees{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #a21caf 0%, #701a75 100%);">
        <div>
            <span class="badge bg-white text-purple mb-2 font-monospace" style="color: #a21caf;"><i class="fas fa-users-cog me-1"></i> MASS GRADE UPGRADE</span>
            <h2 class="mb-1 font-weight-bold">Employee Promotion Entry Bulk</h2>
            <p class="mb-0 opacity-75">Perform batch promotion upgrades for staff groups based on annual appraisal scores.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-sitemap fa-3x opacity-50"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="mb-0 fw-bold" style="color: #a21caf;"><i class="fas fa-layer-group me-2"></i>Batch Grade Upgrade Matrix</h5>
        </div>
        <div class="card-body p-4">
            <form action="{{ BASE_URL }}/hr/employees/promotion-bulk" method="POST">
                {{ csrf_field() | raw }}
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Effective Date *</label>
                        <input type="date" name="effective_date" class="form-control" value="2026-08-01" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Target Department</label>
                        <select name="department_id" class="form-select border-purple">
                            <option value="">All Departments</option>
                            {% for dept in departments %}
                            <option value="{{ dept.department_id }}">{{ dept.department_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Target Designation Upgrade *</label>
                        <select name="new_designation" class="form-select border-purple fw-bold" required>
                            <option value="">Select New Designation</option>
                            {% for des in designations %}
                            <option value="{{ des.designation_name }}">{{ des.designation_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="p-3 bg-light rounded-3 mb-4 border">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-lightbulb fa-2x me-3" style="color: #a21caf;"></i>
                        <div>
                            <div class="fw-bold text-dark">Batch Evaluation Rule</div>
                            <div class="small text-muted">Bulk promotion updates multiple qualifying staff members simultaneously based on annual performance review matrices.</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn text-white rounded-pill px-5 py-3 fw-bold shadow-sm" style="background-color: #a21caf;"><i class="fas fa-check-double me-2"></i> Execute Bulk Promotion</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
