{% extends "layouts/app.twig" %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #e11d48 0%, #f43f5e 100%);">
        <div>
            <span class="badge bg-white text-danger mb-2 font-monospace" style="color: #e11d48;"><i class="fas fa-baby me-1"></i> FEMALE WORKER STATUTORY BENEFIT</span>
            <h2 class="mb-1 font-weight-bold">Maternity Benefit Tracker & Compliance</h2>
            <p class="mb-0 opacity-75">Track pregnancy cases, calculate 16-week paid leave, statutory 50% split payouts under BLA 2006.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-light rounded-pill px-4 font-weight-bold text-danger shadow-sm" style="color: #e11d48;" data-bs-toggle="modal" data-bs-target="#registerCaseModal"><i class="fas fa-plus me-1"></i> Register New Case</button>
            <a href="{{ BASE_URL }}/hr/rmg-compliance" class="btn btn-outline-light rounded-pill px-3"><i class="fas fa-arrow-left me-1"></i> Compliance</a>
        </div>
    </div>

    <!-- Active Cases Sheet -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-0">
            <h6 class="m-0 fw-bold text-primary"><i class="fas fa-baby-carriage me-2"></i>Maternity Cases Ledger</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Employee</th>
                            <th>Expected Delivery</th>
                            <th>Leave Duration</th>
                            <th class="text-end">Daily Wage</th>
                            <th class="text-end">Benefit Amount</th>
                            <th>Case Status</th>
                            <th>Payment Ledger</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for case in benefits %}
                        <tr>
                            <td>
                                <div class="fw-bold">{{ case.first_name }} {{ case.last_name }}</div>
                                <div class="small text-muted">{{ case.employee_code }} &bull; {{ case.department_name }}</div>
                            </td>
                            <td>
                                <div class="fw-semibold"><i class="fas fa-calendar-day text-danger me-1"></i>{{ case.expected_delivery_date|date("M j, Y") }}</div>
                            </td>
                            <td>
                                <div class="small">{{ case.leave_start_date|date("M j, Y") }}</div>
                                <div class="small text-muted">to {{ case.leave_end_date|date("M j, Y") }}</div>
                            </td>
                            <td class="text-end">BDT {{ case.avg_daily_wage|number_format(2) }}</td>
                            <td class="text-end fw-bold text-primary">BDT {{ case.total_benefit_amount|number_format(2) }}</td>
                            <td>
                                {% set statusClass = {
                                    'Approved': 'bg-success-subtle text-success',
                                    'Rejected': 'bg-danger-subtle text-danger',
                                    'Pending': 'bg-warning-subtle text-warning'
                                } %}
                                <span class="badge {{ statusClass[case.status] }} rounded-pill px-3 py-1">
                                    {{ case.status }}
                                </span>
                            </td>
                            <td>
                                <!-- Payment status & Dates -->
                                <div class="d-flex flex-column gap-1 small">
                                    <div>
                                        <strong>1st Half:</strong>
                                        {% if case.payment1_date %}
                                            <span class="text-success"><i class="fas fa-check-circle me-1"></i>Paid ({{ case.payment1_date|date("M j") }})</span>
                                        {% else %}
                                            <span class="text-muted"><i class="fas fa-clock me-1"></i>Unpaid (BDT {{ case.payment1_amount|number_format(2) }})</span>
                                        {% endif %}
                                    </div>
                                    <div>
                                        <strong>2nd Half:</strong>
                                        {% if case.payment2_date %}
                                            <span class="text-success"><i class="fas fa-check-circle me-1"></i>Paid ({{ case.payment2_date|date("M j") }})</span>
                                        {% else %}
                                            <span class="text-muted"><i class="fas fa-clock me-1"></i>Unpaid (BDT {{ case.payment2_amount|number_format(2) }})</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    {% if case.status == 'Pending' %}
                                        <button class="btn btn-sm btn-outline-success" onclick="approveCase({{ case.id }})" title="Approve Maternity Case">
                                            <i class="fas fa-check"></i> Approve
                                        </button>
                                    {% endif %}
                                    
                                    {% if case.status == 'Approved' and case.payment_status != 'Fully Paid' %}
                                        <button class="btn btn-sm btn-primary dropdown-toggle" data-bs-toggle="dropdown">
                                            <i class="fas fa-wallet me-1"></i>Pay
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            {% if not case.payment1_date %}
                                            <li><a class="dropdown-menu-item dropdown-item" href="#" onclick="payout({{ case.id }}, 1)"><i class="fas fa-hand-holding-usd text-success me-2"></i>Pay 1st Half (BDT {{ case.payment1_amount|number_format(2) }})</a></li>
                                            {% endif %}
                                            {% if not case.payment2_date %}
                                            <li><a class="dropdown-menu-item dropdown-item" href="#" onclick="payout({{ case.id }}, 2)"><i class="fas fa-hand-holding-usd text-success me-2"></i>Pay 2nd Half (BDT {{ case.payment2_amount|number_format(2) }})</a></li>
                                            {% endif %}
                                        </ul>
                                    {% endif %}
                                    
                                    <button class="btn btn-sm btn-outline-danger ms-1" onclick="deleteCase({{ case.id }})" title="Delete Case">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">No active maternity benefit cases registered.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Register Case Modal -->
<div class="modal fade" id="registerCaseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold text-dark"><i class="fas fa-baby me-2 text-primary"></i>Register Maternity Case</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="registerCaseForm" action="{{ BASE_URL }}/hr/rmg-compliance/maternity?action=create" method="POST">
    {{ csrf_field() | raw }}
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Female Employee</label>
                        <select class="form-select" name="employee_id" required>
                            <option value="">Select Employee</option>
                            {% for emp in femaleEmployees %}
                            <option value="{{ emp.employee_id }}">{{ emp.first_name }} {{ emp.last_name }} ({{ emp.employee_code }})</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Expected Date of Delivery</label>
                        <input type="date" class="form-control" name="expected_delivery_date" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Leave Start Date (Pre-natal starting)</label>
                        <input type="date" class="form-control" name="leave_start_date" required>
                        <div class="form-text text-muted">The system will automatically calculate the 112 days (16 weeks) legal leave end date.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="registerCaseForm" class="btn btn-primary">Calculate & Register</button>
            </div>
        </div>
    </div>
</div>

<script>
function approveCase(id) {
    Swal.fire({
        title: 'Approve Maternity Case?',
        text: 'This will authorize the calculation parameters and enable payouts.',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#2ecc71',
        confirmButtonText: 'Yes, Approve'
    }).then((result) => {
        if (result.isConfirmed) {
            fetch('{{ BASE_URL }}/hr/rmg-compliance/maternity/' + id + '/approve', {
                method: 'POST'
            }).then(response => response.json())
            .then(data => {
                if(data.success) {
                    Swal.fire('Approved!', 'The case has been authorized.', 'success')
                    .then(() => location.reload());
                } else {
                    Swal.fire('Failed!', 'Approval failed.', 'error');
                }
            });
        }
    });
}

function payout(id, installment) {
    Swal.fire({
        title: 'Confirm Payment?',
        text: 'Are you sure you want to record the payout for ' + (installment === 1 ? '1st Half' : '2nd Half') + '?',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#2ecc71',
        confirmButtonText: 'Confirm Payout'
    }).then((result) => {
        if (result.isConfirmed) {
            fetch('{{ BASE_URL }}/hr/rmg-compliance/maternity/' + id + '/payout?installment=' + installment, {
                method: 'POST'
            }).then(response => response.json())
            .then(data => {
                if(data.success) {
                    Swal.fire('Paid!', 'The payment has been successfully recorded in the ledger.', 'success')
                    .then(() => location.reload());
                } else {
                    Swal.fire('Failed!', 'Payment registration failed.', 'error');
                }
            });
        }
    });
}

function deleteCase(id) {
    Swal.fire({
        title: 'Delete Maternity Case?',
        text: 'This action is permanent and will delete all payment history for this case!',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        confirmButtonText: 'Yes, Delete'
    }).then((result) => {
        if (result.isConfirmed) {
            fetch('{{ BASE_URL }}/hr/rmg-compliance/maternity/' + id, {
                method: 'DELETE'
            }).then(response => response.json())
            .then(data => {
                if(data.success) {
                    Swal.fire('Deleted!', 'Maternity case deleted.', 'success')
                    .then(() => location.reload());
                } else {
                    Swal.fire('Failed!', 'Failed to delete case.', 'error');
                }
            });
        }
    });
}
</script>
{% endblock %}
