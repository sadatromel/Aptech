{% extends "layouts/app.twig" %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #d97706 0%, #b45309 100%);">
        <div>
            <span class="badge bg-white text-warning mb-2 font-monospace" style="color: #b45309;"><i class="fas fa-scale-balanced me-1"></i> BLA 2006 AUDIT & CONTROLS</span>
            <h2 class="mb-1 font-weight-bold">RMG Compliance Dashboard</h2>
            <p class="mb-0 opacity-75">Bangladesh Labour Act 2006 regulatory HR controls, 7-grade minimum wage audit & maternity benefit cases.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-gavel fa-3x opacity-50"></i>
        </div>
    </div>

    <!-- Quick Stats Grid -->
    <div class="row g-4 mb-4">
        <!-- Minimum Wage Card -->
        <div class="col-xl-3 col-md-6">
            <a href="{{ BASE_URL }}/hr/rmg-compliance/wage-compliance" class="text-decoration-none text-dark card-hover">
                <div class="card border-0 shadow-sm h-100 bg-gradient-primary-soft">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-muted small text-uppercase fw-bold mb-1">Wage Compliance</div>
                                <h4 class="mb-0 fw-bold">7-Grade Scale</h4>
                                <small class="text-success fw-semibold"><i class="fas fa-check-double me-1"></i>View Audits</small>
                            </div>
                            <div class="icon-circle bg-primary text-white shadow-sm">
                                <i class="fas fa-gavel fa-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Attendance Bonus Card -->
        <div class="col-xl-3 col-md-6">
            <a href="{{ BASE_URL }}/hr/rmg-compliance/attendance-bonus" class="text-decoration-none text-dark card-hover">
                <div class="card border-0 shadow-sm h-100 bg-gradient-success-soft">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-muted small text-uppercase fw-bold mb-1">Attendance Bonus</div>
                                <h4 class="mb-0 fw-bold text-success">{{ bonusCount }} Eligible</h4>
                                <small class="text-muted">For {{ currentMonth }}</small>
                            </div>
                            <div class="icon-circle bg-success text-white shadow-sm">
                                <i class="fas fa-medal fa-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Festival Bonus Card -->
        <div class="col-xl-3 col-md-6">
            <a href="{{ BASE_URL }}/hr/rmg-compliance/festival-bonus" class="text-decoration-none text-dark card-hover">
                <div class="card border-0 shadow-sm h-100 bg-gradient-warning-soft">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-muted small text-uppercase fw-bold mb-1">Festival Bonus</div>
                                <h4 class="mb-0 fw-bold text-warning">Eid Payouts</h4>
                                <small class="text-muted">Calculated on Basic</small>
                            </div>
                            <div class="icon-circle bg-warning text-white shadow-sm">
                                <i class="fas fa-star fa-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Maternity Benefits Card -->
        <div class="col-xl-3 col-md-6">
            <a href="{{ BASE_URL }}/hr/rmg-compliance/maternity" class="text-decoration-none text-dark card-hover">
                <div class="card border-0 shadow-sm h-100 bg-gradient-danger-soft">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-muted small text-uppercase fw-bold mb-1">Maternity leaves</div>
                                <h4 class="mb-0 fw-bold text-danger">{{ maternityStats.total }} Registered</h4>
                                <small class="text-danger-emphasis fw-semibold">
                                    {{ maternityStats.pending }} Pending Case
                                </small>
                            </div>
                            <div class="icon-circle bg-danger text-white shadow-sm">
                                <i class="fas fa-baby fa-lg"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="row g-4">
        <!-- Grade Wage Summary -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-0">
                    <h6 class="m-0 fw-bold text-primary"><i class="fas fa-list-ol me-2"></i>7-Grade Employee Allocation</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Worker Grade</th>
                                    <th>Total Workers</th>
                                    <th>Avg Gross Salary</th>
                                    <th>Avg Basic Salary</th>
                                    <th class="text-end">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for stat in gradeStats %}
                                <tr>
                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3">
                                            Grade {{ stat.grade }}
                                        </span>
                                    </td>
                                    <td class="fw-semibold">{{ stat.count }}</td>
                                    <td>BDT {{ stat.avg_gross|number_format(2) }}</td>
                                    <td>BDT {{ stat.avg_basic|number_format(2) }}</td>
                                    <td class="text-end">
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2">Active</span>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No graded worker profiles found.</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- BLA 2006 Reference Rules -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-0">
                    <h6 class="m-0 fw-bold text-primary"><i class="fas fa-book me-2"></i>BLA 2006 Reference</h6>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-start mb-3">
                        <div class="icon-circle bg-light text-primary me-3 flex-shrink-0">
                            <i class="fas fa-gavel"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">RMG 7-Grade Scale</h6>
                            <p class="text-muted small mb-0">Government-mandated wages updated in 2024. Helper entry rate is BDT 12,500.</p>
                        </div>
                    </div>
                    
                    <div class="d-flex align-items-start mb-3">
                        <div class="icon-circle bg-light text-success me-3 flex-shrink-0">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Overtime Law (Sec. 108)</h6>
                            <p class="text-muted small mb-0">OT rate is calculated as double the basic salary hourly rate: (Basic/208)*2.</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start mb-3">
                        <div class="icon-circle bg-light text-danger me-3 flex-shrink-0">
                            <i class="fas fa-baby"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Maternity Leave (Sec. 45-50)</h6>
                            <p class="text-muted small mb-0">16 weeks (112 days) of fully paid leave based on average of preceding 3 months' wages.</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start">
                        <div class="icon-circle bg-light text-warning me-3 flex-shrink-0">
                            <i class="fas fa-gift"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Festival Bonus</h6>
                            <p class="text-muted small mb-0">Paid to employees with 1+ year service, usually equivalent to basic wage.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.bg-gradient-primary-soft {
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(102, 126, 234, 0.03) 100%);
    border-left: 4px solid var(--primary);
}
.bg-gradient-success-soft {
    background: linear-gradient(135deg, rgba(46, 204, 113, 0.1) 0%, rgba(46, 204, 113, 0.03) 100%);
    border-left: 4px solid #2ecc71;
}
.bg-gradient-warning-soft {
    background: linear-gradient(135deg, rgba(241, 196, 15, 0.1) 0%, rgba(241, 196, 15, 0.03) 100%);
    border-left: 4px solid #f1c40f;
}
.bg-gradient-danger-soft {
    background: linear-gradient(135deg, rgba(231, 76, 60, 0.1) 0%, rgba(231, 76, 60, 0.03) 100%);
    border-left: 4px solid #e74c3c;
}
.card-hover {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.card-hover:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 16px rgba(0,0,0,0.1) !important;
}
.icon-circle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}
</style>
{% endblock %}
