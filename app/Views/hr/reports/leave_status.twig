{% extends "layouts/app.twig" %}

{% block title %}Employee Leave Status Report | HR Module{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-3">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-2 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #059669 0%, #10b981 100%);">
        <div>
            <span class="badge bg-white mb-2 font-monospace fw-bold" style="color: #059669;"><i class="fas fa-file-invoice me-1"></i> HR REPORTING PORTAL</span>
            <h2 class="mb-1 font-weight-bold">Employee Leave Status Report</h2>
            <p class="mb-0 opacity-75">Categorized status overview of employee leave requests across departments and sections.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button onclick="window.print()" class="btn btn-light rounded-pill px-4 font-weight-bold shadow-sm" style="color: #059669;"><i class="fas fa-print me-1"></i> Print Report</button>
            <a href="{{ BASE_URL }}/hr/reports" class="btn btn-outline-light rounded-pill px-4 font-weight-bold shadow-sm"><i class="fas fa-arrow-left me-1"></i> Back to Reports</a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 d-print-none">
        <div class="card-body p-4">
            <form method="GET" action="{{ BASE_URL }}/hr/reports/leave-status">
                <div class="row g-3 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-muted">Year</label>
                        <select class="form-select" name="year">
                            {% for y in 2024..2027 %}
                                <option value="{{ y }}" {{ filters.year == y ? 'selected' : '' }}>{{ y }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-muted">Department</label>
                        <select class="form-select" name="department_id">
                            <option value="">All Departments</option>
                            {% for dept in filterOptions.departments %}
                                <option value="{{ dept.department_id }}" {{ filters.department_id == dept.department_id ? 'selected' : '' }}>{{ dept.department_name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-muted">Section</label>
                        <select class="form-select" name="section_id">
                            <option value="">All Sections</option>
                            {% for sec in filterOptions.sections %}
                                <option value="{{ sec.section_id }}" {{ filters.section_id == sec.section_id ? 'selected' : '' }}>{{ sec.section_name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-muted">Leave Type</label>
                        <select class="form-select" name="leave_type">
                            <option value="">All Leave Types</option>
                            <option value="Casual Leave" {{ filters.leave_type == 'Casual Leave' ? 'selected' : '' }}>Casual Leave</option>
                            <option value="Sick Leave" {{ filters.leave_type == 'Sick Leave' ? 'selected' : '' }}>Sick Leave</option>
                            <option value="Earned Leave" {{ filters.leave_type == 'Earned Leave' ? 'selected' : '' }}>Earned Leave</option>
                            <option value="Leave Without Pay" {{ filters.leave_type == 'Leave Without Pay' ? 'selected' : '' }}>Leave Without Pay</option>
                            <option value="Maternity Leave" {{ filters.leave_type == 'Maternity Leave' ? 'selected' : '' }}>Maternity Leave</option>
                            <option value="Special Leave" {{ filters.leave_type == 'Special Leave' ? 'selected' : '' }}>Special Leave</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-muted">Status</label>
                        <select class="form-select" name="status">
                            <option value="">All Statuses</option>
                            <option value="Approved" {{ filters.status == 'Approved' ? 'selected' : '' }}>Approved</option>
                            <option value="Pending" {{ filters.status == 'Pending' ? 'selected' : '' }}>Pending</option>
                            <option value="Rejected" {{ filters.status == 'Rejected' ? 'selected' : '' }}>Rejected</option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold w-100"><i class="fas fa-search me-1"></i> Filter</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Metrics -->
    <div class="row mb-4">
        <div class="col-md-3 mb-2">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-primary">
                <div class="small text-muted font-weight-bold text-uppercase">Total Applications</div>
                <div class="h3 font-weight-bold text-primary my-1">{{ stats.total_applied }}</div>
                <div class="small text-muted">{{ stats.total_days }} Total Leave Days</div>
            </div>
        </div>
        <div class="col-md-3 mb-2">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-success">
                <div class="small text-muted font-weight-bold text-uppercase">Approved Leaves</div>
                <div class="h3 font-weight-bold text-success my-1">{{ stats.approved }}</div>
                <div class="small text-success"><i class="fas fa-check-circle me-1"></i> Sanctioned</div>
            </div>
        </div>
        <div class="col-md-3 mb-2">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-warning">
                <div class="small text-muted font-weight-bold text-uppercase">Pending Approvals</div>
                <div class="h3 font-weight-bold text-warning my-1">{{ stats.pending }}</div>
                <div class="small text-warning"><i class="fas fa-clock me-1"></i> Awaiting Action</div>
            </div>
        </div>
        <div class="col-md-3 mb-2">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-danger">
                <div class="small text-muted font-weight-bold text-uppercase">Rejected Requests</div>
                <div class="h3 font-weight-bold text-danger my-1">{{ stats.rejected }}</div>
                <div class="small text-danger"><i class="fas fa-times-circle me-1"></i> Declined</div>
            </div>
        </div>
    </div>

    <!-- Official Report Document Box -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4">
            <!-- Official Header -->
            <div class="text-center mb-4 pb-3 border-bottom">
                <h3 class="fw-bold mb-1 text-uppercase">{{ companyName }}</h3>
                <p class="mb-1 text-muted small">{{ companyAddress }}</p>
                <h5 class="fw-bold text-success text-uppercase mt-2">Employee Leave Status Report - {{ filters.year }}</h5>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light text-center">
                        <tr>
                            <th>Sl</th>
                            <th>Emp Code</th>
                            <th>Employee Name</th>
                            <th>Department & Section</th>
                            <th>Designation</th>
                            <th>Leave Type</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Days</th>
                            <th>Status</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for l in leaves %}
                        <tr>
                            <td class="text-center">{{ loop.index }}</td>
                            <td class="text-center font-monospace fw-bold">{{ l.employee_code }}</td>
                            <td class="fw-semibold">{{ l.first_name }} {{ l.last_name }}</td>
                            <td>{{ l.department_name|default('N/A') }} <small class="text-muted">({{ l.section_name|default('General') }})</small></td>
                            <td>{{ l.position_name|default('Staff') }}</td>
                            <td class="text-center">
                                <span class="badge bg-success-subtle text-success border fw-bold">{{ l.leave_type }}</span>
                            </td>
                            <td class="text-center">{{ l.start_date|date("M j, Y") }}</td>
                            <td class="text-center">{{ l.end_date|date("M j, Y") }}</td>
                            <td class="text-center fw-bold">{{ l.total_days|default(1) }}</td>
                            <td class="text-center">
                                {% if l.status == 'Approved' %}
                                    <span class="badge bg-success rounded-pill px-3 py-1">Approved</span>
                                {% elseif l.status == 'Pending' %}
                                    <span class="badge bg-warning text-dark rounded-pill px-3 py-1">Pending</span>
                                {% else %}
                                    <span class="badge bg-danger rounded-pill px-3 py-1">{{ l.status }}</span>
                                {% endif %}
                            </td>
                            <td><small class="text-muted">{{ l.reason|default('N/A') }}</small></td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="11" class="text-center py-5 text-muted">No leave status records match the selected filter criteria.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
