{% extends "layouts/app.twig" %}

{% block title %}Job Card Four Hours Report | HR Module{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-3">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-2 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #0284c7 0%, #06b6d4 100%);">
        <div>
            <span class="badge bg-white mb-2 font-monospace fw-bold" style="color: #0284c7;"><i class="fas fa-business-time me-1"></i> 4-HOUR EXTRA OVERTIME</span>
            <h2 class="mb-1 font-weight-bold">Job Card Four Hours Report</h2>
            <p class="mb-0 opacity-75">Specialized tracking card for 4-hour extra overtime / double shift work days.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button onclick="window.print()" class="btn btn-light rounded-pill px-4 font-weight-bold shadow-sm" style="color: #0284c7;"><i class="fas fa-print me-1"></i> Print Report</button>
            <a href="{{ BASE_URL }}/hr/reports" class="btn btn-outline-light rounded-pill px-4 font-weight-bold shadow-sm"><i class="fas fa-arrow-left me-1"></i> Back to Reports</a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 d-print-none">
        <div class="card-body p-4">
            <form method="GET" action="{{ BASE_URL }}/hr/reports/job-card-four-hours" id="fourHrForm">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-info">Year - Month</label>
                        <input type="month" class="form-control" name="year_month" value="{{ filters.year_month }}" onchange="document.getElementById('fourHrForm').submit()">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-info">Select Employee</label>
                        <select class="form-select border-info-subtle fw-semibold" name="employee_id" onchange="document.getElementById('fourHrForm').submit()">
                            <option value="">-- Browse Employee --</option>
                            {% for emp in allEmployees %}
                                <option value="{{ emp.employee_id }}" {{ filters.employee_id == emp.employee_id ? 'selected' : '' }}>
                                    #{{ emp.employee_id }} - {{ emp.employee_code }} ({{ emp.first_name }} {{ emp.last_name }})
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted">Or Write Emp Code</label>
                        <input type="text" class="form-control font-monospace" name="emp_code" value="{{ filters.emp_code }}" placeholder="EMP-XXXX" onchange="document.getElementById('fourHrForm').submit()">
                    </div>

                    <div class="col-md-2">
                        <button type="submit" class="btn btn-info text-white rounded-pill px-4 fw-bold w-100"><i class="fas fa-search me-1"></i> Generate</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {% if employee %}
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4">
            <!-- Official Header -->
            <div class="text-center mb-4 pb-3 border-bottom">
                <h3 class="fw-bold mb-1 text-uppercase">{{ companyName }}</h3>
                <p class="mb-1 text-muted small">{{ companyAddress }}</p>
                <h5 class="fw-bold text-info text-uppercase mt-2">Job Card Four Hours Overtime Report — {{ filters.year_month }}</h5>
            </div>

            <!-- Profile Summary Box -->
            <div class="bg-light p-3 rounded-3 mb-4 border">
                <div class="row g-3">
                    <div class="col-md-3"><strong>Employee Name:</strong> <span class="text-info fw-bold">{{ employee.first_name }} {{ employee.last_name }}</span></div>
                    <div class="col-md-3"><strong>Emp Code / ID:</strong> <span class="font-monospace fw-bold">{{ employee.employee_code }}</span></div>
                    <div class="col-md-3"><strong>Department:</strong> {{ employee.department_name|default('N/A') }}</div>
                    <div class="col-md-3"><strong>Section:</strong> {{ employee.section_name|default('N/A') }}</div>
                    <div class="col-md-3"><strong>Designation:</strong> {{ employee.position_name|default('N/A') }}</div>
                    <div class="col-md-3"><strong>4-Hour OT Days:</strong> <span class="badge bg-info text-white px-3 py-1">{{ fourHourData|length }} Days</span></div>
                    <div class="col-md-6"><strong>Total 4-Hour OT Accumulation:</strong> <span class="badge bg-success px-3 py-1 fs-6">{{ totalFourHourOt|number_format(1) }} Hours</span></div>
                </div>
            </div>

            <!-- Four Hour Table -->
            <div class="table-responsive">
                <table class="table table-bordered align-middle text-center mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Sl</th>
                            <th>Date</th>
                            <th>Day</th>
                            <th>In Time</th>
                            <th>Out Time</th>
                            <th>Regular OT (Hrs)</th>
                            <th>Extra 4-Hr OT (Hrs)</th>
                            <th>Approval Remark</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in fourHourData %}
                        <tr>
                            <td>{{ loop.index }}</td>
                            <td>{{ row.date }}</td>
                            <td class="fw-semibold">{{ row.day }}</td>
                            <td>{{ row.in }}</td>
                            <td>{{ row.out }}</td>
                            <td>{{ row.regular_ot }} h</td>
                            <td class="fw-bold text-info fs-6 bg-info-subtle">+{{ row.extra_ot }} h</td>
                            <td><span class="badge bg-success-subtle text-success border"><i class="fas fa-check-circle me-1"></i> {{ row.remark }}</span></td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="8" class="py-5 text-muted">No 4-hour extra overtime records logged for this employee in {{ filters.year_month }}.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
