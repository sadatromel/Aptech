{% extends "layouts/app.twig" %}

{% block title %}Pay Slip English | HR Module{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-3">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-2 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #0369a1 0%, #0284c7 100%);">
        <div>
            <span class="badge bg-white mb-2 font-monospace fw-bold" style="color: #0369a1;"><i class="fas fa-file-invoice me-1"></i> ENGLISH PAYSLIP VOUCHER</span>
            <h2 class="mb-1 font-weight-bold">Pay Slip English Report</h2>
            <p class="mb-0 opacity-75">Official English Employee Salary Voucher statement.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button onclick="window.print()" class="btn btn-light rounded-pill px-4 font-weight-bold shadow-sm" style="color: #0369a1;"><i class="fas fa-print me-1"></i> Print Payslip</button>
            <a href="{{ BASE_URL }}/hr/reports" class="btn btn-outline-light rounded-pill px-4 font-weight-bold shadow-sm"><i class="fas fa-arrow-left me-1"></i> Back to Reports</a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 d-print-none">
        <div class="card-body p-4">
            <form method="GET" action="{{ BASE_URL }}/hr/reports/payslip-english" id="engPayslipForm">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-info">Year - Month</label>
                        <input type="month" class="form-control" name="year_month" value="{{ filters.year_month }}" onchange="document.getElementById('engPayslipForm').submit()">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-info">Select Employee</label>
                        <select class="form-select border-info-subtle fw-semibold" name="employee_id" onchange="document.getElementById('engPayslipForm').submit()">
                            {% for emp in allEmployees %}
                                <option value="{{ emp.employee_id }}" {{ filters.employee_id == emp.employee_id ? 'selected' : '' }}>
                                    #{{ emp.employee_id }} - {{ emp.employee_code }} ({{ emp.first_name }} {{ emp.last_name }})
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted">Or Write Emp Code</label>
                        <input type="text" class="form-control font-monospace" name="emp_code" value="{{ filters.emp_code }}" placeholder="EMP-XXXX" onchange="document.getElementById('engPayslipForm').submit()">
                    </div>

                    <div class="col-md-2">
                        <button type="submit" class="btn btn-info text-white rounded-pill px-4 fw-bold w-100"><i class="fas fa-search me-1"></i> Generate</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {% if record %}
    <!-- Official Payslip English Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 mx-auto" style="max-width: 800px;">
        <div class="card-body p-4">
            <!-- Header -->
            <div class="text-center mb-4 pb-3 border-bottom">
                <h3 class="fw-bold mb-1 text-uppercase text-info">{{ companyName }}</h3>
                <p class="mb-1 text-muted small">{{ companyAddress }}</p>
                <div class="badge bg-info-subtle text-info border px-4 py-2 mt-2 fs-6 fw-bold">SALARY PAYSLIP VOUCHER — {{ filters.year_month }}</div>
            </div>

            <!-- Employee Meta Table -->
            <table class="table table-sm table-bordered align-middle mb-4">
                <tbody>
                    <tr>
                        <th class="bg-light" style="width: 25%;">Employee Name:</th>
                        <td class="fw-bold text-info">{{ record.name }}</td>
                        <th class="bg-light" style="width: 25%;">Emp Code / ID:</th>
                        <td class="font-monospace fw-bold">{{ record.employee_code }}</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Department:</th>
                        <td>{{ record.department_name }}</td>
                        <th class="bg-light">Section / Line:</th>
                        <td>{{ record.section_name }}</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Designation:</th>
                        <td>{{ record.position_name }}</td>
                        <th class="bg-light">Payable Days:</th>
                        <td class="fw-bold">{{ record.payable_days }} Days</td>
                    </tr>
                </tbody>
            </table>

            <!-- Salary Details Table -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="card border-info-subtle h-100">
                        <div class="card-header bg-info text-white fw-bold"><i class="fas fa-plus-circle me-1"></i> Earnings Breakdown</div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <tbody>
                                    <tr><td>Basic Salary:</td><td class="text-end fw-semibold">৳ {{ record.basic|number_format }}</td></tr>
                                    <tr><td>House Rent Allowance:</td><td class="text-end fw-semibold">৳ {{ record.house_rent|number_format }}</td></tr>
                                    <tr><td>Medical Allowance:</td><td class="text-end fw-semibold">৳ {{ record.medical|number_format }}</td></tr>
                                    <tr><td>Conveyance Allowance:</td><td class="text-end fw-semibold">৳ {{ record.conveyance|number_format }}</td></tr>
                                    <tr><td>Food Allowance:</td><td class="text-end fw-semibold">৳ {{ record.food|number_format }}</td></tr>
                                    <tr class="table-light font-weight-bold"><td>Gross Salary:</td><td class="text-end text-primary">৳ {{ record.gross|number_format }}</td></tr>
                                    <tr><td>Attendance Bonus:</td><td class="text-end text-success">+৳ {{ record.att_bonus }}</td></tr>
                                    <tr><td>Overtime (Rate: ৳ {{ record.ot_rate }}/h x {{ record.regular_ot_hrs }}h):</td><td class="text-end text-warning">+৳ {{ record.regular_ot_amt|number_format }}</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-danger-subtle h-100">
                        <div class="card-header bg-danger text-white fw-bold"><i class="fas fa-minus-circle me-1"></i> Deductions & Net Payable</div>
                        <div class="card-body p-0 d-flex flex-column justify-content-between">
                            <table class="table table-sm mb-0">
                                <tbody>
                                    <tr><td>Revenue Stamp:</td><td class="text-end text-danger">-৳ {{ record.stamp }}</td></tr>
                                    <tr><td>Absence Deduction:</td><td class="text-end text-danger">৳ 0</td></tr>
                                    <tr class="table-light font-weight-bold"><td>Total Deductions:</td><td class="text-end text-danger">৳ {{ record.stamp }}</td></tr>
                                </tbody>
                            </table>

                            <div class="p-3 bg-info-subtle border-top text-center mt-3">
                                <span class="text-muted small fw-bold text-uppercase d-block mb-1">Total Net Payable Salary</span>
                                <div class="h3 font-weight-bold text-info mb-0">৳ {{ record.net_salary|number_format }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Signatures -->
            <div class="row pt-5 mt-4 text-center">
                <div class="col-md-4">
                    <div class="border-top pt-2"><small>Prepared By</small></div>
                </div>
                <div class="col-md-4">
                    <div class="border-top pt-2"><small>HR & Payroll Manager</small></div>
                </div>
                <div class="col-md-4">
                    <div class="border-top pt-2"><small>Employee Signature</small></div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
