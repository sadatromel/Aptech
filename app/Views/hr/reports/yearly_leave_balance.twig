{% extends "layouts/app.twig" %}

{% block title %}Employee Leave Balance Yearly Report | HR Module{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-3">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-2 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #1d4ed8 0%, #3b82f6 100%);">
        <div>
            <span class="badge bg-white mb-2 font-monospace fw-bold" style="color: #1d4ed8;"><i class="fas fa-table-cells me-1"></i> YEARLY LEAVE MATRIX</span>
            <h2 class="mb-1 font-weight-bold">Employee Leave Balance Yearly Report</h2>
            <p class="mb-0 opacity-75">Yearly matrix breakdown of entitlements, leaves taken, and remaining balances across CL, SL, LWP, RL, SPL, EL, and EDL.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button onclick="window.print()" class="btn btn-light rounded-pill px-4 font-weight-bold shadow-sm" style="color: #1d4ed8;"><i class="fas fa-print me-1"></i> Print Matrix</button>
            <a href="{{ BASE_URL }}/hr/reports" class="btn btn-outline-light rounded-pill px-4 font-weight-bold shadow-sm"><i class="fas fa-arrow-left me-1"></i> Back to Reports</a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 d-print-none">
        <div class="card-body p-4">
            <form method="GET" action="{{ BASE_URL }}/hr/reports/yearly-leave-balance">
                <div class="row g-3 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-primary">Year</label>
                        <select class="form-select" name="year">
                            {% for y in 2024..2027 %}
                                <option value="{{ y }}" {{ filters.year == y ? 'selected' : '' }}>{{ y }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-primary">Department</label>
                        <select class="form-select" name="department_id">
                            <option value="">All Departments</option>
                            {% for dept in filterOptions.departments %}
                                <option value="{{ dept.department_id }}" {{ filters.department_id == dept.department_id ? 'selected' : '' }}>{{ dept.department_name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-primary">Section</label>
                        <select class="form-select" name="section_id">
                            <option value="">All Sections</option>
                            {% for sec in filterOptions.sections %}
                                <option value="{{ sec.section_id }}" {{ filters.section_id == sec.section_id ? 'selected' : '' }}>{{ sec.section_name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-bold small text-primary">Designation</label>
                        <select class="form-select" name="position_id">
                            <option value="">All Positions</option>
                            {% for pos in filterOptions.positions %}
                                <option value="{{ pos.position_id }}" {{ filters.position_id == pos.position_id ? 'selected' : '' }}>{{ pos.position_name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold w-100"><i class="fas fa-sync me-1"></i> Generate</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Official Matrix Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4">
            <!-- Official Header -->
            <div class="text-center mb-4 pb-3 border-bottom">
                <h3 class="fw-bold mb-1 text-uppercase">{{ companyName }}</h3>
                <p class="mb-1 text-muted small">{{ companyAddress }}</p>
                <h5 class="fw-bold text-primary text-uppercase mt-2">Employee Leave Balance Yearly Summary - {{ filters.year }}</h5>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered align-middle text-center mb-0" style="font-size: 0.85rem;">
                    <thead class="table-light align-middle">
                        <tr>
                            <th rowspan="2">Sl</th>
                            <th rowspan="2">Emp Code</th>
                            <th rowspan="2" style="min-width: 140px;">Employee Name</th>
                            <th rowspan="2">Dept & Section</th>
                            <th colspan="3" class="table-primary">CL (Casual)</th>
                            <th colspan="3" class="table-info">SL (Sick)</th>
                            <th colspan="3" class="table-warning">RL (Replacement)</th>
                            <th colspan="3" class="table-secondary">SPL (Special)</th>
                            <th colspan="3" class="table-success">EL (Earned)</th>
                            <th colspan="3" class="table-danger">EDL (Extra Duty)</th>
                            <th rowspan="2" class="bg-primary text-white">Total Bal</th>
                        </tr>
                        <tr class="table-secondary" style="font-size: 0.78rem;">
                            <th>Ent</th><th>Eng</th><th>Bal</th>
                            <th>Ent</th><th>Eng</th><th>Bal</th>
                            <th>Ent</th><th>Eng</th><th>Bal</th>
                            <th>Ent</th><th>Eng</th><th>Bal</th>
                            <th>Ent</th><th>Eng</th><th>Bal</th>
                            <th>Ent</th><th>Eng</th><th>Bal</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in matrixData %}
                        <tr>
                            <td>{{ row.sl }}</td>
                            <td class="font-monospace fw-bold">{{ row.employee_code }}</td>
                            <td class="text-start fw-semibold">{{ row.name }}</td>
                            <td class="text-start"><small>{{ row.department_name }} ({{ row.section_name }})</small></td>
                            
                            <!-- CL -->
                            <td>{{ row.balances.CL.ent }}</td><td>{{ row.balances.CL.taken }}</td><td class="fw-bold text-primary">{{ row.balances.CL.bal }}</td>
                            <!-- SL -->
                            <td>{{ row.balances.SL.ent }}</td><td>{{ row.balances.SL.taken }}</td><td class="fw-bold text-info">{{ row.balances.SL.bal }}</td>
                            <!-- RL -->
                            <td>{{ row.balances.RL.ent }}</td><td>{{ row.balances.RL.taken }}</td><td class="fw-bold text-warning">{{ row.balances.RL.bal }}</td>
                            <!-- SPL -->
                            <td>{{ row.balances.SPL.ent }}</td><td>{{ row.balances.SPL.taken }}</td><td class="fw-bold text-secondary">{{ row.balances.SPL.bal }}</td>
                            <!-- EL -->
                            <td>{{ row.balances.EL.ent }}</td><td>{{ row.balances.EL.taken }}</td><td class="fw-bold text-success">{{ row.balances.EL.bal }}</td>
                            <!-- EDL -->
                            <td>{{ row.balances.EDL.ent }}</td><td>{{ row.balances.EDL.taken }}</td><td class="fw-bold text-danger">{{ row.balances.EDL.bal }}</td>

                            <!-- Total Balance -->
                            <td class="fw-bold text-primary fs-6 bg-primary-subtle">{{ row.total_remaining|number_format(1) }}</td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="23" class="py-5 text-muted">No employee leave balance records found for {{ filters.year }}.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
