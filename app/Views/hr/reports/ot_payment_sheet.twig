{% extends "layouts/app.twig" %}

{% block title %}OT Payment Sheet | HR Module{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-3">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-2 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #4338ca 0%, #6366f1 100%);">
        <div>
            <span class="badge bg-white mb-2 font-monospace fw-bold" style="color: #4338ca;"><i class="fas fa-calculator me-1"></i> REGULAR OVERTIME</span>
            <h2 class="mb-1 font-weight-bold">OT Payment Sheet</h2>
            <p class="mb-0 opacity-75">Regular Overtime (2 Hours/Day) monthly payment register and signature sheet.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="{{ BASE_URL }}/hr/reports/ot-payment-sheet/export-excel?year_month={{ filters.year_month }}&department_id={{ filters.department_id }}&section_id={{ filters.section_id }}" class="btn btn-light rounded-pill px-4 font-weight-bold shadow-sm" style="color: #4338ca;"><i class="fas fa-file-excel me-1 text-success"></i> Export Excel</a>
            <button onclick="window.print()" class="btn btn-outline-light rounded-pill px-4 font-weight-bold shadow-sm"><i class="fas fa-print me-1"></i> Print Sheet</button>
            <a href="{{ BASE_URL }}/hr/reports" class="btn btn-outline-light rounded-pill px-4 font-weight-bold shadow-sm"><i class="fas fa-arrow-left me-1"></i> Back to Reports</a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 d-print-none">
        <div class="card-body p-4">
            <form method="GET" action="{{ BASE_URL }}/hr/reports/ot-payment-sheet">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-indigo">Year - Month</label>
                        <input type="month" class="form-control" name="year_month" value="{{ filters.year_month }}">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-indigo">Department</label>
                        <select class="form-select" name="department_id">
                            <option value="">All Departments</option>
                            {% for dept in filterOptions.departments %}
                                <option value="{{ dept.department_id }}" {{ filters.department_id == dept.department_id ? 'selected' : '' }}>{{ dept.department_name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-indigo">Section</label>
                        <select class="form-select" name="section_id">
                            <option value="">All Sections</option>
                            {% for sec in filterOptions.sections %}
                                <option value="{{ sec.section_id }}" {{ filters.section_id == sec.section_id ? 'selected' : '' }}>{{ sec.section_name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn btn-indigo text-white rounded-pill px-4 fw-bold w-100" style="background-color: #4338ca;"><i class="fas fa-search me-1"></i> Filter</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Official Report Document Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4">
            <!-- Official Header -->
            <div class="text-center mb-4 pb-3 border-bottom">
                <h3 class="fw-bold mb-1 text-uppercase">{{ companyName }}</h3>
                <p class="mb-1 text-muted small">{{ companyAddress }}</p>
                <h5 class="fw-bold text-indigo text-uppercase mt-2">Regular Overtime Payment Sheet — {{ filters.year_month }}</h5>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered align-middle text-center mb-0" style="font-size: 0.85rem;">
                    <thead class="table-light">
                        <tr>
                            <th>Sl</th>
                            <th>Emp Code</th>
                            <th style="min-width: 140px;">Employee Name</th>
                            <th>Department & Section</th>
                            <th>Designation</th>
                            <th>Basic (Tk)</th>
                            <th>OT Rate (Tk)</th>
                            <th>OT Hours</th>
                            <th>OT Amount (Tk)</th>
                            <th>Stamp</th>
                            <th>Net OT Payable (Tk)</th>
                            <th style="min-width: 120px;">Signature</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% set totalOtHrs = 0 %}
                        {% set totalOtPayable = 0 %}
                        {% for r in records %}
                        {% set totalOtHrs = totalOtHrs + r.regular_ot_hrs %}
                        {% set totalOtPayable = totalOtPayable + r.regular_ot_amt %}
                        <tr>
                            <td>{{ r.sl }}</td>
                            <td class="font-monospace fw-bold">{{ r.employee_code }}</td>
                            <td class="text-start fw-semibold">{{ r.name }}</td>
                            <td class="text-start"><small>{{ r.department_name }} ({{ r.section_name }})</small></td>
                            <td>{{ r.position_name }}</td>
                            <td>{{ r.basic|number_format }}</td>
                            <td class="fw-semibold">৳ {{ r.ot_rate|number_format(2) }}</td>
                            <td class="fw-bold text-primary">{{ r.regular_ot_hrs }} h</td>
                            <td>৳ {{ r.regular_ot_amt|number_format }}</td>
                            <td class="text-muted">৳ {{ r.stamp }}</td>
                            <td class="fw-bold text-success fs-6 bg-success-subtle">৳ {{ r.regular_ot_amt|number_format }}</td>
                            <td class="text-muted"><small>________________</small></td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="12" class="py-5 text-muted">No overtime payment records found for {{ filters.year_month }}.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                    {% if records %}
                    <tfoot class="table-dark">
                        <tr>
                            <td colspan="7" class="text-end fw-bold">Grand Total:</td>
                            <td class="fw-bold text-primary fs-6">{{ totalOtHrs }} h</td>
                            <td colspan="2"></td>
                            <td class="fw-bold text-success fs-5">৳ {{ totalOtPayable|number_format }}</td>
                            <td></td>
                        </tr>
                    </tfoot>
                    {% endif %}
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
