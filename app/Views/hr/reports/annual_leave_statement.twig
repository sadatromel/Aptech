{% extends "layouts/app.twig" %}

{% block title %}Employee Yearly Annual Leave Statement | HR Module{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-3">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-2 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%);">
        <div>
            <span class="badge bg-white mb-2 font-monospace fw-bold" style="color: #d97706;"><i class="fas fa-file-contract me-1"></i> BLA SECTION 117 COMPLIANCE</span>
            <h2 class="mb-1 font-weight-bold">Employee Yearly Annual Leave Statement</h2>
            <p class="mb-0 opacity-75">Annual Earned/Annual Leave accumulation & closing balance statement.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button onclick="window.print()" class="btn btn-light rounded-pill px-4 font-weight-bold shadow-sm" style="color: #d97706;"><i class="fas fa-print me-1"></i> Print Statement</button>
            <a href="{{ BASE_URL }}/hr/reports" class="btn btn-outline-light rounded-pill px-4 font-weight-bold shadow-sm"><i class="fas fa-arrow-left me-1"></i> Back to Reports</a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 d-print-none">
        <div class="card-body p-4">
            <form method="GET" action="{{ BASE_URL }}/hr/reports/annual-leave-statement">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-warning">Calendar Year</label>
                        <select class="form-select" name="year">
                            {% for y in 2024..2027 %}
                                <option value="{{ y }}" {{ filters.year == y ? 'selected' : '' }}>{{ y }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-warning">Department</label>
                        <select class="form-select" name="department_id">
                            <option value="">All Departments</option>
                            {% for dept in filterOptions.departments %}
                                <option value="{{ dept.department_id }}" {{ filters.department_id == dept.department_id ? 'selected' : '' }}>{{ dept.department_name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-warning">Section</label>
                        <select class="form-select" name="section_id">
                            <option value="">All Sections</option>
                            {% for sec in filterOptions.sections %}
                                <option value="{{ sec.section_id }}" {{ filters.section_id == sec.section_id ? 'selected' : '' }}>{{ sec.section_name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn btn-warning text-white rounded-pill px-4 fw-bold w-100"><i class="fas fa-calculator me-1"></i> Generate Statement</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Official Report Document Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4">
            <!-- Official Header -->
            <div class="text-center mb-4 pb-3 border-bottom">
                <h3 class="fw-bold mb-1 text-uppercase">{{ companyName }}</h3>
                <p class="mb-1 text-muted small">{{ companyAddress }}</p>
                <h5 class="fw-bold text-warning text-uppercase mt-2">Employee Yearly Annual / Earned Leave Statement - {{ filters.year }}</h5>
                <small class="text-muted">(Calculated as per Bangladesh Labour Act 2006, Section 117 — 1 day per 18 working days)</small>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered align-middle text-center mb-0">
                    <thead class="table-light">
                        <tr>
                            <th rowspan="2">Sl</th>
                            <th rowspan="2">Emp Code</th>
                            <th rowspan="2">Employee Name</th>
                            <th rowspan="2">Department & Section</th>
                            <th rowspan="2">Joining Date</th>
                            <th rowspan="2">Working Days</th>
                            <th colspan="3" class="bg-warning-subtle text-warning border-bottom">Earned Leave Credit (Days)</th>
                            <th colspan="2" class="bg-danger-subtle text-danger border-bottom">Debit / Availed (Days)</th>
                            <th rowspan="2" class="bg-success-subtle text-success">Net Closing Balance</th>
                        </tr>
                        <tr class="table-secondary">
                            <th>Opening Bal</th>
                            <th>Earned in Year</th>
                            <th>Total Credit</th>
                            <th>Availed Leave</th>
                            <th>Encashed</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in statementData %}
                        <tr>
                            <td>{{ row.sl }}</td>
                            <td class="font-monospace fw-bold">{{ row.employee_code }}</td>
                            <td class="text-start fw-semibold">{{ row.name }}</td>
                            <td class="text-start">{{ row.department_name }} <small class="text-muted">({{ row.section_name }})</small></td>
                            <td>{{ row.hire_date|default('N/A') }}</td>
                            <td class="fw-bold">{{ row.working_days }}</td>
                            <td>{{ row.prev_balance|number_format(1) }}</td>
                            <td class="fw-semibold text-primary">+{{ row.earned_in_year|number_format(1) }}</td>
                            <td class="fw-bold text-dark">{{ row.total_available|number_format(1) }}</td>
                            <td class="text-danger">-{{ row.availed_days|number_format(1) }}</td>
                            <td class="text-danger">-{{ row.encashed_days|number_format(1) }}</td>
                            <td class="fw-bold text-success fs-6 bg-success-subtle">{{ row.closing_balance|number_format(1) }} Days</td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="12" class="py-5 text-muted">No annual leave statement records found.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
