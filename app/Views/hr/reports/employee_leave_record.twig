{% extends "layouts/app.twig" %}

{% block title %}Employee Wise Leave Record Report | HR Module{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-3">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-2 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #0284c7 0%, #38bdf8 100%);">
        <div>
            <span class="badge bg-white mb-2 font-monospace fw-bold" style="color: #0284c7;"><i class="fas fa-address-card me-1"></i> INDIVIDUAL LEAVE LEDGER</span>
            <h2 class="mb-1 font-weight-bold">Employee Wise Leave Record Report</h2>
            <p class="mb-0 opacity-75">Detailed leave history and ledger statement for a selected employee.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button onclick="window.print()" class="btn btn-light rounded-pill px-4 font-weight-bold shadow-sm" style="color: #0284c7;"><i class="fas fa-print me-1"></i> Print Statement</button>
            <a href="{{ BASE_URL }}/hr/reports" class="btn btn-outline-light rounded-pill px-4 font-weight-bold shadow-sm"><i class="fas fa-arrow-left me-1"></i> Back to Reports</a>
        </div>
    </div>

    <!-- Employee Selector Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 d-print-none">
        <div class="card-body p-4">
            <form method="GET" action="{{ BASE_URL }}/hr/reports/employee-leave-record" id="empLeaveRecordForm">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-info">Calendar Year</label>
                        <select class="form-select" name="year" onchange="document.getElementById('empLeaveRecordForm').submit()">
                            {% for y in 2024..2027 %}
                                <option value="{{ y }}" {{ filters.year == y ? 'selected' : '' }}>{{ y }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-info">Select Employee</label>
                        <select class="form-select border-info-subtle fw-semibold" name="employee_id" id="report_employee_id" onchange="document.getElementById('empLeaveRecordForm').submit()">
                            <option value="">-- Browse Employee --</option>
                            {% for emp in allEmployees %}
                                <option value="{{ emp.employee_id }}" {{ filters.employee_id == emp.employee_id ? 'selected' : '' }}>
                                    #{{ emp.employee_id }} - {{ emp.employee_code }} ({{ emp.first_name }} {{ emp.last_name }})
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-muted">Or Write Emp Code</label>
                        <input type="text" class="form-control font-monospace" name="emp_code" value="{{ filters.emp_code }}" placeholder="EMP-XXXX" onchange="document.getElementById('empLeaveRecordForm').submit()">
                    </div>

                    <div class="col-md-2">
                        <button type="submit" class="btn btn-info text-white rounded-pill px-4 fw-bold w-100"><i class="fas fa-search me-1"></i> Generate</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Official Employee Statement Card -->
    {% if employee %}
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4">
            <!-- Official Header -->
            <div class="text-center mb-4 pb-3 border-bottom">
                <h3 class="fw-bold mb-1 text-uppercase">{{ companyName }}</h3>
                <p class="mb-1 text-muted small">{{ companyAddress }}</p>
                <h5 class="fw-bold text-info text-uppercase mt-2">Employee Wise Leave Record Statement - {{ filters.year }}</h5>
            </div>

            <!-- Employee Profile Summary Card -->
            <div class="bg-light p-3 rounded-3 mb-4 border">
                <div class="row g-3">
                    <div class="col-md-3"><strong>Employee Name:</strong> <span class="text-info fw-bold">{{ employee.first_name }} {{ employee.last_name }}</span></div>
                    <div class="col-md-3"><strong>Employee Code:</strong> <span class="font-monospace fw-bold">{{ employee.employee_code }}</span></div>
                    <div class="col-md-3"><strong>Department:</strong> {{ employee.department_name|default('N/A') }}</div>
                    <div class="col-md-3"><strong>Section:</strong> {{ employee.section_name|default('N/A') }}</div>
                    <div class="col-md-3"><strong>Designation:</strong> {{ employee.position_name|default('N/A') }}</div>
                    <div class="col-md-3"><strong>Joining Date:</strong> {{ employee.hire_date|default('N/A') }}</div>
                    <div class="col-md-3"><strong>Employment Type:</strong> {{ employee.employment_type|default('Permanent') }}</div>
                    <div class="col-md-3"><strong>Total Records:</strong> <span class="badge bg-info text-white px-3 py-1">{{ leaves|length }} Application(s)</span></div>
                </div>
            </div>

            <!-- Leave Balance Summary Table for Selected Employee -->
            {% if leaveBalances %}
            <div class="mb-4">
                <h6 class="fw-bold text-secondary mb-2"><i class="fas fa-calculator me-1"></i> Current Year Leave Entitlement & Balance Matrix ({{ filters.year }})</h6>
                <div class="table-responsive">
                    <table class="table table-bordered align-middle text-center mb-0" style="font-size: 0.85rem;">
                        <thead class="table-light">
                            <tr>
                                <th>Status</th>
                                <th>CL (Casual)</th>
                                <th>SL (Sick)</th>
                                <th>LWP (Unpaid)</th>
                                <th>RL (Replacement)</th>
                                <th>SPL (Special)</th>
                                <th>EL (Earned)</th>
                                <th>EDL (Extra Duty)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th class="bg-light text-secondary text-start px-3">Entitlement</th>
                                <td>{{ leaveBalances.CL.ent }}</td>
                                <td>{{ leaveBalances.SL.ent }}</td>
                                <td>{{ leaveBalances.LWP.ent }}</td>
                                <td>{{ leaveBalances.RL.ent }}</td>
                                <td>{{ leaveBalances.SPL.ent }}</td>
                                <td>{{ leaveBalances.EL.ent }}</td>
                                <td>{{ leaveBalances.EDL.ent }}</td>
                            </tr>
                            <tr>
                                <th class="bg-light text-secondary text-start px-3">Taken / Enjoyed</th>
                                <td class="text-danger fw-semibold">{{ leaveBalances.CL.taken }}</td>
                                <td class="text-danger fw-semibold">{{ leaveBalances.SL.taken }}</td>
                                <td class="text-danger fw-semibold">{{ leaveBalances.LWP.taken }}</td>
                                <td class="text-danger fw-semibold">{{ leaveBalances.RL.taken }}</td>
                                <td class="text-danger fw-semibold">{{ leaveBalances.SPL.taken }}</td>
                                <td class="text-danger fw-semibold">{{ leaveBalances.EL.taken }}</td>
                                <td class="text-danger fw-semibold">{{ leaveBalances.EDL.taken }}</td>
                            </tr>
                            <tr>
                                <th class="bg-light text-success text-start px-3">Remaining Balance</th>
                                <td class="fw-bold text-success fs-6">{{ leaveBalances.CL.bal }}</td>
                                <td class="fw-bold text-success fs-6">{{ leaveBalances.SL.bal }}</td>
                                <td class="fw-bold text-secondary fs-6">{{ leaveBalances.LWP.bal }}</td>
                                <td class="fw-bold text-success fs-6">{{ leaveBalances.RL.bal }}</td>
                                <td class="fw-bold text-success fs-6">{{ leaveBalances.SPL.bal }}</td>
                                <td class="fw-bold text-success fs-6">{{ leaveBalances.EL.bal }}</td>
                                <td class="fw-bold text-success fs-6">{{ leaveBalances.EDL.bal }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            {% endif %}

            <!-- Transaction Ledger Table -->
            <h6 class="fw-bold text-secondary mb-2"><i class="fas fa-list me-1"></i> Chronological Leave Application Register</h6>
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light text-center">
                        <tr>
                            <th>#ID</th>
                            <th>Applied Date</th>
                            <th>Leave Type</th>
                            <th>Day's Part</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Total Days</th>
                            <th>Substitute / Job Responsible</th>
                            <th>Status</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for l in leaves %}
                        <tr>
                            <td class="text-center font-monospace small">#{{ l.id }}</td>
                            <td class="text-center small">{{ l.created_at|date("M j, Y") }}</td>
                            <td class="text-center">
                                <span class="badge bg-info-subtle text-info border fw-bold">{{ l.leave_type }}</span>
                            </td>
                            <td class="text-center small">{{ l.days_part|default('Full Day') }}</td>
                            <td class="text-center fw-semibold">{{ l.start_date|date("M j, Y") }}</td>
                            <td class="text-center fw-semibold">{{ l.end_date|date("M j, Y") }}</td>
                            <td class="text-center fw-bold">{{ l.total_days|default(1) }}</td>
                            <td>
                                {% if l.sub_first %}
                                    <small>{{ l.sub_first }} {{ l.sub_last }} ({{ l.sub_code }})</small>
                                {% else %}
                                    <span class="text-muted small">None</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                {% if l.status == 'Approved' %}
                                    <span class="badge bg-success rounded-pill px-3 py-1">Approved</span>
                                {% elseif l.status == 'Pending' %}
                                    <span class="badge bg-warning text-dark rounded-pill px-3 py-1">Pending</span>
                                {% else %}
                                    <span class="badge bg-danger rounded-pill px-3 py-1">{{ l.status }}</span>
                                {% endif %}
                            </td>
                            <td><small class="text-muted">{{ l.reason|default('N/A') }}</small></td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="10" class="text-center py-4 text-muted">No leave entries recorded for this employee in {{ filters.year }}.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% elseif filters.employee_id or filters.emp_code %}
        <div class="alert alert-warning text-center rounded-3">
            <i class="fas fa-exclamation-triangle me-2"></i> Specified Employee not found. Please select a valid employee from the list above.
        </div>
    {% endif %}
</div>
{% endblock %}
