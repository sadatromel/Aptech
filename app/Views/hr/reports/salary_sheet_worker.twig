{% extends "layouts/app.twig" %}

{% block title %}Monthly Salary Sheet Worker | HR Module{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-3">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-2 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #15803d 0%, #22c55e 100%);">
        <div>
            <span class="badge bg-white mb-2 font-monospace fw-bold" style="color: #15803d;"><i class="fas fa-users-gear me-1"></i> WORKER PAYROLL REGISTER</span>
            <h2 class="mb-1 font-weight-bold">Monthly Payment / Salary Sheet Worker</h2>
            <p class="mb-0 opacity-75">RMG Standard factory worker & operator monthly salary disbursement sheet.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button onclick="window.print()" class="btn btn-light rounded-pill px-4 font-weight-bold shadow-sm" style="color: #15803d;"><i class="fas fa-print me-1"></i> Print Worker Sheet</button>
            <a href="{{ BASE_URL }}/hr/reports" class="btn btn-outline-light rounded-pill px-4 font-weight-bold shadow-sm"><i class="fas fa-arrow-left me-1"></i> Back to Reports</a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 d-print-none">
        <div class="card-body p-4">
            <form method="GET" action="{{ BASE_URL }}/hr/reports/salary-sheet-worker">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-success">Year - Month</label>
                        <input type="month" class="form-control" name="year_month" value="{{ filters.year_month }}">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-success">Department</label>
                        <select class="form-select" name="department_id">
                            <option value="">All Worker Departments</option>
                            {% for dept in filterOptions.departments %}
                                <option value="{{ dept.department_id }}" {{ filters.department_id == dept.department_id ? 'selected' : '' }}>{{ dept.department_name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold small text-success">Section / Line</label>
                        <select class="form-select" name="section_id">
                            <option value="">All Sections</option>
                            {% for sec in filterOptions.sections %}
                                <option value="{{ sec.section_id }}" {{ filters.section_id == sec.section_id ? 'selected' : '' }}>{{ sec.section_name }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold w-100"><i class="fas fa-search me-1"></i> Generate Sheet</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Official Report Document Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4">
            <!-- Official Header -->
            <div class="text-center mb-4 pb-3 border-bottom">
                <h3 class="fw-bold mb-1 text-uppercase">{{ companyName }}</h3>
                <p class="mb-1 text-muted small">{{ companyAddress }}</p>
                <h5 class="fw-bold text-success text-uppercase mt-2">Worker & Operator Monthly Salary Sheet — {{ filters.year_month }}</h5>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered align-middle text-center mb-0" style="font-size: 0.82rem;">
                    <thead class="table-light align-middle">
                        <tr>
                            <th rowspan="2">Sl</th>
                            <th rowspan="2">Card No</th>
                            <th rowspan="2" style="min-width: 140px;">Worker Name</th>
                            <th rowspan="2">Dept & Line</th>
                            <th rowspan="2">Designation</th>
                            <th colspan="4" class="table-secondary">Salary Breakdown (Tk)</th>
                            <th rowspan="2">Pay Days</th>
                            <th rowspan="2">Earned Gross</th>
                            <th colspan="2" class="table-warning">Overtime</th>
                            <th rowspan="2">Att. Bonus</th>
                            <th rowspan="2">Stamp</th>
                            <th rowspan="2" class="bg-success text-white">Net Payable (Tk)</th>
                            <th rowspan="2" style="min-width: 130px;">Worker Signature</th>
                        </tr>
                        <tr class="table-secondary" style="font-size: 0.76rem;">
                            <th>Gross</th><th>Basic</th><th>H.Rent</th><th>Medical</th>
                            <th>OT Hrs</th><th>OT Amt</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% set totalGross = 0 %}
                        {% set totalNet = 0 %}
                        {% for r in records %}
                        {% set totalGross = totalGross + r.gross %}
                        {% set totalNet = totalNet + r.net_salary %}
                        <tr>
                            <td>{{ r.sl }}</td>
                            <td class="font-monospace fw-bold">{{ r.employee_code }}</td>
                            <td class="text-start fw-semibold">{{ r.name }}</td>
                            <td class="text-start"><small>{{ r.department_name }} ({{ r.section_name }})</small></td>
                            <td>{{ r.position_name }}</td>

                            <td>{{ r.gross|number_format }}</td>
                            <td>{{ r.basic|number_format }}</td>
                            <td>{{ r.house_rent|number_format }}</td>
                            <td>{{ r.medical|number_format }}</td>

                            <td class="fw-bold">{{ r.payable_days }}</td>
                            <td class="fw-semibold">{{ r.earned_gross|number_format }}</td>

                            <td>{{ r.regular_ot_hrs }} h</td>
                            <td>৳ {{ r.regular_ot_amt|number_format }}</td>
                            <td class="text-success fw-semibold">+৳ {{ r.att_bonus }}</td>
                            <td class="text-muted">৳ {{ r.stamp }}</td>

                            <td class="fw-bold text-success fs-6 bg-success-subtle">৳ {{ r.net_salary|number_format }}</td>
                            <td class="text-muted"><small>________________</small></td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="17" class="py-5 text-muted">No worker salary records found for {{ filters.year_month }}.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                    {% if records %}
                    <tfoot class="table-dark">
                        <tr>
                            <td colspan="5" class="text-end fw-bold">Grand Total:</td>
                            <td class="fw-bold text-warning">৳ {{ totalGross|number_format }}</td>
                            <td colspan="9"></td>
                            <td class="fw-bold text-success fs-5">৳ {{ totalNet|number_format }}</td>
                            <td></td>
                        </tr>
                    </tfoot>
                    {% endif %}
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
