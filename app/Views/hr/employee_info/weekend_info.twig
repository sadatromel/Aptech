{% extends "layouts/app.twig" %}

{% block title %}Employee Weekend | HR Employee Information{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #6366f1 0%, #4338ca 100%);">
        <div>
            <span class="badge bg-white text-indigo mb-2 font-monospace" style="color: #4338ca;"><i class="fas fa-calendar-week me-1"></i> EMPLOYEE SCHEDULE & ROSTER</span>
            <h2 class="mb-1 font-weight-bold">Employee Weekend Information</h2>
            <p class="mb-0 opacity-75">Assign and manage weekly off days for individual employees or groups.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-calendar-check fa-3x opacity-50"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <div class="row">
        <!-- Form Section -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 text-indigo fw-bold" style="color: #4338ca;"><i class="fas fa-user-clock me-2"></i>Assign Employee Weekend</h5>
                </div>
                <div class="card-body p-4">
                    <form action="{{ BASE_URL }}/hr/employees/weekend" method="POST">
                        {{ csrf_field() | raw }}
                        <div class="mb-3">
                            <label for="employee_id" class="form-label fw-bold">Select Employee *</label>
                            <select class="form-select border-indigo fw-bold" id="employee_id" name="employee_id" required>
                                <option value="">-- Choose Employee --</option>
                                {% for emp in employees %}
                                <option value="{{ emp.employee_id }}">{{ emp.employee_code }} - {{ emp.first_name }} {{ emp.last_name }} ({{ emp.department_name }})</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Weekend Off Days *</label>
                            <div class="d-flex flex-wrap gap-2 p-3 bg-light rounded border">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" name="weekend_days[]" value="Friday" id="day_fri" checked>
                                    <label class="form-check-label fw-bold text-danger" for="day_fri">Friday</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" name="weekend_days[]" value="Saturday" id="day_sat">
                                    <label class="form-check-label fw-semibold" for="day_sat">Saturday</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" name="weekend_days[]" value="Sunday" id="day_sun">
                                    <label class="form-check-label fw-semibold" for="day_sun">Sunday</label>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <label for="effective_date" class="form-label fw-semibold">Effective Date *</label>
                                <input type="date" class="form-control" id="effective_date" name="effective_date" value="{{ "now"|date("Y-m-d") }}" required>
                            </div>
                            <div class="col-6">
                                <label for="status" class="form-label fw-semibold">Status *</label>
                                <select class="form-select" id="status" name="status" required>
                                    <option value="active">Active</option>
                                    <option value="inactive">Inactive</option>
                                </select>
                            </div>
                        </div>

                        <button type="submit" class="btn text-white w-100 rounded-pill py-3 fw-bold shadow-sm" style="background-color: #4338ca;"><i class="fas fa-save me-2"></i> Save Weekend Schedule</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Table Section -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-list me-2"></i>Assigned Weekend Schedules</h5>
                    <span class="badge bg-indigo-subtle text-indigo px-3 py-2 border">Total: {{ records|length }}</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Code</th>
                                    <th>Employee</th>
                                    <th>Department</th>
                                    <th>Off Day(s)</th>
                                    <th>Effective Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if records is empty %}
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No custom weekend schedules assigned yet.</td>
                                </tr>
                                {% else %}
                                {% for rec in records %}
                                <tr>
                                    <td class="fw-bold font-monospace">{{ rec.employee_code }}</td>
                                    <td class="fw-semibold">{{ rec.employee_name }}</td>
                                    <td><span class="badge bg-light text-dark border">{{ rec.department_name ?: 'General' }}</span></td>
                                    <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1"><i class="fas fa-mug-hot me-1"></i>{{ rec.weekend_days }}</span></td>
                                    <td>{{ rec.effective_date }}</td>
                                    <td>
                                        {% if rec.status == 'active' %}
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                        {% else %}
                                        <span class="badge bg-secondary-subtle text-secondary border">Inactive</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
