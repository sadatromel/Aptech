{% extends "layouts/app.twig" %}

{% block title %}Employee Submitted Documents | HR Employee Information{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #0d9488 0%, #115e59 100%);">
        <div>
            <span class="badge bg-white text-teal mb-2 font-monospace" style="color: #115e59;"><i class="fas fa-folder-open me-1"></i> ONBOARDING & AUDIT FILE REPOSITORY</span>
            <h2 class="mb-1 font-weight-bold">Employee Submitted Documents</h2>
            <p class="mb-0 opacity-75">Track NID, Academic Certificates, Appointment Letters, Nominee Forms, and Passport Photos.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-file-pdf fa-3x opacity-50"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <div class="row">
        <!-- Form -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold" style="color: #115e59;"><i class="fas fa-cloud-upload-alt me-2"></i>Log Submitted Document</h5>
                </div>
                <div class="card-body p-4">
                    <form action="{{ BASE_URL }}/hr/employees/submitted-documents" method="POST">
                        {{ csrf_field() | raw }}
                        <div class="mb-3">
                            <label for="employee_id" class="form-label fw-bold">Select Employee *</label>
                            <select class="form-select fw-bold border-teal" id="employee_id" name="employee_id" required>
                                <option value="">-- Choose Employee --</option>
                                {% for emp in employees %}
                                <option value="{{ emp.employee_id }}">{{ emp.employee_code }} - {{ emp.first_name }} {{ emp.last_name }} ({{ emp.department_name }})</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="document_type" class="form-label fw-semibold">Document Category *</label>
                            <select class="form-select" id="document_type" name="document_type" required>
                                <option value="National ID Card (NID)">National ID Card (NID)</option>
                                <option value="Birth Certificate">Birth Certificate</option>
                                <option value="Academic Certificate">Academic Certificate</option>
                                <option value="Appointment Letter (Signed)">Appointment Letter (Signed)</option>
                                <option value="Nominee Form with Photo">Nominee Form with Photo</option>
                                <option value="Doctor Medical Clearance">Doctor Medical Clearance</option>
                                <option value="Experience Certificate">Experience Certificate</option>
                                <option value="Tax TIN Certificate">Tax TIN Certificate</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="document_name" class="form-label fw-semibold">Document Reference Title *</label>
                            <input type="text" class="form-control" id="document_name" name="document_name" placeholder="e.g. SSC Certificate Copy / NID Copy" required>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <label for="document_number" class="form-label fw-semibold">Document / Reg No.</label>
                                <input type="text" class="form-control font-monospace" id="document_number" name="document_number" placeholder="Doc No.">
                            </div>
                            <div class="col-6">
                                <label for="submission_date" class="form-label fw-semibold">Submission Date *</label>
                                <input type="date" class="form-control" id="submission_date" name="submission_date" value="{{ "now"|date("Y-m-d") }}" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="verification_status" class="form-label fw-semibold">Verification Status *</label>
                            <select class="form-select" id="verification_status" name="verification_status" required>
                                <option value="Verified">Verified & Approved</option>
                                <option value="Submitted">Submitted (Pending Audit)</option>
                                <option value="Rejected">Rejected / Re-upload Required</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="remarks" class="form-label fw-semibold">Remarks</label>
                            <textarea class="form-control" id="remarks" name="remarks" rows="2" placeholder="Verification notes..."></textarea>
                        </div>

                        <button type="submit" class="btn text-white w-100 rounded-pill py-3 fw-bold shadow-sm" style="background-color: #115e59;"><i class="fas fa-save me-2"></i> Log Document Record</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-archive me-2"></i>Submitted Document Records</h5>
                    <span class="badge bg-teal-subtle text-teal border">Total: {{ records|length }}</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Employee</th>
                                    <th>Document Category</th>
                                    <th>Title / Reg No</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if records is empty %}
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No document records logged yet.</td>
                                </tr>
                                {% else %}
                                {% for rec in records %}
                                <tr>
                                    <td class="fw-semibold">
                                        <div class="fw-bold">{{ rec.employee_name }}</div>
                                        <span class="font-monospace small text-muted">{{ rec.employee_code }}</span>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">{{ rec.document_type }}</span></td>
                                    <td>
                                        <div class="fw-bold text-dark">{{ rec.document_name }}</div>
                                        {% if rec.document_number %}
                                        <span class="small text-muted font-monospace">NO: {{ rec.document_number }}</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ rec.submission_date }}</td>
                                    <td>
                                        {% if rec.verification_status == 'Verified' %}
                                        <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="fas fa-check-circle me-1"></i>Verified</span>
                                        {% elseif rec.verification_status == 'Submitted' %}
                                        <span class="badge bg-info-subtle text-info border border-info-subtle"><i class="fas fa-clock me-1"></i>Pending</span>
                                        {% else %}
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="fas fa-times-circle me-1"></i>Rejected</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
