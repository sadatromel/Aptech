{% extends "layouts/app.twig" %}

{% block title %}Employee Salary Information | HR Employee Information{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #059669 0%, #047857 100%);">
        <div>
            <span class="badge bg-white text-emerald mb-2 font-monospace" style="color: #047857;"><i class="fas fa-coins me-1"></i> PAYROLL STRUCTURE & ALLOWANCES</span>
            <h2 class="mb-1 font-weight-bold">Employee Salary Information</h2>
            <p class="mb-0 opacity-75">View and update basic salary, house rent, medical, transport allowances, and bank payout details.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-file-invoice-dollar fa-3x opacity-50"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <div class="row">
        <!-- Form -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 text-emerald fw-bold" style="color: #047857;"><i class="fas fa-edit me-2"></i>Update Employee Salary Structure</h5>
                </div>
                <div class="card-body p-4">
                    <form action="{{ BASE_URL }}/hr/employees/salary-info" method="POST">
                        {{ csrf_field() | raw }}
                        <div class="mb-3">
                            <label for="employee_id" class="form-label fw-bold">Select Employee *</label>
                            <select class="form-select fw-bold border-emerald" id="employee_id" name="employee_id" required onchange="populateSalaryFields(this)">
                                <option value="">-- Choose Employee --</option>
                                {% for emp in employees %}
                                <option value="{{ emp.employee_id }}" data-basic="{{ emp.basic_salary }}">{{ emp.employee_code }} - {{ emp.first_name }} {{ emp.last_name }} (Current: ৳{{ emp.basic_salary|number_format(2) }})</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <label for="basic_salary" class="form-label fw-semibold">Basic Salary (৳) *</label>
                                <input type="number" step="0.01" class="form-control fw-bold" id="basic_salary" name="basic_salary" placeholder="0.00" required>
                            </div>
                            <div class="col-6">
                                <label for="house_rent" class="form-label fw-semibold">House Rent (৳)</label>
                                <input type="number" step="0.01" class="form-control" id="house_rent" name="house_rent" placeholder="0.00">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-4">
                                <label for="medical_allowance" class="form-label fw-semibold">Medical (৳)</label>
                                <input type="number" step="0.01" class="form-control" id="medical_allowance" name="medical_allowance" placeholder="0.00">
                            </div>
                            <div class="col-4">
                                <label for="transport_allowance" class="form-label fw-semibold">Conveyance (৳)</label>
                                <input type="number" step="0.01" class="form-control" id="transport_allowance" name="transport_allowance" placeholder="0.00">
                            </div>
                            <div class="col-4">
                                <label for="food_allowance" class="form-label fw-semibold">Food (৳)</label>
                                <input type="number" step="0.01" class="form-control" id="food_allowance" name="food_allowance" placeholder="0.00">
                            </div>
                        </div>

                        <hr class="my-3">
                        <h6 class="fw-bold mb-3 text-dark"><i class="fas fa-university me-2 text-emerald" style="color: #047857;"></i>Bank Payout Details</h6>

                        <div class="mb-3">
                            <label for="bank_name" class="form-label fw-semibold">Bank / MFS Name</label>
                            <input type="text" class="form-control" id="bank_name" name="bank_name" placeholder="e.g. Dutch-Bangla Bank / bKash">
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <label for="bank_account" class="form-label fw-semibold">Account Number</label>
                                <input type="text" class="form-control font-monospace" id="bank_account" name="bank_account" placeholder="A/C No">
                            </div>
                            <div class="col-6">
                                <label for="bank_branch" class="form-label fw-semibold">Branch / Routing</label>
                                <input type="text" class="form-control" id="bank_branch" name="bank_branch" placeholder="Branch Name">
                            </div>
                        </div>

                        <button type="submit" class="btn text-white w-100 rounded-pill py-3 fw-bold shadow-sm" style="background-color: #047857;"><i class="fas fa-save me-2"></i> Save Salary Information</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-table me-2"></i>Employee Compensation Records</h5>
                    <span class="badge bg-emerald-subtle text-emerald border">Total: {{ employees|length }}</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Code</th>
                                    <th>Employee</th>
                                    <th>Department</th>
                                    <th>Basic Salary</th>
                                    <th>Gross Est.</th>
                                    <th>Payment Mode</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if employees is empty %}
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No salary records found.</td>
                                </tr>
                                {% else %}
                                {% for emp in employees %}
                                <tr>
                                    <td class="fw-bold font-monospace">{{ emp.employee_code }}</td>
                                    <td class="fw-semibold">{{ emp.first_name }} {{ emp.last_name }}</td>
                                    <td><span class="badge bg-light text-dark border">{{ emp.department_name ?: 'General' }}</span></td>
                                    <td class="fw-bold text-success">৳ {{ emp.basic_salary|number_format(2) }}</td>
                                    <td class="fw-bold text-primary">৳ {{ (emp.basic_salary * 1.55)|number_format(2) }}</td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info border border-info-subtle"><i class="fas fa-university me-1"></i>Bank Advice</span>
                                    </td>
                                </tr>
                                {% endfor %}
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function populateSalaryFields(select) {
    let option = select.options[select.selectedIndex];
    let basic = parseFloat(option.getAttribute('data-basic')) || 0;
    if (basic > 0) {
        document.getElementById('basic_salary').value = basic.toFixed(2);
        document.getElementById('house_rent').value = (basic * 0.5).toFixed(2);
        document.getElementById('medical_allowance').value = (1500.00).toFixed(2);
        document.getElementById('transport_allowance').value = (450.00).toFixed(2);
        document.getElementById('food_allowance').value = (1250.00).toFixed(2);
    }
}
</script>
{% endblock %}
