{% extends "layouts/app.twig" %}

{% block title %}Employee Policy Tagging Information | HR Employee Information{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #7c3aed 0%, #5b21b6 100%);">
        <div>
            <span class="badge bg-white text-purple mb-2 font-monospace" style="color: #5b21b6;"><i class="fas fa-tags me-1"></i> COMPLIANCE & RULES MAPPING</span>
            <h2 class="mb-1 font-weight-bold">Employee Policy Tagging Information</h2>
            <p class="mb-0 opacity-75">Assign OT rules, attendance grace policies, leave allocations, and code of conduct policies to staff.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-file-contract fa-3x opacity-50"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <div class="row">
        <!-- Form -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold" style="color: #5b21b6;"><i class="fas fa-plus-circle me-2"></i>Tag Policy to Employee</h5>
                </div>
                <div class="card-body p-4">
                    <form action="{{ BASE_URL }}/hr/employees/policy-tagging" method="POST">
                        {{ csrf_field() | raw }}
                        <div class="mb-3">
                            <label for="employee_id" class="form-label fw-bold">Select Employee *</label>
                            <select class="form-select fw-bold border-purple" id="employee_id" name="employee_id" required>
                                <option value="">-- Choose Employee --</option>
                                {% for emp in employees %}
                                <option value="{{ emp.employee_id }}">{{ emp.employee_code }} - {{ emp.first_name }} {{ emp.last_name }} ({{ emp.department_name }})</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="policy_name" class="form-label fw-semibold">Policy Name *</label>
                            <select class="form-select" id="policy_name" name="policy_name" required>
                                <option value="Overtime Approval & Rate Policy">Overtime Approval & Rate Policy</option>
                                <option value="15-Min Attendance Grace Time Policy">15-Min Attendance Grace Time Policy</option>
                                <option value="Annual Leave Encashment Rules">Annual Leave Encashment Rules</option>
                                <option value="RMG Worker Safety & Fire Drill Protocol">RMG Worker Safety & Fire Drill Protocol</option>
                                <option value="Night Shift Allowance Policy">Night Shift Allowance Policy</option>
                                <option value="Code of Conduct & Confidentiality">Code of Conduct & Confidentiality</option>
                            </select>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <label for="policy_type" class="form-label fw-semibold">Policy Type *</label>
                                <select class="form-select" id="policy_type" name="policy_type" required>
                                    <option value="Operational">Operational</option>
                                    <option value="Compliance">Compliance</option>
                                    <option value="Benefit">Benefit</option>
                                    <option value="Safety">Safety</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label for="status" class="form-label fw-semibold">Tag Status *</label>
                                <select class="form-select" id="status" name="status" required>
                                    <option value="active">Active</option>
                                    <option value="pending">Pending Acknowledgement</option>
                                    <option value="expired">Expired</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <label for="effective_date" class="form-label fw-semibold">Effective Date *</label>
                                <input type="date" class="form-control" id="effective_date" name="effective_date" value="{{ "now"|date("Y-m-d") }}" required>
                            </div>
                            <div class="col-6">
                                <label for="expiry_date" class="form-label fw-semibold">Expiry Date</label>
                                <input type="date" class="form-control" id="expiry_date" name="expiry_date">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="remarks" class="form-label fw-semibold">Remarks / Notes</label>
                            <textarea class="form-control" id="remarks" name="remarks" rows="2" placeholder="Optional notes..."></textarea>
                        </div>

                        <button type="submit" class="btn text-white w-100 rounded-pill py-3 fw-bold shadow-sm" style="background-color: #5b21b6;"><i class="fas fa-save me-2"></i> Tag Policy</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-list me-2"></i>Tagged Employee Policies</h5>
                    <span class="badge bg-purple-subtle text-purple border">Total: {{ records|length }}</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Employee</th>
                                    <th>Policy Name</th>
                                    <th>Type</th>
                                    <th>Effective</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if records is empty %}
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No policies tagged to employees yet.</td>
                                </tr>
                                {% else %}
                                {% for rec in records %}
                                <tr>
                                    <td class="fw-semibold">
                                        <div class="fw-bold">{{ rec.employee_name }}</div>
                                        <span class="font-monospace small text-muted">{{ rec.employee_code }}</span>
                                    </td>
                                    <td class="fw-bold text-dark">{{ rec.policy_name }}</td>
                                    <td><span class="badge bg-light text-dark border">{{ rec.policy_type }}</span></td>
                                    <td>{{ rec.effective_date }}</td>
                                    <td>
                                        {% if rec.status == 'active' %}
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                        {% elseif rec.status == 'pending' %}
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Pending</span>
                                        {% else %}
                                        <span class="badge bg-secondary-subtle text-secondary border">Expired</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
