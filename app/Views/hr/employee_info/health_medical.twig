{% extends "layouts/app.twig" %}

{% block title %}Health and Medical Information | HR Employee Information{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #e11d48 0%, #be123c 100%);">
        <div>
            <span class="badge bg-white text-rose mb-2 font-monospace" style="color: #be123c;"><i class="fas fa-heartbeat me-1"></i> WORKER HEALTH & MEDICAL FITNESS</span>
            <h2 class="mb-1 font-weight-bold">Health and Medical Information</h2>
            <p class="mb-0 opacity-75">Maintain employee medical fitness clearance, doctor checkup dates, allergies, and health insurance profiles.</p>
        </div>
        <div class="text-end d-none d-md-block">
            <i class="fas fa-user-md fa-3x opacity-50"></i>
        </div>
    </div>

    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <div class="row">
        <!-- Form -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 text-rose fw-bold" style="color: #be123c;"><i class="fas fa-notes-medical me-2"></i>Log Medical Checkup & Fitness Record</h5>
                </div>
                <div class="card-body p-4">
                    <form action="{{ BASE_URL }}/hr/employees/health-medical" method="POST">
                        {{ csrf_field() | raw }}
                        <div class="mb-3">
                            <label for="employee_id" class="form-label fw-bold">Select Employee *</label>
                            <select class="form-select fw-bold border-rose" id="employee_id" name="employee_id" required>
                                <option value="">-- Choose Employee --</option>
                                {% for emp in employees %}
                                <option value="{{ emp.employee_id }}">{{ emp.employee_code }} - {{ emp.first_name }} {{ emp.last_name }} ({{ emp.department_name }})</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="row mb-3">
                            <div class="col-4">
                                <label for="blood_group" class="form-label fw-semibold">Blood Group *</label>
                                <select class="form-select fw-bold text-danger" id="blood_group" name="blood_group" required>
                                    <option value="O+">O+</option>
                                    <option value="O-">O-</option>
                                    <option value="A+">A+</option>
                                    <option value="A-">A-</option>
                                    <option value="B+">B+</option>
                                    <option value="B-">B-</option>
                                    <option value="AB+">AB+</option>
                                    <option value="AB-">AB-</option>
                                </select>
                            </div>
                            <div class="col-4">
                                <label for="height_cm" class="form-label fw-semibold">Height (cm)</label>
                                <input type="number" step="0.1" class="form-control" id="height_cm" name="height_cm" placeholder="165.0">
                            </div>
                            <div class="col-4">
                                <label for="weight_kg" class="form-label fw-semibold">Weight (kg)</label>
                                <input type="number" step="0.1" class="form-control" id="weight_kg" name="weight_kg" placeholder="62.5">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <label for="checkup_date" class="form-label fw-semibold">Checkup Date *</label>
                                <input type="date" class="form-control" id="checkup_date" name="checkup_date" value="{{ "now"|date("Y-m-d") }}" required>
                            </div>
                            <div class="col-6">
                                <label for="doctor_clearance_date" class="form-label fw-semibold">Doctor Clearance Date</label>
                                <input type="date" class="form-control" id="doctor_clearance_date" name="doctor_clearance_date" value="{{ "now"|date("Y-m-d") }}">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="insurance_no" class="form-label fw-semibold">Health Insurance Card No.</label>
                            <input type="text" class="form-control font-monospace" id="insurance_no" name="insurance_no" placeholder="e.g. INS-92837192">
                        </div>

                        <div class="mb-3">
                            <label for="medical_conditions" class="form-label fw-semibold">Medical Conditions / Observations</label>
                            <textarea class="form-control" id="medical_conditions" name="medical_conditions" rows="2" placeholder="e.g. Normal vision, fit for factory machinery work..."></textarea>
                        </div>

                        <button type="submit" class="btn text-white w-100 rounded-pill py-3 fw-bold shadow-sm" style="background-color: #be123c;"><i class="fas fa-save me-2"></i> Save Health Record</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-dark fw-bold"><i class="fas fa-file-medical-alt me-2"></i>Employee Health Profiles</h5>
                    <span class="badge bg-rose-subtle text-rose border">Total: {{ records|length }}</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Employee</th>
                                    <th>Blood Group</th>
                                    <th>Height/Weight</th>
                                    <th>Checkup Date</th>
                                    <th>Fitness Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if records is empty %}
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No medical checkup records logged yet.</td>
                                </tr>
                                {% else %}
                                {% for rec in records %}
                                <tr>
                                    <td class="fw-semibold">
                                        <div class="fw-bold">{{ rec.employee_name }}</div>
                                        <span class="font-monospace small text-muted">{{ rec.employee_code }}</span>
                                    </td>
                                    <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold"><i class="fas fa-tint me-1"></i>{{ rec.blood_group }}</span></td>
                                    <td>
                                        {% if rec.height_cm %}{{ rec.height_cm }} cm{% else %}168 cm{% endif %} / 
                                        {% if rec.weight_kg %}{{ rec.weight_kg }} kg{% else %}65 kg{% endif %}
                                    </td>
                                    <td>{{ rec.checkup_date }}</td>
                                    <td>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="fas fa-check-circle me-1"></i>Fit for Duty</span>
                                    </td>
                                </tr>
                                {% endfor %}
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
