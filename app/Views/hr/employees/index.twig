{% extends "layouts/app.twig" %}

{% block title %}Employee Directory | HR Module{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);">
        <div>
            <span class="badge bg-white text-primary mb-2 font-monospace"><i class="fas fa-users me-1"></i> WORKFORCE MANAGEMENT</span>
            <h2 class="mb-1 font-weight-bold">Employee Directory & Master Database</h2>
            <p class="mb-0 opacity-75">Manage complete worker profiles, personal records, shift assignments, and employment status.</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <a href="{{ BASE_URL }}/hr/employees?action=create" class="btn btn-light rounded-pill px-4 font-weight-bold text-primary shadow-sm"><i class="fas fa-plus me-2"></i>Add New Employee</a>
        </div>
    </div>

    <!-- KPI Summary Row -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-primary">
                <div class="small text-muted font-weight-bold text-uppercase">Total Headcount</div>
                <div class="h3 font-weight-bold text-primary my-1">{{ employees|length }}</div>
                <div class="small text-muted"><i class="fas fa-id-card me-1"></i> Registered Workforce</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-success">
                <div class="small text-muted font-weight-bold text-uppercase">Active Status</div>
                <div class="h3 font-weight-bold text-success my-1">{{ employees|length }}</div>
                <div class="small text-success"><i class="fas fa-check-circle me-1"></i> On Active Payroll</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-info">
                <div class="small text-muted font-weight-bold text-uppercase">Female Workers</div>
                <div class="h3 font-weight-bold text-info my-1">62%</div>
                <div class="small text-muted"><i class="fas fa-female me-1"></i> RMG Standard Target</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-warning">
                <div class="small text-muted font-weight-bold text-uppercase">Departments</div>
                <div class="h3 font-weight-bold text-warning my-1">10 Lines</div>
                <div class="small text-muted"><i class="fas fa-sitemap me-1"></i> Factory Operations</div>
            </div>
        </div>
    </div>

    <!-- Main Table Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-primary fw-bold"><i class="fas fa-id-badge me-2"></i>Employee Master Register</h5>
            <form class="d-flex gap-2" method="GET" action="{{ BASE_URL }}/hr/employees">  
                <input type="text" name="q" class="form-control form-control-sm rounded-pill px-3" placeholder="Search by name, ID or code..." value="{{ request.q }}">
                <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3"><i class="fas fa-search me-1"></i> Search</button>
            </form>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Code</th>
                            <th>Employee Name</th>
                            <th>Contact & Email</th>
                            <th>Department & Position</th>
                            <th>Status</th>
                            <th>Joining Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for employee in employees %}
                        <tr>
                            <td><span class="badge bg-light text-dark border font-monospace">{{ employee.employee_code }}</span></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-circle me-3 bg-primary-subtle text-primary fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                        {{ employee.first_name|first }}{{ employee.last_name|first }}
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">{{ employee.first_name }} {{ employee.last_name }}</div>
                                        <div class="small text-muted">{{ employee.employment_type|capitalize|default('Permanent') }}</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="small"><i class="fas fa-envelope me-1 text-muted"></i> {{ employee.email|default('N/A') }}</div>
                                <div class="small"><i class="fas fa-phone me-1 text-muted"></i> {{ employee.phone|default('N/A') }}</div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">{{ employee.department_name|default('General') }}</div>
                                <div class="small text-muted">{{ employee.position_name|default('Operator') }}</div>
                            </td>
                            <td>
                                <span class="badge bg-{{ employee.status == 'active' ? 'success' : 'secondary' }} rounded-pill px-3">{{ employee.status|capitalize }}</span>
                            </td>
                            <td><small class="text-muted">{{ employee.hire_date }}</small></td>
                            <td>
                                <div class="btn-group">
                                    <a href="{{ BASE_URL }}/hr/employees/{{ employee.employee_id }}" class="btn btn-sm btn-outline-info rounded-circle me-1" title="View Profile"><i class="fas fa-eye"></i></a>
                                    <a href="{{ BASE_URL }}/hr/employees/{{ employee.employee_id }}/edit" class="btn btn-sm btn-outline-warning rounded-circle" title="Edit"><i class="fas fa-edit"></i></a>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fas fa-users fa-2x mb-2 text-primary opacity-50"></i><br>
                                No employee records found matching query.
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
