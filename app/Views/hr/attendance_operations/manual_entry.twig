{% extends "layouts/app.twig" %}

{% block title %}Manual Attendance Entry | HR Module{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);">
        <div>
            <span class="badge bg-white text-purple mb-2 font-monospace" style="color: #7c3aed;"><i class="fas fa-fingerprint me-1"></i> TIME CARD ADJUSTMENT</span>
            <h2 class="mb-1 font-weight-bold">Manual Attendance Entry</h2>
            <p class="mb-0 opacity-75">Log missed punch cards, gate pass adjustments, or manual single employee time-in/out overrides.</p>
        </div>
    </div>

    {% if flash_success %}
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4">
            <i class="fas fa-check-circle me-1"></i> {{ flash_success }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endif %}

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 fw-bold" style="color: #7c3aed;"><i class="fas fa-user-clock me-2"></i>Manual Punch Override Form</h5>
        </div>
        <div class="card-body p-4">
            <form action="{{ BASE_URL }}/hr/attendance/manual-entry" method="POST">
                {{ csrf_field() | raw }}
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Select Employee *</label>
                        <select name="employee_id" class="form-select form-select-lg border-purple" required>
                            <option value="">Select Employee</option>
                            {% for emp in employees %}
                                <option value="{{ emp.employee_id }}">{{ emp.first_name }} {{ emp.last_name }} ({{ emp.employee_code }})</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Attendance Date *</label>
                        <input type="date" name="date" class="form-control form-control-lg" value="{{ 'now'|date('Y-m-d') }}" required>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Check In Time *</label>
                        <input type="time" name="check_in" class="form-control" required>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Check Out Time</label>
                        <input type="time" name="check_out" class="form-control">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Status *</label>
                        <select name="status" class="form-select fw-bold" required>
                            <option value="Present">Present</option>
                            <option value="Late">Late</option>
                            <option value="Absent">Absent</option>
                            <option value="Leave">Leave</option>
                        </select>
                    </div>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn text-white rounded-pill px-4 font-weight-bold" style="background-color: #7c3aed;"><i class="fas fa-save me-1"></i> Save Manual Punch</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
