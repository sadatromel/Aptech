{% extends "layouts/app.twig" %}

{% block title %}Date Attendance Transfer | HR Module{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #0d9488 0%, #059669 100%);">
        <div>
            <span class="badge bg-white text-teal mb-2 font-monospace" style="color: #0d9488;"><i class="fas fa-exchange-alt me-1"></i> PUNCH LOG ROTATION</span>
            <h2 class="mb-1 font-weight-bold">Date Attendance Transfer</h2>
            <p class="mb-0 opacity-75">Copy or transfer time card punches from one date or shift to another date during shift rotations or emergency makeup working days.</p>
        </div>
    </div>

    {% if flash_success %}
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4">
            <i class="fas fa-check-circle me-1"></i> {{ flash_success }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endif %}

    <div class="row">
        <div class="col-lg-5 mb-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 text-teal fw-bold" style="color: #0d9488;"><i class="fas fa-random me-2"></i>Transfer Punch Log</h5>
                </div>
                <div class="card-body p-4">
                    <form action="{{ BASE_URL }}/hr/attendance/date-transfer" method="POST">
                        {{ csrf_field() | raw }}
                        <div class="mb-3">
                            <label class="form-label fw-bold">Source Date (Original Punch Date) *</label>
                            <input type="date" name="source_date" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Target Date (Destination Date) *</label>
                            <input type="date" name="target_date" class="form-control" required>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Target Department (Optional)</label>
                            <select name="department_id" class="form-select">
                                <option value="">All Factory Departments</option>
                                {% for dept in departments %}
                                    <option value="{{ dept.department_id }}">{{ dept.department_name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <button type="submit" class="btn text-white rounded-pill w-100 fw-bold py-2" style="background-color: #0d9488;"><i class="fas fa-play me-1"></i> Execute Transfer</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7 mb-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 text-teal fw-bold" style="color: #0d9488;"><i class="fas fa-history me-2"></i>Recent Transfer Logs</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Source Date</th>
                                    <th>Target Date</th>
                                    <th>Department</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in history %}
                                <tr>
                                    <td><span class="badge bg-light text-dark border font-monospace">{{ item.source_date }}</span></td>
                                    <td><span class="badge bg-light text-dark border font-monospace">{{ item.target_date }}</span></td>
                                    <td><span class="fw-semibold text-dark">{{ item.department_name|default('All Departments') }}</span></td>
                                    <td><span class="badge bg-success rounded-pill px-3">{{ item.status|capitalize }}</span></td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No attendance transfer logs found.</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
