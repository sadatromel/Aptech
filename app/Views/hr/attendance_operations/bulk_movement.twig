{% extends "layouts/app.twig" %}

{% block title %}Bulk Movement Entry | HR Module{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);">
        <div>
            <span class="badge bg-white text-indigo mb-2 font-monospace" style="color: #4f46e5;"><i class="fas fa-walking me-1"></i> FIELD DUTY & PASSES</span>
            <h2 class="mb-1 font-weight-bold">Bulk Movement Entry</h2>
            <p class="mb-0 opacity-75">Log outdoor duty passes, factory site visits, or buyer meeting movements for multiple workers at once.</p>
        </div>
        <div>
            <a href="{{ BASE_URL }}/hr/attendance/movement-register" class="btn btn-light rounded-pill px-4 font-weight-bold text-primary shadow-sm"><i class="fas fa-list me-1"></i> Movement Register</a>
        </div>
    </div>

    {% if flash_success %}
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4">
            <i class="fas fa-check-circle me-1"></i> {{ flash_success }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endif %}

    <!-- Top KPI Row -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-indigo" style="border-color: #4f46e5 !important;">
                <div class="small text-muted font-weight-bold text-uppercase">Today's Field Movements</div>
                <div class="h3 font-weight-bold text-indigo my-1" style="color: #4f46e5;">24 Workers</div>
                <div class="small text-muted"><i class="fas fa-building me-1"></i> Buyer & Site Visits</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-success">
                <div class="small text-muted font-weight-bold text-uppercase">Approved Passes</div>
                <div class="h3 font-weight-bold text-success my-1">100% Verified</div>
                <div class="small text-success"><i class="fas fa-check-double me-1"></i> HR Sanctioned</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-info">
                <div class="small text-muted font-weight-bold text-uppercase">Active Workers</div>
                <div class="h3 font-weight-bold text-info my-1">{{ employees|length }} Available</div>
                <div class="small text-muted"><i class="fas fa-users me-1"></i> Registered Staff</div>
            </div>
        </div>
    </div>

    <!-- Form Container -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 fw-bold" style="color: #4f46e5;"><i class="fas fa-edit me-2"></i>New Outdoor Movement Form</h5>
        </div>
        <div class="card-body p-4">
            <form action="{{ BASE_URL }}/hr/attendance/movement-bulk" method="POST">
                {{ csrf_field() | raw }}
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Movement Date *</label>
                        <input type="date" name="movement_date" class="form-control" value="{{ 'now'|date('Y-m-d') }}" required>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Out Time (Departure) *</label>
                        <input type="time" name="start_time" class="form-control" required>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Return Time (Expected)</label>
                        <input type="time" name="end_time" class="form-control">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Destination / Location *</label>
                        <input type="text" name="destination" class="form-control" placeholder="e.g., EPZ Factory Site / BGMEA Complex" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Purpose *</label>
                        <input type="text" name="purpose" class="form-control" placeholder="e.g., Buyer Inspection / Fabric Sample Delivery" required>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Select Workers (Hold Ctrl for Multiple) *</label>
                    <select name="employee_ids[]" class="form-select border-indigo" multiple size="6" required>
                        {% for emp in employees %}
                            <option value="{{ emp.employee_id }}">{{ emp.first_name }} {{ emp.last_name }} ({{ emp.employee_code }})</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn text-white rounded-pill px-4 font-weight-bold" style="background-color: #4f46e5;"><i class="fas fa-save me-1"></i> Save Bulk Movement</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
