{% extends "layouts/app.twig" %}

{% block title %}Define Holiday | HR Module{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #059669 0%, #10b981 100%);">
        <div>
            <span class="badge bg-white text-success mb-2 font-monospace"><i class="fas fa-calendar-plus me-1"></i> STATUTORY & FACTORY HOLIDAYS</span>
            <h2 class="mb-1 font-weight-bold">Define Factory Holiday</h2>
            <p class="mb-0 opacity-75">Declare government gazetted holidays, Eid/Puja festival vacations, or special factory shut-down days.</p>
        </div>
        <div>
            <a href="{{ BASE_URL }}/hr/attendance/holiday-remove" class="btn btn-light rounded-pill px-4 font-weight-bold text-success shadow-sm"><i class="fas fa-calendar-minus me-1"></i> Revoke Holiday</a>
        </div>
    </div>

    {% if flash_success %}
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4">
            <i class="fas fa-check-circle me-1"></i> {{ flash_success }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endif %}

    <div class="row">
        <div class="col-lg-5 mb-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 text-success fw-bold"><i class="fas fa-plus-circle me-2"></i>Add Holiday Declaration</h5>
                </div>
                <div class="card-body p-4">
                    <form action="{{ BASE_URL }}/hr/attendance/define-holiday" method="POST">
                        {{ csrf_field() | raw }}
                        <div class="mb-3">
                            <label class="form-label fw-bold">Holiday Title / Name *</label>
                            <input type="text" name="holiday_title" class="form-control" placeholder="e.g., Holy Eid-ul-Fitr / Victory Day" required>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Start Date *</label>
                                <input type="date" name="start_date" class="form-control" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">End Date *</label>
                                <input type="date" name="end_date" class="form-control" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Holiday Category *</label>
                            <select name="holiday_type" class="form-select border-success fw-bold" required>
                                <option value="festival">🎉 Festival / Religious Vacation</option>
                                <option value="government">🏛️ Government Public Holiday</option>
                                <option value="company_declared">🏭 Company Special Shutdown</option>
                            </select>
                        </div>
                        <div class="form-check mb-3">
                            <input type="checkbox" name="is_recurring" value="1" class="form-check-input" id="is_recurring">
                            <label class="form-check-label fw-bold" for="is_recurring">Annual Recurring Holiday</label>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Remarks / Notice</label>
                            <input type="text" name="remarks" class="form-control" placeholder="Brief holiday description...">
                        </div>
                        <button type="submit" class="btn btn-success text-white rounded-pill w-100 fw-bold py-2"><i class="fas fa-save me-1"></i> Save Holiday Declaration</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7 mb-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 text-success fw-bold"><i class="fas fa-calendar-alt me-2"></i>Active Holiday Calendar</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Title</th>
                                    <th>Dates</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for h in holidays %}
                                <tr>
                                    <td><span class="fw-bold text-dark">{{ h.holiday_title }}</span></td>
                                    <td>
                                        <small class="fw-semibold text-dark">{{ h.start_date|date("M j, Y") }}</small>
                                        <small class="text-muted">to {{ h.end_date|date("M j, Y") }}</small>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">{{ h.holiday_type|capitalize }}</span></td>
                                    <td><span class="badge bg-success rounded-pill px-3">{{ h.status|capitalize }}</span></td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No active holidays declared.</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
