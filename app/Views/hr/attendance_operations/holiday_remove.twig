{% extends "layouts/app.twig" %}

{% block title %}Holiday Remove | HR Module{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #be123c 0%, #fb7185 100%);">
        <div>
            <span class="badge bg-white text-danger mb-2 font-monospace" style="color: #be123c;"><i class="fas fa-calendar-times me-1"></i> HOLIDAY REVOCATION</span>
            <h2 class="mb-1 font-weight-bold">Holiday Remove / Revoke</h2>
            <p class="mb-0 opacity-75">Revoke or remove declared factory holidays when emergency working shifts are called for buyer production deadlines.</p>
        </div>
        <div>
            <a href="{{ BASE_URL }}/hr/attendance/define-holiday" class="btn btn-light rounded-pill px-4 font-weight-bold text-danger shadow-sm" style="color: #be123c;"><i class="fas fa-calendar-plus me-1"></i> Define Holiday</a>
        </div>
    </div>

    {% if flash_success %}
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4">
            <i class="fas fa-check-circle me-1"></i> {{ flash_success }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endif %}

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 text-danger fw-bold"><i class="fas fa-ban me-2"></i>Active Declared Holidays</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Holiday Title</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for h in holidays %}
                        <tr>
                            <td><span class="fw-bold text-dark">{{ h.holiday_title }}</span></td>
                            <td><small class="fw-semibold text-dark">{{ h.start_date|date("M j, Y") }}</small></td>
                            <td><small class="fw-semibold text-dark">{{ h.end_date|date("M j, Y") }}</small></td>
                            <td><span class="badge bg-light text-dark border">{{ h.holiday_type|capitalize }}</span></td>
                            <td>
                                <span class="badge bg-{{ h.status == 'active' ? 'success' : 'secondary' }} rounded-pill px-3">{{ h.status|capitalize }}</span>
                            </td>
                            <td>
                                {% if h.status == 'active' %}
                                    <form action="{{ BASE_URL }}/hr/attendance/holiday-remove" method="POST" onsubmit="return confirm('Revoke this declared holiday? Workers will be scheduled for regular shifts.');">
                                        {{ csrf_field() | raw }}
                                        <input type="hidden" name="holiday_id" value="{{ h.holiday_id }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold"><i class="fas fa-times me-1"></i> Revoke Holiday</button>
                                    </form>
                                {% else %}
                                    <span class="text-muted small">Revoked</span>
                                {% endif %}
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No declared holidays found.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
