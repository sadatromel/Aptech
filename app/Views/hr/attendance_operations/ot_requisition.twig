{% extends "layouts/app.twig" %}

{% block title %}OT Requisition | HR Module{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #b45309 0%, #d97706 100%);">
        <div>
            <span class="badge bg-white text-warning mb-2 font-monospace" style="color: #b45309;"><i class="fas fa-clock me-1"></i> OVERTIME APPROVAL WORKFLOW</span>
            <h2 class="mb-1 font-weight-bold">Overtime (OT) Requisition</h2>
            <p class="mb-0 opacity-75">Pre-approval workflow for department line extra OT hours prior to shift extension under BLA 2006 compliance.</p>
        </div>
    </div>

    {% if flash_success %}
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4">
            <i class="fas fa-check-circle me-1"></i> {{ flash_success }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endif %}

    <div class="row">
        <div class="col-lg-5 mb-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 text-warning fw-bold" style="color: #b45309;"><i class="fas fa-plus-circle me-2"></i>New OT Pre-Approval Requisition</h5>
                </div>
                <div class="card-body p-4">
                    <form action="{{ BASE_URL }}/hr/attendance/ot-requisition" method="POST">
                        {{ csrf_field() | raw }}
                        <div class="mb-3">
                            <label class="form-label fw-bold">Department / Line *</label>
                            <select name="department_id" class="form-select border-warning" required>
                                <option value="">Select Line / Department</option>
                                {% for dept in departments %}
                                    <option value="{{ dept.department_id }}">{{ dept.department_name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Requisition Date *</label>
                            <input type="date" name="requisition_date" class="form-control" value="{{ 'now'|date('Y-m-d') }}" required>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">OT Hours Required *</label>
                                <input type="number" step="0.5" min="0.5" max="4" name="requested_ot_hours" class="form-control" placeholder="e.g., 2.0" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Worker Count *</label>
                                <input type="number" min="1" name="worker_count" class="form-control" placeholder="e.g., 45" required>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Reason for Overtime *</label>
                            <input type="text" name="reason" class="form-control" placeholder="e.g., Shipment Target Urgency for Buyer Shipment #8820" required>
                        </div>
                        <button type="submit" class="btn text-white rounded-pill w-100 fw-bold py-2" style="background-color: #b45309;"><i class="fas fa-paper-plane me-1"></i> Submit OT Requisition</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7 mb-4">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 text-warning fw-bold" style="color: #b45309;"><i class="fas fa-list me-2"></i>Approved OT Requisitions</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Department</th>
                                    <th>OT Hours</th>
                                    <th>Workers</th>
                                    <th>Reason</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for r in requisitions %}
                                <tr>
                                    <td><span class="badge bg-light text-dark border font-monospace">{{ r.requisition_date }}</span></td>
                                    <td><span class="fw-bold text-dark">{{ r.department_name }}</span></td>
                                    <td><span class="badge bg-warning text-dark font-monospace fw-bold">{{ r.requested_ot_hours }} Hrs</span></td>
                                    <td><span class="badge bg-light text-dark border">{{ r.worker_count }} Staff</span></td>
                                    <td><small class="text-muted">{{ r.reason }}</small></td>
                                    <td><span class="badge bg-success rounded-pill px-3">{{ r.status|capitalize }}</span></td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No overtime requisitions logged.</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
