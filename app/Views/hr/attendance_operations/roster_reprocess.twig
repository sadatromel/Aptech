{% extends "layouts/app.twig" %}

{% block title %}Duty Roster Re-process | HR Module{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4 p-4 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #d97706 0%, #b45309 100%);">
        <div>
            <span class="badge bg-white text-warning mb-2 font-monospace" style="color: #b45309;"><i class="fas fa-sync-alt me-1"></i> SHIFT RE-CALCULATION</span>
            <h2 class="mb-1 font-weight-bold">Duty Roster Re-process</h2>
            <p class="mb-0 opacity-75">Re-calculate shift assignments, late marks, and in/out punch tolerances after roster modifications or shift schedule revisions.</p>
        </div>
    </div>

    {% if flash_success %}
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4">
            <i class="fas fa-check-circle me-1"></i> {{ flash_success }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endif %}

    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 text-warning fw-bold" style="color: #b45309;"><i class="fas fa-calculator me-2"></i>Shift Roster Re-process Parameters</h5>
        </div>
        <div class="card-body p-4">
            <form action="{{ BASE_URL }}/hr/attendance/roster-reprocess" method="POST">
                {{ csrf_field() | raw }}
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Select Roster Month *</label>
                        <input type="month" name="year_month" class="form-control form-control-lg border-warning fw-bold" value="{{ 'now'|date('Y-m') }}" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Target Department (Optional)</label>
                        <select name="department_id" class="form-select form-select-lg">
                            <option value="">All Production Lines & Departments</option>
                            {% for dept in departments %}
                                <option value="{{ dept.department_id }}">{{ dept.department_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="alert alert-warning py-3 mb-4">
                    <i class="fas fa-exclamation-triangle me-1"></i> Running duty roster re-processing will refresh punch time logs, grace period late statuses, and shift overtime for all workers in the selected month.
                </div>

                <div class="text-end">
                    <button type="submit" class="btn text-white rounded-pill px-4 font-weight-bold" style="background-color: #d97706;"><i class="fas fa-play me-1"></i> Start Roster Re-process</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
