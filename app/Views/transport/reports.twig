{% extends "layouts/app.twig" %}

{% block title %}Transport Reports Hub{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-1 font-weight-bold text-gray-800">
                <i class="fas fa-truck text-warning me-2"></i>Transport & Vehicle Reports Center
            </h2>
            <p class="text-muted small mb-0">Vehicle Fleet Status, Fuel & Maintenance, Requisitions & Employee Seat Allotments</p>
        </div>
        <a href="{{ BASE_URL }}/vehicles" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Transport Module
        </a>
    </div>

    <div class="row">
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-warning text-white rounded-circle p-3 me-3">
                            <i class="fas fa-list fa-lg"></i>
                        </div>
                        <div>
                            <h5 class="card-title h6 mb-1 font-weight-bold">Fleet Register & Status</h5>
                            <span class="badge bg-light text-warning">Vehicles</span>
                        </div>
                    </div>
                    <p class="card-text small text-muted">Complete listing of company vehicles, registration, driver assignments, and fitness dates.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <a href="{{ BASE_URL }}/vehicles" class="btn btn-sm btn-outline-warning w-100">Open Fleet Report</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-danger text-white rounded-circle p-3 me-3">
                            <i class="fas fa-tools fa-lg"></i>
                        </div>
                        <div>
                            <h5 class="card-title h6 mb-1 font-weight-bold">Maintenance & Parts Usage</h5>
                            <span class="badge bg-light text-danger">Maintenance</span>
                        </div>
                    </div>
                    <p class="card-text small text-muted">Vehicle servicing history, repair costs, spare parts inventory consumption, and breakdown logs.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <a href="{{ BASE_URL }}/transport/maintenance" class="btn btn-sm btn-outline-danger w-100">Open Maintenance Report</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary text-white rounded-circle p-3 me-3">
                            <i class="fas fa-chair fa-lg"></i>
                        </div>
                        <div>
                            <h5 class="card-title h6 mb-1 font-weight-bold">Employee Seat Allotment</h5>
                            <span class="badge bg-light text-primary">Routes</span>
                        </div>
                    </div>
                    <p class="card-text small text-muted">Route-wise staff bus allocation, seat capacity utilization, and pickup point registry.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <a href="{{ BASE_URL }}/employee_seat_allotment" class="btn btn-sm btn-outline-primary w-100">Open Seat Allotment Report</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
