{% extends "layouts/app.twig" %}

{% block title %}Routes & Scheduling{% endblock %}

{% block content %}
<div class="row mb-4">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="text-white"><i class="fas fa-route me-2"></i>Routes & Scheduling</h2>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addRouteModal">
                <i class="fas fa-plus me-1"></i> Add New Route
            </button>
        </div>
    </div>
</div>

<div class="card bg-dark text-white border-0 shadow-sm">
    <div class="card-header bg-dark border-secondary">
        <h5 class="mb-0 text-primary">Route List</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle" id="routesTable">
                <thead>
                    <tr>
                        <th>Route Name</th>
                        <th>Vehicle</th>
                        <th>From</th>
                        <th>To</th>
                        <th>Distance</th>
                        <th>Est. Time</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for route in routes %}
                    <tr>
                        <td class="fw-bold">{{ route.route_name }}</td>
                        <td>
                            {% if route.vehicle_number %}
                                <div>{{ route.vehicle_number }}</div>
                                <small class="text-muted">{{ route.registration_number }}</small>
                            {% else %}
                                <span class="badge bg-secondary">Unassigned</span>
                            {% endif %}
                        </td>
                        <td><i class="fas fa-map-marker-alt text-success me-1"></i> {{ route.start_location }}</td>
                        <td><i class="fas fa-map-marker-alt text-danger me-1"></i> {{ route.end_location }}</td>
                        <td>{{ route.distance }} km</td>
                        <td>{{ route.duration }}</td>
                        <td>
                            {% if route.status == 'active' %}
                                <span class="badge bg-success rounded-pill"><i class="fas fa-check-circle me-1"></i>Active</span>
                            {% else %}
                                <span class="badge bg-danger rounded-pill"><i class="fas fa-times-circle me-1"></i>Inactive</span>
                            {% endif %}
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-info edit-route-btn" 
                                data-id="{{ route.route_id }}"
                                data-name="{{ route.route_name }}"
                                data-vehicle="{{ route.vehicle_id }}"
                                data-start="{{ route.start_location }}"
                                data-end="{{ route.end_location }}"
                                data-distance="{{ route.distance }}"
                                data-duration="{{ route.duration }}"
                                data-status="{{ route.status }}"
                                data-bs-toggle="modal" data-bs-target="#editRouteModal">
                                <i class="fas fa-edit"></i>
                            </button>
                            <form action="?page=vehicle_routes&action=delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this route?');">
    {{ csrf_field() | raw }}
                                <input type="hidden" name="id" value="{{ route.route_id }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No routes found.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Route Modal -->
<div class="modal fade" id="addRouteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">Add New Route</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="?page=vehicle_routes&action=create" method="POST">
    {{ csrf_field() | raw }}
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Route Name</label>
                        <input type="text" name="route_name" class="form-control bg-dark text-white border-secondary" placeholder="Enter route name" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Vehicle</label>
                        <select name="vehicle_id" class="form-select bg-dark text-white border-secondary">
                            <option value="">Select Vehicle</option>
                            {% for vehicle in vehicles %}
                                <option value="{{ vehicle.vehicle_id }}">{{ vehicle.registration_number }} - {{ vehicle.make }} {{ vehicle.model }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">From Location</label>
                        <input type="text" name="start_location" class="form-control bg-dark text-white border-secondary" placeholder="Start location" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">To Location</label>
                        <input type="text" name="end_location" class="form-control bg-dark text-white border-secondary" placeholder="End location" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Distance (km)</label>
                        <input type="number" step="0.01" name="distance" class="form-control bg-dark text-white border-secondary" placeholder="0.00">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Estimated Time</label>
                        <input type="text" name="duration" class="form-control bg-dark text-white border-secondary" placeholder="e.g. 2 hours 30 minutes">
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Route</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Route Modal -->
<div class="modal fade" id="editRouteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">Edit Route</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editRouteForm" action="" method="POST">
    {{ csrf_field() | raw }}
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Route Name</label>
                        <input type="text" id="edit_route_name" name="route_name" class="form-control bg-dark text-white border-secondary" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Vehicle</label>
                        <select id="edit_vehicle_id" name="vehicle_id" class="form-select bg-dark text-white border-secondary">
                            <option value="">Select Vehicle</option>
                            {% for vehicle in vehicles %}
                                <option value="{{ vehicle.vehicle_id }}">{{ vehicle.registration_number }} - {{ vehicle.make }} {{ vehicle.model }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">From Location</label>
                        <input type="text" id="edit_start_location" name="start_location" class="form-control bg-dark text-white border-secondary" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">To Location</label>
                        <input type="text" id="edit_end_location" name="end_location" class="form-control bg-dark text-white border-secondary" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Distance (km)</label>
                        <input type="number" step="0.01" id="edit_distance" name="distance" class="form-control bg-dark text-white border-secondary">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Estimated Time</label>
                        <input type="text" id="edit_duration" name="duration" class="form-control bg-dark text-white border-secondary">
                    </div>
                     <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select id="edit_status" name="status" class="form-select bg-dark text-white border-secondary">
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Route</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const editBtns = document.querySelectorAll('.edit-route-btn');
    const editForm = document.getElementById('editRouteForm');
    
    editBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            const id = this.getAttribute('data-id');
            const name = this.getAttribute('data-name');
            const vehicle = this.getAttribute('data-vehicle');
            const start = this.getAttribute('data-start');
            const end = this.getAttribute('data-end');
            const distance = this.getAttribute('data-distance');
            const duration = this.getAttribute('data-duration');
            const status = this.getAttribute('data-status');
            
            editForm.action = '?page=vehicle_routes&action=edit&id=' + id;
            document.getElementById('edit_route_name').value = name;
            document.getElementById('edit_vehicle_id').value = vehicle;
            document.getElementById('edit_start_location').value = start;
            document.getElementById('edit_end_location').value = end;
            document.getElementById('edit_distance').value = distance;
            document.getElementById('edit_duration').value = duration;
            document.getElementById('edit_status').value = status;
        });
    });
});
</script>
{% endblock %}
