{% extends "layouts/app.twig" %}

{% block title %}Vehicle Maintenance - Transport{% endblock %}

{% block content %}
<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Vehicle Maintenance</h1>
</div>

<div class="alert alert-info">
    <i class="fas fa-tools"></i> This module is currently under development.
</div>

<div class="card">
    <div class="card-body text-center py-5">
        <i class="fas fa-wrench fa-4x text-muted mb-3"></i>
        <h3>Maintenance Logs</h3>
        <p class="text-muted">Track vehicle repairs and maintenance schedules.</p>
        <button class="btn btn-primary mt-2">
            <i class="fas fa-plus"></i> Log Maintenance (Coming Soon)
        </button>
    </div>
</div>
{% endblock %}
