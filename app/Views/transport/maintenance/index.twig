{% extends 'layouts/app.twig' %}

{% block title %}Vehicle Management • Maintenance{% endblock %}

{% block content %}
<div class="container-fluid vehicle-maintenance">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1"><i class="fas fa-tools me-2"></i>Repair and Maintenance Tracking</h1>
            <p class="text-muted mb-0">Track and manage vehicle maintenance records</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ app_base_url }}/dashboard.php" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
            </a>
        </div>
    </div>

    {% if message %}
        {% if message starts with 'Error' %}
            <div class="alert alert-danger alert-dismissible fade show">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% else %}
            <div class="alert alert-success alert-dismissible fade show">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endif %}
    {% endif %}

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">Add Maintenance Record</h5>
            <form method="POST" action="?page=vehicle_management/maintenance&action=store">
    {{ csrf_field() | raw }}
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Vehicle</label>
                        <select name="vehicle_id" class="form-select" required>
                            <option value="">Select Vehicle</option>
                            {% for v in vehicles %}
                                <option value="{{ v.vehicle_id }}">{{ v.registration_number }} - {{ v.vehicle_name }}</option>
                            {% else %}
                                <option value="" disabled>No vehicles available. Please add vehicles first.</option>
                            {% endfor %}
                        </select>
                        {% if vehicles is empty %}
                            <p class="text-danger small mt-1">No active vehicles found. Please add vehicles in the Vehicles section first.</p>
                        {% endif %}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Maintenance Type</label>
                        <select name="maintenance_type" class="form-select" required>
                            <option value="">Select Type</option>
                            <option value="Oil Change">Oil Change</option>
                            <option value="Filter Replacement">Filter Replacement</option>
                            <option value="Brake Service">Brake Service</option>
                            <option value="Tire Replacement">Tire Replacement</option>
                            <option value="Engine Checkup">Engine Checkup</option>
                            <option value="Battery Replacement">Battery Replacement</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea name="description" class="form-control" rows="2" required></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Scheduled Date</label>
                        <input type="date" name="scheduled_date" class="form-control" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Cost (Rs.)</label>
                        <input type="number" name="cost" class="form-control" step="0.01" required>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Notes</label>
                        <textarea name="notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <button type="submit" name="add_maintenance" class="btn btn-primary mt-3">
                    <i class="fas fa-plus me-1"></i>Add Maintenance
                </button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title mb-3">Repair and Maintenance Records</h5>
            
            <!-- Search and Filter -->
            <div class="filter-section bg-body-secondary p-3 rounded mb-3">
                <form method="GET" action="?page=vehicle_management/maintenance">
                    <input type="hidden" name="page" value="vehicle_management/maintenance">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Search</label>
                            <input type="text" name="search" class="form-control" placeholder="Search by type, description, or vehicle..." value="{{ filters.search }}">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Status</label>
                            <select name="status" class="form-select">
                                <option value="">All Status</option>
                                <option value="scheduled" {{ filters.status == 'scheduled' ? 'selected' }}>Scheduled</option>
                                <option value="in_progress" {{ filters.status == 'in_progress' ? 'selected' }}>In Progress</option>
                                <option value="completed" {{ filters.status == 'completed' ? 'selected' }}>Completed</option>
                                <option value="overdue" {{ filters.status == 'overdue' ? 'selected' }}>Overdue</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">From Date</label>
                            <input type="date" name="date_from" class="form-control" value="{{ filters.date_from }}">
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">To Date</label>
                            <input type="date" name="date_to" class="form-control" value="{{ filters.date_to }}">
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-search me-1"></i>Filter
                            </button>
                            <a href="?page=vehicle_management/maintenance" class="btn btn-secondary ms-2">
                                <i class="fas fa-times me-1"></i>Clear
                            </a>
                        </div>
                    </div>
                </form>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Vehicle</th>
                            <th>Type</th>
                            <th>Description</th>
                            <th>Scheduled Date</th>
                            <th>Cost</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for m in maintenance %}
                            <tr>
                                <td>{{ m.registration_number }}</td>
                                <td>{{ m.maintenance_type }}</td>
                                <td>
                                    {{ m.description|length > 50 ? m.description|slice(0, 50) ~ '...' : m.description }}
                                </td>
                                <td>{{ m.scheduled_date|date('M d, Y') }}</td>
                                <td>Rs. {{ m.cost|number_format(2) }}</td>
                                <td>
                                    {% set statusClass = {
                                        'scheduled': 'secondary',
                                        'in_progress': 'info',
                                        'completed': 'success',
                                        'overdue': 'danger'
                                    } %}
                                    <span class="badge bg-{{ statusClass[m.status] ?? 'secondary' }}">
                                        {{ m.status|replace({'_': ' '})|title }}
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        {% if m.status != 'completed' and m.status != 'overdue' %}
                                            <form method="POST" action="?page=vehicle_management/maintenance&action=updateStatus" class="d-inline">
    {{ csrf_field() | raw }}
                                                <input type="hidden" name="maintenance_id" value="{{ m.maintenance_id }}">
                                                {% if m.status == 'scheduled' %}
                                                    <input type="hidden" name="new_status" value="in_progress">
                                                    <button type="submit" name="update_status" class="btn btn-info" title="Start Maintenance">
                                                        <i class="fas fa-play"></i> Start
                                                    </button>
                                                {% elseif m.status == 'in_progress' %}
                                                    <input type="hidden" name="new_status" value="completed">
                                                    <button type="submit" name="update_status" class="btn btn-success" 
                                                            onclick="return confirm('Are you sure you want to mark this maintenance as complete?')">
                                                        <i class="fas fa-check"></i> Complete
                                                    </button>
                                                {% endif %}
                                            </form>
                                        {% endif %}
                                        
                                        {% if m.status == 'scheduled' %}
                                            <form method="POST" action="?page=vehicle_management/maintenance&action=updateStatus" class="d-inline ms-1">
    {{ csrf_field() | raw }}
                                                <input type="hidden" name="maintenance_id" value="{{ m.maintenance_id }}">
                                                <input type="hidden" name="new_status" value="overdue">
                                                <button type="submit" name="update_status" class="btn btn-danger" 
                                                        onclick="return confirm('Are you sure you want to mark this maintenance as overdue?')">
                                                    <i class="fas fa-exclamation"></i> Mark Overdue
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    <i class="fas fa-wrench fa-2x mb-3 d-block"></i>
                                    {% if filters.search or filters.status or filters.date_from or filters.date_to %}
                                        No maintenance records found. Try adjusting your search criteria.
                                    {% else %}
                                        No maintenance records found. Add your first maintenance record to get started.
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<style>
    /* Dark mode fix for filter section */
    html.dark-theme .filter-section,
    body.dark-mode .filter-section {
        background-color: #1a1d2e !important;
        border: 1px solid #2d3748 !important;
    }
    
    html.dark-theme .filter-section .form-label,
    body.dark-mode .filter-section .form-label {
        color: #e5e7eb !important;
    }
    
    html.dark-theme .filter-section .form-control,
    html.dark-theme .filter-section .form-select,
    body.dark-mode .filter-section .form-control,
    body.dark-mode .filter-section .form-select {
        background-color: #0f1117 !important;
        border-color: #2d3748 !important;
        color: #f9fafb !important;
    }
    
    html.dark-theme .filter-section .form-control:focus,
    html.dark-theme .filter-section .form-select:focus,
    body.dark-mode .filter-section .form-control:focus,
    body.dark-mode .filter-section .form-select:focus {
        background-color: #0a0e1a !important;
        border-color: #60a5fa !important;
        color: #f9fafb !important;
    }
    
    html.dark-theme .filter-section .form-control::placeholder,
    body.dark-mode .filter-section .form-control::placeholder {
        color: #6b7280 !important;
    }
</style>
<script>
    // Auto-dismiss alerts after 5 seconds
    document.addEventListener('DOMContentLoaded', () => {
        const alerts = document.querySelectorAll('.alert-dismissible');
        alerts.forEach(alert => {
            setTimeout(() => {
                const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
                bsAlert.close();
            }, 5000);
        });
    });
</script>
{% endblock %}
