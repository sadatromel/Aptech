                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Purchase Order</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- View Modal -->
<div class="modal fade" id="poViewModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="poViewTitle">Purchase Order</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="poViewContent" class="placeholder-glow">
                    <div class="placeholder col-12 mb-2"></div>
                    <div class="placeholder col-10"></div>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block scripts %}
{{ parent() }}
<script>
    // ── Helper lists populated from Controller variables ──
    const rfqVendorsData = {{ rfqVendors|json_encode|raw }};
    const activeVendorsList = {{ vendors|json_encode|raw }};

    function openLogQuoteModal(rfqId, rfqNo) {
        document.getElementById('log_quote_rfq_id').value = rfqId;
        document.getElementById('log_quote_rfq_no').textContent = rfqNo;
        
        // Populate select list with invited vendors for this RFQ
        const select = document.getElementById('log_quote_vendor_id');
        select.innerHTML = '<option value="">— Select Quoting Vendor —</option>';
        
        const invited = rfqVendorsData.filter(rv => rv.rfq_id == rfqId);
        invited.forEach(rv => {
            select.innerHTML += `<option value="${rv.vendor_id}">${rv.vendor_name}</option>`;
        });
        
        // Fallback: If no vendors are linked to this RFQ yet, allow all vendors
        if (invited.length === 0) {
            activeVendorsList.forEach(v => {
                select.innerHTML += `<option value="${v.vendor_id}">${v.vendor_name}</option>`;
            });
        }

        const modal = new bootstrap.Modal(document.getElementById('logQuoteModal'));
        modal.show();
    }

    function openFinalizeModal(rfqId) {
        document.getElementById('finalize_rfq_id').value = rfqId;
        
        const select = document.getElementById('finalize_vendor_id');
        select.innerHTML = '<option value="">— Select Vendor Quote —</option>';
        
        // Show only vendors who submitted a quote
        const quoted = rfqVendorsData.filter(rv => rv.rfq_id == rfqId && Number(rv.quoted_price) > 0);
        quoted.forEach(rv => {
            select.innerHTML += `<option value="${rv.vendor_id}">${rv.vendor_name} ($${rv.quoted_price})</option>`;
        });
        
        if (quoted.length === 0) {
            select.innerHTML = '<option value="">No vendor price quotes submitted yet</option>';
        }

        const modal = new bootstrap.Modal(document.getElementById('finalizeRfqModal'));
        modal.show();
    }

    // ── PRESERVED ORIGINAL PO LOGIC ──
    (function() {
        const itemsData = {{ dropdowns.items|json_encode|raw }};
        const itemsContainer = document.getElementById('itemsContainer');
        const addItemBtn = document.getElementById('addItemBtn');
        const poForm = document.getElementById('poForm');
        const poModalEl = document.getElementById('poModal');
        const poModal = poModalEl ? bootstrap.Modal.getOrCreateInstance(poModalEl) : null;
        const poAlert = document.getElementById('poAlert');
        let itemIndex = 0;

        const currency = (value) => `$${Number(value || 0).toFixed(2)}`;

        function renderItemRow(index) {
            if (!itemsContainer) return;
            const group = document.createElement('div');
            group.className = 'item-row card card-body mb-2';
            group.dataset.index = index;
            group.innerHTML = `
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Item</label>
                        <select class="form-select" name="items[${index}][item_id]" required>
                            <option value="">Select item</option>
                            ${itemsData.map(item => `<option value="${item.item_id}" data-price="${item.unit_cost}" data-uom="${item.uom}">${item.item_name} (${item.uom})</option>`).join('')}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Quantity</label>
                        <input type="number" step="0.01" min="0" class="form-control" name="items[${index}][quantity]" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Unit Price</label>
                        <input type="number" step="0.01" min="0" class="form-control" name="items[${index}][unit_price]" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Line Total</label>
                        <div class="line-total">$0.00</div>
                    </div>
                    <div class="col-md-2 text-end">
                        <button type="button" class="btn btn-outline-danger btn-sm" data-remove-item>
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            `;
            itemsContainer.appendChild(group);
        }

        function updateLineTotals() {
            if (!itemsContainer) return;
            let total = 0;
            itemsContainer.querySelectorAll('.item-row').forEach(row => {
                const qty = parseFloat(row.querySelector('input[name$="[quantity]"]').value) || 0;
                const price = parseFloat(row.querySelector('input[name$="[unit_price]"]').value) || 0;
                const lineTotal = qty * price;
                row.querySelector('.line-total').textContent = currency(lineTotal);
                total += lineTotal;
            });
            const grandTotalEl = document.getElementById('grandTotal');
            if (grandTotalEl) grandTotalEl.textContent = currency(total);
        }

        addItemBtn?.addEventListener('click', () => {
            renderItemRow(itemIndex++);
        });

        itemsContainer?.addEventListener('change', (event) => {
            const select = event.target.closest('select[name^="items"]');
            if (select) {
                const option = select.options[select.selectedIndex];
                const row = select.closest('.item-row');
                const priceInput = row.querySelector('input[name$="[unit_price]"]');
                if (option && option.dataset.price && priceInput) {
                    priceInput.value = option.dataset.price;
                }
            }
            updateLineTotals();
        });

        itemsContainer?.addEventListener('input', updateLineTotals);

        itemsContainer?.addEventListener('click', (event) => {
            if (event.target.closest('[data-remove-item]')) {
                event.target.closest('.item-row')?.remove();
                updateLineTotals();
            }
        });

        poForm?.addEventListener('submit', async (event) => {
            event.preventDefault();
            if (!poAlert) return;
            poAlert.classList.add('d-none');
            const formData = new FormData(poForm);
            const payload = Object.fromEntries(formData.entries());
            payload.lines = [];
            itemsContainer.querySelectorAll('.item-row').forEach(row => {
                const select = row.querySelector('select');
                const qty = row.querySelector('input[name$="[quantity]"]').value;
                const price = row.querySelector('input[name$="[unit_price]"]').value;
                payload.lines.push({
                    item_id: select.value,
                    quantity: qty,
                    unit_price: price
                });
            });

            try {
                const response = await fetch('/procurement/purchase-orders', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await response.json();
                if (!response.ok) throw data;
                location.reload();
            } catch (error) {
                poAlert.className = 'alert alert-danger';
                poAlert.textContent = error?.message || 'Failed to create purchase order.';
                poAlert.classList.remove('d-none');
            }
        });

        document.querySelectorAll('[data-view-po]').forEach(btn => {
            btn.addEventListener('click', async () => {
                const poId = btn.dataset.poId;
                const modalEl = document.getElementById('poViewModal');
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                const content = document.getElementById('poViewContent');
                content.innerHTML = '<div class="text-center py-4 text-muted">Loading...</div>';
                modal.show();
                const response = await fetch(`/procurement/purchase-orders/${poId}`);
                const data = await response.json();
                if (data.data) {
                    const po = data.data;
                    document.getElementById('poViewTitle').textContent = `${po.po_number} \u2022 ${po.vendor_name}`;
                    content.innerHTML = `
                        <div class="mb-3">
                            <div class="fw-bold">Vendor</div>
                            <div>${po.vendor_name} (${po.vendor_code || 'N/A'})</div>
                        </div>
                        <div class="mb-3">
                            <div class="fw-bold">Dates</div>
                            <div>Order: ${po.po_date} • Required: ${po.required_date}</div>
                        </div>
                        <div class="mb-3">
                            <div class="fw-bold">Line Items</div>
                            <div class="table-responsive">
                                <table class="table table-sm">
                                    <thead><tr><th>Item</th><th>Qty</th><th>Price</th><th>Total</th></tr></thead>
                                    <tbody>
                                        ${po.lines.map(line => `
                                            <tr>
                                                <td>${line.item_name}</td>
                                                <td>${line.quantity_ordered} ${line.uom || ''}</td>
                                                <td>${currency(line.unit_price)}</td>
                                                <td>${currency(line.line_total)}</td>
                                            </tr>
                                        `).join('')}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    `;
                } else {
                    content.innerHTML = '<div class="text-danger">Unable to load purchase order.</div>';
                }
            });
        });

        document.querySelectorAll('[data-update-status]').forEach(btn => {
            btn.addEventListener('click', async () => {
                const poId = btn.dataset.poId;
                const status = btn.dataset.nextStatus;
                if (!confirm(`Mark PO #${poId} as ${status}?`)) return;
                const response = await fetch(`/procurement/purchase-orders/${poId}/status`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status })
                });
                if (response.ok) {
                    location.reload();
                } else {
                    alert('Failed to update status');
                }
            });
        });

        document.querySelectorAll('[data-delete-po]').forEach(btn => {
            btn.addEventListener('click', async () => {
                const poId = btn.dataset.poId;
                if (!confirm('Delete this purchase order?')) return;
                const response = await fetch(`/procurement/purchase-orders/${poId}`, { method: 'DELETE' });
                if (response.ok) {
                    location.reload();
                } else {
                    alert('Failed to delete purchase order.');
                }
            });
        });

        // initialize with one row
        renderItemRow(itemIndex++);
    })();
</script>
{% endblock %}
