{% extends "layouts/app.twig" %}

{% block title %}Purchase Orders{% endblock %}

{% block content %}
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Purchase Orders</h1>
        <div class="btn-toolbar mb-2 mb-md-0">
            <a href="{{ BASE_URL }}/procurement/pos/create" class="btn btn-sm btn-primary">
                <i class="fas fa-plus"></i> New PO
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>PO #</th>
                    <th>Date</th>
                    <th>Vendor</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for po in orders %}
                <tr>
                    <td>{{ po.po_number }}</td>
                    <td>{{ po.order_date }}</td>
                    <td>{{ po.vendor_name }}</td>
                    <td>{{ po.total_amount|number_format(2) }} {{ po.currency }}</td>
                    <td><span class="badge bg-secondary">{{ po.status|capitalize }}</span></td>
                    <td>
                        <a href="#" class="btn btn-sm btn-info">View</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
