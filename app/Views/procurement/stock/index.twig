{% extends 'layouts/app.twig' %}

{% block title %}Procurement • Stock{% endblock %}

{% block content %}
<div class="container-fluid procurement-stock">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Inventory & Stock</h1>
            <p class="text-muted mb-0">Monitor warehouse balances, spot low inventory, and log adjustments.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#adjustStockModal">
                <i class="fas fa-exchange-alt me-2"></i>Adjust Stock
            </button>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addStockModal">
                <i class="fas fa-plus me-2"></i>Add Stock
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <p class="label">Tracked Items</p>
                <h2>{{ stats.total_items }}</h2>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <p class="label">Total Quantity</p>
                <h2>{{ stats.total_quantity|number_format(0, '.', ',') }}</h2>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card accent">
                <p class="label">Inventory Value</p>
                <h2>${{ stats.total_value|number_format(2, '.', ',') }}</h2>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card warning">
                <p class="label">Low / Critical</p>
                <h2>{{ stats.low_stock }} / {{ stats.critical_stock }}</h2>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form class="row g-3" method="get" action="/procurement/stock">
                <div class="col-md-4">
                    <label class="form-label">Warehouse</label>
                    <select class="form-select" name="warehouse_id">
                        <option value="">All warehouses</option>
                        {% for warehouse in warehouses %}
                            <option value="{{ warehouse.warehouse_id }}" {{ filters.warehouse_id == warehouse.warehouse_id ? 'selected' }}>
                                {{ warehouse.warehouse_name }} ({{ warehouse.warehouse_code }})
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Stock Status</label>
                    <select class="form-select" name="status">
                        <option value="">All</option>
                        <option value="normal" {{ filters.status == 'normal' ? 'selected' }}>Normal</option>
                        <option value="low" {{ filters.status == 'low' ? 'selected' }}>Low</option>
                        <option value="critical" {{ filters.status == 'critical' ? 'selected' }}>Critical</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button class="btn btn-outline-primary" type="submit"><i class="fas fa-filter me-1"></i>Filter</button>
                    <a href="/procurement/stock" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Warehouse</th>
                            <th>Quantity</th>
                            <th>Value</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for stock in stockItems %}
                            <tr>
                                <td>
                                    <strong>{{ stock.item_name }}</strong>
                                    <div class="text-muted small">{{ stock.item_type }} • {{ stock.uom }}</div>
                                </td>
                                <td>
                                    {{ stock.warehouse_name }}
                                    <div class="text-muted small">{{ stock.warehouse_code }}</div>
                                </td>
                                <td>
                                    {{ stock.quantity_on_hand|number_format(2) }}
                                    <div class="progress-bar">
                                        {% set level = stock.reorder_level ?: 1 %}
                                        {% set percent = (stock.quantity_on_hand / level) * 100 %}
                                        <div class="progress-fill {{ stock.stock_status }}" style="width: {{ [percent, 100]|min }}%"></div>
                                    </div>
                                    <div class="text-muted small">Reorder level: {{ stock.reorder_level }}</div>
                                </td>
                                <td>${{ stock.total_value|number_format(2, '.', ',') }}</td>
                                <td>
                                    <span class="badge stock-{{ stock.stock_status }}">{{ stock.stock_status|title }}</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary" data-adjust-stock data-stock-id="{{ stock.stock_id }}" data-stock='{{ stock|json_encode|raw }}'>
                                            <i class="fas fa-exchange-alt"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" data-delete-stock data-stock-id="{{ stock.stock_id }}">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">No stock records found.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Stock Modal -->
<div class="modal fade" id="addStockModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addStockForm">
                <div class="modal-header">
                    <h5 class="modal-title">Add Stock</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="addStockAlert" class="alert d-none"></div>
                    <div class="mb-3">
                        <label class="form-label">Item</label>
                        <select class="form-select" name="item_id" required>
                            <option value="">Select item</option>
                            {% for item in items %}
                                <option value="{{ item.item_id }}">{{ item.item_name }} ({{ item.category }})</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Warehouse</label>
                        <select class="form-select" name="warehouse_id" required>
                            <option value="">Select warehouse</option>
                            {% for warehouse in warehouses %}
                                <option value="{{ warehouse.warehouse_id }}">{{ warehouse.warehouse_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Quantity</label>
                        <input type="number" step="0.01" min="0" class="form-control" name="quantity" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Adjust Stock Modal -->
<div class="modal fade" id="adjustStockModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="adjustStockForm">
                <input type="hidden" name="stock_id" id="adjustStockId">
                <div class="modal-header">
                    <h5 class="modal-title" id="adjustStockTitle">Adjust Stock</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="adjustStockAlert" class="alert d-none"></div>
                    <div class="mb-3">
                        <label class="form-label">Adjustment Type</label>
                        <select class="form-select" name="adjustment_type" required>
                            <option value="add">Add</option>
                            <option value="remove">Remove</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Quantity</label>
                        <input type="number" step="0.01" min="0" class="form-control" name="adjustment_quantity" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Reason</label>
                        <textarea class="form-control" name="adjustment_reason" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script>
    (function() {
        const addStockForm = document.getElementById('addStockForm');
        const addStockAlert = document.getElementById('addStockAlert');
        const adjustStockForm = document.getElementById('adjustStockForm');
        const adjustStockAlert = document.getElementById('adjustStockAlert');
        const adjustStockModalEl = document.getElementById('adjustStockModal');
        const adjustStockModal = adjustStockModalEl ? bootstrap.Modal.getOrCreateInstance(adjustStockModalEl) : null;

        const toJSON = (form) => {
            const formData = new FormData(form);
            return Object.fromEntries(formData.entries());
        };

        addStockForm?.addEventListener('submit', async (event) => {
            event.preventDefault();
            addStockAlert.classList.add('d-none');
            try {
                const response = await fetch('/procurement/stock', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(toJSON(addStockForm))
                });
                const data = await response.json();
                if (!response.ok) throw data;
                location.reload();
            } catch (error) {
                addStockAlert.className = 'alert alert-danger';
                addStockAlert.textContent = error?.message || 'Failed to add stock.';
                addStockAlert.classList.remove('d-none');
            }
        });

        document.querySelectorAll('[data-adjust-stock]').forEach(btn => {
            btn.addEventListener('click', () => {
                const stock = JSON.parse(btn.getAttribute('data-stock'));
                adjustStockForm.reset();
                adjustStockForm.stock_id.value = stock.stock_id;
                document.getElementById('adjustStockTitle').textContent = `Adjust ${stock.item_name}`;
                adjustStockModal?.show();
            });
        });

        adjustStockForm?.addEventListener('submit', async (event) => {
            event.preventDefault();
            adjustStockAlert.classList.add('d-none');
            const payload = toJSON(adjustStockForm);
            const stockId = payload.stock_id;
            try {
                const response = await fetch(`/procurement/stock/${stockId}/adjust`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await response.json();
                if (!response.ok) throw data;
                location.reload();
            } catch (error) {
                adjustStockAlert.className = 'alert alert-danger';
                adjustStockAlert.textContent = error?.message || 'Failed to adjust stock.';
                adjustStockAlert.classList.remove('d-none');
            }
        });

        document.querySelectorAll('[data-delete-stock]').forEach(btn => {
            btn.addEventListener('click', async () => {
                if (!confirm('Delete this stock record?')) return;
                const response = await fetch(`/procurement/stock/${btn.dataset.stockId}`, { method: 'DELETE' });
                if (response.ok) {
                    location.reload();
                } else {
                    alert('Failed to delete stock.');
                }
            });
        });
    })();
</script>
{% endblock %}
