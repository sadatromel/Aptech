{% extends "layouts/app.twig" %}

{% block title %}Register New User | RMG ERP{% endblock %}

{% block styles %}
<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #4e54c8, #8f94fb);
        --card-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.1);
        --input-bg: #f8f9fa;
        --input-border: #e9ecef;
        --input-focus-border: #8f94fb;
    }

    body[data-theme='dark'] {
        --input-bg: #2b3035;
        --input-border: #495057;
        --primary-gradient: linear-gradient(135deg, #373b8c, #4e54c8);
    }

    .register-card {
        border: none;
        border-radius: 1rem;
        box-shadow: var(--card-shadow);
        overflow: hidden;
        transition: transform 0.3s ease;
    }

    .register-header {
        background: var(--primary-gradient);
        color: white;
        padding: 2rem 1.5rem;
        position: relative;
        text-align: center;
    }

    .register-header h2 {
        font-weight: 700;
        margin-bottom: 0.5rem;
        font-size: 1.75rem;
    }

    .register-header p {
        opacity: 0.9;
        margin-bottom: 0;
        font-weight: 300;
        font-size: 0.95rem;
    }

    .register-icon-wrapper {
        width: 60px;
        height: 60px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        backdrop-filter: blur(5px);
    }

    .register-icon-wrapper i {
        font-size: 1.5rem;
    }

    .form-group-custom {
        position: relative;
        margin-bottom: 1.5rem;
    }

    .form-group-custom .input-group-text {
        background-color: transparent;
        border-right: none;
        color: #6c757d;
        border-color: var(--input-border);
    }

    .form-group-custom .form-control,
    .form-group-custom .form-select {
        background-color: var(--input-bg);
        border-left: none;
        border-color: var(--input-border);
        padding-top: 0.75rem;
        padding-bottom: 0.75rem;
        font-size: 0.95rem;
    }
    
    .form-group-custom .form-control:focus,
    .form-group-custom .form-select:focus {
        box-shadow: none;
        border-color: var(--input-focus-border);
        background-color: var(--input-bg);
    }
    
    .form-group-custom .form-control:focus + .input-group-text,
    .form-group-custom .form-control:focus ~ .input-group-text {
        border-color: var(--input-focus-border);
        color: var(--input-focus-border);
    }

    .btn-gradient {
        background: var(--primary-gradient);
        border: none;
        color: white;
        padding: 0.8rem 1.5rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
    }

    .btn-gradient:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(78, 84, 200, 0.4);
        color: white;
    }

    .password-toggle {
        cursor: pointer;
        z-index: 10;
        background: transparent;
        border: 1px solid var(--input-border);
        border-left: none;
        color: #6c757d;
    }
    
    .password-toggle:hover {
        color: #4e54c8;
    }

    /* Floating label overrides for input groups */
    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label,
    .form-floating > .form-select ~ label {
        opacity: 0.65;
        transform: scale(0.85) translateY(-0.5rem) translateX(0.15rem);
    }
</style>
<!-- SweetAlert2 CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            
            <nav aria-label="breadcrumb" class="mb-4 d-none d-md-block">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="{{ BASE_URL }}/admin/users" class="text-decoration-none">User Management</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Register User</li>
                </ol>
            </nav>

            <div class="card register-card">
                <div class="register-header">
                    <div class="register-icon-wrapper">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <h2>Create New Account</h2>
                    <p>Enter the user's details below to grant access to the ERP system.</p>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    <form action="{{ BASE_URL }}/admin/users/store" method="POST" id="registerUserForm" novalidate>
    {{ csrf_field() | raw }}
                        
                        <div class="row g-3">
                            <!-- Helper Text -->
                            <div class="col-12 mb-2">
                                <h6 class="text-uppercase text-muted fw-bold small ls-1">Personal Information</h6>
                                <hr class="mt-1 mb-3">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label text-muted small">First Name</label>
                                <div class="input-group form-group-custom">
                                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                                    <input type="text" class="form-control" name="first_name" placeholder="John" required>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label text-muted small">Last Name</label>
                                <div class="input-group form-group-custom">
                                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                                    <input type="text" class="form-control" name="last_name" placeholder="Doe" required>
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label text-muted small">Email Address</label>
                                <div class="input-group form-group-custom">
                                    <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                    <input type="email" class="form-control" name="email" placeholder="john.doe@company.com" required>
                                </div>
                            </div>

                            <div class="col-12 mt-4 mb-2">
                                <h6 class="text-uppercase text-muted fw-bold small ls-1">Security & Access</h6>
                                <hr class="mt-1 mb-3">
                            </div>

                            <div class="col-md-6 mr-3">
                                <label class="form-label text-muted small">Password</label>
                                <div class="input-group form-group-custom">
                                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                    <input type="password" class="form-control" name="password" id="passwordInput" placeholder="Minimum 6 characters" minlength="6" required>
                                    <button class="btn btn-outline-secondary password-toggle" type="button" onclick="togglePassword('passwordInput')">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <div class="form-text small mt-0 mb-3"><i class="fas fa-info-circle me-1"></i>Must be at least 6 characters long.</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label text-muted small">Role Assignment</label>
                                <div class="input-group form-group-custom">
                                    <span class="input-group-text"><i class="fas fa-user-shield"></i></span>
                                    <select class="form-select" name="role_id" required>
                                        <option value="" selected disabled>Select Role...</option>
                                        {% for role in roles %}
                                            <option value="{{ role.role_id }}">{{ role.role_name }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-5">
                            <button class="btn btn-gradient btn-lg" type="submit" id="submitBtn">
                                <span class="normal-state"><i class="fas fa-paper-plane me-2"></i>Create User Account</span>
                                <span class="loading-state d-none"><i class="fas fa-spinner fa-spin me-2"></i>Creating...</span>
                            </button>
                            <a href="{{ BASE_URL }}/admin/users" class="btn btn-light btn-sm text-muted mt-2">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<!-- SweetAlert2 JS -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // Password Toggle Functionality
    function togglePassword(inputId) {
        const input = document.getElementById(inputId);
        const icon = event.currentTarget.querySelector('i');
        
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    document.getElementById('registerUserForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const form = this;
        const btn = document.getElementById('submitBtn');
        const normalState = btn.querySelector('.normal-state');
        const loadingState = btn.querySelector('.loading-state');
        
        // Basic Client-side Validation
        if (!form.checkValidity()) {
            e.stopPropagation();
            form.classList.add('was-validated');
            
            // Find first invalid field
            const firstInvalid = form.querySelector(':invalid');
            if (firstInvalid) {
                const fieldName = firstInvalid.getAttribute('placeholder') || firstInvalid.name;
                Toast.fire({
                    icon: 'warning',
                    title: 'Please check your input',
                    text: `The ${fieldName} field is invalid or missing.`
                });
                firstInvalid.focus();
            }
            return;
        }

        // Set Loading State
        btn.disabled = true;
        normalState.classList.add('d-none');
        loadingState.classList.remove('d-none');

        const formData = new FormData(this);
        const data = Object.fromEntries(formData.entries());

        fetch('{{ BASE_URL }}/admin/users/store', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify(data)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                Swal.fire({
                    title: 'Success!',
                    text: 'User account created successfully.',
                    icon: 'success',
                    confirmButtonColor: '#4e54c8',
                    confirmButtonText: 'Great!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '{{ BASE_URL }}/admin/users';
                    }
                });
                form.reset();
            } else {
                // Show Error
                Swal.fire({
                    title: 'Error!',
                    text: data.message || 'Something went wrong.',
                    icon: 'error',
                    confirmButtonColor: '#d33'
                });
            }
        })
        .catch(error => {
            console.error('Error:', error);
            Swal.fire({
                title: 'System Error',
                text: 'A network error occurred. Please try again.',
                icon: 'error',
                confirmButtonColor: '#d33'
            });
        })
        .finally(() => {
            // Reset Button State
            btn.disabled = false;
            normalState.classList.remove('d-none');
            loadingState.classList.add('d-none');
        });
    });

    // Toast Configuration
    const Toast = Swal.mixin({
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer)
            toast.addEventListener('mouseleave', Swal.resumeTimer)
        }
    });
</script>
{% endblock %}
