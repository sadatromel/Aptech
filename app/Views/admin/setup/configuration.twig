{% extends "layouts/app.twig" %}

{% block title %}System Configuration{% endblock %}

{% block content %}
<div class="container-fluid p-0">
    <!-- Top Navigation Tabs -->
    <div class="row mb-4">
        <div class="col-12">
            <ul class="nav nav-tabs nav-fill bg-white shadow-sm p-2 rounded" style="border-bottom: none;">
                <li class="nav-item">
                    <a class="nav-link {{ active_tab == 'setup' ? 'active fw-bold border-0 text-primary' : 'text-muted border-0' }}" 
                       href="{{ BASE_URL }}/admin/setup?tab=setup">Setup</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ active_tab == 'management' ? 'active fw-bold border-0 text-primary' : 'text-muted border-0' }}" 
                       href="{{ BASE_URL }}/admin/setup?tab=management">Management</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ active_tab == 'database' ? 'active fw-bold border-0 text-primary' : 'text-muted border-0' }}" 
                       href="{{ BASE_URL }}/admin/setup?tab=database">Database</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ active_tab == 'configuration' ? 'active fw-bold border-0 text-primary' : 'text-muted border-0' }}" 
                       href="{{ BASE_URL }}/admin/setup?tab=configuration">Configuration</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ active_tab == 'backups' ? 'active fw-bold border-0 text-primary' : 'text-muted border-0' }}" 
                       href="{{ BASE_URL }}/admin/setup?tab=backups">Backups</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ active_tab == 'tools' ? 'active fw-bold border-0 text-primary' : 'text-muted border-0' }}" 
                       href="{{ BASE_URL }}/admin/setup?tab=tools">Tools</a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Main Content -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            
            <!-- System Configuration -->
            <div class="mb-5">
                <h5 class="text-dark fw-bold mb-4">
                    <i class="fas fa-cog me-2"></i>System Configuration
                </h5>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">Site URL</label>
                        <input type="text" class="form-control" name="site_url" value="{{ site_url }}" readonly>
                    </div>
                     <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold">Environment</label>
                        <input type="text" class="form-control" name="environment" value="{{ environment }}" readonly>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label text-danger small fw-bold">Configuration File</label>
                    <textarea class="form-control font-monospace small bg-light" rows="20" style="font-family: 'Consolas', 'Monaco', monospace; white-space: pre;">{{ config_content }}</textarea>
                </div>

                <div class="d-flex justify-content-start">
                    <button type="button" class="btn btn-light border py-2" id="refreshBtn">
                        <i class="fas fa-sync-alt me-2"></i> Refresh Configuration
                    </button>
                </div>

            </div>

        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        
        // Refresh Configuration Button
        document.getElementById('refreshBtn').addEventListener('click', function() {
            // Reload the page to refresh content
             const btn = this;
             const originalContent = btn.innerHTML;
             btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Refreshing...';
             btn.disabled = true;

             setTimeout(() => {
                 location.reload();
             }, 500);
        });

    });
</script>
{% endblock %}
