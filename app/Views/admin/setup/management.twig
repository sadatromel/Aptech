{% extends "layouts/app.twig" %}

{% block title %}System Management{% endblock %}

{% block content %}
<div class="container-fluid p-0">
    <!-- Top Navigation Tabs -->
    <div class="row mb-4">
        <div class="col-12">
            <ul class="nav nav-tabs nav-fill bg-white shadow-sm p-2 rounded" style="border-bottom: none;">
                <li class="nav-item">
                    <a class="nav-link {{ active_tab == 'setup' ? 'active fw-bold border-0 text-primary' : 'text-muted border-0' }}" 
                       href="{{ BASE_URL }}/admin/setup?tab=setup">Setup</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ active_tab == 'management' ? 'active fw-bold border-0 text-primary' : 'text-muted border-0' }}" 
                       href="{{ BASE_URL }}/admin/setup?tab=management">Management</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ active_tab == 'database' ? 'active fw-bold border-0 text-primary' : 'text-muted border-0' }}" 
                       href="{{ BASE_URL }}/admin/setup?tab=database">Database</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ active_tab == 'configuration' ? 'active fw-bold border-0 text-primary' : 'text-muted border-0' }}" 
                       href="{{ BASE_URL }}/admin/setup?tab=configuration">Configuration</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ active_tab == 'backups' ? 'active fw-bold border-0 text-primary' : 'text-muted border-0' }}" 
                       href="{{ BASE_URL }}/admin/setup?tab=backups">Backups</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ active_tab == 'tools' ? 'active fw-bold border-0 text-primary' : 'text-muted border-0' }}" 
                       href="{{ BASE_URL }}/admin/setup?tab=tools">Tools</a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Main Content -->
    <div class="card shadow-sm border-0" style="min-height: 400px;">
        <div class="card-body p-4">
            
            {% if is_configured %}
                <!-- System Configured: Show Data -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="text-dark fw-bold m-0">
                        <i class="fas fa-users-cog me-2"></i>Administrator Management
                    </h5>
                    <button class="btn btn-primary btn-sm">
                        <i class="fas fa-plus me-1"></i> Add New Admin
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="bg-light">
                            <tr>
                                <th>Name</th>
                                <th>Username</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in users %}
                            <tr>
                                <td class="fw-bold">{{ user.first_name }} {{ user.last_name }}</td>
                                <td>{{ user.username }}</td>
                                <td>{{ user.email }}</td>
                                <td><span class="badge bg-info text-dark">{{ user.role_name }}</span></td>
                                <td>
                                    <a href="{{ BASE_URL }}/users/edit?id={{ user.user_id }}" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="fas fa-users-slash fa-2x mb-2 d-block"></i>
                                    No users found.
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

            {% else %}
                <!-- System Not Configured: Show Warning -->
                <div class="alert alert-warning border-warning d-flex align-items-center" role="alert" style="background-color: #fff3cd; color: #856404;">
                    <i class="fas fa-exclamation-triangle me-3 fa-lg"></i>
                    <div>
                        <strong>System is not configured.</strong> Please run the setup first.
                    </div>
                </div>
            {% endif %}

        </div>
    </div>
</div>
{% endblock %}
