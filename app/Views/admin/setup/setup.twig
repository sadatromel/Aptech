{% extends "layouts/app.twig" %}

{% block title %}Admin Setup{% endblock %}

{% block content %}
<div class="container-fluid p-0">
    <!-- Top Navigation Tabs -->
    <div class="row mb-4">
        <div class="col-12">
            <ul class="nav nav-tabs nav-fill bg-white shadow-sm p-2 rounded" style="border-bottom: none;">
                <li class="nav-item">
                    <a class="nav-link {{ active_tab == 'setup' ? 'active fw-bold border-0 text-primary' : 'text-muted border-0' }}" 
                       href="{{ BASE_URL }}/admin/setup?tab=setup">Setup</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ active_tab == 'management' ? 'active fw-bold border-0 text-primary' : 'text-muted border-0' }}" 
                       href="{{ BASE_URL }}/admin/setup?tab=management">Management</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ active_tab == 'database' ? 'active fw-bold border-0 text-primary' : 'text-muted border-0' }}" 
                       href="{{ BASE_URL }}/admin/setup?tab=database">Database</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ active_tab == 'configuration' ? 'active fw-bold border-0 text-primary' : 'text-muted border-0' }}" 
                       href="{{ BASE_URL }}/admin/setup?tab=configuration">Configuration</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ active_tab == 'backups' ? 'active fw-bold border-0 text-primary' : 'text-muted border-0' }}" 
                       href="{{ BASE_URL }}/admin/setup?tab=backups">Backups</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ active_tab == 'tools' ? 'active fw-bold border-0 text-primary' : 'text-muted border-0' }}" 
                       href="{{ BASE_URL }}/admin/setup?tab=tools">Tools</a>
                </li>
            </ul>
        </div>
    </div>

    <!-- Main Content -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            
            <!-- Database Configuration Section -->
            <div class="mb-5">
                <h5 class="text-primary mb-4">
                    <i class="fas fa-database me-2"></i>Database Configuration
                </h5>

                <form id="setupForm">
                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold">Server Environment Type (Auto-configures Host)</label>
                        <select class="form-select" name="env_type">
                            <option value="custom">Custom Configuration - Manual Host Entry</option>
                            <option value="local">Local Development (localhost)</option>
                            <option value="production">Production Server</option>
                        </select>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Database Host</label>
                            <input type="text" class="form-control" name="db_host" value="192.168.2.7">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Database Name</label>
                            <input type="text" class="form-control" name="db_name" value="u650801924_aip_tvm">
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Database User</label>
                            <input type="text" class="form-control" name="db_user" value="u650801924_aip">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Database Password</label>
                            <input type="password" class="form-control" name="db_password" value="............">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold">Application URL (Default/Primary)</label>
                        <input type="text" class="form-control" name="app_url" value="http://192.168.2.7/tvm">
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Local Network URL</label>
                            <input type="text" class="form-control" name="local_url" value="http://192.168.2.7/tvm">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Cloud/External URL</label>
                            <input type="text" class="form-control" name="cloud_url" value="https://apt.aptechgroup.net/tvm">
                        </div>
                    </div>
                </form>
            </div>

            <!-- Administrator Account Section -->
            <div class="mb-5">
                <h5 class="text-primary mb-4">
                    <i class="fas fa-user-shield me-2"></i>Administrator Account
                </h5>

                <div class="row">
                    <div class="col-md-4">
                        <label class="form-label text-muted small fw-bold">Admin Username</label>
                        <input type="text" class="form-control" name="admin_username" value="admin">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted small fw-bold">Admin Email</label>
                        <input type="email" class="form-control" name="admin_email" value="admin@example.com">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted small fw-bold">Admin Password</label>
                        <input type="password" class="form-control" name="admin_password" value="..........">
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex flex-wrap gap-2 justify-content-start border-top pt-4">
                <button type="button" class="btn btn-light border">
                    <i class="fas fa-plug me-1"></i> Test Connection
                </button>
                <button type="button" class="btn btn-warning text-white">
                    <i class="fas fa-plus-circle me-1"></i> Create Database
                </button>
                <button type="button" class="btn btn-primary" style="background-color: #4e46e5; border-color: #4e46e5;">
                    <i class="fas fa-play-circle me-1"></i> Run Migrations
                </button>
                <button type="button" class="btn btn-primary" style="background-color: #4e46e5; border-color: #4e46e5;">
                    <i class="fas fa-user-plus me-1"></i> Create Super Admin
                </button>
                <button type="button" class="btn btn-success" style="background-color: #10b981; border-color: #10b981;">
                    <i class="fas fa-file-code me-1"></i> Generate Config
                </button>
                <button type="button" class="btn btn-light border">
                    <i class="fas fa-truck-loading me-1"></i> Load RMG Data
                </button>
                <button type="button" class="btn btn-danger ms-auto">
                    <i class="fas fa-trash-alt me-1"></i> Reset Database
                </button>
            </div>
        </div>
    </div>

    <!-- Footer Status -->
    <div class="mt-3 bg-dark text-white p-2 rounded small">
        <i class="fas fa-terminal me-2"></i> Waiting for actions...
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const envSelect = document.querySelector('select[name="env_type"]');
        const dbHostInput = document.querySelector('input[name="db_host"]');
        const appUrlInput = document.querySelector('input[name="app_url"]');
        
        // Environment Type Change Handler
        envSelect.addEventListener('change', function() {
            if (this.value === 'local') {
                dbHostInput.value = 'localhost';
                appUrlInput.value = 'http://localhost/Aptech';
            } else if (this.value === 'production') {
                // Keep existing or clears? screenshot shows custom config mostly
            }
        });

        // Button Actions
        const buttons = {
            'Test Connection': function() {
                Swal.fire({
                    title: 'Testing Connection...',
                    text: 'Attempting to connect to database',
                    icon: 'info',
                    showConfirmButton: false,
                    timer: 1500
                }).then(() => {
                    Swal.fire('Success', 'Database connection validation successful!', 'success');
                });
            },
            'Create Database': function() {
                 Swal.fire({
                    title: 'Create Database?',
                    text: "You are about to create a new database schema.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ffc107',
                    confirmButtonText: 'Yes, create it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                       Swal.fire('Created!', 'Database has been created.', 'success');
                    }
                });
            },
             'Run Migrations': function() {
                 Swal.fire({
                    title: 'Running Migrations...',
                    html: 'Migrating tables...<br>Migrating users...<br>Migrating settings...',
                    timer: 2000,
                    didOpen: () => {
                        Swal.showLoading()
                    }
                }).then(() => {
                    Swal.fire('Completed', 'All migrations executed successfully.', 'success');
                });
            },
             'Create Super Admin': function() {
                 // Simple validation
                 const pass = document.querySelector('input[name="admin_password"]').value;
                 if(pass.length < 6) {
                     Swal.fire('Error', 'Password must be at least 6 characters', 'error');
                     return;
                 }
                 Swal.fire('Success', 'Super Admin account created!', 'success');
            },
             'Generate Config': function() {
                 Swal.fire('Generated', 'Configuration file generated successfully at config/app.php', 'success');
            },
             'Load RMG Data': function() {
                 Swal.fire({
                    title: 'Load Sample Data?',
                    text: "This will populate the database with RMG industry sample data.",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Load Data'
                }).then((result) => {
                    if (result.isConfirmed) {
                       Swal.fire('Loaded', 'Sample data loaded successfully.', 'success');
                    }
                });
            },
             'Reset Database': function() {
                 Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to revert this! All data will be lost.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, reset it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire('Reset!', 'Database has been reset to factory state.', 'success');
                    }
                });
            }
        };

        // Attach listeners to buttons based on text content (simple matching)
        document.querySelectorAll('button').forEach(btn => {
            const text = btn.innerText.trim();
            if (buttons[text]) {
                btn.addEventListener('click', buttons[text]);
            }
        });
    });
</script>
{% endblock %}
