{% extends 'layouts/app.twig' %}

{% block title %}{{ pageTitle }}{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">Database Backup</h1>
                <div>
                    <button class="btn btn-primary" id="createBackupBtn">
                        <i class="fas fa-download"></i> Create Backup
                    </button>
                    <a href="{{ BASE_URL }}/admin/setup" class="btn btn-outline-secondary ms-2">
                        <i class="fas fa-arrow-left"></i> Back to Setup
                    </a>
                </div>
            </div>
        </div>
    </div>

    {% if flash.success %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        {{ flash.success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    {% endif %}

    {% if flash.error %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        {{ flash.error }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    {% endif %}

    <!-- Backup Progress -->
    <div class="row mb-4" id="backupProgress" style="display: none;">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-4">
                    <div class="spinner-border text-primary mb-3" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <h5>Creating backup...</h5>
                    <p class="text-muted">Please wait while we create your database backup.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Backup Statistics -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">{{ backups|length }}</h4>
                            <p class="card-text">Total Backups</p>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-archive fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">
                                {% if backups|length > 0 %}
                                    {{ backups.0.created|date('M d, Y') }}
                                {% else %}
                                    No backups
                                {% endif %}
                            </h4>
                            <p class="card-text">Last Backup</p>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-calendar-check fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">
                                {% if backups|length > 0 %}
                                    {{ backups.0.size }}
                                {% else %}
                                    0 MB
                                {% endif %}
                            </h4>
                            <p class="card-text">Last Backup Size</p>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-weight fa-2x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Backups List -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Backup Files</h5>
                </div>
                <div class="card-body">
                    {% if backups|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Filename</th>
                                    <th>Size</th>
                                    <th>Created</th>
                                    <th width="200">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for backup in backups %}
                                <tr>
                                    <td>
                                        <i class="fas fa-file-archive text-muted me-2"></i>
                                        <code>{{ backup.filename }}</code>
                                    </td>
                                    <td>{{ backup.size }}</td>
                                    <td>{{ backup.created }}</td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a href="{{ BASE_URL }}/admin/setup/download_backup?filename={{ backup.filename }}" 
                                               class="btn btn-outline-primary" title="Download">
                                                <i class="fas fa-download"></i>
                                            </a>
                                            <button class="btn btn-outline-info restore-backup" 
                                                    data-filename="{{ backup.filename }}" title="Restore">
                                                <i class="fas fa-undo"></i>
                                            </button>
                                            <button class="btn btn-outline-danger delete-backup" 
                                                    data-filename="{{ backup.filename }}" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                    <div class="text-center py-5">
                        <i class="fas fa-archive fa-4x text-muted mb-3"></i>
                        <h4 class="text-muted">No Backups Found</h4>
                        <p class="text-muted">Create your first backup to ensure your data is safe.</p>
                        <button class="btn btn-primary" id="createFirstBackupBtn">
                            <i class="fas fa-plus"></i> Create First Backup
                        </button>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Backup Settings -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Backup Settings</h5>
                </div>
                <div class="card-body">
                    <form id="backupSettingsForm">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="autoBackup" class="form-label">Automatic Backup</label>
                                    <select class="form-select" id="autoBackup" name="auto_backup">
                                        <option value="disabled">Disabled</option>
                                        <option value="daily">Daily</option>
                                        <option value="weekly">Weekly</option>
                                        <option value="monthly">Monthly</option>
                                    </select>
                                    <div class="form-text">Schedule automatic database backups</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="backupRetention" class="form-label">Backup Retention</label>
                                    <select class="form-select" id="backupRetention" name="backup_retention">
                                        <option value="7">7 days</option>
                                        <option value="14">14 days</option>
                                        <option value="30">30 days</option>
                                        <option value="60">60 days</option>
                                        <option value="0">Keep all</option>
                                    </select>
                                    <div class="form-text">Automatically delete old backups</div>
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-secondary">Save Settings</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Restore Confirmation Modal -->
<div class="modal fade" id="restoreModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Restore Backup</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle"></i>
                    <strong>Warning:</strong> Restoring a backup will replace all current data with the backup data. This action cannot be undone.
                </div>
                <p>Are you sure you want to restore the backup: <strong id="restoreFilename"></strong>?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="confirmRestoreBtn">Restore Backup</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascript %}
<script>
// Create Backup
document.getElementById('createBackupBtn').addEventListener('click', function() {
    document.getElementById('backupProgress').style.display = 'block';
    
    fetch('{{ BASE_URL }}/admin/setup/create_backup', {
        method: 'POST'
    })
    .then(response => response.json())
    .then(data => {
        document.getElementById('backupProgress').style.display = 'none';
        
        if (data.success) {
            location.reload();
        } else {
            alert(data.message || 'Error creating backup');
        }
    })
    .catch(error => {
        document.getElementById('backupProgress').style.display = 'none';
        console.error('Error:', error);
        alert('Error creating backup');
    });
});

// Create First Backup (same as above)
document.getElementById('createFirstBackupBtn')?.addEventListener('click', function() {
    document.getElementById('createBackupBtn').click();
});

// Delete Backup
document.querySelectorAll('.delete-backup').forEach(button => {
    button.addEventListener('click', function() {
        if (confirm('Are you sure you want to delete this backup?')) {
            const filename = this.dataset.filename;
            
            fetch('{{ BASE_URL }}/admin/setup/delete_backup', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: 'filename=' + encodeURIComponent(filename)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.message || 'Error deleting backup');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error deleting backup');
            });
        }
    });
});

// Restore Backup
let restoreFilename = '';
document.querySelectorAll('.restore-backup').forEach(button => {
    button.addEventListener('click', function() {
        restoreFilename = this.dataset.filename;
        document.getElementById('restoreFilename').textContent = restoreFilename;
        new bootstrap.Modal(document.getElementById('restoreModal')).show();
    });
});

document.getElementById('confirmRestoreBtn').addEventListener('click', function() {
    // Implement restore functionality
    alert('Restore functionality would be implemented here. This requires server-side script to restore the SQL file.');
    new bootstrap.Modal(document.getElementById('restoreModal')).hide();
});

// Backup Settings
document.getElementById('backupSettingsForm').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    
    // Save settings to configuration
    fetch('{{ BASE_URL }}/admin/setup/save_config', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('Backup settings saved successfully');
        } else {
            alert(data.message || 'Error saving settings');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Error saving settings');
    });
});
</script>
{% endblock %}
