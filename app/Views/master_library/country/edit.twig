{% extends "layouts/app.twig" %}

{% block title %}Edit Country | Master Library{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Edit Country</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library">Master Library</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library/countries">Countries</a></li>
        <li class="breadcrumb-item active">Edit Country</li>
    </ol>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-transparent border-bottom py-3">
             <h5 class="mb-0 text-primary"><i class="fas fa-edit me-1"></i> Edit Country Details</h5>
        </div>
        <div class="card-body p-4">
            <form action="{{ BASE_URL }}/master_library/countries/edit/{{ country.country_id }}" method="POST">
    {{ csrf_field() | raw }}
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="country_code" name="country_code" type="text" placeholder="Enter country code" required maxlength="3" value="{{ country.country_code }}" />
                            <label for="country_code">Country Code (ISO-3)</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input class="form-control" id="country_name" name="country_name" type="text" placeholder="Enter country name" required value="{{ country.country_name }}" />
                            <label for="country_name">Country Name</label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="region" name="region" type="text" placeholder="Enter region" value="{{ country.region }}" />
                            <label for="region">Region</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select class="form-select" id="currency_code" name="currency_code">
                                <option value="">Select Currency</option>
                                {% for currency in currencies %}
                                <option value="{{ currency.currency_code }}" {{ country.currency_code == currency.currency_code ? 'selected' : '' }}>{{ currency.currency_code }} - {{ currency.currency_name }}</option>
                                {% endfor %}
                            </select>
                            <label for="currency_code">Currency Code</label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select class="form-select" id="status" name="status">
                                <option value="active" {{ country.status == 'active' ? 'selected' : '' }}>Active</option>
                                <option value="inactive" {{ country.status == 'inactive' ? 'selected' : '' }}>Inactive</option>
                            </select>
                            <label for="status">Status</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 mb-0">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="{{ BASE_URL }}/master_library/countries" class="btn btn-light me-md-2 px-4 rounded-pill border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 rounded-pill">Update Country</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
