{% extends "layouts/app.twig" %}

{% block title %}Add New Category | Master Library{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Add New Category</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library">Master Library</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library/item_categories">Item Categories</a></li>
        <li class="breadcrumb-item active">Add New</li>
    </ol>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-transparent border-bottom py-3">
            <h5 class="mb-0 text-primary"><i class="fas fa-plus me-1"></i> New Category Details</h5>
        </div>
        <div class="card-body p-4">
            <form action="{{ BASE_URL }}/master_library/item_categories/create" method="POST">
    {{ csrf_field() | raw }}
                <div class="row mb-3">
                    <div class="col-md-6">
                         <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="category_code" name="category_code" type="text" placeholder="Enter category code" required />
                            <label for="category_code">Category Code</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="category_name" name="category_name" type="text" placeholder="Enter category name" required />
                            <label for="category_name">Category Name</label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                         <div class="form-floating mb-3 mb-md-0">
                            <select class="form-select" id="type" name="type">
                                <option value="Raw Material">Raw Material</option>
                                <option value="Stationery">Stationery</option>
                                <option value="Spare Parts">Spare Parts</option>
                                <option value="Consumables">Consumables</option>
                                 <option value="Others">Others</option>
                            </select>
                            <label for="type">Type</label>
                        </div>
                    </div>
                     <div class="col-md-6">
                        <div class="form-floating">
                            <select class="form-select" id="status" name="status">
                                <option value="active" selected>Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                            <label for="status">Status</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 mb-0">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="{{ BASE_URL }}/master_library/item_categories" class="btn btn-light me-md-2 px-4 rounded-pill border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 rounded-pill">Save Category</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
