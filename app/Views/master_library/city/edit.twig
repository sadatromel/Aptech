{% extends "layouts/app.twig" %}

{% block title %}Edit City | Master Library{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Edit City</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library">Master Library</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library/cities">Cities</a></li>
        <li class="breadcrumb-item active">Edit City</li>
    </ol>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-transparent border-bottom py-3">
            <h5 class="mb-0 text-primary"><i class="fas fa-edit me-1"></i> Edit City Details</h5>
        </div>
        <div class="card-body p-4">
            <form action="{{ BASE_URL }}/master_library/cities/edit/{{ city.city_id }}" method="POST">
    {{ csrf_field() | raw }}
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="city_name" name="city_name" type="text" placeholder="Enter city name" required value="{{ city.city_name }}" />
                            <label for="city_name">City Name</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                             <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="state_province" name="state_province" type="text" placeholder="Enter state/province" value="{{ city.state_province }}" />
                            <label for="state_province">State/Province</label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                     <div class="col-md-6">
                        <div class="form-floating">
                            <select class="form-select" id="country_id" name="country_id" required>
                                <option value="">Select Country</option>
                                {% for country in countries %}
                                <option value="{{ country.country_id }}" {{ city.country_id == country.country_id ? 'selected' : '' }}>{{ country.country_name }}</option>
                                {% endfor %}
                            </select>
                            <label for="country_id">Country</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select class="form-select" id="status" name="status">
                                <option value="active" {{ city.status == 'active' ? 'selected' : '' }}>Active</option>
                                <option value="inactive" {{ city.status == 'inactive' ? 'selected' : '' }}>Inactive</option>
                            </select>
                            <label for="status">Status</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 mb-0">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="{{ BASE_URL }}/master_library/cities" class="btn btn-light me-md-2 px-4 rounded-pill border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 rounded-pill">Update City</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
