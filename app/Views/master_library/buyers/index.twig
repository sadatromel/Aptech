{% extends 'layouts/app.twig' %}

{% block title %}Buyers | Master Library{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mt-4 mb-4">
        <div>
            <h1 class="h3 mb-0">Buyer Profiles</h1>
            <p class="text-muted mb-0">Manage your customer base and their specific requirements.</p>
        </div>
        <a href="{{ BASE_URL }}/master_library/buyers/create" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>New Buyer
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="small text-muted fw-bold text-uppercase">Total Buyers</div>
                        <div class="h3 mb-0">{{ stats.total }}</div>
                    </div>
                    <div class="text-primary bg-primary bg-opacity-10 p-3 rounded-circle">
                         <i class="fas fa-users fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="small text-muted fw-bold text-uppercase">Active</div>
                        <div class="h3 mb-0">{{ stats.active }}</div>
                    </div>
                    <div class="text-success bg-success bg-opacity-10 p-3 rounded-circle">
                        <i class="fas fa-user-check fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-grow-1">
                        <div class="small text-muted fw-bold text-uppercase">Inactive</div>
                        <div class="h3 mb-0">{{ stats.inactive }}</div>
                    </div>
                    <div class="text-secondary bg-secondary bg-opacity-10 p-3 rounded-circle">
                        <i class="fas fa-user-times fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4 shadow-sm border-0">
        <div class="card-body">
            <form class="row gy-3 gx-3 align-items-end" method="get" action="{{ BASE_URL }}/master_library/buyers">
                <div class="col-md-5">
                    <label class="form-label small text-muted text-uppercase fw-bold">Search</label>
                    <input type="text" class="form-control" name="search" placeholder="Name, code, or country..." value="{{ filters.search }}">
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted text-uppercase fw-bold">Status</label>
                    <select class="form-select" name="status">
                        <option value="">All statuses</option>
                        <option value="active" {{ filters.status == 'active' ? 'selected' }}>Active</option>
                        <option value="inactive" {{ filters.status == 'inactive' ? 'selected' }}>Inactive</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-primary w-100" type="submit">
                        <i class="fas fa-filter me-1"></i>Filter
                    </button>
                </div>
                <div class="col-md-2">
                    <a class="btn btn-outline-secondary w-100" href="{{ BASE_URL }}/master_library/buyers">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Buyer</th>
                            <th>Code</th>
                            <th>Contact</th>
                            <th>Country</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for buyer in buyers %}
                            <tr>
                                <td class="ps-4">
                                    <strong>{{ buyer.buyer_name }}</strong>
                                </td>
                                <td><span class="badge bg-light text-dark border">{{ buyer.buyer_code ?: '—' }}</span></td>
                                <td>
                                    <div>{{ buyer.contact_person ?: '—' }}</div>
                                    {% if buyer.email %}<div class="text-muted small"><i class="fas fa-envelope me-1"></i>{{ buyer.email }}</div>{% endif %}
                                </td>
                                <td>{{ buyer.country ?: '—' }}</td>
                                <td>
                                    <span class="badge rounded-pill bg-{{ buyer.status == 'active' ? 'success' : 'secondary' }}">
                                        {{ buyer.status|capitalize }}
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a href="{{ BASE_URL }}/master_library/buyers/edit/{{ buyer.buyer_id }}" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                                        <form action="{{ BASE_URL }}/master_library/buyers/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete buyer {{ buyer.buyer_name }}?');">
    {{ csrf_field() | raw }}
                                            <input type="hidden" name="id" value="{{ buyer.buyer_id }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">No buyers found.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
