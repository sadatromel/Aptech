{% extends "layouts/app.twig" %}

{% block title %}Edit Store Location | Master Library{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Edit Store Location</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library">Master Library</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library/store_locations">Store Locations</a></li>
        <li class="breadcrumb-item active">Edit Location</li>
    </ol>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-transparent border-bottom py-3">
            <h5 class="mb-0 text-primary"><i class="fas fa-edit me-1"></i> Edit Location Details</h5>
        </div>
        <div class="card-body p-4">
            <form action="{{ BASE_URL }}/master_library/store_locations/edit/{{ location.rack_id }}" method="POST">
                {{ csrf_field() | raw }}
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-floating mb-3 mb-md-0">
                            <select class="form-select" id="factory_id" name="factory_id" required>
                                <option value="">-- Select Factory --</option>
                                {% for factory in factories %}
                                <option value="{{ factory.factory_id }}" {{ current_store.factory_id == factory.factory_id ? 'selected' : '' }}>
                                    {{ factory.factory_name }} ({{ factory.factory_code }})
                                </option>
                                {% endfor %}
                            </select>
                            <label for="factory_id">Factory <span class="text-danger">*</span></label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3 mb-md-0">
                            <select class="form-select" id="warehouse_id" name="warehouse_id" required>
                                <option value="">-- Select Store --</option>
                                {% for store in stores %}
                                {% if store.factory_id == current_store.factory_id %}
                                <option value="{{ store.location_id }}" {{ location.warehouse_id == store.location_id ? 'selected' : '' }}>
                                    {{ store.location_name }} ({{ store.location_code }})
                                </option>
                                {% endif %}
                                {% endfor %}
                            </select>
                            <label for="warehouse_id">Store <span class="text-danger">*</span></label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                         <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="rack_code" name="rack_code" type="text" placeholder="Enter location code" required value="{{ location.rack_code }}" />
                            <label for="rack_code">Location Code <span class="text-danger">*</span></label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="rack_name" name="rack_name" type="text" placeholder="Enter location name" required value="{{ location.rack_name }}" />
                            <label for="rack_name">Location Name <span class="text-danger">*</span></label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-3 col-sm-6">
                         <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="zone" name="zone" type="text" placeholder="Zone" value="{{ location.zone }}" />
                            <label for="zone">Zone</label>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="aisle" name="aisle" type="text" placeholder="Aisle" value="{{ location.aisle }}" />
                            <label for="aisle">Aisle</label>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                         <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="level" name="level" type="text" placeholder="Level" value="{{ location.level }}" />
                            <label for="level">Level</label>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="bin" name="bin" type="text" placeholder="Bin" value="{{ location.bin }}" />
                            <label for="bin">Bin</label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                         <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="capacity_weight" name="capacity_weight" type="number" step="0.01" placeholder="Capacity Weight" value="{{ location.capacity_weight }}" />
                            <label for="capacity_weight">Capacity Weight (kg)</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="capacity_volume" name="capacity_volume" type="number" step="0.01" placeholder="Capacity Volume" value="{{ location.capacity_volume }}" />
                            <label for="capacity_volume">Capacity Volume (m³)</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <select class="form-select" id="status" name="status">
                                <option value="active" {{ location.status == 'active' ? 'selected' : '' }}>Active</option>
                                <option value="inactive" {{ location.status == 'inactive' ? 'selected' : '' }}>Inactive</option>
                                <option value="maintenance" {{ location.status == 'maintenance' ? 'selected' : '' }}>Maintenance</option>
                            </select>
                            <label for="status">Status</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 mb-0">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="{{ BASE_URL }}/master_library/store_locations" class="btn btn-light me-md-2 px-4 rounded-pill border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 rounded-pill">Update Location</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const factorySelect = document.getElementById('factory_id');
    const warehouseSelect = document.getElementById('warehouse_id');

    if (factorySelect) {
        factorySelect.addEventListener('change', function () {
            const factoryId = this.value;
            warehouseSelect.innerHTML = '<option value="">-- Loading Stores... --</option>';
            warehouseSelect.disabled = true;

            if (!factoryId) {
                warehouseSelect.innerHTML = '<option value="">-- Select Store --</option>';
                return;
            }

            fetch(`{{ BASE_URL }}/master_library/store_locations/get-stores?factory_id=${factoryId}`)
                .then(response => response.json())
                .then(data => {
                    warehouseSelect.innerHTML = '<option value="">-- Select Store --</option>';
                    if (data && data.length > 0) {
                        data.forEach(store => {
                            const option = document.createElement('option');
                            option.value = store.location_id;
                            option.textContent = `${store.location_name} (${store.location_code})`;
                            warehouseSelect.appendChild(option);
                        });
                        warehouseSelect.disabled = false;
                    } else {
                        warehouseSelect.innerHTML = '<option value="">No Active Stores Found</option>';
                    }
                })
                .catch(error => {
                    console.error('Error fetching stores:', error);
                    warehouseSelect.innerHTML = '<option value="">Error Loading Stores</option>';
                });
        });
    }
});
</script>
{% endblock %}
