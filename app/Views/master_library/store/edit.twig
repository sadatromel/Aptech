{% extends "layouts/app.twig" %}

{% block title %}Edit Store | Master Library{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Edit Store</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library">Master Library</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library/stores">Stores</a></li>
        <li class="breadcrumb-item active">Edit Store</li>
    </ol>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-transparent border-bottom py-3">
            <h5 class="mb-0 text-primary"><i class="fas fa-edit me-1"></i> Edit Store Details</h5>
        </div>
        <div class="card-body p-4">
            <form action="{{ BASE_URL }}/master_library/stores/edit/{{ store.location_id }}" method="POST">
                {{ csrf_field() | raw }}
                
                <div class="row mb-3">
                    <div class="col-md-6">
                         <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="location_code" name="location_code" type="text" placeholder="Enter store code" required value="{{ store.location_code }}" />
                            <label for="location_code">Store Code <span class="text-danger">*</span></label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="location_name" name="location_name" type="text" placeholder="Enter store name" required value="{{ store.location_name }}" />
                            <label for="location_name">Store Name <span class="text-danger">*</span></label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-floating mb-3 mb-md-0">
                            <select class="form-select" id="factory_id" name="factory_id" required>
                                <option value="">-- Select Factory --</option>
                                {% for factory in factories %}
                                <option value="{{ factory.factory_id }}" {{ store.factory_id == factory.factory_id ? 'selected' : '' }}>
                                    {{ factory.factory_name }} ({{ factory.factory_code }})
                                </option>
                                {% endfor %}
                            </select>
                            <label for="factory_id">Factory <span class="text-danger">*</span></label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select class="form-select" id="location_type" name="location_type">
                                <option value="Raw Material" {{ store.location_type == 'Raw Material' ? 'selected' : '' }}>Raw Material</option>
                                <option value="Finished Goods" {{ store.location_type == 'Finished Goods' ? 'selected' : '' }}>Finished Goods</option>
                                <option value="WIP" {{ store.location_type == 'WIP' ? 'selected' : '' }}>WIP</option>
                                <option value="General" {{ store.location_type == 'General' ? 'selected' : '' }}>General</option>
                            </select>
                            <label for="location_type">Store Type</label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-floating mb-3 mb-md-0">
                            <textarea class="form-control" id="description" name="description" placeholder="Optional description..." style="height: 100px;">{{ store.description }}</textarea>
                            <label for="description">Description</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select class="form-select" id="status" name="status">
                                <option value="active" {{ store.status == 'active' ? 'selected' : '' }}>Active</option>
                                <option value="inactive" {{ store.status == 'inactive' ? 'selected' : '' }}>Inactive</option>
                            </select>
                            <label for="status">Status</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 mb-0">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="{{ BASE_URL }}/master_library/stores" class="btn btn-light me-md-2 px-4 rounded-pill border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 rounded-pill">Update Store</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
