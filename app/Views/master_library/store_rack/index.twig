{% extends "layouts/app.twig" %}

{% block title %}Racks | Master Library{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Racks</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library">Master Library</a></li>
        <li class="breadcrumb-item active">Racks</li>
    </ol>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
            <div class="h5 mb-0 text-primary"><i class="fas fa-table me-2"></i>Rack List</div>
            <a href="{{ BASE_URL }}/master_library/store_racks/create" class="btn btn-primary px-4 rounded-pill"><i class="fas fa-plus me-1"></i> Add New</a>
        </div>
        <div class="card-body p-4">
            <table id="datatablesSimple" class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Factory</th>
                        <th>Store</th>
                        <th>Store Location</th>
                        <th>Floor</th>
                        <th>Room</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for rack in racks %}
                    <tr>
                        <td>{{ rack.rack_code }}</td>
                        <td>{{ rack.rack_name }}</td>
                        <td>{{ rack.factory_name|default('N/A') }}</td>
                        <td>{{ rack.store_name|default('N/A') }}</td>
                        <td>{{ rack.store_location_name|default('N/A') }}</td>
                        <td>{{ rack.floor_name|default('N/A') }}</td>
                        <td>{{ rack.room_name|default('N/A') }}</td>
                        <td>
                            <span class="badge rounded-pill bg-{{ rack.status == 'active' ? 'success' : 'secondary' }}">{{ rack.status|capitalize }}</span>
                        </td>
                        <td>
                            <a href="{{ BASE_URL }}/master_library/store_racks/edit/{{ rack.rack_id }}" class="btn btn-warning btn-sm rounded-circle" title="Edit"><i class="fas fa-edit"></i></a>
                            <form action="{{ BASE_URL }}/master_library/store_racks/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure?');">
                                {{ csrf_field() | raw }}
                                <input type="hidden" name="id" value="{{ rack.rack_id }}">
                                <button type="submit" class="btn btn-danger btn-sm rounded-circle" title="Delete"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
