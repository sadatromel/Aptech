{% extends "layouts/app.twig" %}

{% block title %}Trims Costing Templates | Master Library{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1 fw-bold text-dark">Trims Costing Templates</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard" class="text-decoration-none text-primary">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library" class="text-decoration-none text-primary">Master Library</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Trims Costing Templates</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ BASE_URL }}/master_library/trims_costing_template/create" class="btn btn-primary px-4 rounded-pill shadow-sm">
                <i class="fas fa-plus me-2"></i>New Template
            </a>
        </div>
    </div>

    <!-- Stats Cards Section -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card premium-glass-card border-0 h-100 shadow-sm overflow-hidden">
                <div class="card-body d-flex align-items-center p-4">
                    <div class="flex-grow-1">
                        <div class="small text-muted fw-bold text-uppercase mb-1" style="letter-spacing: 0.5px;">Total Templates</div>
                        <div class="h2 mb-0 fw-bold text-primary">{{ stats.total_templates }}</div>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-4">
                        <i class="fas fa-file-invoice-dollar text-primary fa-2x"></i>
                    </div>
                </div>
                <div class="progress rounded-0" style="height: 4px;">
                    <div class="progress-bar bg-primary" style="width: 100%"></div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card premium-glass-card border-0 h-100 shadow-sm overflow-hidden">
                <div class="card-body d-flex align-items-center p-4">
                    <div class="flex-grow-1">
                        <div class="small text-muted fw-bold text-uppercase mb-1" style="letter-spacing: 0.5px;">Active Templates</div>
                        <div class="h2 mb-0 fw-bold text-success">{{ stats.active_templates }}</div>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-4">
                        <i class="fas fa-check-double text-success fa-2x"></i>
                    </div>
                </div>
                {% set active_percent = (stats.total_templates > 0) ? (stats.active_templates / stats.total_templates * 100)|round : 0 %}
                <div class="progress rounded-0" style="height: 4px;">
                    <div class="progress-bar bg-success" style="width: {{ active_percent }}%"></div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card premium-glass-card border-0 h-100 shadow-sm overflow-hidden">
                <div class="card-body d-flex align-items-center p-4">
                    <div class="flex-grow-1">
                        <div class="small text-muted fw-bold text-uppercase mb-1" style="letter-spacing: 0.5px;">Standard Items</div>
                        <div class="h2 mb-0 fw-bold text-info">{{ stats.total_items }}</div>
                    </div>
                    <div class="bg-info bg-opacity-10 p-3 rounded-4">
                        <i class="fas fa-layer-group text-info fa-2x"></i>
                    </div>
                </div>
                <div class="progress rounded-0" style="height: 4px;">
                    <div class="progress-bar bg-info" style="width: 100%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Section -->
    <div class="row g-4">
        <!-- Templates Table Card -->
        <div class="col-lg-8">
            <div class="card premium-glass-card border-0 shadow-lg rounded-4 overflow-hidden h-100">
                <div class="card-header bg-white bg-opacity-50 border-bottom py-3 px-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-table me-2 text-primary"></i>Template Inventory</h5>
                        <div class="badge bg-light text-dark border px-3 py-2 rounded-pill">Total: {{ templates|length }}</div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="datatablesSimple">
                            <thead class="table-light bg-opacity-50 text-uppercase small fw-bold text-muted">
                                <tr>
                                    <th class="ps-4">Template Details</th>
                                    <th>Buyer Association</th>
                                    <th>Status</th>
                                    <th>Last Updated</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for template in templates %}
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm bg-primary bg-opacity-10 text-primary rounded-3 p-2 me-3 text-center" style="width: 40px;">
                                                <i class="fas fa-file-alt"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">{{ template.template_name }}</div>
                                                <div class="small text-muted">ID: #TMPL-{{ template.template_id|format("%03d") }}</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-primary border px-3 py-2 rounded-pill">
                                            <i class="fas fa-user-tie me-1"></i> {{ template.buyer_name }}
                                        </span>
                                    </td>
                                    <td>
                                        {% if template.status == 'Active' %}
                                            <span class="badge bg-success-soft text-success rounded-pill px-3 py-2">
                                                <i class="fas fa-dot-circle me-1 small"></i>Active
                                            </span>
                                        {% else %}
                                            <span class="badge bg-secondary-soft text-secondary rounded-pill px-3 py-2">
                                                <i class="fas fa-times-circle me-1 small"></i>Inactive
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="small fw-bold text-dark">{{ template.updated_at|date('d M, Y') }}</div>
                                        <div class="small text-muted">{{ template.updated_at|date('h:i A') }}</div>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a href="{{ BASE_URL }}/master_library/trims_costing_template/edit/{{ template.template_id }}" class="btn btn-sm btn-outline-primary rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Edit Template">
                                                <i class="fas fa-pen-nib"></i>
                                            </a>
                                            <form action="{{ BASE_URL }}/master_library/trims_costing_template/delete" 
                                                  method="POST" class="d-inline delete-form">
    {{ csrf_field() | raw }}
                                                <input type="hidden" name="id" value="{{ template.template_id }}">
                                                <button type="button" class="btn btn-sm btn-icon btn-outline-danger rounded-circle shadow-sm" 
                                                        onclick="confirmDelete(this)" title="Delete Template">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="5" class="text-center py-5">
                                        <div class="text-muted">
                                            <i class="fas fa-folder-open fa-3x mb-3 opacity-25"></i>
                                            <p class="mb-0">No templates found. Start by creating one!</p>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side Widgets -->
        <div class="col-lg-4">
            <!-- Search & Load Widget -->
            <div class="card premium-glass-card border-0 shadow-lg rounded-4 mb-4">
                <div class="card-header bg-white bg-opacity-50 border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-bolt me-2 text-warning"></i>Quick Actions</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label for="searchBuyer" class="form-label small fw-bold text-muted text-uppercase">Select Buyer</label>
                        <select class="form-select border-0 bg-light shadow-none py-2" id="searchBuyer">
                            <option value="">-- Choose Buyer --</option>
                            {% for buyer in buyers %}
                            <option value="{{ buyer.buyer_id }}">{{ buyer.buyer_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-4">
                        <label for="searchTemplate" class="form-label small fw-bold text-muted text-uppercase">Choose Template</label>
                        <select class="form-select border-0 bg-light shadow-none py-2" id="searchTemplate">
                            <option value="">-- Choose Template --</option>
                        </select>
                    </div>
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-outline-info border-2 fw-bold" onclick="showTemplate()">
                            <i class="fas fa-external-link-alt me-2"></i>Open Selected
                        </button>
                        <button type="button" class="btn btn-success fw-bold shadow-sm" onclick="copyTemplate()">
                            <i class="fas fa-copy me-2"></i>Clone Template
                        </button>
                    </div>
                </div>
            </div>

            <!-- Help/Info Widget -->
            <div class="card bg-primary text-white border-0 shadow-lg rounded-4 overflow-hidden position-relative">
                <div class="card-body p-4 position-relative" style="z-index: 1;">
                    <h5 class="fw-bold mb-3">Mastering Costing</h5>
                    <p class="small opacity-75 mb-4">Templates allow you to standardize trims costing across different buyers, ensuring consistency and speed in your merchandising workflow.</p>
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar bg-white bg-opacity-25 rounded p-2">
                            <i class="fas fa-lightbulb"></i>
                        </div>
                        <div class="small">Tip: Use descriptive names like "Basic Polo Trims" for better searchability.</div>
                    </div>
                </div>
                <i class="fas fa-gem position-absolute text-white opacity-10" style="font-size: 8rem; bottom: -2rem; right: -2rem;"></i>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-success-soft { background-color: rgba(25, 135, 84, 0.1); }
    .bg-secondary-soft { background-color: rgba(108, 117, 125, 0.1); }
    .btn-icon { width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center; transition: all 0.2s ease; }
    .btn-icon:hover { transform: translateY(-2px); }
    .avatar-sm { display: flex; align-items: center; justify-content: center; }
    .card.premium-glass-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .card.premium-glass-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important;
    }
</style>

<script>
function loadTemplatesByBuyer(buyerId) {
    if (!buyerId) {
        const select = document.getElementById('searchTemplate');
        select.innerHTML = '<option value="">-- Choose Template --</option>';
        return;
    }
    
    // Add loading state
    const select = document.getElementById('searchTemplate');
    select.disabled = true;
    select.innerHTML = '<option value="">Loading...</option>';
    
    fetch(`{{ BASE_URL }}/master_library/trims_costing_template/templates-by-buyer?buyer_id=${buyerId}`)
        .then(response => response.json())
        .then(data => {
            select.disabled = false;
            select.innerHTML = '<option value="">-- Choose Template --</option>';
            
            if (data.success && data.data.length > 0) {
                data.data.forEach(template => {
                    select.innerHTML += `<option value="${template.template_id}">${template.template_name}</option>`;
                });
            } else {
                select.innerHTML = '<option value="">No templates found</option>';
            }
        })
        .catch(err => {
            select.disabled = false;
            select.innerHTML = '<option value="">Error loading</option>';
            console.error('Fetch error:', err);
        });
}

function showTemplate() {
    const templateId = document.getElementById('searchTemplate').value;
    if (!templateId) {
        Swal.fire({ icon: 'warning', title: 'Selection Required', text: 'Please select a template to open.' });
        return;
    }
    window.location.href = `{{ BASE_URL }}/master_library/trims_costing_template/${templateId}/edit`;
}

function copyTemplate() {
    const sourceTemplateId = document.getElementById('searchTemplate').value;
    if (!sourceTemplateId) {
        Swal.fire({ icon: 'warning', title: 'Selection Required', text: 'Please select a source template to clone.' });
        return;
    }
    
    const sourceBuyerId = document.getElementById('searchBuyer').value;

    Swal.fire({
        title: 'Clone Template',
        text: 'Enter a name for the new template:',
        input: 'text',
        inputPlaceholder: 'e.g. New Seasonal Template',
        showCancelButton: true,
        confirmButtonText: 'Clone Now',
        showLoaderOnConfirm: true,
        preConfirm: (newTemplateName) => {
            if (!newTemplateName) {
                Swal.showValidationMessage('Template name is required');
                return false;
            }
            return fetch('{{ BASE_URL }}/master_library/trims_costing_template/copy', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    source_template_id: sourceTemplateId,
                    new_template_name: newTemplateName,
                    new_buyer_id: sourceBuyerId
                })
            })
            .then(response => response.json())
            .then(data => {
                if (!data.success) { throw new Error(data.message || 'Cloning failed'); }
                return data;
            })
            .catch(error => {
                Swal.showValidationMessage(`Request failed: ${error}`);
            });
        },
        allowOutsideClick: () => !Swal.isLoading()
    }).then((result) => {
        if (result.isConfirmed) {
            Swal.fire({ icon: 'success', title: 'Success!', text: 'Template cloned successfully.' }).then(() => {
                location.reload();
            });
        }
    });
}

function confirmDelete(button) {
    Swal.fire({
        title: 'Are you sure?',
        text: "You won't be able to revert this!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Yes, delete it!'
    }).then((result) => {
        if (result.isConfirmed) {
            button.closest('form').submit();
        }
    });
}

// Event Listeners
document.addEventListener('DOMContentLoaded', function() {
    document.getElementById('searchBuyer').addEventListener('change', function() {
        loadTemplatesByBuyer(this.value);
    });
});
</script>
{% endblock %}
