{% extends "layouts/app.twig" %}

{% block title %}Edit Size Range | Master Library{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Edit Size Range</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library/size-ranges">Size Ranges</a></li>
        <li class="breadcrumb-item active">{{ range.range_name }}</li>
    </ol>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-transparent border-bottom py-3">
             <div class="h5 mb-0 text-primary"><i class="fas fa-edit me-2"></i>Edit Range: {{ range.range_name }}</div>
        </div>
        <div class="card-body p-4">
            <form action="{{ BASE_URL }}/master_library/size-ranges/update/{{ range.size_range_id }}" method="POST">
    {{ csrf_field() | raw }}
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="range_name" id="range_name" value="{{ range.range_name }}" required>
                            <label for="range_name">Range Name <span class="text-danger">*</span></label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="sizes" id="sizes" value="{{ range.sizes_array|join(', ') }}" required placeholder="e.g., S, M, L, XL, XXL">
                            <label for="sizes">Sizes <span class="text-danger">*</span></label>
                        </div>
                        <div class="form-text mt-1">List sizes in order, separated by commas.</div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-floating">
                            <textarea class="form-control" name="description" id="description" style="height: 100px">{{ range.description }}</textarea>
                            <label for="description">Description</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-4 border-top d-flex justify-content-end gap-2">
                    <a href="{{ BASE_URL }}/master_library/size-ranges" class="btn btn-light border rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="fas fa-save me-1"></i> Update Range</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
