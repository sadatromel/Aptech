{% extends 'layouts/app.twig' %}

{% block title %}Size Ranges | Master Library{% endblock %}

{% block content %}
<div class="container-fluid px-4 master-library-size-ranges">
    <h1 class="mt-4">Size Ranges</h1>
    
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library">Master Library</a></li>
        <li class="breadcrumb-item active">Size Ranges</li>
    </ol>
    
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <p class="text-muted mb-0">Standardize size charts and breakdowns for your styles.</p>
        </div>
        <a href="{{ BASE_URL }}/master_library/size-ranges/create" class="btn btn-primary rounded-pill">
            <i class="fas fa-plus me-2"></i>New Size Range
        </a>
    </div>

    <!-- Stats or Filters can go here if needed, keeping simple for now -->
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-body">
             <form class="row gy-3 gx-3 align-items-end" method="get" action="{{ BASE_URL }}/master_library/size-ranges">
                <div class="col-md-8">
                    <label class="form-label small text-muted text-uppercase fw-bold">Search</label>
                    <input type="text" class="form-control" name="search" placeholder="Search ranges..." value="{{ filters.search }}">
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-primary w-100" type="submit">
                        <i class="fas fa-filter me-1"></i>Filter
                    </button>
                </div>
                 <div class="col-md-2">
                    <a class="btn btn-outline-secondary w-100" href="{{ BASE_URL }}/master_library/size-ranges">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-lg border-0 rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Range Name</th>
                        <th>Sizes</th>
                        <th>Breakdowns</th>
                        <th>Last Updated</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for range in ranges %}
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold">{{ range.range_name }}</div>
                                {% if range.description %}
                                    <div class="small text-muted">{{ range.description }}</div>
                                {% endif %}
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    {% for size in range.sizes_array %}
                                        <span class="badge bg-light text-dark border">{{ size }}</span>
                                    {% endfor %}
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-{{ range.breakdown_count > 0 ? 'info' : 'secondary' }}">
                                    {{ range.breakdown_count }} linked
                                </span>
                            </td>
                            <td class="text-muted small">
                                {{ range.updated_at|date('M d, Y') }}
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a href="{{ BASE_URL }}/master_library/size-ranges/edit/{{ range.size_range_id }}" class="btn btn-outline-primary rounded-circle me-1" title="Edit"><i class="fas fa-edit"></i></a>
                                    <a href="{{ BASE_URL }}/master_library/size-ranges/delete/{{ range.size_range_id }}" class="btn btn-outline-danger rounded-circle" title="Delete" onclick="return confirm('Delete range {{ range.range_name }}?');"><i class="fas fa-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">No size ranges defined yet.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
