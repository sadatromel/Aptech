{% extends "layouts/app.twig" %}

{% block title %}New Size Range | Master Library{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">New Size Range</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library/size-ranges">Size Ranges</a></li>
        <li class="breadcrumb-item active">New Size Range</li>
    </ol>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-transparent border-bottom py-3">
             <div class="h5 mb-0 text-primary"><i class="fas fa-ruler-horizontal me-2"></i>Create New Size Range</div>
        </div>
        <div class="card-body p-4">
            <form action="{{ BASE_URL }}/master_library/size-ranges/create" method="POST">
    {{ csrf_field() | raw }}
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="range_name" id="range_name" required autofocus placeholder="e.g., Men's Tops S-XML">
                            <label for="range_name">Range Name <span class="text-danger">*</span></label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" name="sizes" id="sizes" required placeholder="e.g., S, M, L, XL, XXL (comma separated)">
                            <label for="sizes">Sizes <span class="text-danger">*</span></label>
                        </div>
                        <div class="form-text mt-1">List sizes in order, separated by commas.</div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-floating">
                            <textarea class="form-control" name="description" id="description" style="height: 100px" placeholder="Optional notes about this size range"></textarea>
                            <label for="description">Description</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-4 border-top d-flex justify-content-end gap-2">
                    <a href="{{ BASE_URL }}/master_library/size-ranges" class="btn btn-light border rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="fas fa-save me-1"></i> Create Range</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
