{% extends "layouts/app.twig" %}

{% block title %}Sub-Districts (Upazila / Thana) | Master Library{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Sub-Districts (Upazila / Thana)</h1>
    
    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-1"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library">Master Library</a></li>
        <li class="breadcrumb-item active">Sub-Districts</li>
    </ol>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
            <div class="h5 mb-0 text-primary"><i class="fas fa-layer-group me-2"></i>Sub-District List</div>
            <a href="{{ BASE_URL }}/master_library/sub_districts/create" class="btn btn-primary px-4 rounded-pill"><i class="fas fa-plus me-1"></i> Add New Sub-District</a>
        </div>
        <div class="card-body p-4">
            <table id="datatablesSimple" class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Sub-District / Upazila</th>
                        <th>Upazila Name (Bangla)</th>
                        <th>Parent District</th>
                        <th>Country</th>
                        <th>Postal Code</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for sd in sub_districts %}
                    <tr>
                        <td><span class="badge bg-light text-dark border">{{ sd.sub_district_code|default('N/A') }}</span></td>
                        <td class="fw-bold">{{ sd.sub_district_name }}</td>
                        <td class="fw-medium text-dark" style="font-family: 'SolaimanLipi', 'Kalpurush', sans-serif;">{{ sd.sub_district_name_bn|default('-') }}</td>
                        <td>
                            <i class="fas fa-map-marker-alt text-danger me-1"></i>
                            {{ sd.district_name|default('N/A') }}
                            {% if sd.district_name_bn %}<span class="text-muted small">({{ sd.district_name_bn }})</span>{% endif %}
                        </td>
                        <td>{{ sd.country_name|default('N/A') }}</td>
                        <td>{{ sd.postal_code|default('N/A') }}</td>
                        <td>
                            <span class="badge rounded-pill bg-{{ sd.status == 'active' ? 'success' : 'secondary' }}">{{ sd.status|capitalize }}</span>
                        </td>
                        <td>
                            <a href="{{ BASE_URL }}/master_library/sub_districts/edit/{{ sd.sub_district_id }}" class="btn btn-warning btn-sm rounded-circle" title="Edit"><i class="fas fa-edit"></i></a>
                            <button type="button" class="btn btn-danger btn-sm rounded-circle" title="Delete" onclick="deleteSubDistrict('{{ sd.sub_district_id }}')"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No sub-districts recorded yet. Click "Add New Sub-District" to create one.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function deleteSubDistrict(id) {
        if (confirm('Are you sure you want to delete this sub-district?')) {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '{{ BASE_URL }}/master_library/sub_districts/delete';
            form.style.display = 'none';

            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'id';
            input.value = id;

            var csrfInput = document.createElement('input');
            csrfInput.type = 'hidden';
            csrfInput.name = '_csrf';
            csrfInput.value = document.querySelector('meta[name="csrf-token"]')?.content || '';

            form.appendChild(input);
            form.appendChild(csrfInput);
            document.body.appendChild(form);
            form.submit();
        }
    }
</script>
{% endblock %}
