{% extends "layouts/app.twig" %}

{% block title %}Add New Sub-District | Master Library{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Add New Sub-District (Upazila / Thana)</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library">Master Library</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library/sub_districts">Sub-Districts</a></li>
        <li class="breadcrumb-item active">Add New</li>
    </ol>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-transparent border-bottom py-3">
            <h5 class="mb-0 text-primary"><i class="fas fa-plus me-1"></i> New Sub-District Details</h5>
        </div>
        <div class="card-body p-4">
            <form action="{{ BASE_URL }}/master_library/sub_districts/create" method="POST">
                {{ csrf_field() | raw }}
                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="sub_district_name" name="sub_district_name" type="text" placeholder="Enter sub-district / upazila name" required />
                            <label for="sub_district_name">Sub-District Name (English) *</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="sub_district_name_bn" name="sub_district_name_bn" type="text" placeholder="বাংলায় নাম (যেমন: সাভার, দোহার)" />
                            <label for="sub_district_name_bn">Sub-District Name (বাংলা)</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="sub_district_code" name="sub_district_code" type="text" placeholder="Enter code" />
                            <label for="sub_district_code">Sub-District Code</label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select class="form-select" id="district_id" name="district_id" required>
                                <option value="">Select Parent District</option>
                                {% for district in districts %}
                                <option value="{{ district.district_id }}">{{ district.district_name }} {% if district.district_name_bn %}({{ district.district_name_bn }}){% endif %}</option>
                                {% endfor %}
                            </select>
                            <label for="district_id">Parent District *</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="postal_code" name="postal_code" type="text" placeholder="Enter postal code" />
                            <label for="postal_code">Postal / Zip Code</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-floating">
                            <select class="form-select" id="status" name="status">
                                <option value="active" selected>Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                            <label for="status">Status</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 mb-0">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="{{ BASE_URL }}/master_library/sub_districts" class="btn btn-light me-md-2 px-4 rounded-pill border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 rounded-pill"><i class="fas fa-save me-1"></i> Save Sub-District</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
