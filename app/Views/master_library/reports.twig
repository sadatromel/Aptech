{% extends "layouts/app.twig" %}

{% block title %}Master Library Reports Hub{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-1 font-weight-bold text-gray-800">
                <i class="fas fa-book text-info me-2"></i>Master Library Reports Center
            </h2>
            <p class="text-muted small mb-0">System Setup Directory, Buyer & Vendor Masters, Product Natures, Departments & Lines</p>
        </div>
        <a href="{{ BASE_URL }}/master_library" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Master Library
        </a>
    </div>

    <div class="row">
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-info text-white rounded-circle p-3 me-3">
                            <i class="fas fa-user-tie fa-lg"></i>
                        </div>
                        <div>
                            <h5 class="card-title h6 mb-1 font-weight-bold">Buyers & Brands Directory</h5>
                            <span class="badge bg-light text-info">Buyers</span>
                        </div>
                    </div>
                    <p class="card-text small text-muted">Complete buyer registry, associated brands, contact persons, and country locations.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <a href="{{ BASE_URL }}/master_library/buyers" class="btn btn-sm btn-outline-info w-100">Open Buyers Report</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-success text-white rounded-circle p-3 me-3">
                            <i class="fas fa-sitemap fa-lg"></i>
                        </div>
                        <div>
                            <h5 class="card-title h6 mb-1 font-weight-bold">Factory & Line Setup Register</h5>
                            <span class="badge bg-light text-success">Setup</span>
                        </div>
                    </div>
                    <p class="card-text small text-muted">Factory units, floors, production line counts, target machine configurations, and supervisors.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <a href="{{ BASE_URL }}/master_library/production_lines" class="btn btn-sm btn-outline-success w-100">Open Line Setup Report</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-secondary text-white rounded-circle p-3 me-3">
                            <i class="fas fa-tshirt fa-lg"></i>
                        </div>
                        <div>
                            <h5 class="card-title h6 mb-1 font-weight-bold">Garments Items & Categories</h5>
                            <span class="badge bg-light text-secondary">Products</span>
                        </div>
                    </div>
                    <p class="card-text small text-muted">Garment item types, product natures, categories, departments, and SMV baseline master.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <a href="{{ BASE_URL }}/master_library/garments_items" class="btn btn-sm btn-outline-secondary w-100">Open Garment Items Report</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
