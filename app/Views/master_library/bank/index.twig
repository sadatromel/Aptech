{% extends "layouts/app.twig" %}

{% block title %}Banks | Master Library{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Banks</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library">Master Library</a></li>
        <li class="breadcrumb-item active">Banks</li>
    </ol>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
            <div class="h5 mb-0"><i class="fas fa-table me-2"></i>Bank List</div>
            <div class="d-flex">
                 <button type="button" class="btn btn-success px-4 rounded-pill me-2" data-bs-toggle="modal" data-bs-target="#importModal"><i class="fas fa-file-csv me-1"></i> Import CSV</button>
                <a href="{{ BASE_URL }}/master_library/banks/create" class="btn btn-primary px-4 rounded-pill"><i class="fas fa-plus me-1"></i> Add New</a>
            </div>
        </div>
        <div class="card-body p-4">
            <table id="datatablesSimple" class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Account Number</th>
                        <th>Branch</th>
                        <th>Address</th>
                        <th>SWIFT</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for bank in banks %}
                    <tr>
                        <td>{{ bank.bank_name }}</td>
                        <td>{{ bank.account_number }}</td>
                        <td>{{ bank.branch_name }}</td>
                        <td>{{ bank.address }}</td>
                        <td>{{ bank.swift_code }}</td>
                        <td>
                            <span class="badge rounded-pill bg-{{ bank.bank_status == 'Active' ? 'success' : 'secondary' }}">{{ bank.bank_status|capitalize }}</span>
                        </td>
                        <td>
                            <a href="{{ BASE_URL }}/master_library/banks/edit/{{ bank.bank_id }}" class="btn btn-warning btn-sm rounded-circle" title="Edit"><i class="fas fa-edit"></i></a>
                            <form action="{{ BASE_URL }}/master_library/banks/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure?');">
    {{ csrf_field() | raw }}
                                <input type="hidden" name="id" value="{{ bank.bank_id }}">
                                <button type="submit" class="btn btn-danger btn-sm rounded-circle" title="Delete"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Import Modal -->
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="importModalLabel">Import Banks from CSV</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="{{ BASE_URL }}/master_library/banks/import" method="POST" enctype="multipart/form-data">
    {{ csrf_field() | raw }}
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="csv_file" class="form-label">Choose CSV File</label>
                        <input class="form-control" type="file" id="csv_file" name="csv_file" accept=".csv" required>
                        <div class="form-text">
                            Format: Name, Account Number, Branch, SWIFT, Address, Contact, Phone
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Import</button>
                </div>
            </form>
        </div>
    </div>
</div>
</div>
{% endblock %}
