{% extends "layouts/app.twig" %}

{% block title %}Edit Bank | Master Library{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Edit Bank</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library">Master Library</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library/banks">Banks</a></li>
        <li class="breadcrumb-item active">Edit Bank</li>
    </ol>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-transparent border-bottom py-3">
            <h5 class="mb-0"><i class="fas fa-edit me-1"></i> Edit Bank Details</h5>
        </div>
        <div class="card-body p-4">
            <form action="{{ BASE_URL }}/master_library/banks/edit/{{ bank.bank_id }}" method="POST">
    {{ csrf_field() | raw }}
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="bank_name" name="bank_name" type="text" placeholder="Enter bank name" required value="{{ bank.bank_name }}" />
                            <label for="bank_name">Bank Name</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input class="form-control" id="account_number" name="account_number" type="text" placeholder="Enter account number" required value="{{ bank.account_number }}" />
                            <label for="account_number">Account Number</label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="branch_name" name="branch_name" type="text" placeholder="Enter branch name" value="{{ bank.branch_name }}" />
                            <label for="branch_name">Branch Name</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                         <div class="form-floating">
                            <input class="form-control" id="swift_code" name="swift_code" type="text" placeholder="Enter SWIFT code" value="{{ bank.swift_code }}" />
                            <label for="swift_code">SWIFT Code</label>
                        </div>
                    </div>
                </div>

                 <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="form-floating">
                            <input class="form-control" id="address" name="address" type="text" placeholder="Enter address" value="{{ bank.address }}" />
                            <label for="address">Address</label>
                        </div>
                    </div>
                </div>

                 <div class="row mb-3">
                    <div class="col-md-4">
                         <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="contact_person" name="contact_person" type="text" placeholder="Enter contact person" value="{{ bank.contact_person }}" />
                            <label for="contact_person">Contact Person</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="phone" name="phone" type="text" placeholder="Enter phone" value="{{ bank.phone }}" />
                            <label for="phone">Phone</label>
                        </div>
                    </div>
                     <div class="col-md-4">
                        <div class="form-floating">
                            <select class="form-select" id="status" name="status">
                                <option value="Active" {{ bank.status == 'Active' ? 'selected' : '' }}>Active</option>
                                <option value="Inactive" {{ bank.status == 'Inactive' ? 'selected' : '' }}>Inactive</option>
                            </select>
                            <label for="status">Status</label>
                        </div>
                    </div>
                </div>


                <div class="mt-4 mb-0">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="{{ BASE_URL }}/master_library/banks" class="btn btn-light me-md-2 px-4 rounded-pill border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 rounded-pill">Update Bank</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
