{% extends "layouts/app.twig" %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Product Departments</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library">Master Library</a></li>
        <li class="breadcrumb-item active">Product Departments</li>
    </ol>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
            <div class="h5 mb-0 text-primary"><i class="fas fa-building me-2"></i>Department List</div>
            <a href="{{ parse_url(BASE_URL).path }}/master_library/product_departments/create" class="btn btn-primary px-4 rounded-pill">
                <i class="fas fa-plus me-1"></i> Add New
            </a>
        </div>
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Department Code</th>
                            <th>Department Name</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for department in departments %}
                        <tr>
                            <td>{{ department.department_code }}</td>
                            <td>{{ department.department_name }}</td>
                            <td>{{ department.description }}</td>
                            <td>
                                <span class="badge rounded-pill bg-{{ department.status == 'active' ? 'success' : 'secondary' }}">
                                    {{ department.status|capitalize }}
                                </span>
                            </td>
                            <td>
                                <a href="{{ parse_url(BASE_URL).path }}/master_library/product_departments/edit/{{ department.department_id }}" class="btn btn-warning btn-sm rounded-circle" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form action="{{ parse_url(BASE_URL).path }}/master_library/product_departments/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this department?');">
    {{ csrf_field() | raw }}
                                    <input type="hidden" name="id" value="{{ department.department_id }}">
                                    <button type="submit" class="btn btn-danger btn-sm rounded-circle" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="5" class="text-center">No departments found.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
