{% extends "layouts/app.twig" %}

{% block title %}Edit Product Nature | Master Library{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Edit Product Nature</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library">Master Library</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library/product_natures">Product Natures</a></li>
        <li class="breadcrumb-item active">Edit</li>
    </ol>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-transparent border-bottom py-3">
            <h5 class="mb-0 text-primary"><i class="fas fa-edit me-1"></i> Edit Product Nature Details</h5>
        </div>
        <div class="card-body p-4">
            <form action="{{ BASE_URL }}/master_library/product_natures/edit/{{ nature.nature_id }}" method="POST">
                {{ csrf_field() | raw }}
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="nature_code" name="nature_code" type="text" placeholder="Enter nature code" required maxlength="50" style="text-transform: uppercase;" oninput="this.value = this.value.toUpperCase()" value="{{ nature.nature_code }}" />
                            <label for="nature_code">Nature Code</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input class="form-control" id="nature_name" name="nature_name" type="text" placeholder="Enter nature name" required maxlength="100" value="{{ nature.nature_name }}" />
                            <label for="nature_name">Nature Name</label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="form-floating">
                            <textarea class="form-control" id="description" name="description" placeholder="Enter description" style="height: 100px;">{{ nature.description }}</textarea>
                            <label for="description">Description</label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select class="form-select" id="status" name="status">
                                <option value="active" {{ nature.status == 'active' ? 'selected' : '' }}>Active</option>
                                <option value="inactive" {{ nature.status == 'inactive' ? 'selected' : '' }}>Inactive</option>
                            </select>
                            <label for="status">Status</label>
                        </div>
                    </div>
                </div>

                <div class="card mb-4 border border-light-subtle rounded-3">
                    <div class="card-header bg-light py-3">
                        <h6 class="mb-0 text-secondary"><i class="fas fa-layer-group me-2"></i>Associate Product Categories</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row">
                            {% for category in categories %}
                            <div class="col-md-4 col-sm-6 mb-3">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="category_ids[]" id="cat_{{ category.category_id }}" value="{{ category.category_id }}" {% if category.category_id in selectedCategoryIds %}checked{% endif %}>
                                    <label class="form-check-label" for="cat_{{ category.category_id }}">
                                        <strong>{{ category.category_code }}</strong> - {{ category.category_name }}
                                    </label>
                                </div>
                            </div>
                            {% else %}
                            <div class="col-12 text-muted">
                                No product categories available. Please create categories first.
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <div class="mt-4 mb-0">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="{{ BASE_URL }}/master_library/product_natures" class="btn btn-light me-md-2 px-4 rounded-pill border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 rounded-pill">Update Product Nature</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
