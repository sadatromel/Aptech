{% extends "layouts/app.twig" %}

{% block title %}Product Natures | Master Library{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Product Natures</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library">Master Library</a></li>
        <li class="breadcrumb-item active">Product Natures</li>
    </ol>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
            <div class="h5 mb-0 text-primary"><i class="fas fa-leaf me-2"></i>Product Nature List</div>
            {% if canCreate('master_library', 'create_product_natures') %}
            <a href="{{ BASE_URL }}/master_library/product_natures/create" class="btn btn-primary px-4 rounded-pill">
                <i class="fas fa-plus me-1"></i> Add New
            </a>
            {% endif %}
        </div>
        <div class="card-body p-4">
            <div class="table-responsive">
                <table id="datatablesSimple" class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Nature Code</th>
                            <th>Nature Name</th>
                            <th>Description</th>
                            <th>Product Categories</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for nature in natures %}
                        <tr>
                            <td><strong>{{ nature.nature_code }}</strong></td>
                            <td>{{ nature.nature_name }}</td>
                            <td>{{ nature.description }}</td>
                            <td>
                                {% if nature.categories %}
                                    <span class="text-secondary">{{ nature.categories }}</span>
                                {% else %}
                                    <span class="text-muted small">None</span>
                                {% endif %}
                            </td>
                            <td>
                                <span class="badge rounded-pill bg-{{ nature.status == 'active' ? 'success' : 'secondary' }}">
                                    {{ nature.status|capitalize }}
                                </span>
                            </td>
                            <td>
                                {% if canEdit('master_library', 'edit_product_natures') %}
                                <a href="{{ BASE_URL }}/master_library/product_natures/edit/{{ nature.nature_id }}" class="btn btn-warning btn-sm rounded-circle" title="Edit">
                                    <i class="fas fa-edit text-white"></i>
                                </a>
                                {% endif %}
                                
                                {% if canDelete('master_library', 'delete_product_natures') %}
                                <form action="{{ BASE_URL }}/master_library/product_natures/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this product nature?');">
                                    {{ csrf_field() | raw }}
                                    <input type="hidden" name="id" value="{{ nature.nature_id }}">
                                    <button type="submit" class="btn btn-danger btn-sm rounded-circle" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                                {% endif %}
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No product natures found.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
