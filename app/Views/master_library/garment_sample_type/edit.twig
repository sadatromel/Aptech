{% extends "layouts/app.twig" %}

{% block title %}Edit Garment Sample Type | Master Library{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Edit Garment Sample Type</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library">Master Library</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library/garment_sample_types">Garment Sample Types</a></li>
        <li class="breadcrumb-item active">Edit</li>
    </ol>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-transparent border-bottom py-3">
            <h5 class="mb-0 text-primary"><i class="fas fa-edit me-1"></i> Edit Garment Sample Type Details</h5>
        </div>
        <div class="card-body p-4">
            <form action="{{ BASE_URL }}/master_library/garment_sample_types/edit/{{ sampleType.sample_type_id }}" method="POST">
                {{ csrf_field() | raw }}
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="sample_type_code" name="sample_type_code" type="text" placeholder="Enter sample type code" required maxlength="50" style="text-transform: uppercase;" oninput="this.value = this.value.toUpperCase()" value="{{ sampleType.sample_type_code }}" />
                            <label for="sample_type_code">Sample Type Code</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input class="form-control" id="sample_type_name" name="sample_type_name" type="text" placeholder="Enter sample type name" required maxlength="255" value="{{ sampleType.sample_type_name }}" />
                            <label for="sample_type_name">Sample Type Name</label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="form-floating">
                            <textarea class="form-control" id="description" name="description" placeholder="Enter description" style="height: 100px;">{{ sampleType.description }}</textarea>
                            <label for="description">Description</label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select class="form-select" id="status" name="status">
                                <option value="active" {{ sampleType.status == 'active' ? 'selected' : '' }}>Active</option>
                                <option value="inactive" {{ sampleType.status == 'inactive' ? 'selected' : '' }}>Inactive</option>
                            </select>
                            <label for="status">Status</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 mb-0">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="{{ BASE_URL }}/master_library/garment_sample_types" class="btn btn-light me-md-2 px-4 rounded-pill border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 rounded-pill">Update Sample Type</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
