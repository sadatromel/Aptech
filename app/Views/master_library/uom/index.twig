{% extends "layouts/app.twig" %}

{% block title %}Units of Measure (UOM) | Master Library{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Units of Measure (UOM)</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library">Master Library</a></li>
        <li class="breadcrumb-item active">UOM</li>
    </ol>

    {% if session.success_message %}
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i>{{ session.success_message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    {% if session.error_message %}
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>{{ session.error_message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
            <div class="h5 mb-0 text-primary"><i class="fas fa-ruler me-2"></i>Unit of Measure List</div>
            {% if canCreate('master_library', 'create_uoms') %}
            <a href="{{ BASE_URL }}/master_library/uoms/create" class="btn btn-primary px-4 rounded-pill">
                <i class="fas fa-plus me-1"></i> Add New UOM
            </a>
            {% endif %}
        </div>
        <div class="card-body p-4">
            <div class="table-responsive">
                <table id="datatablesSimple" class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for uom in uoms %}
                        <tr>
                            <td><strong>{{ uom.uom_code }}</strong></td>
                            <td>{{ uom.uom_name }}</td>
                            <td>{{ uom.description|default('-') }}</td>
                            <td>
                                <span class="badge rounded-pill bg-{{ uom.status == 'active' ? 'success' : 'secondary' }}">
                                    {{ uom.status|capitalize }}
                                </span>
                            </td>
                            <td>
                                {% if canEdit('master_library', 'edit_uoms') %}
                                <a href="{{ BASE_URL }}/master_library/uoms/edit/{{ uom.uom_id }}" class="btn btn-warning btn-sm rounded-circle" title="Edit">
                                    <i class="fas fa-edit text-white"></i>
                                </a>
                                {% endif %}
                                
                                {% if canDelete('master_library', 'delete_uoms') %}
                                <form action="{{ BASE_URL }}/master_library/uoms/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this Unit of Measure?');">
                                    {{ csrf_field() | raw }}
                                    <input type="hidden" name="id" value="{{ uom.uom_id }}">
                                    <button type="submit" class="btn btn-danger btn-sm rounded-circle" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                                {% endif %}
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No units of measure found.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
