{% extends "layouts/app.twig" %}

{% block title %}Districts | Master Library{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Districts</h1>
    
    {% if flash_success %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-1"></i> {{ flash_success }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library">Master Library</a></li>
        <li class="breadcrumb-item active">Districts</li>
    </ol>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
            <div class="h5 mb-0 text-primary"><i class="fas fa-map-marked-alt me-2"></i>District List</div>
            <a href="{{ BASE_URL }}/master_library/districts/create" class="btn btn-primary px-4 rounded-pill"><i class="fas fa-plus me-1"></i> Add New District</a>
        </div>
        <div class="card-body p-4">
            <table id="datatablesSimple" class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>District Code</th>
                        <th>District Name</th>
                        <th>District Name (Bangla)</th>
                        <th>Division / State</th>
                        <th>Country</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for district in districts %}
                    <tr>
                        <td><span class="badge bg-light text-dark border">{{ district.district_code|default('N/A') }}</span></td>
                        <td class="fw-bold">{{ district.district_name }}</td>
                        <td class="fw-medium text-dark" style="font-family: 'SolaimanLipi', 'Kalpurush', sans-serif;">{{ district.district_name_bn|default('-') }}</td>
                        <td>{{ district.division_state|default('N/A') }}</td>
                        <td>{{ district.country_name|default('N/A') }}</td>
                        <td>
                            <span class="badge rounded-pill bg-{{ district.status == 'active' ? 'success' : 'secondary' }}">{{ district.status|capitalize }}</span>
                        </td>
                        <td>
                            <a href="{{ BASE_URL }}/master_library/districts/edit/{{ district.district_id }}" class="btn btn-warning btn-sm rounded-circle" title="Edit"><i class="fas fa-edit"></i></a>
                            <button type="button" class="btn btn-danger btn-sm rounded-circle" title="Delete" onclick="deleteDistrict('{{ district.district_id }}')"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">No districts recorded yet. Click "Add New District" to add one.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function deleteDistrict(id) {
        if (confirm('Are you sure you want to delete this district? This will also remove associated sub-districts.')) {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '{{ BASE_URL }}/master_library/districts/delete';
            form.style.display = 'none';

            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'id';
            input.value = id;

            var csrfInput = document.createElement('input');
            csrfInput.type = 'hidden';
            csrfInput.name = '_csrf';
            csrfInput.value = document.querySelector('meta[name="csrf-token"]')?.content || '';

            form.appendChild(input);
            form.appendChild(csrfInput);
            document.body.appendChild(form);
            form.submit();
        }
    }
</script>
{% endblock %}
