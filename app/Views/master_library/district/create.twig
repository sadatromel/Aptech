{% extends "layouts/app.twig" %}

{% block title %}Add New District | Master Library{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Add New District</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library">Master Library</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library/districts">Districts</a></li>
        <li class="breadcrumb-item active">Add New</li>
    </ol>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-transparent border-bottom py-3">
            <h5 class="mb-0 text-primary"><i class="fas fa-plus me-1"></i> New District Details</h5>
        </div>
        <div class="card-body p-4">
            <form action="{{ BASE_URL }}/master_library/districts/create" method="POST">
                {{ csrf_field() | raw }}
                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="district_name" name="district_name" type="text" placeholder="Enter district name" required />
                            <label for="district_name">District Name (English) *</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="district_name_bn" name="district_name_bn" type="text" placeholder="বাংলায় নাম (যেমন: ঢাকা, গাজীপুর)" />
                            <label for="district_name_bn">District Name (বাংলা)</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="district_code" name="district_code" type="text" placeholder="Enter district code" />
                            <label for="district_code">District Code (e.g. DHK, CTG)</label>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="form-floating mb-3 mb-md-0">
                            <input class="form-control" id="division_state" name="division_state" type="text" placeholder="Enter division or state" />
                            <label for="division_state">Division / State</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <select class="form-select" id="country_id" name="country_id">
                                <option value="">Select Country</option>
                                {% for country in countries %}
                                <option value="{{ country.country_id }}">{{ country.country_name }}</option>
                                {% endfor %}
                            </select>
                            <label for="country_id">Country</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating">
                            <select class="form-select" id="status" name="status">
                                <option value="active" selected>Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                            <label for="status">Status</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 mb-0">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="{{ BASE_URL }}/master_library/districts" class="btn btn-light me-md-2 px-4 rounded-pill border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 rounded-pill"><i class="fas fa-save me-1"></i> Save District</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
