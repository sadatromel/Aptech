{% extends "layouts/app.twig" %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Edit Buyer Brand</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library">Master Library</a></li>
        <li class="breadcrumb-item"><a href="{{ parse_url(BASE_URL).path }}/master_library/buyer_brands">Buyer Brands</a></li>
        <li class="breadcrumb-item active">{{ brand.brand_name }}</li>
    </ol>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-transparent border-bottom py-3">
             <div class="h5 mb-0 text-primary"><i class="fas fa-edit me-2"></i>Edit Buyer Brand: {{ brand.brand_name }}</div>
        </div>
        <div class="card-body p-4">
            <form action="{{ parse_url(BASE_URL).path }}/master_library/buyer_brands/update/{{ brand.brand_id }}" method="POST">
    {{ csrf_field() | raw }}
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="buyer_id" class="form-label">Buyer <span class="text-danger">*</span></label>
                        <select class="form-select" id="buyer_id" name="buyer_id" required>
                            <option value="">Select Buyer</option>
                            {% for buyer in buyers %}
                            <option value="{{ buyer.buyer_id }}" {{ buyer.buyer_id == brand.buyer_id ? 'selected' : '' }}>{{ buyer.buyer_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="brand_name" class="form-label">Brand Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="brand_name" name="brand_name" value="{{ brand.brand_name }}" required>
                    </div>
                    <div class="col-md-6">
                        <label for="description" class="form-label">Description</label>
                        <textarea class="form-control" id="description" name="description" rows="2">{{ brand.description }}</textarea>
                    </div>
                    <div class="col-md-6">
                        <label for="status" class="form-label">Status</label>
                        <select class="form-select" id="status" name="status">
                            <option value="active" {{ brand.status == 'active' ? 'selected' : '' }}>Active</option>
                            <option value="inactive" {{ brand.status == 'inactive' ? 'selected' : '' }}>Inactive</option>
                        </select>
                    </div>
                </div>

                <div class="mt-4 mb-0">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="{{ parse_url(BASE_URL).path }}/master_library/buyer_brands" class="btn btn-light me-md-2 px-4 rounded-pill border">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 rounded-pill"><i class="fas fa-save me-1"></i> Update Brand</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
