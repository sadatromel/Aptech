{% extends "layouts/app.twig" %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Buyer Brands</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/master_library">Master Library</a></li>
        <li class="breadcrumb-item active">Buyer Brands</li>
    </ol>

    <div class="card shadow-lg border-0 rounded-3 mb-4">
        <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
            <div class="h5 mb-0 text-primary"><i class="fas fa-tags me-2"></i>Buyer Brands List</div>
            <a href="{{ parse_url(BASE_URL).path }}/master_library/buyer_brands/create" class="btn btn-primary px-4 rounded-pill">
                <i class="fas fa-plus me-1"></i> Add New
            </a>
        </div>
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Buyer</th>
                            <th>Brand Name</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for brand in brands %}
                        <tr>
                            <td>{{ brand.buyer_name }}</td>
                            <td>{{ brand.brand_name }}</td>
                            <td>{{ brand.description }}</td>
                            <td>
                                <span class="badge rounded-pill bg-{{ brand.status == 'active' ? 'success' : 'secondary' }}">
                                    {{ brand.status|capitalize }}
                                </span>
                            </td>
                            <td>
                                <a href="{{ parse_url(BASE_URL).path }}/master_library/buyer_brands/edit/{{ brand.brand_id }}" class="btn btn-warning btn-sm rounded-circle" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form action="{{ parse_url(BASE_URL).path }}/master_library/buyer_brands/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this brand?');">
    {{ csrf_field() | raw }}
                                    <input type="hidden" name="id" value="{{ brand.brand_id }}">
                                    <button type="submit" class="btn btn-danger btn-sm rounded-circle" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="5" class="text-center">No brands found.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
