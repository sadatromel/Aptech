{% extends "layouts/app.twig" %}

{% block title %}Letters of Credit (L/C) Management • Aptech ERP{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="fas fa-university text-danger me-2"></i>Letters of Credit (L/C) Management
            </h1>
            <p class="text-muted small mb-0">Master L/Cs, Back-to-Back L/Cs, Opening & Advising Banks, Credit Utilization, and Expiry Tracking.</p>
        </div>
        <div>
            <button class="btn btn-primary rounded-pill px-3 shadow-sm btn-sm" data-bs-toggle="modal" data-bs-target="#createLcModal">
                <i class="fas fa-plus me-1"></i>New Letter of Credit
            </button>
        </div>
    </div>

    <!-- Summary KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 bg-primary text-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-white-50 small text-uppercase fw-semibold">Active L/C Limit</span>
                        <h3 class="fw-bold mb-0 mt-1">${{ stats.total_lc_sum|number_format(2) }}</h3>
                    </div>
                    <i class="fas fa-file-invoice-dollar fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 bg-warning text-dark p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-dark-50 small text-uppercase fw-semibold">Utilized Value</span>
                        <h3 class="fw-bold mb-0 mt-1">${{ stats.utilized_sum|number_format(2) }}</h3>
                    </div>
                    <i class="fas fa-chart-pie fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 bg-success text-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-white-50 small text-uppercase fw-semibold">Available Credit</span>
                        <h3 class="fw-bold mb-0 mt-1">${{ stats.available_sum|number_format(2) }}</h3>
                    </div>
                    <i class="fas fa-check-circle fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 bg-dark text-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-white-50 small text-uppercase fw-semibold">Total L/Cs Logged</span>
                        <h3 class="fw-bold mb-0 mt-1">{{ stats.total_count }}</h3>
                    </div>
                    <i class="fas fa-layer-group fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Table Card -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 pt-3 px-3">
            <form method="GET" action="{{ BASE_URL }}/commercial/letters-of-credit" class="row g-2">
                <div class="col-md-9">
                    <input type="text" name="search" class="form-control" placeholder="Search by L/C #, Opening Bank, or Buyer..." value="{{ filters.search }}">
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100">Filter</button>
                    {% if filters.search %}
                    <a href="{{ BASE_URL }}/commercial/letters-of-credit" class="btn btn-outline-secondary">Reset</a>
                    {% endif %}
                </div>
            </form>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small">
                        <tr>
                            <th class="ps-3">L/C Number</th>
                            <th>Type</th>
                            <th>Buyer</th>
                            <th>Opening Bank</th>
                            <th class="text-end">L/C Amount ($)</th>
                            <th class="text-end">Utilized ($)</th>
                            <th>Shipment / Expiry</th>
                            <th class="text-end pe-3">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if lcs is empty %}
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="fas fa-university fa-3x mb-3 text-secondary opacity-50 d-block"></i>
                                No Letters of Credit (L/C) records found.
                            </td>
                        </tr>
                        {% else %}
                        {% for lc in lcs %}
                        <tr>
                            <td class="ps-3 fw-bold text-primary">{{ lc.lc_number }}</td>
                            <td><span class="badge bg-light text-dark border">{{ lc.lc_type|replace({'_': ' '})|title }}</span></td>
                            <td><span class="fw-semibold">{{ lc.buyer_name ?? 'General' }}</span></td>
                            <td><small class="fw-semibold text-dark">{{ lc.opening_bank ?: '-' }}</small></td>
                            <td class="text-end fw-bold text-success">${{ lc.lc_amount|number_format(2) }}</td>
                            <td class="text-end fw-bold text-warning">${{ lc.utilized_amount|number_format(2) }}</td>
                            <td>
                                <small class="d-block text-dark fw-semibold">Ship: {{ lc.shipment_date ? lc.shipment_date|date('d M Y') : '-' }}</small>
                                <small class="text-muted">Exp: {{ lc.expiry_date ? lc.expiry_date|date('d M Y') : '-' }}</small>
                            </td>
                            <td class="text-end pe-3">
                                <span class="badge rounded-pill {% if lc.status == 'active' %}bg-success{% elseif lc.status == 'amendment' %}bg-warning text-dark{% else %}bg-secondary{% endif %}">
                                    {{ lc.status|capitalize }}
                                </span>
                            </td>
                        </tr>
                        {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal: New Letter of Credit -->
<div class="modal fade" id="createLcModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-dark text-white rounded-top-4">
                <h5 class="modal-title fw-bold"><i class="fas fa-university me-2"></i>Record New Letter of Credit (L/C)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="POST" action="{{ BASE_URL }}/commercial/letters-of-credit">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">L/C Number</label>
                            <input type="text" name="lc_number" class="form-control" placeholder="e.g. LC-2026-9908" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">L/C Type</label>
                            <select name="lc_type" class="form-select">
                                <option value="master_lc">Master L/C</option>
                                <option value="back_to_back_lc">Back-to-Back L/C</option>
                                <option value="contract">Sales Contract / Deferred</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Buyer / Customer</label>
                            <select name="buyer_id" class="form-select">
                                <option value="0">-- Select Buyer --</option>
                                {% for b in buyers %}
                                <option value="{{ b.buyer_id }}">{{ b.buyer_name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">L/C Amount ($)</label>
                            <input type="number" step="0.01" name="lc_amount" class="form-control" placeholder="0.00" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Opening Bank</label>
                            <input type="text" name="opening_bank" class="form-control" placeholder="e.g. HSBC London / Standard Chartered">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Advising / Negotiating Bank</label>
                            <input type="text" name="advising_bank" class="form-control" placeholder="e.g. Islami Bank / DBBL Dhaka">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Issue Date</label>
                            <input type="date" name="issue_date" class="form-control" value="{{ "now"|date("Y-m-d") }}">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Last Shipment Date</label>
                            <input type="date" name="shipment_date" class="form-control">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">L/C Expiry Date</label>
                            <input type="date" name="expiry_date" class="form-control">
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="fas fa-save me-1"></i>Save L/C Record</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
