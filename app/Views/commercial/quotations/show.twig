{% extends "layouts/app.twig" %}

{% block title %}Quotation Details{% endblock %}

{% block content %}
    <div class="pt-3 pb-2 mb-3 border-bottom d-flex justify-content-between">
        <h1 class="h2">Quotation #{{ quotation.quotation_no }}</h1>
        <div>
             <a href="{{ BASE_URL }}/commercial/quotations" class="btn btn-secondary">Back</a>
             <a href="#" class="btn btn-primary" onclick="window.print()">Print</a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h5>Customer Details</h5>
                    <p>
                        <strong>{{ quotation.customer_name }}</strong><br>
                        {{ quotation.customer_address }}<br>
                        Contact: {{ quotation.attention_to }}
                    </p>
                </div>
                <div class="col-md-6 text-end">
                    <p>
                        <strong>Date:</strong> {{ quotation.quotation_date|date('Y-m-d') }}<br>
                        <strong>Valid Until:</strong> {{ quotation.valid_date ? quotation.valid_date|date('Y-m-d') : 'N/A' }}<br>
                        <strong>Status:</strong> {{ quotation.status|capitalize }}
                    </p>
                </div>
            </div>
        </div>
    </div>

    <h5>Items</h5>
    <div class="table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Style No</th>
                    <th>Description</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                {% for line in lines %}
                <tr>
                    <td>{{ line.line_number }}</td>
                    <td>{{ line.style_no }}</td>
                    <td>{{ line.description }}</td>
                    <td>{{ line.quantity }}</td>
                    <td>{{ line.unit_price|number_format(2) }}</td>
                    <td>{{ (line.quantity * line.unit_price)|number_format(2) }}</td>
                </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                 <tr>
                     <td colspan="5" class="text-end"><strong>Grand Total</strong></td>
                     <td><strong>{{ quotation.grand_total|number_format(2) }} {{ quotation.currency }}</strong></td>
                 </tr>
            </tfoot>
        </table>
    </div>
    
    {% if quotation.terms_conditions %}
    <div class="mt-4">
        <h6>Terms & Conditions</h6>
        <p>{{ quotation.terms_conditions|nl2br }}</p>
    </div>
    {% endif %}

{% endblock %}
