{% extends "layouts/app.twig" %}

{% block title %}Create Quotation{% endblock %}

{% block content %}
    <div class="pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Create Quotation</h1>
    </div>

    <form action="{{ BASE_URL }}/commercial/quotations/store" method="POST">
    {{ csrf_field() | raw }}
        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Quotation No</label>
                <input type="text" class="form-control" name="quotation_no" value="{{ next_quotation_no }}" readonly>
            </div>
            <div class="col-md-4">
                <label class="form-label">Date</label>
                <input type="date" class="form-control" name="quotation_date" value="{{ 'now'|date('Y-m-d') }}" required>
            </div>
            <div class="col-md-4">
                <label class="form-label">Customer</label>
                <select class="form-select" name="customer_id" required>
                    <option value="">Select Customer</option>
                    {% for customer in customers %}
                    <option value="{{ customer.customer_id }}">{{ customer.customer_name }} ({{ customer.customer_code }})</option>
                    {% endfor %}
                </select>
            </div>
        </div>
        
        <!-- Dynamic Lines Section (Simplified for brevity) -->
        <h5>Items</h5>
        <div id="lines-container">
            <div class="row mb-2 line-item">
                 <div class="col-md-3">
                     <input type="text" class="form-control" name="lines[0][style_no]" placeholder="Style No" required>
                 </div>
                 <div class="col-md-3">
                     <input type="text" class="form-control" name="lines[0][description]" placeholder="Description">
                 </div>
                 <div class="col-md-2">
                     <input type="number" class="form-control" name="lines[0][quantity]" placeholder="Qty" required>
                 </div>
                 <div class="col-md-2">
                     <input type="number" step="0.01" class="form-control" name="lines[0][unit_price]" placeholder="Unit Price" required>
                 </div>
            </div>
        </div>
        <button type="button" class="btn btn-secondary btn-sm mb-3" onclick="addLine()">Add Line</button>

        <div class="mb-3">
            <button type="submit" class="btn btn-primary">Create Quotation</button>
            <a href="{{ BASE_URL }}/commercial/quotations" class="btn btn-light">Cancel</a>
        </div>
    </form>
{% endblock %}

{% block scripts %}
<script>
    let lineCount = 1;
    function addLine() {
        // Logic to append new line inputs with index lineCount++
    }
</script>
{% endblock %}
