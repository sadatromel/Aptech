{% extends "layouts/app.twig" %}

{% block title %}Sales Order Details{% endblock %}

{% block content %}
    <div class="pt-3 pb-2 mb-3 border-bottom d-flex justify-content-between">
        <h1 class="h2">Sales Order #{{ salesOrder.so_no }}</h1>
        <div>
             <a href="/commercial/sales_orders" class="btn btn-secondary">Back</a>
             <a href="#" class="btn btn-primary" onclick="window.print()">Print</a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h5>Customer</h5>
                    <p>
                        <strong>{{ salesOrder.customer_name }}</strong><br>
                        {{ salesOrder.shipping_address }}
                    </p>
                </div>
                 <div class="col-md-6 text-end">
                    <p>
                        <strong>Order Date:</strong> {{ salesOrder.order_date|date('Y-m-d') }}<br>
                        <strong>Delivery Date:</strong> {{ salesOrder.delivery_date ? salesOrder.delivery_date|date('Y-m-d') : 'N/A' }}<br>
                        <strong>Quotation Ref:</strong> {{ salesOrder.quotation_no }}<br>
                        <strong>Status:</strong> {{ salesOrder.status|capitalize }}
                    </p>
                </div>
            </div>
        </div>
    </div>

    <h5>Items</h5>
    <div class="table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Style No</th>
                    <th>Description</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                {% for line in lines %}
                <tr>
                    <td>{{ line.line_number }}</td>
                    <td>{{ line.style_no }}</td>
                    <td>{{ line.description }}</td>
                    <td>{{ line.quantity }}</td>
                    <td>{{ line.unit_price|number_format(2) }}</td>
                    <td>{{ (line.quantity * line.unit_price)|number_format(2) }}</td>
                </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                 <tr>
                     <td colspan="5" class="text-end"><strong>Grand Total</strong></td>
                     <td><strong>{{ salesOrder.grand_total|number_format(2) }} {{ salesOrder.currency }}</strong></td>
                 </tr>
            </tfoot>
        </table>
    </div>
{% endblock %}
