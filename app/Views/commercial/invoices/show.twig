{% extends 'layouts/app.twig' %}

{% block title %}Commercial • Invoice #{{ invoice.invoice_number }}{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="{{ BASE_URL }}/commercial/invoices" class="btn btn-sm btn-outline-secondary mb-3">
                <i class="fas fa-arrow-left me-2"></i>Back to List
            </a>
            <h1 class="h3 mb-1">Invoice #{{ invoice.invoice_number }}</h1>
            <p class="text-muted">Detailed view and payment history for this invoice.</p>
        </div>
        <div class="btn-group">
            <a href="{{ BASE_URL }}/commercial/invoices/print/{{ invoice.id }}" target="_blank" class="btn btn-outline-secondary rounded-pill px-4 me-2 shadow-sm">
                <i class="fas fa-print me-2"></i>Print
            </a>
            {% if invoice.status != 'paid' %}
                <button type="button" class="btn btn-success rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#paymentModal">
                    <i class="fas fa-hand-holding-usd me-2"></i>Receive Payment
                </button>
            {% endif %}
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Invoice Card -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-body p-4">
                    <div class="row mb-4">
                        <div class="col-sm-6">
                            <h6 class="text-muted text-uppercase small fw-bold mb-3">Customer Information</h6>
                            <h5 class="mb-1 fw-bold">{{ invoice.customer_name }}</h5>
                            <p class="text-muted mb-0">
                                {{ invoice.address|nl2br }}<br>
                                {{ invoice.phone }}<br>
                                {{ invoice.email }}
                            </p>
                        </div>
                        <div class="col-sm-6 text-sm-end">
                            <h6 class="text-muted text-uppercase small fw-bold mb-3">Invoice Details</h6>
                            <div class="mb-1">
                                <span class="text-muted me-2">Date:</span>
                                <span class="fw-bold">{{ invoice.invoice_date|date('d M Y') }}</span>
                            </div>
                            <div class="mb-1">
                                <span class="text-muted me-2">Due Date:</span>
                                <span class="fw-bold">{{ invoice.due_date|date('d M Y') }}</span>
                            </div>
                            <div class="mb-1">
                                <span class="text-muted me-2">Status:</span>
                                <span class="badge rounded-pill bg-{{ invoice.status == 'paid' ? 'success' : (invoice.status == 'partial' ? 'info' : 'warning text-dark') }}">
                                    {{ invoice.status|capitalize }}
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-3">Description</th>
                                    <th class="text-center" style="width: 15%;">Quantity</th>
                                    <th class="text-end" style="width: 20%;">Unit Price</th>
                                    <th class="text-end pe-3" style="width: 20%;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in items %}
                                    <tr>
                                        <td class="ps-3">{{ item.description }}</td>
                                        <td class="text-center">{{ item.quantity }}</td>
                                        <td class="text-end">${{ item.unit_price|number_format(2) }}</td>
                                        <td class="text-end pe-3 fw-bold">${{ item.total|number_format(2) }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                            <tfoot class="border-top-0">
                                <tr>
                                    <td colspan="3" class="text-end border-0 pt-4">Subtotal</td>
                                    <td class="text-end pe-3 border-0 pt-4 fw-bold">${{ (invoice.total_amount - invoice.tax_amount + invoice.discount)|number_format(2) }}</td>
                                </tr>
                                <tr>
                                    <td colspan="3" class="text-end border-0">Tax ({{ invoice.tax_rate }}%)</td>
                                    <td class="text-end pe-3 border-0 text-danger fw-bold">${{ invoice.tax_amount|number_format(2) }}</td>
                                </tr>
                                <tr>
                                    <td colspan="3" class="text-end border-0">Discount</td>
                                    <td class="text-end pe-3 border-0 text-success fw-bold">-${{ invoice.discount|number_format(2) }}</td>
                                </tr>
                                <tr class="h5">
                                    <td colspan="3" class="text-end border-0 pt-3 fw-bold text-dark">Grand Total</td>
                                    <td class="text-end pe-3 border-0 pt-3 fw-bold text-primary">${{ invoice.total_amount|number_format(2) }}</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold">Payment History</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Date</th>
                                    <th>Method</th>
                                    <th>Reference</th>
                                    <th class="text-end pe-4">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for payment in payments %}
                                    <tr>
                                        <td class="ps-4">{{ payment.payment_date|date('d M Y') }}</td>
                                        <td>{{ payment.payment_method|capitalize }}</td>
                                        <td>{{ payment.reference_number ?: '-' }}</td>
                                        <td class="text-end pe-4 fw-bold text-success">${{ payment.payment_amount|number_format(2) }}</td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted small">No payments recorded yet.</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Summary -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 mb-4 bg-primary text-white overflow-hidden position-relative">
                <div class="card-body p-4 position-relative z-index-1">
                    <h6 class="text-white-50 text-uppercase small fw-bold mb-3">Balance Summary</h6>
                    <div class="mb-4">
                        <div class="small text-white-50">Grand Total</div>
                        <div class="h3 fw-bold">${{ invoice.total_amount|number_format(2) }}</div>
                    </div>
                    <div class="mb-4">
                        <div class="small text-white-50">Total Paid</div>
                        <div class="h3 fw-bold">${{ invoice.paid_amount|number_format(2) }}</div>
                    </div>
                    <hr class="bg-white-50">
                    <div>
                        <div class="small text-white-50">Outstanding Balance</div>
                        <div class="h2 fw-bold mb-0">${{ invoice.balance|number_format(2) }}</div>
                    </div>
                </div>
                <i class="fas fa-dollar-sign position-absolute bottom-0 end-0 mb-n3 me-n3 opacity-10" style="font-size: 8rem;"></i>
            </div>

            {% if invoice.notes %}
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase small fw-bold mb-3">Notes / Terms</h6>
                        <p class="mb-0 small">{{ invoice.notes|nl2br }}</p>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<!-- Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow card">
            <div class="modal-header border-0 pb-0 card-header bg-white py-3 px-4">
                <h5 class="modal-title fw-bold">Receive Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="paymentForm">
                <div class="modal-body p-4 card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-bold">Payment Amount <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" name="payment_amount" class="form-control" required min="1" max="{{ invoice.balance }}" step="0.01" value="{{ invoice.balance }}">
                            </div>
                            <div class="form-text text-muted small">Outstanding balance is ${{ invoice.balance|number_format(2) }}</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Payment Date <span class="text-danger">*</span></label>
                            <input type="date" name="payment_date" class="form-control" required value="{{ "now"|date("Y-m-d") }}">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Method <span class="text-danger">*</span></label>
                            <select name="payment_method" class="form-select" required>
                                <option value="cash">Cash</option>
                                <option value="cheque">Cheque</option>
                                <option value="bank_transfer">Bank Transfer</option>
                                <option value="mobile_banking">Mobile Banking</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Reference #</label>
                            <input type="text" name="reference_number" class="form-control" placeholder="TXN ID, Cheque # etc.">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Notes</label>
                            <textarea name="notes" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm">
                        <i class="fas fa-check me-2"></i>Apply Payment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.querySelector('#paymentForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = new FormData(e.target);
        const data = Object.fromEntries(formData.entries());

        try {
            const response = await fetch('{{ BASE_URL }}/commercial/invoices/receive-payment/{{ invoice.id }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const result = await response.json();
            if (result.success) {
                window.location.reload();
            } else {
                alert(result.message || 'Failed to apply payment');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('An unexpected error occurred');
        }
    });
</script>

<style>
    .bg-primary-soft { background-color: rgba(13, 110, 253, 0.1); }
    .z-index-1 { z-index: 1; }
</style>
{% endblock %}
