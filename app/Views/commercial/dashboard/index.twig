{% extends "layouts/app.twig" %}

{% block title %}Commercial Executive Dashboard • RMG PRO ERP{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-3">
    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="fas fa-chart-line text-primary me-2"></i>Commercial Dashboard
            </h1>
            <p class="text-muted small mb-0">Executive overview of export revenue, invoicing, sales contracts, Letters of Credit (L/C), and shipping documents.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <a href="{{ BASE_URL }}/commercial/invoices/create" class="btn btn-primary rounded-pill px-3 shadow-sm btn-sm">
                <i class="fas fa-plus me-1"></i>New Invoice
            </a>
            <a href="{{ BASE_URL }}/commercial/letters-of-credit" class="btn btn-outline-dark rounded-pill px-3 shadow-sm btn-sm">
                <i class="fas fa-university me-1"></i>Manage L/Cs
            </a>
            <a href="{{ BASE_URL }}/commercial/reports" class="btn btn-outline-primary rounded-pill px-3 shadow-sm btn-sm">
                <i class="fas fa-file-alt me-1"></i>Reports Hub
            </a>
        </div>
    </div>

    <!-- Top Stats Bar -->
    <div class="row g-3 mb-4">
        <!-- Invoiced Revenue -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 card-stat-blue text-white" style="background: linear-gradient(135deg, #0575E6 0%, #00F260 100%) !important;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-white-50 text-uppercase fw-semibold small">Invoiced Revenue</span>
                            <h2 class="display-6 fw-bold mb-0 mt-1">${{ metrics.invoiced_revenue|number_format(2) }}</h2>
                            <small class="text-white-50">{{ metrics.total_invoices }} Invoices Generated</small>
                        </div>
                        <div class="rounded-circle bg-white bg-opacity-10 p-3">
                            <i class="fas fa-file-invoice-dollar fa-2x text-white"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Outstanding Receivables -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 card-stat-pink text-white" style="background: linear-gradient(135deg, #ff416c 0%, #ff4b2b 100%) !important;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-white-50 text-uppercase fw-semibold small">Unpaid Balance</span>
                            <h2 class="display-6 fw-bold mb-0 mt-1">${{ metrics.receivable_balance|number_format(2) }}</h2>
                            <small class="text-white-50">Pending collection from buyers</small>
                        </div>
                        <div class="rounded-circle bg-white bg-opacity-10 p-3">
                            <i class="fas fa-hand-holding-usd fa-2x text-white"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Sales Contracts -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 card-stat-navy text-white" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%) !important;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-white-50 text-uppercase fw-semibold small">Active Sales Contracts</span>
                            <h2 class="display-6 fw-bold mb-0 mt-1">${{ metrics.active_contracts_sum|number_format(2) }}</h2>
                            <small class="text-white-50">{{ metrics.total_contracts }} Contracts Signed</small>
                        </div>
                        <div class="rounded-circle bg-white bg-opacity-10 p-3">
                            <i class="fas fa-file-contract fa-2x text-white"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Master L/Cs -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 card-stat-teal text-white" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%) !important;">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-white-50 text-uppercase fw-semibold small">Active L/Cs Value</span>
                            <h2 class="display-6 fw-bold mb-0 mt-1">${{ metrics.active_lcs_sum|number_format(2) }}</h2>
                            <small class="text-white-50">${{ metrics.utilized_lcs_sum|number_format(2) }} Utilized</small>
                        </div>
                        <div class="rounded-circle bg-white bg-opacity-10 p-3">
                            <i class="fas fa-university fa-2x text-white"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Commercial Submodules Shortcuts -->
    <div class="row g-3 mb-4">
        <div class="col-12">
            <h6 class="fw-bold text-uppercase text-muted mb-2 small"><i class="fas fa-th-large me-1"></i>Commercial Operations Hub</h6>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <a href="{{ BASE_URL }}/commercial/quotations" class="card card-hover border-0 shadow-sm rounded-3 text-decoration-none text-dark h-100">
                <div class="card-body text-center p-3">
                    <div class="avatar bg-primary-subtle text-primary mx-auto mb-2 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="fas fa-file-invoice-dollar fa-lg"></i>
                    </div>
                    <span class="fw-semibold d-block small">Quotations</span>
                </div>
            </a>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <a href="{{ BASE_URL }}/commercial/sales-orders" class="card card-hover border-0 shadow-sm rounded-3 text-decoration-none text-dark h-100">
                <div class="card-body text-center p-3">
                    <div class="avatar bg-success-subtle text-success mx-auto mb-2 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="fas fa-shopping-bag fa-lg"></i>
                    </div>
                    <span class="fw-semibold d-block small">Sales Orders</span>
                </div>
            </a>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <a href="{{ BASE_URL }}/commercial/sales-contracts" class="card card-hover border-0 shadow-sm rounded-3 text-decoration-none text-dark h-100">
                <div class="card-body text-center p-3">
                    <div class="avatar bg-info-subtle text-info mx-auto mb-2 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="fas fa-file-contract fa-lg"></i>
                    </div>
                    <span class="fw-semibold d-block small">Sales Contracts</span>
                </div>
            </a>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <a href="{{ BASE_URL }}/commercial/invoices" class="card card-hover border-0 shadow-sm rounded-3 text-decoration-none text-dark h-100">
                <div class="card-body text-center p-3">
                    <div class="avatar bg-warning-subtle text-warning mx-auto mb-2 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="fas fa-receipt fa-lg"></i>
                    </div>
                    <span class="fw-semibold d-block small">Commercial Invoices</span>
                </div>
            </a>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <a href="{{ BASE_URL }}/commercial/letters-of-credit" class="card card-hover border-0 shadow-sm rounded-3 text-decoration-none text-dark h-100">
                <div class="card-body text-center p-3">
                    <div class="avatar bg-danger-subtle text-danger mx-auto mb-2 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="fas fa-university fa-lg"></i>
                    </div>
                    <span class="fw-semibold d-block small">Letters of Credit</span>
                </div>
            </a>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <a href="{{ BASE_URL }}/commercial/export-documents" class="card card-hover border-0 shadow-sm rounded-3 text-decoration-none text-dark h-100">
                <div class="card-body text-center p-3">
                    <div class="avatar bg-secondary-subtle text-secondary mx-auto mb-2 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="fas fa-ship fa-lg"></i>
                    </div>
                    <span class="fw-semibold d-block small">Export Documents</span>
                </div>
            </a>
        </div>
    </div>

    <!-- Data Tables Row -->
    <div class="row g-4 mb-4">
        <!-- Recent Commercial Invoices -->
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0"><i class="fas fa-receipt text-primary me-2"></i>Recent Commercial Invoices</h6>
                    <a href="{{ BASE_URL }}/commercial/invoices" class="btn btn-link btn-sm text-decoration-none">View All</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small">
                                <tr>
                                    <th class="ps-3">Invoice #</th>
                                    <th>Buyer</th>
                                    <th>Date</th>
                                    <th class="text-end">Amount</th>
                                    <th class="text-end pe-3">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if metrics.recent_invoices is empty %}
                                <tr><td colspan="5" class="text-center text-muted py-4">No commercial invoices generated.</td></tr>
                                {% else %}
                                {% for inv in metrics.recent_invoices %}
                                <tr>
                                    <td class="ps-3 fw-bold text-primary">{{ inv.invoice_number }}</td>
                                    <td><small class="fw-semibold">{{ inv.buyer_name ?? 'Buyer' }}</small></td>
                                    <td><small class="text-muted">{{ inv.invoice_date ? inv.invoice_date|date('d M Y') : '-' }}</small></td>
                                    <td class="text-end fw-bold">${{ inv.total_amount|number_format(2) }}</td>
                                    <td class="text-end pe-3">
                                        <span class="badge rounded-pill {% if inv.status == 'paid' %}bg-success{% elseif inv.status == 'partial' %}bg-warning text-dark{% else %}bg-secondary{% endif %}">
                                            {{ inv.status|capitalize }}
                                        </span>
                                    </td>
                                </tr>
                                {% endfor %}
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Sales Contracts -->
        <div class="col-xl-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0"><i class="fas fa-file-contract text-info me-2"></i>Recent Sales Contracts</h6>
                    <a href="{{ BASE_URL }}/commercial/sales-contracts" class="btn btn-link btn-sm text-decoration-none">View All</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small">
                                <tr>
                                    <th class="ps-3">Contract #</th>
                                    <th>Buyer</th>
                                    <th>Contract Date</th>
                                    <th class="text-end">Value</th>
                                    <th class="text-end pe-3">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if metrics.recent_contracts is empty %}
                                <tr><td colspan="5" class="text-center text-muted py-4">No sales contracts logged.</td></tr>
                                {% else %}
                                {% for sc in metrics.recent_contracts %}
                                <tr>
                                    <td class="ps-3 fw-bold text-dark">{{ sc.contract_no }}</td>
                                    <td><small class="fw-semibold">{{ sc.buyer_name ?? 'Buyer' }}</small></td>
                                    <td><small class="text-muted">{{ sc.contract_date ? sc.contract_date|date('d M Y') : '-' }}</small></td>
                                    <td class="text-end fw-bold text-success">${{ sc.total_amount|number_format(2) }}</td>
                                    <td class="text-end pe-3">
                                        <span class="badge rounded-pill {% if sc.status == 'active' %}bg-success{% else %}bg-secondary{% endif %}">
                                            {{ sc.status|capitalize }}
                                        </span>
                                    </td>
                                </tr>
                                {% endfor %}
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.card-hover {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.card-hover:hover {
    transform: translateY(-3px);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1) !important;
}
</style>
{% endblock %}
