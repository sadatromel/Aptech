                                </div>
                                <table class="table table-sm table-bordered mb-2">
                                    <tr><td>Execution Records</td><td class="fw-bold text-primary">{{ stats.total_executions ?? 0 }}</td></tr>
                                </table>
                                <a href="{{ BASE_URL }}/cutting/execution" class="btn btn-sm btn-outline-info w-100">View Execution →</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}

    </div><!-- /col-12 -->
</div><!-- /row -->

<style>
.btn-xs { padding: 3px 8px; font-size: 0.75rem; }
.border-dashed { border: 2px dashed #dee2e6 !important; }
</style>

<script>
// Generic search filter
function filterTable(inputId, tableId) {
    document.getElementById(inputId)?.addEventListener('keyup', function() {
        const term = this.value.toLowerCase();
        document.querySelectorAll('#' + tableId + ' tbody tr').forEach(row => {
            row.style.display = row.innerText.toLowerCase().includes(term) ? '' : 'none';
        });
    });
}
filterTable('planSearch', 'plansTable');
filterTable('markerSearch', 'markersTable');
filterTable('bundleSearch', 'bundlesTable');

// Open update plan modal
function openUpdatePlan(planId, currentStatus, currentQty) {
    const form = document.getElementById('updatePlanForm');
    form.action = '{{ BASE_URL }}/cutting/plans/' + planId + '/update-status';
    form.querySelector('[name="status"]').value = currentStatus;
    document.getElementById('updateCompletedQty').value = currentQty;
    new bootstrap.Modal(document.getElementById('updatePlanModal')).show();
}
</script>
{% endblock %}
