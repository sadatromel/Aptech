        {# ===== 5. FABRIC ===== #}
        {% if activeTab == 'fabric' %}
        <div class="card glow-card border-0 p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-success mb-0"><i class="fas fa-scroll me-2"></i>Fabric Issue & Roll Management</h5>
