                        <td><button class="btn btn-xs btn-outline-danger" disabled><i class="fas fa-trash"></i></button></td>
                    </tr>
                    {% else %}
                    <tr><td colspan="13" class="text-center py-4 text-muted">No lay sheets yet. <a href="#" data-bs-toggle="modal" data-bs-target="#addLayModal">Create one.</a></td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Add Lay Modal -->
        <div class="modal fade" id="addLayModal" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <form method="POST" action="{{ BASE_URL }}/cutting/lay" class="modal-content">
                    {{ csrf_field()|raw }}
                    <input type="hidden" name="action" value="create_lay">
                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title"><i class="fas fa-layer-group me-2"></i>New Lay Sheet</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-4"><label class="form-label fw-bold">Lay Number</label><input type="text" class="form-control" name="lay_number" value="LAY-{{ 'now'|date('Ymd') }}-{{ random(100, 999) }}"></div>
                            <div class="col-md-4"><label class="form-label fw-bold">Cutting Plan</label>
                                <select class="form-select" name="plan_id">
                                    <option value="">Select Plan</option>
                                    {% for p in plans %}<option value="{{ p.plan_id }}">{{ p.plan_number }} – {{ p.style_code }}</option>{% endfor %}
                                </select>
                            </div>
                            <div class="col-md-4"><label class="form-label fw-bold">Style</label>
                                <select class="form-select" name="style_id">
                                    <option value="">Select Style</option>
                                    {% for s in styles %}<option value="{{ s.style_id }}">{{ s.style_code }} – {{ s.style_name }}</option>{% endfor %}
                                </select>
                            </div>
                            <div class="col-md-4"><label class="form-label fw-bold">Marker (optional)</label>
                                <select class="form-select" name="marker_id">
                                    <option value="">Select Marker</option>
                                    {% for m in markers %}<option value="{{ m.marker_id }}">{{ m.marker_number }}</option>{% endfor %}
                                </select>
                            </div>
                            <div class="col-md-4"><label class="form-label fw-bold">Cutting Room</label>
                                <select class="form-select" name="cutting_room_id">
                                    <option value="">Select Room</option>
                                    {% for cr in cutting_rooms %}<option value="{{ cr.cutting_room_id }}">{{ cr.cutting_room_name }}</option>{% endfor %}
                                </select>
                            </div>
                            <div class="col-md-4"><label class="form-label fw-bold">Spreading Method</label>
                                <select class="form-select" name="spreading_method">
                                    <option>Face-to-face</option><option>Face-up</option><option>Face-down</option><option>Tubular</option>
                                </select>
                            </div>
                            <div class="col-md-3"><label class="form-label fw-bold">Total Plies</label><input type="number" class="form-control" name="total_plies" min="1"></div>
                            <div class="col-md-3"><label class="form-label fw-bold">Fabric Width (m)</label><input type="number" class="form-control" name="fabric_width" step="0.01"></div>
                            <div class="col-md-3"><label class="form-label fw-bold">Lay Length (m)</label><input type="number" class="form-control" name="lay_length" step="0.01"></div>
