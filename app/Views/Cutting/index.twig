            <div class="table-responsive">
                <table class="table table-hover mb-0" id="fabricTable">
                    <thead class="table-light"><tr>
                        <th>Roll #</th><th>Barcode</th><th>Style</th><th>Color/Shade</th>
                        <th>Width (m)</th><th>Length (m)</th><th>Weight (kg)</th>
                        <th>Relaxation Start</th><th>Room</th><th>Status</th>
                    </tr></thead>
                    <tbody>
                    {% for roll in fabric_rolls %}
                    <tr>
                        <td><strong>{{ roll.roll_number ?? roll.roll_id }}</strong></td>
                        <td><code>{{ roll.barcode ?? '-' }}</code></td>
                        <td>{{ roll.style_code }}</td>
                        <td>{{ roll.shade ?? roll.color ?? '-' }}</td>
                        <td>{{ roll.width|number_format(2) }}</td>
                        <td>{{ roll.length|number_format(2) }}</td>
                        <td>{{ roll.weight|number_format(2) }}</td>
                        <td>{{ roll.relaxation_start ? roll.relaxation_start|date('M d, Y H:i') : '-' }}</td>
