                        <th>Lay #</th><th>Plan</th><th>Style</th><th>Marker</th>
                        <th>Plies</th><th>Width (m)</th><th>Length (m)</th><th>Spreading</th>
                        <th>Relax (hrs)</th><th>Date</th><th>Room</th><th>Status</th><th>Actions</th>
                    </tr></thead>
                    <tbody>
                    {% for lay in lays %}
                    <tr>
                        <td><strong>{{ lay.lay_number }}</strong></td>
                        <td>{{ lay.plan_number ?? '-' }}</td>
                        <td>{{ lay.style_code }}</td>
                        <td>{{ lay.marker_number ?? '-' }}</td>
                        <td>{{ lay.total_plies }}</td>
                        <td>{{ lay.fabric_width|number_format(2) }}</td>
                        <td>{{ lay.lay_length|number_format(2) }}</td>
                        <td>{{ lay.spreading_method }}</td>
                        <td>{{ lay.relaxation_hours }}h</td>
