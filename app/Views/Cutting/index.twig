                        <td>{{ exec.operator_name }}</td>
                        <td>{{ exec.cutting_date ? exec.cutting_date|date('M d, Y') : '-' }}</td>
                        <td>{{ exec.start_time ?? '-' }}</td>
                        <td>{{ exec.end_time ?? '-' }}</td>
                        <td class="text-success fw-bold">{{ exec.cut_quantity|number_format }}</td>
                        <td class="text-danger">{{ exec.defect_quantity }}</td>
                        <td>{{ exec.cutting_room_name ?? '-' }}</td>
                        <td><span class="status-badge status-{{ exec.status }}">{{ exec.status|title }}</span></td>
                    </tr>
                    {% else %}
                    <tr><td colspan="11" class="text-center py-4 text-muted">No execution logs yet. <a href="#" data-bs-toggle="modal" data-bs-target="#addExecutionModal">Log one.</a></td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Log Execution Modal -->
        <div class="modal fade" id="addExecutionModal" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <form method="POST" action="{{ BASE_URL }}/cutting/execution" class="modal-content">
                    {{ csrf_field()|raw }}
                    <input type="hidden" name="action" value="create_execution">
                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title"><i class="fas fa-cut me-2"></i>Log Cutting Execution</h5>
