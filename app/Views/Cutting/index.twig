                        <th>Exec #</th><th>Plan</th><th>Style</th><th>Operator</th>
                        <th>Date</th><th>Start</th><th>End</th><th>Cut Qty</th>
                        <th>Defects</th><th>Room</th><th>Status</th>
                    </tr></thead>
