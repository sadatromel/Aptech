                            <div class="col-md-6"><label class="form-label fw-bold">Lay Date</label><input type="date" class="form-control" name="lay_date" value="{{ 'now'|date('Y-m-d') }}"></div>
                            <div class="col-md-6"><label class="form-label fw-bold">Notes</label><input type="text" class="form-control" name="notes"></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success"><i class="fas fa-save me-1"></i>Save Lay Sheet</button>
                    </div>
                </form>
            </div>
        </div>
