{% extends 'layouts/app.twig' %}

{% block title %}Merchandising • Sample Production Tracking{% endblock %}

{% block content %}
<div class="container-fluid merchandising-production">
    <div class="container-fluid px-4">
        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center mt-4 mb-3">
            <div>
                <h1 class="h3 mb-1">Production Efficiency Tracking</h1>
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="{{ BASE_URL }}/merchandising">Merchandising</a></li>
                    <li class="breadcrumb-item active">Prod Tracking</li>
                </ol>
            </div>
            <button class="btn btn-primary px-4 rounded-pill shadow-sm fw-bold" onclick="openNewTracking()">
                <i class="fas fa-plus-circle me-1"></i> Log Entry
            </button>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="row g-3 mb-4 mx-3">
        <div class="col-md-3">
            <div class="stat-card text-center p-4 text-white rounded-4 shadow" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); position: relative; overflow: hidden;">
                <i class="fas fa-bullseye position-absolute text-white" style="font-size: 3.5rem; opacity: 0.15; right: 25px; top: 50%; transform: translateY(-50%);"></i>
                <p class="label mb-1 fw-bold text-white-50 text-uppercase tracking-wide" style="font-size:0.75rem;">Today's Target</p>
                <h2 class="mb-0 fw-black display-6">{{ stats.today_target }}</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card text-center p-4 text-white rounded-4 shadow" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); position: relative; overflow: hidden;">
                <i class="fas fa-check-double position-absolute text-white" style="font-size: 3.5rem; opacity: 0.15; right: 25px; top: 50%; transform: translateY(-50%);"></i>
                <p class="label mb-1 fw-bold text-white-50 text-uppercase tracking-wide" style="font-size:0.75rem;">Today's Output</p>
                <h2 class="mb-0 fw-black display-6">{{ stats.today_actual }}</h2>
            </div>
        </div>
        <div class="col-md-3">
            {% set eff = stats.today_target > 0 ? ((stats.today_actual / stats.today_target) * 100)|round(1) : 0 %}
            <div class="stat-card text-center p-4 text-dark rounded-4 shadow" style="background: linear-gradient(135deg, #f2994a 0%, #f2c94c 100%); position: relative; overflow: hidden;">
                <i class="fas fa-percent position-absolute text-white" style="font-size: 3.5rem; opacity: 0.45; right: 25px; top: 50%; transform: translateY(-50%);"></i>
                <p class="label mb-1 fw-bold text-dark text-uppercase tracking-wide opacity-75" style="font-size:0.75rem;">Efficiency</p>
                <h2 class="mb-0 fw-black display-6">{{ stats.today_target > 0 ? eff ~ '%' : '—' }}</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card text-center p-4 text-white rounded-4 shadow" style="background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%); position: relative; overflow: hidden;">
                <i class="fas fa-chart-line position-absolute text-white" style="font-size: 3.5rem; opacity: 0.15; right: 25px; top: 50%; transform: translateY(-50%);"></i>
                <p class="label mb-1 fw-bold text-white-50 text-uppercase tracking-wide" style="font-size:0.75rem;">Logs Added</p>
                <h2 class="mb-0 fw-black display-6">{{ records|length }}</h2>
            </div>
        </div>
    </div>

    <!-- Central Working Area -->
    <div class="row g-4 mx-2">
        <div class="col-lg-12">
            <!-- Global Dashboard Filters -->
            <div class="card shadow-sm border-0 mb-4 rounded-4">
                <div class="card-body">
                    <form method="get" action="{{ BASE_URL }}/merchandising/sample-production">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label small fw-bold text-muted mb-1">Buyer Analysis</label>
                                <select class="form-select shadow-sm rounded-pill" name="buyer_id">
                                    <option value="">All Buyers</option>
                                    {% for buyer in buyers %}
                                        <option value="{{ buyer.buyer_id }}" {% if filters.buyer_id == buyer.buyer_id %}selected{% endif %}>
                                            {{ buyer.buyer_name }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-bold text-muted mb-1">Style Reference</label>
                                <select class="form-select shadow-sm rounded-pill" name="style_id">
                                    <option value="">All Styles</option>
                                    {% for style in styles %}
                                        <option value="{{ style.style_id }}" {% if filters.style_id == style.style_id %}selected{% endif %}>
                                            {{ style.style_code }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-bold text-muted mb-1">Date (From)</label>
                                <input type="date" class="form-control shadow-sm rounded-pill" name="from_date" value="{{ filters.from_date }}">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-bold text-muted mb-1">Date (To)</label>
                                <input type="date" class="form-control shadow-sm rounded-pill" name="to_date" value="{{ filters.to_date }}">
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="submit" class="btn btn-secondary w-100 rounded-pill shadow-sm fw-bold"><i class="fas fa-filter me-1"></i> Filter</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Master Data Table -->
            <div class="card shadow-sm border-0 mb-4 rounded-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-body-tertiary">
                                <tr>
                                    <th class="ps-4 py-3 fw-bold text-muted small text-uppercase" style="width: 120px;">Log Date</th>
                                    <th class="py-3 fw-bold text-muted small text-uppercase">Buyer</th>
                                    <th class="py-3 fw-bold text-muted small text-uppercase">Style Code</th>
                                    <th class="py-3 fw-bold text-muted small text-uppercase">Requisition Info & Materials</th>
                                    <th class="py-3 fw-bold text-muted small text-uppercase" style="width: 100px;">Target</th>
                                    <th class="py-3 fw-bold text-muted small text-uppercase" style="width: 100px;">Actual</th>
                                    <th class="py-3 fw-bold text-muted small text-uppercase" style="width: 100px;">Eff%</th>
                                    <th class="text-end pe-4 py-3 fw-bold text-muted small text-uppercase">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for record in records %}
                                    <tr data-record='{{ record|json_encode|raw|e('html_attr') }}'>
                                        <td class="ps-4">
                                            <div class="fw-bold text-primary">{{ record.tracking_date|date('M d, Y') }}</div>
                                        </td>
                                        <td>
                                            <div class="fw-bold">{{ record.buyer_name }}</div>
                                        </td>
                                        <td>
                                            <div class="small fw-black">{{ record.style_code }}</div>
                                            {% if record.style_name %}
                                                <div class="small text-muted">{{ record.style_name }}</div>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if record.requisition_no %}
                                                <div class="fw-bold">
                                                    {{ record.requisition_no }} <span class="badge bg-secondary bg-opacity-25 text-secondary rounded-pill ms-2" style="font-size:0.6rem;">{{ record.sample_type|upper }}</span>
                                                </div>
                                                
                                                {# Inject the 5 material flags inline for deep context #}
                                                <div class="d-flex flex-wrap gap-1 align-items-center mt-1">
                                                    <span class="badge {{ record.shell_fabric_available ? 'bg-success bg-opacity-25 text-success border border-success' : 'bg-transparent text-muted border border-secondary' }} rounded-pill" title="Shell Fabric: {{ record.shell_fabric_available ? 'Ready' : 'Pending' }}" style="font-size: 0.60rem; padding: 0.20em 0.4em;"><i class="{{ record.shell_fabric_available ? 'fas fa-check-circle' : 'far fa-circle' }} me-1"></i>Shell</span>
                                                    <span class="badge {{ record.pocketing_available ? 'bg-success bg-opacity-25 text-success border border-success' : 'bg-transparent text-muted border border-secondary' }} rounded-pill" title="Pocketing: {{ record.pocketing_available ? 'Ready' : 'Pending' }}" style="font-size: 0.60rem; padding: 0.20em 0.4em;"><i class="{{ record.pocketing_available ? 'fas fa-check-circle' : 'far fa-circle' }} me-1"></i>Pock.</span>
                                                    <span class="badge {{ record.lining_interlining_available ? 'bg-success bg-opacity-25 text-success border border-success' : 'bg-transparent text-muted border border-secondary' }} rounded-pill" title="Lining: {{ record.lining_interlining_available ? 'Ready' : 'Pending' }}" style="font-size: 0.60rem; padding: 0.20em 0.4em;"><i class="{{ record.lining_interlining_available ? 'fas fa-check-circle' : 'far fa-circle' }} me-1"></i>Lining</span>
                                                    <span class="badge {{ record.sewing_accessories_available ? 'bg-success bg-opacity-25 text-success border border-success' : 'bg-transparent text-muted border border-secondary' }} rounded-pill" title="Sewing Acc.: {{ record.sewing_accessories_available ? 'Ready' : 'Pending' }}" style="font-size: 0.60rem; padding: 0.20em 0.4em;"><i class="{{ record.sewing_accessories_available ? 'fas fa-check-circle' : 'far fa-circle' }} me-1"></i>S.Acc</span>
                                                    <span class="badge {{ record.finishing_accessories_available ? 'bg-success bg-opacity-25 text-success border border-success' : 'bg-transparent text-muted border border-secondary' }} rounded-pill" title="Finishing Acc.: {{ record.finishing_accessories_available ? 'Ready' : 'Pending' }}" style="font-size: 0.60rem; padding: 0.20em 0.4em;"><i class="{{ record.finishing_accessories_available ? 'fas fa-check-circle' : 'far fa-circle' }} me-1"></i>F.Acc</span>
                                                </div>

                                            {% else %}
                                                <span class="text-muted small fst-italic">Unlinked Requisition</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <div class="fw-bold">{{ record.target_qty }}</div>
                                        </td>
                                        <td>
                                            <div class="fw-bold {% if record.actual_qty >= record.target_qty and record.target_qty > 0 %}text-success{% endif %}">
                                                {{ record.actual_qty }}
                                            </div>
                                        </td>
                                        <td>
                                            {% if record.target_qty > 0 %}
                                                {% set eff_ind = ((record.actual_qty / record.target_qty) * 100)|round(0) %}
                                                <span class="badge rounded-pill {% if eff_ind >= 100 %}bg-success{% elseif eff_ind >= 80 %}bg-warning text-dark{% else %}bg-danger{% endif %}" style="width: 50px;">
                                                    {{ eff_ind }}%
                                                </span>
                                            {% else %}
                                                <span class="text-muted small">—</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="btn-group btn-group-sm rounded-pill shadow-sm">
                                                <button class="btn btn-outline-info rounded-start-pill px-3" data-edit-record title="Modify Record">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button class="btn btn-outline-danger rounded-end-pill px-3" data-delete-record title="Delete Log">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-5">
                                            <i class="fas fa-folder-open fa-3x mb-3 d-block opacity-25"></i>
                                            No efficiency logs matched this view.
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Offcanvas Tracking Form panel -->
<div class="offcanvas offcanvas-end shadow-lg" tabindex="-1" id="trackingOffcanvas" style="width: 450px;">
    <div class="offcanvas-header border-bottom py-3">
        <h5 class="offcanvas-title fw-bold" id="formTitle"><i class="fas fa-file-signature me-2 text-primary"></i>Track Efficiency</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form id="recordForm">
            <input type="hidden" name="id" id="recordId">
            <div id="alertBox" class="alert d-none small"></div>

            <div class="mb-4 bg-body-tertiary p-3 rounded border">
                <label class="form-label fw-bold text-muted text-uppercase mb-1 small"><i class="far fa-calendar-alt me-1"></i>Tracking Date</label>
                <input type="date" class="form-control shadow-sm rounded" name="tracking_date" id="trackingDate" value="{{ 'now'|date('Y-m-d') }}" required>
            </div>

            <h6 class="text-uppercase small fw-bold mb-3 text-primary"><i class="fas fa-link me-2"></i>Link to Requisition</h6>

            <div class="mb-3">
                <label class="form-label fw-bold text-muted mb-1 small">Select Buyer <span class="text-danger">*</span></label>
                <select class="form-select shadow-sm" name="buyer_id" id="buyerSelect" required>
                    <option value="">— Select Buyer —</option>
                    {% for buyer in buyers %}
                        <option value="{{ buyer.buyer_id }}">{{ buyer.buyer_name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-muted mb-1 small">Select Style <span class="text-danger">*</span></label>
                <select class="form-select shadow-sm" name="style_id" id="styleSelect" required>
                    <option value="">— Select Style —</option>
                    {% for style in styles %}
                        <option value="{{ style.style_id }}" data-buyer="{{ style.buyer_id }}">{{ style.style_code }}{% if style.style_name %} – {{ style.style_name }}{% endif %}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold text-muted mb-1 small">Target Requisition</label>
                <select class="form-select shadow-sm" name="sample_id" id="requisitionSelect">
                    <option value="">— Unlinked / None —</option>
                </select>
                <div class="form-text text-primary small mt-2" id="requisitionHint">Connect a requisition to log resources.</div>
            </div>

            <hr class="text-muted opacity-25 mb-4">

            <div class="card bg-primary text-white border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h6 class="text-uppercase fw-bold text-white mb-3" style="font-size: 0.8rem;"><i class="fas fa-chart-line me-2"></i>Final Productivity</h6>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label text-white-50 fw-bold small mb-1">Target QTY</label>
                            <input type="number" class="form-control text-center fw-bold fs-5 shadow-sm" name="target_qty" id="targetQty" value="0" min="0" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label text-white-50 fw-bold small mb-1">Actual QTY</label>
                            <input type="number" class="form-control text-center fw-bold fs-5 shadow-sm text-primary" name="actual_qty" id="actualQty" value="0" min="0" required>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary py-3 rounded-pill fw-bold shadow-sm" id="submitBtn">
                    <i class="fas fa-save me-2"></i>Save Final Entry
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Core refs
        const trackingOffcanvasEl = document.getElementById('trackingOffcanvas');
        const trackingOffcanvas = trackingOffcanvasEl ? new bootstrap.Offcanvas(trackingOffcanvasEl) : null;

        const form          = document.getElementById('recordForm');
        const alertBox      = document.getElementById('alertBox');
        const formTitle     = document.getElementById('formTitle');
        const submitBtn     = document.getElementById('submitBtn');
        const recordIdInput = document.getElementById('recordId');
        
        // Selects
        const buyerSelect   = document.getElementById('buyerSelect');
        const styleSelect   = document.getElementById('styleSelect');
        const reqSelect     = document.getElementById('requisitionSelect');
        const reqHint       = document.getElementById('requisitionHint');

        const allStyleOptions = Array.from(styleSelect.options).slice(1);

        window.openNewTracking = function() {
            form.reset();
            recordIdInput.value = '';
            formTitle.innerHTML = '<i class="fas fa-file-signature me-2 text-primary"></i>Track Efficiency';
            submitBtn.innerHTML = '<i class="fas fa-save me-2"></i>Save Final Entry';
            alertBox.classList.add('d-none');
            resetStyleOptions();
            clearRequisitions();
            trackingOffcanvas.show();
        };

        function showAlert(msg, type = 'danger') {
            alertBox.className = `alert alert-${type} fw-bold small`;
            alertBox.textContent = msg;
            alertBox.classList.remove('d-none');
        }

        // Filter styles by buyer id mapping
        function resetStyleOptions(buyerId = '') {
            styleSelect.innerHTML = '<option value="">— Select Style —</option>';
            allStyleOptions.forEach(opt => {
                if (!buyerId || opt.dataset.buyer === String(buyerId)) {
                    styleSelect.appendChild(opt.cloneNode(true));
                }
            });
        }

        buyerSelect.addEventListener('change', function () {
            resetStyleOptions(this.value);
            clearRequisitions();
            if (this.value) {
                loadRequisitions(this.value, '');
            }
        });

        styleSelect.addEventListener('change', function () {
            const buyerId = buyerSelect.value;
            clearRequisitions();
            if (this.value) {
                loadRequisitions(buyerId, this.value);
            }
        });

        function clearRequisitions() {
            reqSelect.innerHTML = '<option value="">— Unlinked / None —</option>';
            reqHint.textContent = 'Select Buyer and Style to view Requisitions.';
        }

        async function loadRequisitions(buyerId, styleId) {
            reqHint.textContent = 'Scanning database...';
            try {
                const url = `${BASE_URL}/merchandising/sample-production/requisitions?buyer_id=${buyerId}&style_id=${styleId}`;
                const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const items = await res.json();

                reqSelect.innerHTML = '<option value="">— Unlinked / None —</option>';
                if (items.length === 0) {
                    reqHint.textContent = 'No Requisitions found for matching style.';
                } else {
                    items.forEach(item => {
                        const opt = document.createElement('option');
                        opt.value = item.sample_id;
                        opt.textContent = `${item.requisition_no} (${item.sample_type ?? ''} – ${item.style_code ?? ''})`;
                        reqSelect.appendChild(opt);
                    });
                    reqHint.textContent = `Attached ${items.length} active Requisition links.`;
                }
            } catch (e) {
                reqHint.textContent = 'Network error loading requisitions.';
            }
        }

        // Edit Mode Hook
        document.querySelectorAll('[data-edit-record]').forEach(btn => {
            btn.addEventListener('click', async () => {
                const rec = JSON.parse(btn.closest('tr').dataset.record);
                
                formTitle.innerHTML = '<i class="fas fa-edit me-2 text-primary"></i>Modify Entry';
                submitBtn.innerHTML = '<i class="fas fa-check me-2"></i>Update Entry Output';
                alertBox.classList.add('d-none');
                
                recordIdInput.value          = rec.id;
                form.tracking_date.value     = rec.tracking_date;
                form.target_qty.value        = rec.target_qty;
                form.actual_qty.value        = rec.actual_qty;

                buyerSelect.value = rec.buyer_id || '';
                resetStyleOptions(rec.buyer_id);
                styleSelect.value = rec.style_id || '';

                clearRequisitions();
                if (rec.buyer_id || rec.style_id) {
                    await loadRequisitions(rec.buyer_id || '', rec.style_id || '');
                }
                reqSelect.value = rec.sample_id || '';
                
                trackingOffcanvas.show();
            });
        });

        // Delete Hook
        document.querySelectorAll('[data-delete-record]').forEach(btn => {
            btn.addEventListener('click', async () => {
                if (!confirm('Permanently delete this tracking record?')) return;
                const rec = JSON.parse(btn.closest('tr').dataset.record);
                try {
                    const response = await fetch(`${BASE_URL}/merchandising/sample-production/${rec.id}`, {
                        method: 'DELETE',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    const res = await response.json();
                    if (res.success) {
                        location.reload();
                    } else {
                        throw new Error(res.message || 'Deletion failed');
                    }
                } catch (e) {
                    alert(e.message || 'Failed to delete record.');
                }
            });
        });

        // Save Form Logic
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            alertBox.classList.add('d-none');

            const formData = new FormData(form);
            const data     = Object.fromEntries(formData.entries());
            const isEdit   = !!data.id;
            const endpoint = isEdit
                ? `${BASE_URL}/merchandising/sample-production/${data.id}`
                : `${BASE_URL}/merchandising/sample-production`;
            const method   = isEdit ? 'PUT' : 'POST';

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Transmitting...';

            try {
                const res = await fetch(endpoint, {
                    method,
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(data)
                });

                const result = await res.json();
                if (!res.ok) throw new Error(result.message || 'Failed to record entry.');

                if (result.success) {
                    location.reload();
                } else {
                    showAlert(result.message);
                }
            } catch (err) {
                showAlert(err.message);
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = isEdit
                    ? '<i class="fas fa-check me-2"></i>Update Entry Output'
                    : '<i class="fas fa-save me-2"></i>Save Final Entry';
            }
        });
    });
</script>
{% endblock %}