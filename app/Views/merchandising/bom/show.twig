{% extends 'layouts/app.twig' %}

{% block title %}BOM Details | Merchandising{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mt-4 mb-4">
        <div>
            <h1 class="h3 mb-0">BOM Details</h1>
            <p class="text-muted mb-0">Style: <strong>{{ bom.style_code }}</strong> • Version: <strong>{{ bom.version }}</strong> • Status: <span class="badge bg-secondary">{{ bom.status|title }}</span></p>
        </div>
        <div class="d-flex gap-2">
             <button onclick="window.print();" class="btn btn-outline-dark">
                <i class="fas fa-print me-2"></i>Print BOM
            </button>
             <a href="{{ BASE_URL }}/merchandising/bom" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to List
            </a>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#componentModal" data-modal-mode="create">
                <i class="fas fa-plus me-2"></i>Add Component
            </button>
        </div>
    </div>
    
     <!-- BOM Header Info Card -->
    <div class="card mb-4 shadow-sm border-0 bg-light">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <small class="text-muted text-uppercase fw-bold">Style Name</small>
                    <div class="fw-bold">{{ bom.style_name }}</div>
                </div>
                <div class="col-md-3">
                     <small class="text-muted text-uppercase fw-bold">Total Items</small>
                    <div class="h5 mb-0">{{ stats.item_count }}</div>
                </div>
                 <div class="col-md-3">
                     <small class="text-muted text-uppercase fw-bold">Total Cost</small>
                    <div class="h5 mb-0 text-success">${{ stats.total_cost|number_format(2) }}</div>
                </div>
                <div class="col-md-3">
                     <small class="text-muted text-uppercase fw-bold">Remarks</small>
                    <div class="small">{{ bom.remarks ?: 'No remarks' }}</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Components Table -->
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-transparent py-3">
            <div class="h6 mb-0">Components</div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Material Name</th>
                            <th>Material Code</th>
                            <th>Qty</th>
                            <th>Unit</th>
                            <th>Unit Cost</th>
                            <th>Total Cost</th>
                            <th>Supplier</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for component in components %}
                            <tr data-component='{{ component|json_encode|raw }}'>
                                <td class="ps-4 fw-bold">{{ component.material_name }}</td>
                                <td>{{ component.material_code ?: '—' }}</td>
                                <td>{{ component.quantity|number_format(3) }}</td>
                                <td>{{ component.unit ?: '—' }}</td>
                                <td>${{ component.unit_cost|number_format(2) }}</td>
                                <td class="fw-bold text-success">${{ component.total_cost|number_format(2) }}</td>
                                <td>{{ component.supplier ?: '—' }}</td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-outline-primary" data-edit-component><i class="fas fa-edit"></i></button>
                                        <button class="btn btn-sm btn-outline-danger" data-delete-component><i class="fas fa-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8" class="text-center text-muted py-5">No components added yet.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Component Modal (from original index.twig, adapted) -->
<div class="modal fade" id="componentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="componentForm">
                <input type="hidden" name="component_id" id="componentId">
                <!-- IMPORTANT: Pass Current BOM ID -->
                <input type="hidden" name="bom_id" value="{{ bom.bom_id }}">
                
                <div class="modal-header">
                    <h5 class="modal-title" id="componentModalTitle">Add Component</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="componentAlert" class="alert d-none"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Material Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="material_name" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Material Code</label>
                            <input type="text" class="form-control" name="material_code">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Quantity <span class="text-danger">*</span></label>
                            <input type="number" step="0.001" min="0" class="form-control" name="quantity" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Unit</label>
                            <input type="text" class="form-control" name="unit" placeholder="kg, m, pcs">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Unit Cost <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" min="0" class="form-control" name="unit_cost" required>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Supplier</label>
                            <input type="text" class="form-control" name="supplier">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="componentSubmitBtn">
                        <i class="fas fa-save me-1"></i>Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const modalEl = document.getElementById('componentModal');
        const componentModal = modalEl ? bootstrap.Modal.getOrCreateInstance(modalEl) : null;
        const form = document.getElementById('componentForm');
        const alertBox = document.getElementById('componentAlert');
        const titleEl = document.getElementById('componentModalTitle');
        const submitBtn = document.getElementById('componentSubmitBtn');

        // We are strictly editing components for THIS BOM.
        const currentBomId = {{ bom.bom_id }};

        function setFormMode(mode, data = null) {
            alertBox.classList.add('d-none');
            form.reset();
            // Reset BOM ID to current (it might get cleared by reset)
            form.bom_id.value = currentBomId;
            
            if (mode === 'edit') {
                titleEl.textContent = 'Edit Component';
                submitBtn.innerHTML = '<i class="fas fa-save me-1"></i>Update';
                form.component_id.value = data.component_id;
                form.material_name.value = data.material_name;
                form.material_code.value = data.material_code ?? '';
                form.quantity.value = data.quantity;
                form.unit.value = data.unit ?? '';
                form.unit_cost.value = data.unit_cost;
                form.supplier.value = data.supplier ?? '';
            } else {
                titleEl.textContent = 'Add Component';
                submitBtn.innerHTML = '<i class="fas fa-save me-1"></i>Save';
                form.component_id.value = '';
            }
            modalEl.dataset.mode = mode;
        }

        modalEl?.addEventListener('show.bs.modal', (event) => {
            const trigger = event.relatedTarget;
            const mode = trigger?.getAttribute('data-modal-mode') ?? 'create';
            // If creation, we just open. If edit, click handler handles it.
            if(mode === 'create') setFormMode('create');
        });

        document.querySelectorAll('[data-edit-component]').forEach(btn => {
            btn.addEventListener('click', async () => {
                const row = btn.closest('tr');
                const component = JSON.parse(row.dataset.component);
                setFormMode('edit', component);
                componentModal?.show();
            });
        });

        document.querySelectorAll('[data-delete-component]').forEach(btn => {
            btn.addEventListener('click', async () => {
                const row = btn.closest('tr');
                const component = JSON.parse(row.dataset.component);
                if (!confirm(`Delete ${component.material_name}?`)) return;
                
                // Assuming we use the same controller logic for component deletion or use a dedicated API?
                // The BomService has deleteComponent.
                // The Controller does NOT have deleteComponent exposed yet directly.
                // But the old JS used DELETE /merchandising/bom/{id}.
                // We need to support this or add a route.
                // Let's assume we need to add a route for components or handle it.
                // Current Controller routes: index, create, store, show, edit, update, destroy (BOM).
                // It does NOT handle component CRUD. 
                // We need to add API endpoints for components in BomController or a separate one.
                // For now, let's look at the JS below.
                
                const response = await fetch(`{{ BASE_URL }}/merchandising/bom/components/${component.component_id}`, { method: 'DELETE' });
                if (response.ok) {
                    location.reload();
                } else {
                    alert('Failed to delete component.');
                }
            });
        });

        form?.addEventListener('submit', async (event) => {
            event.preventDefault();
            alertBox.classList.add('d-none');
            constpayload = Object.fromEntries(new FormData(form).entries()); // Typo in prompt variable name? No.
            const payload = Object.fromEntries(new FormData(form).entries());
            const componentId = payload.component_id;
            const isEdit = modalEl.dataset.mode === 'edit' && componentId;
            
            // Endpoint needed for components
            const endpoint = isEdit ? `{{ BASE_URL }}/merchandising/bom/components/${componentId}` : `{{ BASE_URL }}/merchandising/bom/components`;
            // We need to implement these routes in Controller/index.php
            
            const method = isEdit ? 'PUT' : 'POST';
            try {
                const response = await fetch(endpoint, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await response.json();
                if (!response.ok) throw data;
                location.reload();
            } catch (error) {
                alertBox.className = 'alert alert-danger';
                alertBox.textContent = error?.message || 'Unable to save component.';
                alertBox.classList.remove('d-none');
            }
        });
    });
</script>
{% endblock %}
