{% extends 'layouts/app.twig' %}

{% block title %}Purchase Requests - RMG PRO ERP{% endblock %}

{% block styles %}
<style>
/* Page specific styles only */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
}

.page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
}

.page-header h1 {
    font-size: 1.75rem;
    font-weight: 600;
    margin: 0;
}

.page-header p {
    color: var(--text-secondary);
    margin: 0.5rem 0 0 0;
}

.status-badge {
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
}

.status-pending { background: #fff3cd; color: #856404; }
.status-approved { background: #d4edda; color: #155724; }
.status-rejected { background: #f8d7da; color: #721c24; }
.status-ordered { background: #cce5ff; color: #004085; }

.btn-action {
    padding: 0.25rem 0.5rem;
    font-size: 0.8rem;
    margin: 0 0.25rem;
}

.pr-details {
    background: #f8f9fa;
    padding: 0.5rem;
    border-radius: 8px;
    margin-top: 0.25rem;
    font-size: 0.85rem;
}

.item-row {
    background: #f8f9fa;
    padding: 1rem;
    border-radius: 8px;
    margin-bottom: 1rem;
    position: relative;
}

.remove-item {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    background: var(--accent-color);
    color: white;
    border: none;
    border-radius: 50%;
    width: 24px;
    height: 24px;
    font-size: 12px;
    cursor: pointer;
}
/* Dark Mode Support for Modal */
[data-theme="dark"] .modal-content {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
}

[data-theme="dark"] .modal-header,
[data-theme="dark"] .modal-footer {
    border-color: var(--border-color);
}

[data-theme="dark"] .btn-close {
    filter: invert(1) grayscale(100%) brightness(200%);
}

[data-theme="dark"] .form-control,
[data-theme="dark"] .form-select {
    background-color: var(--bg-primary);
    border-color: var(--border-color);
    color: var(--text-primary);
}

[data-theme="dark"] .form-control:focus,
[data-theme="dark"] .form-select:focus {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    border-color: var(--primary);
}

[data-theme="dark"] .item-row {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
}
</style>
{% endblock %}

{% block content %}
<div class="container-fluid px-4">
<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center mt-4 mb-4">
    <div>
        <h1 class="h3 mb-2">Purchase Requests</h1>
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="{{ BASE_URL }}/merchandising">Merchandising</a></li>
            <li class="breadcrumb-item active">Purchase Requests</li>
        </ol>
    </div>
    <div class="d-flex gap-2 text-nowrap mt-3 mt-md-0">
        {% if permissions.create %}
        <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addPRModal">
            <i class="fas fa-plus me-1"></i> New Purchase Request
        </button>
        {% endif %}
    </div>
</div>

<!-- Statistics Cards -->
<div class="stats-grid">
    <div class="card">
        <div class="card-body text-center">
            <h3 class="card-title">{{ stats.total_prs }}</h3>
            <p class="card-text text-muted">Total PRs</p>
        </div>
    </div>
    <div class="card">
        <div class="card-body text-center">
            <h3 class="card-title">{{ stats.pending_prs }}</h3>
            <p class="card-text text-muted">Pending PRs</p>
        </div>
    </div>
    <div class="card">
        <div class="card-body text-center">
            <h3 class="card-title">{{ stats.approved_prs }}</h3>
            <p class="card-text text-muted">Approved PRs</p>
        </div>
    </div>
    <div class="card">
        <div class="card-body text-center">
            <h3 class="card-title">${{ stats.total_value|number_format(2, '.', ',') }}</h3>
            <p class="card-text text-muted">Total Value</p>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card shadow-lg border-0 rounded-3 mb-4">
    <div class="card-body">
        <form method="GET" class="filter-form">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="form-floating">
                        <select class="form-select" id="status" name="status">
                            <option value="">All Status</option>
                            <option value="draft" {% if filters.status == 'draft' %}selected{% endif %}>Draft</option>
                            <option value="pending" {% if filters.status == 'pending' %}selected{% endif %}>Pending Approval</option>
                            <option value="approved" {% if filters.status == 'approved' %}selected{% endif %}>Approved</option>
                            <option value="rejected" {% if filters.status == 'rejected' %}selected{% endif %}>Rejected</option>
                            <option value="ordered" {% if filters.status == 'ordered' %}selected{% endif %}>Ordered</option>
                        </select>
                        <label for="status">Status</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="text" class="form-control" id="search" name="search" value="{{ filters.search }}" placeholder="Search PR Number or Costing">
                        <label for="search">Search</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="input-group">
                        <div class="form-floating flex-grow-1">
                            <input type="date" class="form-control" id="date_from" name="date_from" value="{{ filters.date_from }}">
                            <label for="date_from">From Date</label>
                        </div>
                        <div class="form-floating flex-grow-1">
                            <input type="date" class="form-control" id="date_to" name="date_to" value="{{ filters.date_to }}">
                            <label for="date_to">To Date</label>
                        </div>
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-center">
                    <button type="submit" class="btn btn-secondary rounded-pill w-100 py-3">
                        <i class="fas fa-filter me-1"></i> Filter
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- PR Table -->
<div class="card shadow-lg border-0 rounded-3 mb-4">
    <div class="card-header bg-transparent border-bottom py-3">
        <div class="d-flex justify-content-between align-items-center">
            <div class="h5 mb-0 text-primary"><i class="fas fa-list me-2"></i>Purchase Requests List</div>
            <span class="badge bg-secondary">{{ purchase_requests|length }} Requests</span>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover" id="prTable">
                <thead>
                    <tr>
                        <th class="ps-4">PR Number</th>
                        <th>Style</th>
                        <th>Costing</th>
                        <th>Required Date</th>
                        <th>Created By</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% if purchase_requests|length > 0 %}
                        {% for pr in purchase_requests %}
                            <tr>
                                <td class="ps-4">
                                    <strong>{{ pr.pr_number }}</strong>
                                    <div class="text-muted small">{{ pr.created_date|date('M j, Y') }}</div>
                                </td>
                                <td>
                                    {{ pr.style_code }}<br>
                                    <small class="text-muted">{{ pr.style_name }}</small>
                                </td>
                                <td>
                                    {{ pr.item_name }}
                                    <div class="text-muted small">
                                        Qty: {{ pr.quantity }} × ${{ pr.unit_price|number_format(2) }} = ${{ pr.total_price|number_format(2) }}
                                    </div>
                                </td>
                                <td>
                                    {{ pr.required_date|date('M j, Y') }}
                                    {% set days_left = (pr.required_date|date('U') - 'now'|date('U')) / (60 * 60 * 24) %}
                                    {% if days_left < 0 %}
                                        <br><small class="text-danger">Overdue</small>
                                    {% elseif days_left <= 3 %}
                                        <br><small class="text-warning">{{ days_left|round }} days left</small>
                                    {% endif %}
                                </td>
                                <td>
                                    {{ pr.created_by_name }}
                                </td>
                                <td>
                                    <span class="status-badge status-{{ pr.status }}">
                                        {{ pr.status|title }}
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-info rounded-circle me-1" onclick="viewPR({{ pr.pr_id }})" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        {% if permissions.edit and pr.status in ['draft', 'rejected'] %}
                                        <button class="btn btn-outline-primary rounded-circle me-1" onclick="editPR({{ pr.pr_id }})" title="Edit PR">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        {% endif %}
                                        {% if permissions.delete and pr.status == 'draft' %}
                                        <button class="btn btn-outline-danger rounded-circle" onclick="deletePR({{ pr.pr_id }})" title="Delete PR">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center text-muted">No purchase requests found. Add your first PR to get started.</td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add PR Modal -->
<div class="modal fade" id="addPRModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Purchase Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="addPRForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label class="form-label">Style</label>
                                <select class="form-select" name="style_id" required>
                                    <option value="">Select Style</option>
                                    {% for style in dropdowns.styles %}
                                        <option value="{{ style.style_id }}">{{ style.style_code }} - {{ style.style_name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="mb-3">
                                <label class="form-label">Required Date</label>
                                <input type="date" class="form-control" name="required_date" required>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Items</label>
                        <div id="itemsContainer">
                            <div class="item-row">
                                <button type="button" class="remove-item" onclick="removeItem(this)">×</button>
                                <div class="row">
                                    <div class="col-md-4">
                                        <label class="form-label">Item Name</label>
                                        <input type="text" class="form-control" name="item_name" required>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Quantity</label>
                                        <input type="number" class="form-control" name="quantity" min="0" step="0.01" required onchange="calculateItemTotal(this)">
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Unit Price</label>
                                        <input type="number" class="form-control" name="unit_price" min="0" step="0.01" required onchange="calculateItemTotal(this)">
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Total Price</label>
                                        <input type="number" class="form-control" name="total_price" min="0" step="0.01" readonly>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" name="notes" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Purchase Request</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
// Calculate item total
function calculateItemTotal(input) {
    const row = input.closest('.item-row');
    const quantity = parseFloat(row.querySelector('input[name="quantity"]').value) || 0;
    const price = parseFloat(row.querySelector('input[name="unit_price"]').value) || 0;
    const total = quantity * price;
    row.querySelector('input[name="total_price"]').value = total.toFixed(2);
}

// View PR function
function viewPR(prId) {
    fetch(`{{ BASE_URL }}/merchandising/purchase-requests/${prId}`, {
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.error) {
            alert(data.error);
            return;
        }
        // Show PR details in a modal (simplified for now)
        alert(`Purchase Request Details:\n\nPR Number: ${data.data.pr_number}\nItem: ${data.data.item_name}\nQuantity: ${data.data.quantity}\nStatus: ${data.data.status}`);
    })
    .catch(error => console.error('Error:', error));
}

// Approve PR function
function approvePR(prId) {
    const newStatus = prompt(`Update Purchase Request ID: ${prId}\n\nEnter new status (pending/approved/rejected/ordered):`);
    if (newStatus) {
        fetch(`{{ BASE_URL }}/merchandising/purchase-requests/${prId}/status`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({ status: newStatus })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                location.reload();
            } else {
                alert(data.message);
            }
        })
        .catch(error => console.error('Error:', error));
    }
}

// Delete PR function
function deletePR(prId) {
    if (confirm('Are you sure you want to delete this purchase request?')) {
        fetch(`{{ BASE_URL }}/merchandising/purchase-requests/${prId}`, {
            method: 'DELETE',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                location.reload();
            } else {
                alert(data.message);
            }
        })
        .catch(error => console.error('Error:', error));
    }
}

// Handle form submission
document.getElementById('addPRForm').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    const data = Object.fromEntries(formData.entries());
    
    fetch('{{ BASE_URL }}/merchandising/purchase-requests', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify(data)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert(data.message);
            location.reload();
        } else if (data.errors) {
            alert('Validation errors: ' + JSON.stringify(data.errors));
        } else {
            alert(data.message);
        }
    })
    .catch(error => console.error('Error:', error));
});

// Set minimum date for required date
document.addEventListener('DOMContentLoaded', function() {
    const requiredDateInput = document.querySelector('input[name="required_date"]');
    if (requiredDateInput) {
        const today = new Date().toISOString().split('T')[0];
        requiredDateInput.min = today;
    }
});
</script>
{% endblock %}
