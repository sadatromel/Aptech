{% extends 'layouts/app.twig' %}

{% block title %}View Bulk Costing | RMG PRO ERP{% endblock %}

{% block styles %}
<style>
    .section-header {
        background-color: var(--bg-secondary);
        padding: 0.75rem 1rem;
        border-radius: 8px;
        margin-bottom: 1rem;
        font-weight: 600;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .costing-table th {
        font-size: 0.8rem;
        background-color: #f8f9fa;
        white-space: nowrap;
    }
    .info-label {
        font-weight: 600;
        color: var(--secondary);
        font-size: 0.85rem;
    }
    .info-value {
        font-weight: 500;
    }
</style>
{% endblock %}

{% block content %}
<div class="container-fluid px-4 pb-5">
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
        <div>
            <h1 class="h3 mb-1">Factory: {{ costing.factory_name }}</h1>
            <p class="text-secondary small mb-0">Bulk Costing Reference Sheet</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ BASE_URL }}/merchandising/bulk-costing/{{ costing.costing_id }}/edit" class="btn btn-primary rounded-pill">
                <i class="fas fa-edit me-2"></i>Edit Costing
            </a>
            <a href="{{ BASE_URL }}/merchandising/bulk-costing/{{ costing.costing_id }}/report" target="_blank" class="btn btn-success rounded-pill">
                <i class="fas fa-print me-2"></i>Print Report
            </a>
            <a href="{{ BASE_URL }}/merchandising/bulk-costing" class="btn btn-outline-secondary rounded-pill">
                <i class="fas fa-arrow-left me-2"></i>Back to List
            </a>
        </div>
    </div>

    <!-- Summary Details -->
    <div class="row g-4 mb-4">
        <div class="col-md-9">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="info-label">Buyer</div>
                            <div class="info-value">{{ costing.buyer_name ?? 'N/A' }}</div>
                        </div>
                        <div class="col-md-4">
                            <div class="info-label">Allocation No</div>
                            <div class="info-value">{{ costing.allocation_no ?: 'N/A' }}</div>
                        </div>
                        <div class="col-md-4">
                            <div class="info-label">SC No / Job No</div>
                            <div class="info-value">{{ costing.sc_no ?: 'N/A' }} / {{ costing.job_no ?: 'N/A' }}</div>
                        </div>
                        <div class="col-md-4">
                            <div class="info-label">Costing Date</div>
                            <div class="info-value">{{ costing.costing_date|date('d F, Y') }}</div>
                        </div>
                        <div class="col-md-4">
                            <div class="info-label">Commissions (%)</div>
                            <div class="info-value">
                                Local: {{ costing.local_commission_pct }}%, 
                                Foreign: {{ costing.foreign_commission_pct }}%
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="info-label">Early Payment Cost (%)</div>
                            <div class="info-value">{{ costing.early_payment_cost_pct }}%</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-primary text-white h-100">
                <div class="card-body d-flex flex-column justify-content-center text-center">
                    <div class="small opacity-75 mb-1">Projected Gross Profit</div>
                    <div class="h3 mb-0">$ {{ costing.profit_amount|number_format(2) }}</div>
                    <hr class="my-2 bg-white opacity-25">
                    <div class="small opacity-75 mb-1">Total Costing</div>
                    <div class="h5 mb-0">$ {{ costing.total_costing_value|number_format(2) }}</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Sections -->
    <div class="row g-4">
        <div class="col-12">
            <!-- Style Section -->
            <div class="section-header">STYLE AND ORDER DESCRIPTION</div>
            <div class="table-responsive mb-4">
                <table class="table table-sm table-bordered costing-table">
                    <thead>
                        <tr>
                            <th>Style Information</th>
                            <th width="150">Order No</th>
                            <th>Quantity</th>
                            <th>Unit Price $</th>
                            <th class="text-end">Amount $</th>
                            <th>Shipment Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% set total_qty = 0 %}
                        {% for style in costing.styles %}
                        <tr>
                            <td>
                                <div class="fw-bold">{{ style.style_code }}</div>
                                <div class="text-muted small">{{ style.style_name }}</div>
                            </td>
                            <td>{{ style.order_no }}</td>
                            <td>{{ style.quantity|number_format(0) }}</td>
                            <td>{{ style.unit_price|number_format(4) }}</td>
                            <td class="text-end">{{ (style.quantity * style.unit_price)|number_format(2) }}</td>
                            <td>{{ style.shipment_date ? style.shipment_date|date('d-m-Y') : 'N/A' }}</td>
                        </tr>
                        {% set total_qty = total_qty + style.quantity %}
                        {% endfor %}
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="2">Total</td>
                            <td>{{ total_qty|number_format(0) }}</td>
                            <td></td>
                            <td class="text-end">$ {{ (costing.order_value / (1 - (costing.local_commission_pct + costing.foreign_commission_pct + costing.early_payment_cost_pct)/100))|number_format(2) if total_qty > 0 else '0.00' }}</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Fabric Section -->
            <div class="section-header">ALL FABRIC DESCRIPTION</div>
            <div class="table-responsive mb-4">
                <table class="table table-sm table-bordered costing-table">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Description</th>
                            <th>Ref</th>
                            <th>Width (F/C)</th>
                            <th>UOM</th>
                            <th>Source</th>
                            <th>Cons</th>
                            <th>Qty</th>
                            <th>Price $</th>
                            <th class="text-end">Total $</th>
                            <th>Supplier</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in costing.fabrics %}
                        <tr>
                            <td>{{ item.item_name }}</td>
                            <td>{{ item.description }}</td>
                            <td>{{ item.fabric_ref }}</td>
                            <td>{{ item.full_width }}/{{ item.cutable_width }}</td>
                            <td>{{ item.uom }}</td>
                            <td>{{ item.material_source }}</td>
                            <td>{{ item.consumption }}</td>
                            <td>{{ item.quantity|number_format(2) }}</td>
                            <td>{{ item.unit_price|number_format(3) }}</td>
                            <td class="text-end">{{ (item.quantity * item.unit_price)|number_format(2) }}</td>
                            <td>{{ item.supplier_name }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="row">
                <div class="col-lg-6">
                    <!-- Wash Section -->
                    <div class="section-header">WASH COST</div>
                    <div class="table-responsive mb-4">
                        <table class="table table-sm table-bordered costing-table">
                            <thead>
                                <tr>
                                    <th>Wash Type</th>
                                    <th>Color</th>
                                    <th>Qty</th>
                                    <th>Price $</th>
                                    <th class="text-end">Total $</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in costing.wash_costs %}
                                <tr>
                                    <td>{{ item.wash_type }}</td>
                                    <td>{{ item.color }}</td>
                                    <td>{{ item.quantity|number_format(0) }}</td>
                                    <td>{{ item.unit_price|number_format(2) }}</td>
                                    <td class="text-end">{{ (item.quantity * item.unit_price)|number_format(2) }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-lg-6">
                    <!-- Embl Section -->
                    <div class="section-header">EMBELLISHMENT COST</div>
                    <div class="table-responsive mb-4">
                        <table class="table table-sm table-bordered costing-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Color</th>
                                    <th>Qty</th>
                                    <th>Price $</th>
                                    <th class="text-end">Total $</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in costing.embl_costs %}
                                <tr>
                                    <td>{{ item.embl_name }}</td>
                                    <td>{{ item.color }}</td>
                                    <td>{{ item.quantity|number_format(0) }}</td>
                                    <td>{{ item.unit_price|number_format(2) }}</td>
                                    <td class="text-end">{{ (item.quantity * item.unit_price)|number_format(2) }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Other Cost & CM Section -->
            <div class="section-header">OTHER COST & CM</div>
            <div class="table-responsive mb-4">
                <table class="table table-sm table-bordered costing-table">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th>UOM</th>
                            <th>Quantity</th>
                            <th>Unit Price $</th>
                            <th class="text-end">Total Value $</th>
                            <th>Supplier</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in costing.other_costs %}
                        <tr>
                            <td>{{ item.description }}</td>
                            <td>{{ item.uom }}</td>
                            <td>{{ item.quantity|number_format(2) }}</td>
                            <td>{{ item.unit_price|number_format(2) }}</td>
                            <td class="text-end">{{ (item.quantity * item.unit_price)|number_format(2) }}</td>
                            <td>{{ item.supplier_name }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>
{% endblock %}
