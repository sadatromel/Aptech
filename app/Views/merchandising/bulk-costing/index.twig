{% block scripts %}
<script>
/* ─────────────────────────────────────────────
   BULK COSTING — Interaction Script
───────────────────────────────────────────── */
let counters = { style: 0, fabric: 0, accessory: 0, wash: 0, embl: 0, other: 0 };
let currentMode = 'list';
let deleteTargetId = null;

const toastEl   = document.getElementById('systemToast');
const toastBody = document.getElementById('systemToastBody');
const bsToast   = toastEl ? bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 3500 }) : null;

function showToast(msg, type = 'success') {
    if (!toastEl) return;
    toastEl.className = `toast align-items-center text-white border-0 bg-${type}`;
    toastBody.textContent = msg;
    bsToast?.show();
}

/* ── Tab helpers ── */
function setMode(mode) {
    currentMode = mode;
    document.getElementById('top-actions').style.display = mode === 'list' ? 'block' : 'none';
}
function switchToTab(tabName) {
    const tabEl = document.querySelector(`#${tabName}-tab`);
    bootstrap.Tab.getInstance(tabEl)?.show() || new bootstrap.Tab(tabEl).show();
    if (tabName === 'entry' && !document.getElementById('current_id').value) {
        resetForm();
    }
}

/* ── Row builders ── */
// Shared action buttons for every row: [+] insert below, [×] remove
function rowActions(type) {
    return `<div class="row-action-btns">
        <button type="button" class="btn-row-add" onclick="insertRowAfter(this,'${type}')" title="Insert row below">
            <i class="fas fa-plus"></i>
        </button>
        <button type="button" class="btn-row-del" onclick="removeRow(this)" title="Remove row">
            <i class="fas fa-times"></i>
        </button>
    </div>`;
}

// Insert a new blank row after the row containing `btn`
function insertRowAfter(btn, type) {
    const refTr = btn.closest('tr');
    addRow(type, null, refTr);
}

// addRow(type, data?, afterTr?)
// If afterTr is given the new row is inserted right after it; otherwise appended to tbody.
function addRow(type, data = null, afterTr = null) {
    const tbody = document.querySelector(`#table-${type} tbody`);
    const count = counters[type]++;
    let html = '';
    const acts = rowActions(type);

    if (type === 'style') {
        html = `<tr>
            <td>
                <div class="fw-bold" style="font-size:0.85rem;">${data?.style_code || 'N/A'}</div>
                <div class="text-muted small">${data?.style_name || 'N/A'}</div>
                <input type="hidden" name="styles[${count}][style_id]" value="${data?.style_id || ''}">
            </td>
            <td><input type="text" class="form-control form-control-sm" name="styles[${count}][order_no]" value="${data?.order_no || ''}" placeholder="Order No"></td>
            <td><input type="number" class="form-control form-control-sm qty-input" name="styles[${count}][quantity]" value="${data?.quantity || ''}" onchange="calcTotal()" placeholder="0"></td>
            <td><input type="number" step="0.0001" class="form-control form-control-sm price-input" name="styles[${count}][unit_price]" value="${data?.unit_price || ''}" onchange="calcTotal()" placeholder="0.0000"></td>
            <td><input type="text" class="form-control form-control-sm amount-display readonly-cell" readonly placeholder="0.00"></td>
            <td><input type="date" class="form-control form-control-sm" name="styles[${count}][shipment_date]" value="${data?.shipment_date || ''}"></td>
            <td class="text-center">
                <button type="button" class="btn-row-del" onclick="removeRow(this)" title="Remove row">
                    <i class="fas fa-times"></i>
                </button>
            </td>
        </tr>`;
    } else if (type === 'fabric') {
        html = `<tr>
            <td><input type="text" class="form-control form-control-sm" name="fabrics[${count}][item_name]" value="${data?.item_name || ''}" placeholder="Item name"></td>
            <td><input type="text" class="form-control form-control-sm" name="fabrics[${count}][description]" value="${data?.description || ''}" placeholder="Description"></td>
            <td><input type="text" class="form-control form-control-sm" name="fabrics[${count}][fabric_ref]" value="${data?.fabric_ref || ''}" placeholder="Ref"></td>
            <td><input type="text" class="form-control form-control-sm" name="fabrics[${count}][uom]" value="${data?.uom || 'Yds'}" placeholder="Yds"></td>
            <td><input type="number" step="0.0001" class="form-control form-control-sm cons-input" name="fabrics[${count}][consumption]" value="${data?.consumption || ''}" onchange="calcTotal()" placeholder="0"></td>
            <td><input type="number" step="0.01" class="form-control form-control-sm qty-row-input" name="fabrics[${count}][quantity]" value="${data?.quantity || ''}" onchange="calcTotal()" placeholder="0"></td>
            <td><input type="number" step="0.001" class="form-control form-control-sm price-row-input" name="fabrics[${count}][unit_price]" value="${data?.unit_price || ''}" onchange="calcTotal()" placeholder="0.000"></td>
            <td><input type="text" class="form-control form-control-sm total-display readonly-cell" readonly placeholder="0.00"></td>
            <td class="text-center">${acts}</td>
        </tr>`;
    } else {
        const nameField = type === 'wash' ? 'wash_type' : (type === 'embl' ? 'embl_name' : 'description');
        const hasUom    = (type === 'accessory' || type === 'other');
        const hasCons   = (type === 'accessory');
        html = `<tr>
            <td><input type="text" class="form-control form-control-sm" name="${type}s[${count}][${nameField}]" value="${data?.[nameField] || ''}" placeholder="${type === 'wash' ? 'Wash type' : type === 'embl' ? 'Embl. name' : 'Description'}"></td>
            ${hasUom  ? `<td><input type="text" class="form-control form-control-sm" name="${type}s[${count}][uom]" value="${data?.uom || 'Pcs'}" placeholder="UOM"></td>` : ''}
            ${hasCons ? `<td><input type="number" step="0.0001" class="form-control form-control-sm cons-input" name="${type}s[${count}][consumption]" value="${data?.consumption || ''}" onchange="calcTotal()" placeholder="0"></td>` : ''}
            <td><input type="number" class="form-control form-control-sm qty-row-input" name="${type}s[${count}][quantity]" value="${data?.quantity || ''}" onchange="calcTotal()" placeholder="0"></td>
            <td><input type="number" step="0.01" class="form-control form-control-sm price-row-input" name="${type}s[${count}][unit_price]" value="${data?.unit_price || ''}" onchange="calcTotal()" placeholder="0.00"></td>
            <td><input type="text" class="form-control form-control-sm total-display readonly-cell" readonly placeholder="0.00"></td>
            <td class="text-center">${acts}</td>
        </tr>`;
    }

    if (afterTr) {
        afterTr.insertAdjacentHTML('afterend', html);
    } else {
        tbody.insertAdjacentHTML('beforeend', html);
    }
    calcTotal();
}

// Add style line from entry facility
function addStyleOrderLine() {
    const styleEl = document.getElementById('entry_style_id');
    const orderNo = document.getElementById('entry_order_no').value;
    const qty = document.getElementById('entry_quantity').value;
    const price = document.getElementById('entry_unit_price').value;
    const date = document.getElementById('entry_shipment_date').value;

    if (!styleEl.value) { showToast('Please select a style.', 'warning'); return; }
    if (!orderNo) { showToast('Please enter an order number.', 'warning'); return; }

    const opt = styleEl.selectedOptions[0];
    addRow('style', {
        style_id: styleEl.value,
        style_code: opt.dataset.code,
        style_name: opt.dataset.name,
        order_no: orderNo,
        quantity: qty,
        unit_price: price,
        shipment_date: date
    });

    // Clear entry
    document.getElementById('entry_order_no').value = '';
    document.getElementById('entry_quantity').value = '';
    document.getElementById('entry_unit_price').value = '';
    document.getElementById('entry_shipment_date').value = '';
    $(styleEl).val('').trigger('change');
    showToast('Order line added!', 'success');
}

function removeRow(btn) {
    btn.closest('tr').remove();
    calcTotal();
}

/* ── Calculation ── */
function calcTotal() {
    let totalOrderValue = 0, totalCostingValue = 0;

    document.querySelectorAll('#table-style tbody tr').forEach(row => {
        const qty   = parseFloat(row.querySelector('.qty-input')?.value) || 0;
        const price = parseFloat(row.querySelector('.price-input')?.value) || 0;
        const amt   = qty * price;
        const disp  = row.querySelector('.amount-display');
        if (disp) disp.value = amt.toFixed(2);
        totalOrderValue += amt;
    });

    document.querySelectorAll('.costing-table:not(#table-style) tbody tr').forEach(row => {
        const qty   = parseFloat(row.querySelector('.qty-row-input')?.value) || 0;
        const price = parseFloat(row.querySelector('.price-row-input')?.value) || 0;
        const total = qty * price;
        const disp  = row.querySelector('.total-display');
        if (disp) disp.value = total.toFixed(2);
        totalCostingValue += total;
    });

    const dedPct = ['local_commission_pct','foreign_commission_pct','early_payment_cost_pct']
        .reduce((acc, n) => acc + (parseFloat(document.getElementById(n)?.value) || 0), 0);
    const netOrderValue = totalOrderValue * (1 - dedPct / 100);
    const profit  = netOrderValue - totalCostingValue;
    const margin  = netOrderValue > 0 ? (profit / netOrderValue * 100) : 0;

    document.getElementById('display_order_value').value  = netOrderValue.toFixed(2);
    document.getElementById('summary_order_value').innerText = fmt(netOrderValue);
    document.getElementById('summary_total_cost').innerText  = fmt(totalCostingValue);
    document.getElementById('summary_profit').innerText      = fmt(profit);
    document.getElementById('summary_margin').innerText      = margin.toFixed(1);
    document.getElementById('hidden_total_cost').value = totalCostingValue;
    document.getElementById('hidden_profit').value     = profit;

    // Colour margin
    const marginEl = document.getElementById('summary_margin').parentElement;
    if (margin >= 10) marginEl.style.color = '#198754';
    else if (margin >= 0) marginEl.style.color = '#d97706';
    else marginEl.style.color = '#dc3545';
}

function fmt(n) {
    return n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

/* ── Reset ── */
function resetForm() {
    document.getElementById('bulkCostingForm').reset();
    document.getElementById('current_id').value = '';
    document.getElementById('form-status-badge').textContent = 'NEW';
    document.getElementById('form-status-badge').className = 'badge bg-light text-muted border';
    document.getElementById('save-btn').innerHTML = '<i class="fas fa-save me-2"></i>Save Sheet';
    ['fabric','accessory','wash','embl','other'].forEach(t => {
        document.querySelector(`#table-${t} tbody`).innerHTML = '';
        counters[t] = 0;
    });
    // For style table, we also clear it (user wants display-only table updated by facility)
    document.querySelector('#table-style tbody').innerHTML = '';
    counters['style'] = 0;

    addRow('fabric'); addRow('accessory');
    addRow('wash'); addRow('embl'); addRow('other');
    calcTotal();
}

/* ── Load edit ── */
async function loadEdit(id) {
    try {
        const resp = await fetch(`{{ BASE_URL }}/merchandising/bulk-costing/${id}`, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        if (!resp.ok) throw new Error('Server error');
        const data = (await resp.json()).data;

        resetForm();
        document.getElementById('current_id').value = id;
        document.getElementById('form-status-badge').textContent = (data.status === 'approved') ? 'APPROVED' : 'DRAFT';
        document.getElementById('form-status-badge').className   = (data.status === 'approved')
            ? 'badge bg-success bg-opacity-10 text-success border border-success border-opacity-25'
            : 'badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25';
        document.getElementById('save-btn').innerHTML = '<i class="fas fa-save me-2"></i>Update Sheet';

        const form = document.getElementById('bulkCostingForm');
        ['factory_id','style_id','buyer_id','allocation_no','sc_no','job_no','costing_date',
         'local_commission_pct','foreign_commission_pct','early_payment_cost_pct'].forEach(f => {
            if (form[f]) form[f].value = data[f] ?? '';
        });

        // Fill line items
        const map = { style: data.styles, fabric: data.fabrics, accessory: data.accessories,
                      wash: data.wash_costs, embl: data.embl_costs, other: data.other_costs };
        Object.entries(map).forEach(([t, list]) => {
            const tbody = document.querySelector(`#table-${t} tbody`);
            tbody.innerHTML = ''; counters[t] = 0;
            (list || []).forEach(item => addRow(t, item));
            if (!list || list.length === 0) addRow(t);
        });

        switchToTab('entry');
    } catch (e) {
        showToast('Failed to load costing data. Please try again.', 'danger');
    }
}

/* ── Delete ── */
const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
function deleteCosting(id, label) {
    deleteTargetId = id;
    document.getElementById('delete-sheet-label').textContent = label || `#${id}`;
    deleteModal.show();
}
document.getElementById('confirmDeleteBtn').addEventListener('click', async () => {
    const btn = document.getElementById('confirmDeleteBtn');
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Deleting…';
    btn.disabled = true;
    try {
        const r = await fetch(`{{ BASE_URL }}/merchandising/bulk-costing/${deleteTargetId}`, { method: 'DELETE' });
        const d = await r.json();
        if (d.success) {
            showToast('Costing sheet deleted.', 'success');
            deleteModal.hide();
            setTimeout(() => location.reload(), 900);
        } else {
            throw new Error(d.message);
        }
    } catch (e) {
        showToast(e.message || 'Delete failed.', 'danger');
        btn.innerHTML = '<i class="fas fa-trash me-1"></i>Delete';
        btn.disabled = false;
    }
});

/* ── Save (Create / Update) ── */
document.getElementById('bulkCostingForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const id  = document.getElementById('current_id').value;
    const btn = document.getElementById('save-btn');
    const orig = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Saving…';
    btn.disabled  = true;

    const formData = new FormData(this);
    const payload  = {};
    formData.forEach((v, k) => {
        const p = k.split('[');
        if (p.length === 1) { payload[k] = v; return; }
        let cur = payload;
        for (let i = 0; i < p.length; i++) {
            let s = p[i].replace(']', '');
            if (i === p.length - 1) { cur[s] = v; }
            else {
                if (!cur[s]) cur[s] = isNaN(p[i+1].replace(']','')) ? {} : [];
                cur = cur[s];
            }
        }
    });

    try {
        const resp = await fetch(`{{ BASE_URL }}/merchandising/bulk-costing${id ? '/'+id : ''}`, {
            method: id ? 'PUT' : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const res = await resp.json();
        if (res.success) {
            showToast(id ? 'Costing sheet updated!' : 'New costing sheet saved!', 'success');
            setTimeout(() => location.reload(), 900);
        } else {
            throw new Error(res.message || 'Save failed');
        }
    } catch (err) {
        showToast(err.message, 'danger');
        btn.innerHTML = orig;
        btn.disabled  = false;
    }
});

/* ── Auto-fill Buyer from Style ── */
document.getElementById('entry_style_id').addEventListener('change', function() {
    const opt = this.selectedOptions[0];
    const buyerId = opt?.dataset?.buyer;
    if (buyerId && !document.getElementById('buyer_id').value) {
        document.getElementById('buyer_id').value = buyerId;
        // Trigger buyer_id change manually
        document.getElementById('buyer_id').dispatchEvent(new Event('change'));
    }
});

/* ── Trims Template Integration ── */
document.getElementById('buyer_id').addEventListener('change', function() {
    loadTemplatesForBuyer(this.value);
});

async function loadTemplatesForBuyer(buyerId) {
    const area = document.getElementById('template-loader-area');
    const select = document.getElementById('trims_template_id');
    
    if (!buyerId) {
        area.classList.add('d-none');
        area.classList.remove('d-flex');
        return;
    }

    try {
        const resp = await fetch(`{{ BASE_URL }}/master_library/trims_costing_template/templates-by-buyer?buyer_id=${buyerId}`);
        const res = await resp.json();
        
        if (res.success && res.data.length > 0) {
            select.innerHTML = '<option value="">-- Load Trims Template --</option>';
            res.data.forEach(t => {
                select.innerHTML += `<option value="${t.template_id}">${t.template_name}</option>`;
            });
            area.classList.remove('d-none');
            area.classList.add('d-flex');
        } else {
            area.classList.add('d-none');
            area.classList.remove('d-flex');
        }
    } catch (e) {
        console.error('Template load error', e);
    }
}

async function applyTrimsTemplate() {
    const templateId = document.getElementById('trims_template_id').value;
    if (!templateId) {
        showToast('Please select a template first.', 'warning');
        return;
    }

    Swal.fire({
        title: 'Apply Trims Template?',
        text: 'This will add all items from the template to your accessories list. Existing items will remain.',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#6366f1',
        confirmButtonText: 'Yes, Apply Now'
    }).then(async (result) => {
        if (result.isConfirmed) {
            try {
                const resp = await fetch(`{{ BASE_URL }}/master_library/trims_costing_template/show?id=${templateId}`);
                const res = await resp.json();
                
                if (res.success && res.data.items) {
                    res.data.items.forEach(item => {
                        addRow('accessory', {
                            description: item.trims_group + ': ' + item.item_name,
                            uom: item.uom,
                            consumption: item.consumption,
                            unit_price: item.unit_price,
                            quantity: 0
                        });
                    });
                    showToast(`${res.data.items.length} items applied from template!`, 'success');
                } else {
                    showToast('Template has no items or could not be loaded.', 'warning');
                }
            } catch (e) {
                showToast('Failed to load template items.', 'danger');
            }
        }
    });
}

/* ── Init ── */
$(document).ready(function() {
    $('.select2').select2({
        theme: 'bootstrap-5',
        width: '100%',
        dropdownParent: $('#entry-pane')
    });
});
resetForm();
</script>
