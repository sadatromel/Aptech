{% extends 'layouts/app.twig' %}

{% block title %}Bulk Costing — RMG PRO ERP{% endblock %}

{% block styles %}
<style>
    :root {
        --text-muted: var(--text-tertiary);
    }

    /* ===== ANIMATION ===== */
    .bulk-costing-page { animation: bcFadeIn 0.5s ease-out; }
    @keyframes bcFadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* ===== STAT CARDS - PREMIUM GRADIENT STYLE ===== */
    .stat-card {
        padding: 1.5rem;
        border-radius: 1.25rem !important;
        border: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 140px;
    }
    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.15);
    }
    .stat-card i.position-absolute {
        font-size: 4rem;
        opacity: 0.15;
        right: 20px;
        top: 50%;
        transform: translateY(-50%);
        transition: all 0.5s ease;
    }
    .stat-card:hover i.position-absolute {
        transform: translateY(-50%) scale(1.1);
        opacity: 0.25;
    }
    .stat-card .sc-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        opacity: 0.85;
        margin-bottom: 0.5rem;
        color: white !important;
    }
    .stat-card h2 {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 0;
        line-height: 1;
        color: white !important;
    }

    /* ===== TABLE & CONTAINERS ===== */
    .table-container {
        background: var(--card-bg, #fff);
        border-radius: 1.25rem;
        border: none;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        overflow: hidden;
        margin-bottom: 2rem;
    }
    #costingListTable thead th {
        background-color: var(--bs-tertiary-bg);
        border: none;
        text-transform: uppercase;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.8px;
        color: var(--text-muted);
        padding: 1.25rem 1rem;
    }
    #costingListTable tbody tr {
        transition: all 0.2s ease;
        border-bottom: 1px solid rgba(0,0,0,0.03);
    }
    #costingListTable tbody tr:hover {
        background-color: var(--primary-light) !important;
    }
    #costingListTable td {
        padding: 1.1rem 1rem;
        border: none;
    }

    /* ===== PREMIUM BADGES ===== */
    .badge-status-premium {
        font-weight: 700;
        padding: 0.4em 1.2em;
        border-radius: 50px;
        letter-spacing: 0.5px;
        font-size: 0.68rem;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }
    .badge-success-premium { background-color: rgba(25, 135, 84, 0.1) !important; color: #198754 !important; border: 1px solid rgba(25, 135, 84, 0.2); }
    .badge-warning-premium { background-color: rgba(242, 153, 74, 0.1) !important; color: #f2994a !important; border: 1px solid rgba(242, 153, 74, 0.2); }
    .badge-info-premium { background-color: rgba(30, 60, 114, 0.1) !important; color: #1e3c72 !important; border: 1px solid rgba(30, 60, 114, 0.2); }

    /* ===== FILTERS & LABELS ===== */
    .filter-card {
        background: var(--card-bg, #fff);
        border-radius: 1.25rem !important;
        border: none;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }
    .form-label-premium {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: var(--text-muted);
        margin-bottom: 0.5rem;
        display: block;
    }

    /* ===== ENTRY FORM SECTIONS ===== */
    .form-section-card {
        background: var(--card-bg, #fff);
        border-radius: 1.25rem !important;
        border: none;
        box-shadow: 0 4px 15px rgba(0,0,0,0.04);
        margin-bottom: 2rem;
        overflow: hidden;
    }
    .form-section-card .section-header-bar {
        background-color: var(--bs-tertiary-bg);
        border-bottom: 1px solid rgba(0,0,0,0.03);
        padding: 1rem 1.5rem;
    }
    .form-section-card .section-title {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: var(--primary);
    }
    .costing-table thead th {
        background-color: rgba(0,0,0,0.02);
        font-size: 0.68rem;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 0.75rem;
        border-bottom: 2px solid rgba(0,0,0,0.05);
    }

    /* ===== STICKY SUMMARY BAR ===== */
    .sticky-summary-bar {
        position: sticky;
        bottom: 1rem;
        z-index: 100;
        background: var(--card-bg, #fff);
        border-radius: 1.25rem;
        padding: 1.25rem 2rem;
        margin: 0 0 2rem 0;
        box-shadow: 0 -10px 25px rgba(0,0,0,0.1), 0 10px 25px rgba(0,0,0,0.1);
        border: 1px solid rgba(99, 102, 241, 0.1);
    }
    .summary-value-block .sv-label {
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--text-muted);
        margin-bottom: 0.25rem;
    }
    .summary-value-block .sv-amount {
        font-size: 1.5rem;
        font-weight: 900;
        color: var(--primary);
    }

    /* ===== BUYER AVATAR ===== */
    .buyer-avatar-premium {
        width: 32px; height: 32px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.8rem; font-weight: 800;
        background: var(--primary-light);
        color: var(--primary);
        border: 1px solid rgba(99, 102, 241, 0.1);
    }

    [data-theme="dark"] .table-container, 
    [data-theme="dark"] .filter-card,
    [data-theme="dark"] .form-section-card,
    [data-theme="dark"] .sticky-summary-bar { background: #1e293b; }
    [data-theme="dark"] .costing-table thead th { background-color: rgba(255,255,255,0.05); }

    /* ===== TOAST ===== */
    .toast-container { z-index: 1095; }

    /* form-control-sm overrides for tighter costing tables */
    .costing-table .form-control-sm,
    .costing-table .form-select-sm {
        font-size: 0.8rem;
        padding: 0.28rem 0.5rem;
        border-radius: 6px;
    }

    /* ===== PER-ROW +/× BUTTONS ===== */
    .row-action-btns {
        display: inline-flex;
        gap: 3px;
        align-items: center;
    }
    .btn-row-add,
    .btn-row-del {
        width: 24px;
        height: 24px;
        border: none;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.65rem;
        cursor: pointer;
        transition: all 0.15s ease;
        padding: 0;
        line-height: 1;
    }
    .btn-row-add {
        background: rgba(99,102,241,0.1);
        color: var(--primary, #6366f1);
    }
    .btn-row-add:hover {
        background: var(--primary, #6366f1);
        color: #fff;
        transform: scale(1.1);
    }
    .btn-row-del {
        background: rgba(220,53,69,0.1);
        color: #dc3545;
    }
    .btn-row-del:hover {
        background: #dc3545;
        color: #fff;
        transform: scale(1.1);
    }
</style>
{% endblock %}

{% block content %}
<div class="container-fluid px-4 pb-5 bulk-costing-page">

    {# ─── Page Header ─── #}
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center mt-4 mb-3">
        <div>
            <h1 class="h3 mb-1 fw-bold">Bulk Costing</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="{{ BASE_URL }}/merchandising" class="text-decoration-none">Merchandising</a></li>
                    <li class="breadcrumb-item active fw-medium">Costing Analysis</li>
                </ol>
            </nav>
        </div>
        <div id="top-actions">
            <button class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold" onclick="switchToTab('entry')" id="new-costing-btn">
                <i class="fas fa-plus me-2"></i>New Costing Sheet
            </button>
        </div>
    </div>

    {# ─── Stat Cards ─── #}
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card shadow-sm" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <i class="fas fa-file-invoice-dollar position-absolute"></i>
                <p class="sc-label">Total Costing</p>
                <h2>{{ stats.total }}</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card shadow-sm" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                <i class="fas fa-check-circle position-absolute"></i>
                <p class="sc-label">Approved Sheets</p>
                <h2>{{ stats.active }}</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card shadow-sm" style="background: linear-gradient(135deg, #f2994a 0%, #f2c94c 100%);">
                <i class="fas fa-pencil-alt position-absolute"></i>
                <p class="sc-label">Draft Mode</p>
                <h2>{{ stats.draft }}</h2>
            </div>
        </div>
    </div>

    {# ─── Tabs ─── #}
    <ul class="nav costing-tabs" id="costingTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" id="list-tab" data-bs-toggle="tab" data-bs-target="#list-pane" type="button" role="tab" onclick="setMode('list')">
                <i class="fas fa-table-list me-2"></i>Browse Library
                <span class="badge bg-primary bg-opacity-10 text-primary ms-2" style="font-size:0.7rem;">{{ stats.total }}</span>
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="entry-tab" data-bs-toggle="tab" data-bs-target="#entry-pane" type="button" role="tab" onclick="setMode('entry')">
                <i class="fas fa-file-pen me-2"></i>Costing Editor
            </button>
        </li>
    </ul>

    <div class="tab-content" id="costingTabsContent">

        {# ══════════════════════════ TAB 1: LIST ══════════════════════════ #}
        <div class="tab-pane fade show active" id="list-pane" role="tabpanel">

            {# Filter Bar #}
            <div class="card filter-card mb-4">
                <div class="card-body p-4">
                    <form action="{{ BASE_URL }}/merchandising/costing" method="GET" class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label-premium">Target Style</label>
                            <select class="form-select bg-light border-0" name="style_id">
                                <option value="">All Collections</option>
                                {% for style in dropdowns.styles %}
                                    <option value="{{ style.style_id }}" {% if filters.style_id == style.style_id %}selected{% endif %}>{{ style.style_code }} — {{ style.style_name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label-premium">Review Status</label>
                            <select class="form-select bg-light border-0" name="status">
                                <option value="" {% if not filters.status %}selected{% endif %}>Any Status</option>
                                <option value="approved" {% if filters.status == 'approved' %}selected{% endif %}>Approved</option>
                                <option value="draft" {% if filters.status == 'draft' %}selected{% endif %}>Draft</option>
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label-premium">Keyword Search</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="fas fa-search text-muted small"></i></span>
                                <input type="text" class="form-control bg-light border-0 ps-0" name="search" value="{{ filters.search }}" placeholder="Search factory, buyer, article...">
                            </div>
                        </div>
                        <div class="col-md-2 d-flex gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill flex-grow-1 shadow-sm">
                                <i class="fas fa-filter me-1"></i>Apply
                            </button>
                            <a href="{{ BASE_URL }}/merchandising/costing" class="btn btn-outline-secondary rounded-pill shadow-sm" title="Reset">
                                <i class="fas fa-undo"></i>
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            {# List Table #}
            <div class="table-container mb-4">
                <div class="table-responsive">
                    <table class="table align-middle mb-0" id="costingListTable">
                        <thead>
                            <tr>
                                <th class="ps-4">FACTORY</th>
                                <th>STYLE</th>
                                <th>PARTNER</th>
                                <th>ALLOC NO</th>
                                <th>DATE</th>
                                <th>STATUS</th>
                                <th class="text-end pe-4">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if costings is not empty %}
                                {% for costing in costings %}
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold" style="font-size:0.9rem;">{{ costing.factory_name ?? '—' }}</div>
                                            {% if costing.sc_no %}
                                                <div class="text-muted small">SC: {{ costing.sc_no }}</div>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <div class="fw-bold" style="font-size:0.9rem;">{{ costing.style_code }}</div>
                                            <div class="text-muted small text-truncate" style="max-width:140px;">{{ costing.style_name }}</div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="buyer-avatar-premium">{{ costing.buyer_name|slice(0,1)|upper }}</div>
                                                <span class="fw-semibold">{{ costing.buyer_name ?? '—' }}</span>
                                            </div>
                                        </td>
                                        <td>
                                            {% if costing.allocation_no %}
                                                <span class="badge bg-light text-muted border fw-bold" style="font-size:0.7rem; letter-spacing: 0.5px;">{{ costing.allocation_no }}</span>
                                            {% else %}
                                                <span class="text-muted small">—</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <div class="small fw-bold opacity-75">
                                                <i class="far fa-calendar-alt text-muted me-1"></i>
                                                {{ costing.costing_date|date('d M Y') }}
                                            </div>
                                        </td>
                                        <td>
                                            {% if costing.status == 'approved' %}
                                                <span class="badge-status-premium badge-success-premium"><i class="fas fa-circle" style="font-size:0.4rem;"></i>Approved</span>
                                            {% else %}
                                                <span class="badge-status-premium badge-warning-premium"><i class="fas fa-circle" style="font-size:0.4rem;"></i>Draft</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="btn-group btn-group-sm shadow-sm rounded-pill bg-white border p-1">
                                                <button class="btn btn-link text-primary px-2" onclick="loadEdit({{ costing.costing_id }})" title="Edit Costing">
                                                    <i class="fas fa-pen"></i>
                                                </button>
                                                <a href="{{ BASE_URL }}/merchandising/bulk-costing/{{ costing.costing_id }}/report" target="_blank" class="btn btn-link text-success px-2" title="Print Report">
                                                    <i class="fas fa-print"></i>
                                                </a>
                                                <button class="btn btn-link text-danger px-2" onclick="deleteCosting({{ costing.costing_id }}, '{{ costing.style_code }}')" title="Delete">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <div class="py-5 opacity-50">
                                            <i class="fas fa-file-invoice-dollar fa-4x mb-3"></i>
                                            <h4 class="fw-light">No costing records</h4>
                                            <p class="small mb-4">Adjust filters or start a new costing entry.</p>
                                            {% if filters.search or filters.style_id or filters.status %}
                                                <a href="{{ BASE_URL }}/merchandising/costing" class="btn btn-outline-primary btn-sm rounded-pill px-4">
                                                    Reset All Filters
                                                </a>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>

        </div>{# /list-pane #}

        {# ══════════════════════════ TAB 2: ENTRY FORM ══════════════════════════ #}
        <div class="tab-pane fade" id="entry-pane" role="tabpanel">
            <form id="bulkCostingForm" autocomplete="off">
                <input type="hidden" name="current_id" id="current_id" value="">

                {# ── Header Info ── #}
                <div class="form-section-card">
                    <div class="section-header-bar d-flex justify-content-between align-items-center">
                        <span class="section-title"><i class="fas fa-info-circle me-2"></i>Header Information</span>
                        <span class="badge bg-light text-muted border" id="form-status-badge">NEW SHEET</span>
                    </div>
                    <div class="section-body p-4">
                        <div class="row g-4">
                            <div class="col-md-4">
                                <label class="form-label-premium">Production Factory <span class="text-danger">*</span></label>
                                <select class="form-select bg-light border-0" name="factory_id" id="factory_id" required>
                                    <option value="">Select Factory Partner</option>
                                    {% for factory in dropdowns.factories %}
                                        <option value="{{ factory.factory_id }}">{{ factory.factory_name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label-premium">Customer / Buyer Partner</label>
                                <select class="form-select bg-light border-0" name="buyer_id" id="buyer_id">
                                    <option value="">Select Partner</option>
                                    {% for buyer in dropdowns.buyers %}
                                        <option value="{{ buyer.buyer_id }}">{{ buyer.buyer_name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label-premium">Allocation Number</label>
                                <input type="text" class="form-control bg-light border-0" name="allocation_no" id="allocation_no" placeholder="e.g. ALLOC/25/001">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label-premium">Sales Contract (SC)</label>
                                <input type="text" class="form-control bg-light border-0" name="sc_no" id="sc_no" placeholder="SC-REF-123">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label-premium">Internal Job No</label>
                                <input type="text" class="form-control bg-light border-0" name="job_no" id="job_no">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label-premium">Sheet Date</label>
                                <input type="date" class="form-control bg-light border-0" name="costing_date" id="costing_date" value="{{ 'now'|date('Y-m-d') }}">
                            </div>
                        </div>
                    </div>
                </div>

                {# ── Commission & Deductions ── #}
                <div class="form-section-card">
                    <div class="section-header-bar d-flex justify-content-between align-items-center">
                        <span class="section-title"><i class="fas fa-hand-holding-dollar me-2"></i>Commissions & Taxes</span>
                        <span class="text-muted small opacity-75">Applied to gross value</span>
                    </div>
                    <div class="section-body p-4">
                        <div class="row g-4 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label-premium">Local Agent %</label>
                                <div class="input-group">
                                    <input type="number" step="0.01" min="0" max="100" class="form-control bg-light border-0" name="local_commission_pct" id="local_commission_pct" value="0.00" onchange="calcTotal()">
                                    <span class="input-group-text bg-light border-0">%</span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label-premium">Foreign Agent %</label>
                                <div class="input-group">
                                    <input type="number" step="0.01" min="0" max="100" class="form-control bg-light border-0" name="foreign_commission_pct" id="foreign_commission_pct" value="0.00" onchange="calcTotal()">
                                    <span class="input-group-text bg-light border-0">%</span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label-premium">Early Bank Charges %</label>
                                <div class="input-group">
                                    <input type="number" step="0.01" min="0" max="100" class="form-control bg-light border-0" name="early_payment_cost_pct" id="early_payment_cost_pct" value="0.00" onchange="calcTotal()">
                                    <span class="input-group-text bg-light border-0">%</span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label-premium text-primary">Calculated Order Value</label>
                                <div class="input-group shadow-sm rounded">
                                    <span class="input-group-text bg-primary text-white border-0">$</span>
                                    <input type="number" class="form-control fw-bold border-0 bg-primary-light" id="display_order_value" readonly name="order_value" style="color:var(--primary);">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# ── Style & Order ── #}
                <div class="form-section-card">
                    <div class="section-header-bar d-flex justify-content-between align-items-center">
                        <span class="section-title"><i class="fas fa-tags me-2"></i>Multiple Style &amp; Order Lines</span>
                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 fw-bold" data-bs-toggle="collapse" data-bs-target="#orderEntryArea">
                            <i class="fas fa-plus me-1"></i>Add Order
                        </button>
                    </div>
                    
                    {# New Entry Facility #}
                    <div class="collapse show" id="orderEntryArea">
                        <div class="p-4 bg-light border-bottom">
                            <div class="row g-3 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label-premium">Target Style</label>
                                    <select class="form-select form-select-sm select2" id="entry_style_id">
                                        <option value="">Select Style...</option>
                                        {% for style in dropdowns.styles %}
                                            <option value="{{ style.style_id }}" data-code="{{ style.style_code }}" data-name="{{ style.style_name }}" data-buyer="{{ style.buyer_id }}">{{ style.style_code }} — {{ style.style_name }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-2">
