{% extends 'layouts/app.twig' %}

{% block title %}Merchandising • Buyers{% endblock %}

{% block content %}
<div class="container-fluid px-4 merchandising-buyers">
    <h1 class="mt-4">Buyer Management</h1>
    
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/merchandising">Merchandising</a></li>
        <li class="breadcrumb-item active">Buyers</li>
    </ol>
    
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <p class="text-muted mb-0">Manage your buyers, customers, and their contact details.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary rounded-pill" id="exportBuyersCsv">
                <i class="fas fa-file-export me-2"></i>Export CSV
            </button>
            <button class="btn btn-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#buyerModal" data-modal-mode="create">
                <i class="fas fa-plus me-2"></i>New Buyer
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card">
                <p class="label">Total Buyers</p>
                <h2>{{ stats.total }}</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card info">
                <p class="label">Active</p>
                <h2>{{ stats.active }}</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card danger">
                <p class="label">Inactive</p>
                <h2>{{ stats.inactive }}</h2>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form class="row gy-3 gx-3 align-items-end" method="get" action="{{ BASE_URL }}/merchandising/buyers">
                <div class="col-md-5">
                    <label class="form-label">Search</label>
                    <input type="text" class="form-control" name="search" placeholder="Name, code, country..." value="{{ filters.search }}">
                </div>
                <div class="col-md-4">
                    <label class="form-label">Status</label>
                    <select class="form-select" name="status">
                        <option value="">Any status</option>
                        <option value="active" {{ filters.status == 'active' ? 'selected' }}>Active</option>
                        <option value="inactive" {{ filters.status == 'inactive' ? 'selected' }}>Inactive</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button class="btn btn-outline-primary w-100" type="submit">
                        <i class="fas fa-filter me-1"></i>Apply Filters
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-md border-0 mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="buyersTable">
                    <thead class="table-light">
                        <tr>
                            <th>Buyer Name</th>
                            <th>Code</th>
                            <th>Country</th>
                            <th>Contact Person</th>
                            <th>Date Added</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for buyer in buyers %}
                            <tr data-buyer='{{ buyer|json_encode|raw }}'>
                                <td>
                                    <strong>{{ buyer.buyer_name }}</strong>
                                    {% if buyer.email %}
                                        <div class="text-muted small"><i class="fas fa-envelope me-1"></i>{{ buyer.email }}</div>
                                    {% endif %}
                                </td>
                                <td>{{ buyer.buyer_code ?: '—' }}</td>
                                <td>{{ buyer.country ?: '—' }}</td>
                                <td>
                                    {{ buyer.contact_person ?: '—' }}
                                    {% if buyer.phone %}
                                        <div class="text-muted small"><i class="fas fa-phone me-1"></i>{{ buyer.phone }}</div>
                                    {% endif %}
                                </td>
                                <td>{{ buyer.created_at|date('M d, Y') }}</td>
                                <td>
                                    <span class="badge bg-{{ buyer.status == 'active' ? 'success' : 'secondary' }} text-uppercase">
                                        {{ buyer.status }}
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary rounded-circle me-1" data-view-buyer title="View"><i class="fas fa-eye"></i></button>
                                        <button class="btn btn-outline-primary rounded-circle me-1" data-edit-buyer title="Edit"><i class="fas fa-edit"></i></button>
                                        <button class="btn btn-outline-danger rounded-circle" data-delete-buyer title="Delete"><i class="fas fa-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">No buyers found.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create / Edit Buyer Modal -->
<div class="modal fade" id="buyerModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="buyerForm">
                <input type="hidden" name="buyer_id" id="buyerId">
                <div class="modal-header border-bottom">
                    <div>
                        <h5 class="modal-title" id="buyerModalTitle">New Buyer</h5>
                        <small class="text-muted">Add details about the buyer or customer.</small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="buyerAlert" class="alert d-none"></div>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">Buyer Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="buyer_name" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Buyer Code</label>
                            <input type="text" class="form-control" name="buyer_code" placeholder="e.g. H&M-US">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Country</label>
                            <input type="text" class="form-control" name="country">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Contact Person</label>
                            <input type="text" class="form-control" name="contact_person">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" name="email">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone</label>
                            <input type="text" class="form-control" name="phone">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Address</label>
                            <textarea class="form-control" name="address" rows="2"></textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Status</label>
                            <select class="form-select" name="buyer_status">
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4" id="buyerSubmitBtn">
                        <i class="fas fa-save me-1"></i>Save Buyer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- View Buyer Modal -->
<div class="modal fade" id="viewBuyerModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Buyer Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <dl class="row" id="buyerDetails"></dl>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const buyerModalEl = document.getElementById('buyerModal');
        const buyerModal = buyerModalEl ? bootstrap.Modal.getOrCreateInstance(buyerModalEl) : null;
        const buyerForm = document.getElementById('buyerForm');
        const buyerAlert = document.getElementById('buyerAlert');
        const buyerTitle = document.getElementById('buyerModalTitle');
        const buyerSubmitBtn = document.getElementById('buyerSubmitBtn');
        
        const viewModalEl = document.getElementById('viewBuyerModal');
        const viewModal = viewModalEl ? bootstrap.Modal.getOrCreateInstance(viewModalEl) : null;
        const buyerDetails = document.getElementById('buyerDetails');

        function showAlert(box, message) {
            box.className = 'alert alert-danger';
            box.textContent = message;
            box.classList.remove('d-none');
        }

        function hideAlert(box) {
            box.classList.add('d-none');
        }

        function populateForm(buyer = null) {
            buyerForm.reset();
            hideAlert(buyerAlert);
            if (buyer) {
                buyerTitle.textContent = 'Edit Buyer';
                buyerSubmitBtn.innerHTML = '<i class="fas fa-save me-1"></i>Update Buyer';
                buyerForm.buyer_id.value = buyer.buyer_id;
                buyerForm.buyer_name.value = buyer.buyer_name;
                buyerForm.buyer_code.value = buyer.buyer_code || '';
                buyerForm.country.value = buyer.country || '';
                buyerForm.contact_person.value = buyer.contact_person || '';
                buyerForm.email.value = buyer.email || '';
                buyerForm.phone.value = buyer.phone || '';
                buyerForm.address.value = buyer.address || '';
                buyerForm.buyer_status.value = buyer.status || 'active';
            } else {
                buyerTitle.textContent = 'New Buyer';
                buyerSubmitBtn.innerHTML = '<i class="fas fa-save me-1"></i>Save Buyer';
                buyerForm.buyer_id.value = '';
                buyerForm.buyer_status.value = 'active';
            }
        }

        buyerModalEl?.addEventListener('show.bs.modal', event => {
            const trigger = event.relatedTarget;
            if (trigger?.dataset.modalMode === 'create') {
                populateForm();
            } else {
                // If opened via edit button, logic handles usually separately but if trigger was generic:
                // populateForm(); 
            }
        });

        document.querySelectorAll('[data-edit-buyer]').forEach(btn => {
            btn.addEventListener('click', () => {
                const buyer = JSON.parse(btn.closest('tr').dataset.buyer);
                populateForm(buyer);
                buyerModal?.show();
            });
        });

        buyerForm?.addEventListener('submit', async event => {
            event.preventDefault();
            hideAlert(buyerAlert);
            const payload = Object.fromEntries(new FormData(buyerForm).entries());
            const isEdit = Boolean(payload.buyer_id);
            const endpoint = isEdit ? `{{ BASE_URL }}/merchandising/buyers/${payload.buyer_id}` : '{{ BASE_URL }}/merchandising/buyers';
            
            // Re-using the same pattern as styles - always POST, override method for PUT
            const method = 'POST';
            if (isEdit) payload._method = 'PUT';

            try {
                const response = await fetch(endpoint, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await response.json();
                if (!response.ok) throw data;
                location.reload();
            } catch (error) {
                showAlert(buyerAlert, error?.message || 'Unable to save buyer.');
            }
        });

        document.querySelectorAll('[data-view-buyer]').forEach(btn => {
            btn.addEventListener('click', async () => {
                const buyer = JSON.parse(btn.closest('tr').dataset.buyer);
                renderBuyerDetails(buyer);
                viewModal?.show();
            });
        });

        function renderBuyerDetails(buyer) {
            buyerDetails.innerHTML = '';
            const mapping = {
                'Buyer Name': buyer.buyer_name,
                'Code': buyer.buyer_code || '—',
                'Country': buyer.country || '—',
                'Status': buyer.status,
                'Contact Person': buyer.contact_person || '—',
                'Email': buyer.email || '—',
                'Phone': buyer.phone || '—',
                'Address': buyer.address || '—',
                'Created At': buyer.created_at || '—'
            };
            Object.entries(mapping).forEach(([label, value]) => {
                buyerDetails.insertAdjacentHTML('beforeend', `<dt class="col-md-4">${label}</dt><dd class="col-md-8">${value}</dd>`);
            });
        }

        document.querySelectorAll('[data-delete-buyer]').forEach(btn => {
            btn.addEventListener('click', async () => {
                const buyer = JSON.parse(btn.closest('tr').dataset.buyer);
                if (!confirm(`Delete buyer ${buyer.buyer_name}?`)) return;
                const response = await fetch(`{{ BASE_URL }}/merchandising/buyers/${buyer.buyer_id}`, { 
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ _method: 'DELETE' })
                });
                const data = await response.json().catch(() => ({}));
                if (response.ok) {
                    location.reload();
                } else {
                    alert(data.message || 'Failed to delete buyer.');
                }
            });
        });

        document.getElementById('exportBuyersCsv')?.addEventListener('click', () => {
            const rows = [['Buyer Name', 'Code', 'Country', 'Contact', 'Email', 'Phone', 'Status']];
            document.querySelectorAll('#buyersTable tbody tr').forEach(tr => {
                if (tr.querySelector('td[colspan]')) return;
                const buyer = JSON.parse(tr.dataset.buyer);
                rows.push([
                    buyer.buyer_name,
                    buyer.buyer_code || '',
                    buyer.country || '',
                    buyer.contact_person || '',
                    buyer.email || '',
                    buyer.phone || '',
                    buyer.status
                ]);
            });
            const csv = rows.map(r => r.map(col => `"${String(col).replace(/"/g, '""')}"`).join(',')).join('\n');
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'buyers.csv';
            link.click();
        });
    });
</script>
{% endblock %}
