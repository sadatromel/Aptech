{% extends 'layouts/app.twig' %}

{% block title %}Merchandising • Requisition Tracking{% endblock %}

{% block content %}
<div class="container-fluid merchandising-planning">
    <div class="container-fluid px-4">
        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center mt-4 mb-3">
            <div>
                <h1 class="h3 mb-1">Sample Tracking & Approvals</h1>
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="{{ BASE_URL }}/merchandising">Merchandising</a></li>
                    <li class="breadcrumb-item active">Planning</li>
                </ol>
            </div>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="row g-3 mb-4 mx-3">
        <div class="col-md-4">
            <div class="stat-card text-center p-4 text-white rounded-4 shadow" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); position: relative; overflow: hidden;">
                <i class="fas fa-tasks position-absolute text-white" style="font-size: 3.5rem; opacity: 0.15; right: 25px; top: 50%; transform: translateY(-50%);"></i>
                <p class="label mb-1 fw-bold text-white-50 text-uppercase tracking-wide" style="font-size:0.75rem;">Active Planning</p>
                <h2 class="mb-0 fw-black display-6">{{ requisitions|length }}</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card text-center p-4 text-dark rounded-4 shadow" style="background: linear-gradient(135deg, #f2994a 0%, #f2c94c 100%); position: relative; overflow: hidden;">
                <i class="fas fa-clock position-absolute text-white" style="font-size: 3.5rem; opacity: 0.25; right: 25px; top: 50%; transform: translateY(-50%);"></i>
                <p class="label mb-1 fw-bold text-dark text-uppercase tracking-wide opacity-75" style="font-size:0.75rem;">Pending Analysis</p>
                <h2 class="mb-0 fw-black display-6">{{ pending_requisitions|length }}</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card text-center p-4 text-white rounded-4 shadow" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); position: relative; overflow: hidden;">
                <i class="fas fa-users-cog position-absolute text-white" style="font-size: 3.5rem; opacity: 0.15; right: 25px; top: 50%; transform: translateY(-50%);"></i>
                <p class="label mb-1 fw-bold text-white-50 text-uppercase tracking-wide" style="font-size:0.75rem;">Total Workload</p>
                <h2 class="mb-0 fw-black display-6">{{ requisitions|length + pending_requisitions|length }}</h2>
            </div>
        </div>
    </div>

    <!-- Pending Approval Requisitions -->
    <div class="card shadow-sm border-0 mb-4 mx-4 rounded-4">
        <div class="card-header bg-transparent py-3 border-bottom d-flex justify-content-between align-items-center">
             <h5 class="card-title fw-bold mb-0 text-warning"><i class="fas fa-exclamation-circle me-2"></i>Requires Approval</h5>
             {% if pending_requisitions|length > 0 %}
                 <span class="badge bg-warning text-dark rounded-pill">{{ pending_requisitions|length }} Pending</span>
             {% endif %}
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-body-tertiary">
                        <tr>
                            <th class="ps-4 py-3 fw-bold text-muted small text-uppercase">Req No.</th>
                            <th class="py-3 fw-bold text-muted small text-uppercase">Style</th>
                            <th class="py-3 fw-bold text-muted small text-uppercase">Sample Type</th>
                            <th class="py-3 fw-bold text-muted small text-uppercase">Sizes</th>
                            <th class="py-3 fw-bold text-muted small text-uppercase">Requested</th>
                            <th class="py-3 fw-bold text-muted small text-uppercase">Status & Materials</th>
                            <th class="pe-4 text-end py-3 fw-bold text-muted small text-uppercase">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for req in pending_requisitions %}
                            <tr>
                                <td class="ps-4">
                                     <div class="fw-bold text-primary">{{ req.requisition_no }}</div>
                                </td>
                                <td>
                                     <div class="fw-bold">{{ req.style_code }}</div>
                                     <div class="small text-muted">{{ req.buyer_name }}</div>
                                </td>
                                <td>
                                     <span class="badge bg-secondary bg-opacity-25 text-secondary border px-2 py-1 rounded-pill">{{ req.sample_type|capitalize }}</span>
                                </td>
                                <td>
                                     <div class="fw-bold small">
                                         {% if req.breakdown|length > 0 %}
                                             {{ req.breakdown|map(i => i.size)|join(', ') }}
                                         {% else %}
                                             {{ req.sample_size }}
                                         {% endif %}
                                     </div>
                                     <div class="small text-muted">Total: {{ req.quantity }}</div>
                                </td>
                                <td>
                                     <div class="small">{{ req.request_date|date('M d, Y') }}</div>
                                </td>
                                <td>
                                     <div class="mb-1">
                                          <span class="badge bg-warning text-dark text-uppercase rounded-pill">
                                              {{ req.status|replace({'_': ' '}) }}
                                          </span>
                                     </div>
                                     <div class="d-flex gap-1 align-items-center mt-1">
                                         <span class="badge {{ req.shell_fabric_available ? 'bg-success bg-opacity-25 text-success border border-success' : 'bg-transparent text-muted border border-secondary' }} rounded-pill" title="Shell Fabric: {{ req.shell_fabric_available ? 'Ready' : 'Pending' }}" style="font-size: 0.65rem; padding: 0.25em 0.5em;"><i class="{{ req.shell_fabric_available ? 'fas fa-check-circle' : 'far fa-circle' }} me-1"></i>Shell</span>
                                         <span class="badge {{ req.pocketing_available ? 'bg-success bg-opacity-25 text-success border border-success' : 'bg-transparent text-muted border border-secondary' }} rounded-pill" title="Pocketing: {{ req.pocketing_available ? 'Ready' : 'Pending' }}" style="font-size: 0.65rem; padding: 0.25em 0.5em;"><i class="{{ req.pocketing_available ? 'fas fa-check-circle' : 'far fa-circle' }} me-1"></i>Pock.</span>
                                         <span class="badge {{ req.lining_interlining_available ? 'bg-success bg-opacity-25 text-success border border-success' : 'bg-transparent text-muted border border-secondary' }} rounded-pill" title="Lining: {{ req.lining_interlining_available ? 'Ready' : 'Pending' }}" style="font-size: 0.65rem; padding: 0.25em 0.5em;"><i class="{{ req.lining_interlining_available ? 'fas fa-check-circle' : 'far fa-circle' }} me-1"></i>Lining</span>
                                         <span class="badge {{ req.sewing_accessories_available ? 'bg-success bg-opacity-25 text-success border border-success' : 'bg-transparent text-muted border border-secondary' }} rounded-pill" title="Sewing Acc.: {{ req.sewing_accessories_available ? 'Ready' : 'Pending' }}" style="font-size: 0.65rem; padding: 0.25em 0.5em;"><i class="{{ req.sewing_accessories_available ? 'fas fa-check-circle' : 'far fa-circle' }} me-1"></i>S.Acc</span>
                                         <span class="badge {{ req.finishing_accessories_available ? 'bg-success bg-opacity-25 text-success border border-success' : 'bg-transparent text-muted border border-secondary' }} rounded-pill" title="Finishing Acc.: {{ req.finishing_accessories_available ? 'Ready' : 'Pending' }}" style="font-size: 0.65rem; padding: 0.25em 0.5em;"><i class="{{ req.finishing_accessories_available ? 'fas fa-check-circle' : 'far fa-circle' }} me-1"></i>F.Acc</span>
                                     </div>
                                </td>
                                <td class="text-end pe-4">
                                     <button class="btn btn-sm btn-primary px-3 rounded-pill shadow-sm fw-bold" 
                                             onclick="prepareApproval({{ req|json_encode|raw }})" title="Approve & Assign Targets">
                                         <i class="fas fa-signature me-1"></i> Assign
                                     </button>
                                </td>
                            </tr>
                        {% else %}
                             <tr>
                                 <td colspan="7" class="text-center text-muted py-5">
                                     <i class="fas fa-check-double fa-3x mb-3 d-block opacity-25"></i>
                                     No assignments pending approval.
                                 </td>
                             </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Active Requisitions Table -->
    <div class="card shadow-sm border-0 mb-4 mx-4 rounded-4">
        <div class="card-header bg-transparent py-3 border-bottom d-flex align-items-center">
            <h5 class="card-title fw-bold mb-0 text-success"><i class="fas fa-tasks me-2"></i>Active Job Tracking</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-body-tertiary">
                        <tr>
                            <th class="ps-4 py-3 fw-bold text-muted small text-uppercase">Req No.</th>
                            <th class="py-3 fw-bold text-muted small text-uppercase">Style</th>
                            <th class="py-3 fw-bold text-muted small text-uppercase">Sizes</th>
                            <th class="py-3 fw-bold text-muted small text-uppercase">Materials</th>
                            <th class="py-3 fw-bold text-muted small text-uppercase" style="width:25%">Progress (Pat/Sam)</th>
                            <th class="text-end pe-4 py-3 fw-bold text-muted small text-uppercase">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for req in requisitions %}
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-primary">{{ req.requisition_no }}</div>
                                    <div class="small text-muted">{{ req.request_date|date('M d, Y') }}</div>
                                </td>
                                <td>
                                    <div class="fw-bold">{{ req.style_code }}</div>
                                    <div class="small text-muted">{{ req.buyer_name }}</div>
                                </td>
                                <td>
                                     <div class="fw-bold small">
                                         {% if req.breakdown|length > 0 %}
                                             {{ req.breakdown|map(i => i.size)|join(', ') }}
                                         {% else %}
                                             {{ req.sample_size }}
                                         {% endif %}
                                     </div>
                                     <div class="small text-muted">Total: {{ req.quantity }}</div>
                                </td>
                                <td>
                                     <div class="d-flex flex-wrap gap-1 align-items-center mt-1" style="max-width: 180px;">
                                         <span class="badge {{ req.shell_fabric_available ? 'bg-success bg-opacity-25 text-success border border-success' : 'bg-transparent text-muted border border-secondary' }} rounded-pill" title="Shell Fabric: {{ req.shell_fabric_available ? 'Ready' : 'Pending' }}" style="font-size: 0.65rem; padding: 0.25em 0.5em;"><i class="{{ req.shell_fabric_available ? 'fas fa-check-circle' : 'far fa-circle' }} me-1"></i>Shell</span>
                                         <span class="badge {{ req.pocketing_available ? 'bg-success bg-opacity-25 text-success border border-success' : 'bg-transparent text-muted border border-secondary' }} rounded-pill" title="Pocketing: {{ req.pocketing_available ? 'Ready' : 'Pending' }}" style="font-size: 0.65rem; padding: 0.25em 0.5em;"><i class="{{ req.pocketing_available ? 'fas fa-check-circle' : 'far fa-circle' }} me-1"></i>Pock.</span>
                                         <span class="badge {{ req.lining_interlining_available ? 'bg-success bg-opacity-25 text-success border border-success' : 'bg-transparent text-muted border border-secondary' }} rounded-pill" title="Lining: {{ req.lining_interlining_available ? 'Ready' : 'Pending' }}" style="font-size: 0.65rem; padding: 0.25em 0.5em;"><i class="{{ req.lining_interlining_available ? 'fas fa-check-circle' : 'far fa-circle' }} me-1"></i>Lining</span>
                                         <span class="badge {{ req.sewing_accessories_available ? 'bg-success bg-opacity-25 text-success border border-success' : 'bg-transparent text-muted border border-secondary' }} rounded-pill" title="Sewing Acc.: {{ req.sewing_accessories_available ? 'Ready' : 'Pending' }}" style="font-size: 0.65rem; padding: 0.25em 0.5em;"><i class="{{ req.sewing_accessories_available ? 'fas fa-check-circle' : 'far fa-circle' }} me-1"></i>S.Acc</span>
                                         <span class="badge {{ req.finishing_accessories_available ? 'bg-success bg-opacity-25 text-success border border-success' : 'bg-transparent text-muted border border-secondary' }} rounded-pill" title="Finishing Acc.: {{ req.finishing_accessories_available ? 'Ready' : 'Pending' }}" style="font-size: 0.65rem; padding: 0.25em 0.5em;"><i class="{{ req.finishing_accessories_available ? 'fas fa-check-circle' : 'far fa-circle' }} me-1"></i>F.Acc</span>
                                     </div>
                                </td>
                                <td>
                                     <div class="mb-2">
                                         <div class="d-flex justify-content-between small mb-1">
                                             <span class="text-muted"><i class="fas fa-cut me-1"></i>Pattern: {{ req.total_pat_achieved|default(0) }} / {{ req.quantity }}</span>
                                             <span class="fw-bold text-primary">{{ (req.total_pat_achieved|default(0) / req.quantity * 100)|round }}%</span>
                                         </div>
                                         <div class="progress rounded-pill border" style="height: 6px;">
                                             <div class="progress-bar bg-primary progress-bar-striped progress-bar-animated" role="progressbar" style="width: {{ (req.total_pat_achieved|default(0) / req.quantity * 100)|round }}%"></div>
                                         </div>
                                     </div>
                                     <div>
                                         <div class="d-flex justify-content-between small mb-1">
                                             <span class="text-muted"><i class="fas fa-tshirt me-1"></i>Sample: {{ req.total_sam_achieved|default(0) }} / {{ req.quantity }}</span>
                                             <span class="fw-bold text-info">{{ (req.total_sam_achieved|default(0) / req.quantity * 100)|round }}%</span>
                                         </div>
                                         <div class="progress rounded-pill border" style="height: 6px;">
                                             <div class="progress-bar bg-info progress-bar-striped progress-bar-animated" role="progressbar" style="width: {{ (req.total_sam_achieved|default(0) / req.quantity * 100)|round }}%"></div>
                                         </div>
                                     </div>
                                </td>
                                <td class="text-end pe-4">
                                     <div class="btn-group btn-group-sm shadow-sm rounded-pill">
                                         <button class="btn btn-outline-primary px-3 rounded-start-pill" 
                                                 data-bs-toggle="modal" 
                                                 data-bs-target="#assignModal"
                                                 data-req='{{ req|json_encode|raw|e('html_attr') }}' title="Log Activity">
                                             <i class="fas fa-pen"></i> Log
                                         </button>
                                         <button class="btn btn-outline-secondary px-3 rounded-end-pill" 
                                                 data-bs-toggle="collapse" 
                                                 data-bs-target="#logs-{{ req.sample_id }}" title="View History">
                                             <i class="fas fa-history"></i> Hist
                                         </button>
                                     </div>
                                </td>
                            </tr>
                            <tr class="collapse" id="logs-{{ req.sample_id }}">
                                <td colspan="6" class="p-0 border-bottom-0">
                                    <div class="p-4 bg-body-tertiary rounded-bottom container-fluid border-bottom border-start border-end">
                                        <h6 class="small fw-bold text-uppercase text-muted mb-3"><i class="fas fa-list-ul me-2"></i>Activity History</h6>
                                        <table class="table table-sm bg-body shadow-sm rounded overflow-hidden mb-0 border">
                                            <thead class="bg-light">
                                                <tr class="small text-muted text-uppercase">
                                                    <th class="ps-3 py-2">Date</th>
                                                    <th class="py-2">Ptrn Master</th>
                                                    <th class="py-2">Ptrn Tgt / Ach</th>
                                                    <th class="py-2">Spl Maker</th>
                                                    <th class="py-2">Spl Tgt / Ach</th>
                                                </tr>
                                            </thead>
                                            <tbody class="small">
                                                {% for log in req.logs %}
                                                    <tr>
                                                        <td class="ps-3">{{ log.tracking_date|date('M d, Y') }}</td>
                                                        <td class="fw-bold">{{ log.pm_first_name|default('—') }}</td>
                                                        <td><span class="badge bg-light text-dark border">{{ log.pattern_master_target }} / {{ log.pattern_master_achievement }}</span></td>
                                                        <td class="fw-bold">{{ log.sm_first_name|default('—') }}</td>
                                                        <td><span class="badge bg-light text-dark border">{{ log.sample_man_target }} / {{ log.sample_man_achievement }}</span></td>
                                                    </tr>
                                                {% else %}
                                                    <tr><td colspan="5" class="text-center py-3 text-muted">No activity logs found.</td></tr>
                                                {% endfor %}
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                             <tr>
                                 <td colspan="6" class="text-center text-muted py-5">
                                     <i class="fas fa-folder-open fa-3x mb-3 d-block opacity-25"></i>
                                     No active tracking assignments.
                                 </td>
                             </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Offcanvas Approve & Assign Panel -->
<div class="offcanvas offcanvas-end shadow" tabindex="-1" id="approvalOffcanvas" style="width: 500px;">
    <div class="offcanvas-header border-bottom py-3">
        <h5 class="offcanvas-title fw-bold"><i class="fas fa-signature me-2 text-primary"></i>Assign Targets</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form id="approvalForm">
            <input type="hidden" name="sample_id" id="approveSampleId">
            <input type="hidden" name="buyer_id" id="approveBuyerId">
            <input type="hidden" name="style_id" id="approveStyleId">
            
            <div class="d-flex align-items-center mb-4 p-3 bg-body-tertiary rounded border">
                <div class="bg-white p-2 rounded-circle me-3 shadow-sm border">
                    <i class="fas fa-clipboard-check text-primary fs-4"></i>
                </div>
                <div>
                    <h6 class="mb-0 fw-black text-primary" id="approveReqNumber">REQ-NO</h6>
                    <small class="text-muted fw-bold" id="approveStyleCode">Style Info</small>
                </div>
            </div>
            
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Status Shift <span class="text-danger">*</span></label>
                    <select class="form-select shadow-sm" name="status" required>
                        {% for status in statuses %}
                            <option value="{{ status.value }}" {{ status.value == 'approved' ? 'selected' }}>{{ status.label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1">Tracking Date</label>
                    <input type="date" class="form-control shadow-sm" name="tracking_date" value="{{ 'now'|date('Y-m-d') }}" required>
                </div>
            </div>
            
            <hr class="text-muted opacity-25 my-4">
            
            <h6 class="text-uppercase small fw-bold mb-3 text-primary"><i class="fas fa-user-tag me-2"></i>Initial Resource Limits</h6>
            
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body p-3 border rounded">
                    <label class="form-label small fw-bold"><i class="fas fa-cut me-1 text-muted"></i>Pattern Master</label>
                    <select class="form-select form-select-sm shadow-sm mb-2" name="pattern_master_id">
                        <option value="">Unassigned...</option>
                        {% for emp in employees %}
                            <option value="{{ emp.employee_id }}">{{ emp.first_name }} {{ emp.last_name }}</option>
                        {% endfor %}
                    </select>
                    <input type="number" class="form-control form-control-sm shadow-sm" name="pattern_master_target" placeholder="Production Target Qty" min="0">
                </div>
            </div>
            
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3 border rounded">
                     <label class="form-label small fw-bold"><i class="fas fa-tshirt me-1 text-muted"></i>Sample Maker</label>
                     <select class="form-select form-select-sm shadow-sm mb-2" name="sample_man_id">
                         <option value="">Unassigned...</option>
                         {% for emp in employees %}
                             <option value="{{ emp.employee_id }}">{{ emp.first_name }} {{ emp.last_name }}</option>
                         {% endfor %}
                     </select>
                     <input type="number" class="form-control form-control-sm shadow-sm" name="sample_man_target" placeholder="Production Target Qty" min="0">
                </div>
            </div>
            
            <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill shadow-sm fw-bold" id="btnConfirmApprove">
                <i class="fas fa-check-circle me-2"></i>Confirm Assignment
            </button>
        </form>
    </div>
</div>

<!-- Log Activity Modal (Existing logic preserved with modern UI) -->
<div class="modal fade" id="assignModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold"><i class="fas fa-plus-circle me-2 text-primary"></i>Daily Log</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div id="alertBox" class="alert d-none small"></div>
                <h6 class="fw-bold text-primary mb-3" id="modalReqSub">REQ</h6>
                <form id="assignForm">
                    <input type="hidden" name="sample_id" id="modalSampleId">
                    <input type="hidden" name="buyer_id" id="modalBuyerId">
                    <input type="hidden" name="style_id" id="modalStyleId">
                    
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Activity Date</label>
                        <input type="date" class="form-control shadow-sm" name="tracking_date" value="{{ 'now'|date('Y-m-d') }}" required>
                    </div>
                    
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Pattern Master</label>
                            <select class="form-select form-select-sm mb-2 shadow-sm" name="pattern_master_id">
                                <option value="">Select...</option>
                                {% for emp in employees %}
                                    <option value="{{ emp.employee_id }}">{{ emp.first_name }} {{ emp.last_name }}</option>
                                {% endfor %}
                            </select>
                            <input type="number" class="form-control form-control-sm shadow-sm" name="pattern_master_achievement" placeholder="P. Achieved" min="0">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Sample Maker</label>
                            <select class="form-select form-select-sm mb-2 shadow-sm" name="sample_man_id">
                                <option value="">Select...</option>
                                {% for emp in employees %}
                                    <option value="{{ emp.employee_id }}">{{ emp.first_name }} {{ emp.last_name }}</option>
                                {% endfor %}
                            </select>
                            <input type="number" class="form-control form-control-sm shadow-sm" name="sample_man_achievement" placeholder="S. Achieved" min="0">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top bg-body-tertiary">
                <button type="button" class="btn btn-secondary px-4 rounded-pill" data-bs-dismiss="modal">Close</button>
                <button type="submit" form="assignForm" class="btn btn-primary px-4 rounded-pill shadow-sm" id="submitBtn">
                    <i class="fas fa-save me-1"></i> Save
                </button>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block scripts %}
{{ parent() }}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const approvalOffcanvasEl = document.getElementById('approvalOffcanvas');
        const approvalOffcanvas = approvalOffcanvasEl ? new bootstrap.Offcanvas(approvalOffcanvasEl) : null;
        
        const approvalForm = document.getElementById('approvalForm');
        const approveReqNumber = document.getElementById('approveReqNumber');
        const approveStyleCode = document.getElementById('approveStyleCode');
        const btnConfirmApprove = document.getElementById('btnConfirmApprove');

        const assignModal = document.getElementById('assignModal');
        const assignForm = document.getElementById('assignForm');
        const alertBox = document.getElementById('alertBox');
        const submitBtn = document.getElementById('submitBtn');

        // --- Approve & Assign Logic ---
        window.prepareApproval = function(req) {
            document.getElementById('approveSampleId').value = req.sample_id;
            document.getElementById('approveBuyerId').value = req.buyer_id || '';
            document.getElementById('approveStyleId').value = req.style_id;
            
            approveReqNumber.textContent = req.requisition_no;
            approveStyleCode.textContent = req.style_code ? \`${req.style_code} • ${req.style_name}\` : req.style_name;
            
            approvalOffcanvas?.show();
        };

        approvalForm?.addEventListener('submit', async (e) => {
            e.preventDefault();
            btnConfirmApprove.disabled = true;
            btnConfirmApprove.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';

            try {
                const formData = new FormData(approvalForm);
                const data = Object.fromEntries(formData.entries());

                const res = await fetch(`${BASE_URL}/merchandising/sample-planning`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                
                const result = await res.json();
                if (result.success) {
                    location.reload();
                } else {
                    alert('Error: ' + (result.message || 'Failed to process request'));
                    btnConfirmApprove.disabled = false;
                    btnConfirmApprove.innerHTML = '<i class="fas fa-check-circle me-2"></i>Confirm Assignment';
                }
            } catch (err) {
                alert('A network error occurred.');
                btnConfirmApprove.disabled = false;
                btnConfirmApprove.innerHTML = '<i class="fas fa-check-circle me-2"></i>Confirm Assignment';
            }
        });

        // --- Daily Activity Log Logic ---
        assignModal?.addEventListener('show.bs.modal', (e) => {
            const btn = e.relatedTarget;
            const req = JSON.parse(btn.dataset.req);
            
            document.getElementById('modalSampleId').value = req.sample_id;
            document.getElementById('modalBuyerId').value = req.buyer_id;
            document.getElementById('modalStyleId').value = req.style_id;
            document.getElementById('modalReqSub').textContent = \`${req.requisition_no} • ${req.style_code}\`;
            
            if (req.logs && req.logs.length > 0) {
                const lastLog = req.logs[0];
                assignForm.pattern_master_id.value = lastLog.pattern_master_id || '';
                assignForm.sample_man_id.value = lastLog.sample_man_id || '';
            } else {
                assignForm.pattern_master_id.value = '';
                assignForm.sample_man_id.value = '';
            }

            assignForm.pattern_master_achievement.value = 0;
            assignForm.sample_man_achievement.value = 0;
            alertBox?.classList.add('d-none');
        });

        assignForm?.addEventListener('submit', async (e) => {
            e.preventDefault();
            alertBox?.classList.add('d-none');
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Saving...';

            try {
                const formData = new FormData(assignForm);
                const data = Object.fromEntries(formData.entries());

                const res = await fetch(`${BASE_URL}/merchandising/sample-planning`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                
                const result = await res.json();
                if (result.success) {
                    location.reload();
                } else {
                    alertBox.textContent = result.message || 'Failed to save log';
                    alertBox.className = 'alert alert-danger';
                    alertBox.classList.remove('d-none');
                }
            } catch (err) {
                alertBox.textContent = 'A network error occurred.';
                alertBox.classList.remove('d-none');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-save me-1"></i> Save';
            }
        });
    });
</script>
{% endblock %}