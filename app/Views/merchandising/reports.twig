{% extends "layouts/app.twig" %}

{% block title %}Merchandising Reports Hub{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-1 font-weight-bold text-gray-800">
                <i class="fas fa-tshirt text-primary me-2"></i>Merchandising Reports Center
            </h2>
            <p class="text-muted small mb-0">Style Development, BOM Analysis, Sample Tracking & Bulk Costing Reports</p>
        </div>
        <a href="{{ BASE_URL }}/merchandising/styles" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Merchandising Module
        </a>
    </div>

    <div class="row">
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary text-white rounded-circle p-3 me-3">
                            <i class="fas fa-drafting-compass fa-lg"></i>
                        </div>
                        <div>
                            <h5 class="card-title h6 mb-1 font-weight-bold">Style Master & Status</h5>
                            <span class="badge bg-light text-primary">Styles</span>
                        </div>
                    </div>
                    <p class="card-text small text-muted">Complete style catalog, seasonal breakdown, tech-pack status, and buyer approvals.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <a href="{{ BASE_URL }}/merchandising/styles" class="btn btn-sm btn-outline-primary w-100">Open Styles Report</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-warning text-white rounded-circle p-3 me-3">
                            <i class="fas fa-calculator fa-lg"></i>
                        </div>
                        <div>
                            <h5 class="card-title h6 mb-1 font-weight-bold">Bulk Costing Summary</h5>
                            <span class="badge bg-light text-warning">Costing</span>
                        </div>
                    </div>
                    <p class="card-text small text-muted">Pre-costing vs Actual Costing variance analysis, CM rate breakdown, and margin reports.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <a href="{{ BASE_URL }}/merchandising/costing" class="btn btn-sm btn-outline-warning w-100">Open Costing Report</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-info text-white rounded-circle p-3 me-3">
                            <i class="fas fa-cut fa-lg"></i>
                        </div>
                        <div>
                            <h5 class="card-title h6 mb-1 font-weight-bold">Sample Production Tracking</h5>
                            <span class="badge bg-light text-info">Sampling</span>
                        </div>
                    </div>
                    <p class="card-text small text-muted">Proto, Fit, SMS, and PP Sample submission logs, comments, and approval status.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <a href="{{ BASE_URL }}/merchandising/sample-production" class="btn btn-sm btn-outline-info w-100">Open Sampling Report</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
