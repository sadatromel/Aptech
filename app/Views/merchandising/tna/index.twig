{% extends "layouts/app.twig" %}

{% block title %}Merchandising • Time & Action (T&A) Calendar{% endblock %}

{% block content %}
<div class="container-fluid px-4 py-3">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="{{ BASE_URL }}/merchandising/dashboard">Merchandising</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Time & Action (T&A) Calendar</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">
                <i class="fas fa-calendar-alt text-primary me-2"></i>Time & Action (T&A) Order Execution Tracker
            </h1>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ BASE_URL }}/merchandising/production-orders" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm btn-sm">
                <i class="fas fa-industry me-1"></i>Production Orders
            </a>
            <a href="{{ BASE_URL }}/merchandising/reports" class="btn btn-outline-primary rounded-pill px-3 shadow-sm btn-sm">
                <i class="fas fa-file-invoice me-1"></i>Reports
            </a>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" action="{{ BASE_URL }}/merchandising/tna" class="row g-3 align-items-end">
                <div class="col-lg-4 col-md-6">
                    <label class="form-label small fw-semibold text-muted mb-1">Search Order / Style</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control bg-light border-start-0" placeholder="Order PO #, Style Code or Style Name..." value="{{ filters.search }}">
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-semibold text-muted mb-1">Buyer</label>
                    <select name="buyer_id" class="form-select bg-light">
                        <option value="">All Buyers</option>
                        {% for b in buyers %}
                        <option value="{{ b.buyer_id }}" {% if filters.buyer_id == b.buyer_id %}selected{% endif %}>{{ b.buyer_name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-semibold text-muted mb-1">Style</label>
                    <select name="style_id" class="form-select bg-light">
                        <option value="">All Styles</option>
                        {% for s in styles %}
                        <option value="{{ s.style_id }}" {% if filters.style_id == s.style_id %}selected{% endif %}>{{ s.style_code }} - {{ s.style_name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-lg-2 col-md-6 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 rounded-pill"><i class="fas fa-filter me-1"></i>Filter</button>
                    <a href="{{ BASE_URL }}/merchandising/tna" class="btn btn-outline-secondary rounded-pill" title="Reset"><i class="fas fa-undo"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- T&A Order List Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0"><i class="fas fa-tasks text-primary me-2"></i>Order Execution Milestones Matrix</h6>
            <span class="badge bg-primary rounded-pill px-3 py-2">{{ orders|length }} Orders Tracked</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small">
                        <tr>
                            <th class="ps-3">PO Number</th>
                            <th>Style</th>
                            <th>Buyer</th>
                            <th>Order Qty</th>
                            <th>Delivery Target</th>
                            <th>Milestone Progress</th>
                            <th>Delayed</th>
                            <th class="text-end pe-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if orders is empty %}
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="fas fa-calendar-times fa-2x mb-2 opacity-50 d-block"></i>
                                No production orders found for Time & Action tracking.
                            </td>
                        </tr>
                        {% else %}
                        {% for order in orders %}
                        <tr>
                            <td class="ps-3 fw-bold text-dark">
                                <i class="fas fa-box text-primary me-1"></i>{{ order.order_number }}
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary fw-semibold">{{ order.style_code ?? 'N/A' }}</span>
                                <small class="text-muted d-block">{{ order.style_name }}</small>
                            </td>
                            <td><span class="badge bg-light text-dark border">{{ order.buyer_name ?? 'N/A' }}</span></td>
                            <td class="fw-semibold">{{ order.quantity|number_format }} Pcs</td>
                            <td>
                                <small class="fw-semibold text-dark">{{ order.delivery_date ? order.delivery_date|date('d M Y') : 'TBD' }}</small>
                            </td>
                            <td style="min-width: 180px;">
                                <div class="d-flex justify-content-between align-items-center mb-1 small">
                                    <span class="fw-bold text-dark">{{ order.completed_milestones }} / {{ order.total_milestones }} Done</span>
                                    <span class="fw-bold text-primary">{{ order.progress_pct }}%</span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-success rounded-pill" role="progressbar" style="width: {{ order.progress_pct }}%;" aria-valuenow="{{ order.progress_pct }}" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </td>
                            <td>
                                {% if order.delayed_milestones > 0 %}
                                <span class="badge bg-danger rounded-pill"><i class="fas fa-exclamation-triangle me-1"></i>{{ order.delayed_milestones }} Delayed</span>
                                {% else %}
                                <span class="badge bg-success-subtle text-success rounded-pill"><i class="fas fa-check me-1"></i>On Track</span>
                                {% endif %}
                            </td>
                            <td class="text-end pe-3">
                                <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm btn-view-tna" data-po-id="{{ order.po_id }}" data-po-number="{{ order.order_number }}">
                                    <i class="fas fa-edit me-1"></i>Milestones
                                </button>
                            </td>
                        </tr>
                        {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- T&A Milestones Modal -->
<div class="modal fade" id="tnaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-dark text-white rounded-top-4">
                <h5 class="modal-title fw-bold" id="tnaModalTitle">
                    <i class="fas fa-calendar-alt text-primary me-2"></i>Time & Action Milestones — Order <span id="modalPoNum"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <div id="milestonesLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted small mt-2">Loading milestone execution roadmap...</p>
                </div>
                <div id="milestonesContainer" class="d-none">
                    <div class="table-responsive bg-white rounded-3 shadow-sm">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light small text-muted">
                                <tr>
                                    <th class="ps-3" style="width: 25%;">Milestone Activity</th>
                                    <th style="width: 15%;">Responsible</th>
                                    <th style="width: 15%;">Target Date</th>
                                    <th style="width: 15%;">Actual Completion</th>
                                    <th style="width: 15%;">Status</th>
                                    <th style="width: 15%;" class="text-end pe-3">Save Action</th>
                                </tr>
                            </thead>
                            <tbody id="milestonesTableBody">
                                <!-- Populated dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-white border-0 rounded-bottom-4">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const tnaModal = new bootstrap.Modal(document.getElementById('tnaModal'));
    const modalPoNum = document.getElementById('modalPoNum');
    const milestonesLoading = document.getElementById('milestonesLoading');
    const milestonesContainer = document.getElementById('milestonesContainer');
    const milestonesTableBody = document.getElementById('milestonesTableBody');

    document.querySelectorAll('.btn-view-tna').forEach(btn => {
        btn.addEventListener('click', function() {
            const poId = this.getAttribute('data-po-id');
            const poNumber = this.getAttribute('data-po-number');

            modalPoNum.textContent = poNumber;
            milestonesLoading.classList.remove('d-none');
            milestonesContainer.classList.add('d-none');
            tnaModal.show();

            fetch(`{{ BASE_URL }}/merchandising/tna/${poId}`)
                .then(r => r.json())
                .then(data => {
                    milestonesLoading.classList.add('d-none');
                    milestonesContainer.classList.remove('d-none');

                    if (data.success && data.milestones) {
                        renderMilestones(data.milestones);
                    } else {
                        milestonesTableBody.innerHTML = '<tr><td colspan="6" class="text-center text-danger py-4">Failed to load milestones.</td></tr>';
                    }
                })
                .catch(err => {
                    milestonesLoading.classList.add('d-none');
                    milestonesContainer.classList.remove('d-none');
                    milestonesTableBody.innerHTML = '<tr><td colspan="6" class="text-center text-danger py-4">Network error loading milestones.</td></tr>';
                });
        });
    });

    function renderMilestones(milestones) {
        milestonesTableBody.innerHTML = '';
        milestones.forEach(m => {
            const tr = document.createElement('tr');
            tr.id = `row-milestone-${m.id}`;
            tr.innerHTML = `
                <td class="ps-3">
                    <span class="fw-bold text-dark d-block">${escapeHtml(m.milestone_name)}</span>
                    <small class="text-muted">${escapeHtml(m.milestone_code)}</small>
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm bg-light" id="resp-${m.id}" value="${escapeHtml(m.responsible_person || '')}" placeholder="Assigned Person">
                </td>
                <td>
                    <input type="date" class="form-control form-control-sm" id="target-${m.id}" value="${m.target_date || ''}">
                </td>
                <td>
                    <input type="date" class="form-control form-control-sm" id="actual-${m.id}" value="${m.actual_date || ''}">
                </td>
                <td>
                    <select class="form-select form-select-sm" id="status-${m.id}">
                        <option value="pending" ${m.status === 'pending' ? 'selected' : ''}>Pending</option>
                        <option value="in_progress" ${m.status === 'in_progress' ? 'selected' : ''}>In Progress</option>
                        <option value="completed" ${m.status === 'completed' ? 'selected' : ''}>Completed</option>
                        <option value="delayed" ${m.status === 'delayed' ? 'selected' : ''}>Delayed</option>
                    </select>
                </td>
                <td class="text-end pe-3">
                    <button type="button" class="btn btn-sm btn-success rounded-pill px-3 btn-save-milestone" data-id="${m.id}">
                        <i class="fas fa-save me-1"></i>Save
                    </button>
                </td>
            `;
            milestonesTableBody.appendChild(tr);
        });

        // Add save listeners
        document.querySelectorAll('.btn-save-milestone').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = this.getAttribute('data-id');
                saveMilestone(id, this);
            });
        });
    }

    function saveMilestone(id, btnElement) {
        const payload = {
            target_date: document.getElementById(`target-${id}`).value,
            actual_date: document.getElementById(`actual-${id}`).value,
            status: document.getElementById(`status-${id}`).value,
            responsible_person: document.getElementById(`resp-${id}`).value,
            _csrf: '{{ csrf_token }}'
        };

        btnElement.disabled = true;
        btnElement.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Saving';

        fetch(`{{ BASE_URL }}/merchandising/tna/update-milestone/${id}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify(payload)
        })
        .then(r => r.json())
        .then(res => {
            btnElement.disabled = false;
            btnElement.innerHTML = '<i class="fas fa-check me-1"></i>Saved';
            setTimeout(() => { btnElement.innerHTML = '<i class="fas fa-save me-1"></i>Save'; }, 2000);
        })
        .catch(err => {
            btnElement.disabled = false;
            btnElement.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i>Error';
        });
    }

    function escapeHtml(str) {
        return (str || '').replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }
});
</script>
{% endblock %}
