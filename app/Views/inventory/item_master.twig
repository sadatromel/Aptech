{% extends 'layouts/app.twig' %}

{% block title %}Item Master Management{% endblock %}

{% block styles %}
<style>
    .premium-glass-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: 0 8px 32px rgba(31, 38, 135, 0.05);
        border-radius: var(--border-radius);
    }
    [data-theme="dark"] .premium-glass-card {
        background: rgba(30, 41, 59, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }
    .nav-tabs .nav-link {
        border: none;
        color: #718096;
        font-weight: 600;
        padding: 12px 20px;
    }
    .nav-tabs .nav-link.active {
        background: transparent;
        color: var(--primary);
        border-bottom: 3px solid var(--primary);
    }
</style>
<!-- DataTables CSS -->
<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet">
{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 bg-transparent px-0">
                <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard" class="text-decoration-none"><i class="fas fa-home"></i> Dashboard</a></li>
                <li class="breadcrumb-item"><a href="{{ BASE_URL }}/inventory/dashboard" class="text-decoration-none">Store & Inventory</a></li>
                <li class="breadcrumb-item active" aria-current="page">Item Master</li>
            </ol>
        </nav>
        <div>
            <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addItemModal">
                <i class="fas fa-plus me-2"></i> Add New Item
            </button>
        </div>
    </div>

    <!-- Alert Notifications -->
    {% if session.success_message %}
    <div class="alert alert-success alert-dismissible fade show premium-glass-card mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i>{{ session.success_message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}
    {% if session.error_message %}
    <div class="alert alert-danger alert-dismissible fade show premium-glass-card mb-4" role="alert">
        <i class="fas fa-times-circle me-2"></i>{{ session.error_message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <!-- Tabs Navigation -->
    <div class="card border-0 premium-glass-card mb-4">
        <div class="card-header bg-transparent border-0 p-0">
            <ul class="nav nav-tabs border-bottom" id="itemMasterTabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" id="items-tab" data-bs-toggle="tab" data-bs-target="#itemsContent" type="button" role="tab"><i class="fas fa-boxes me-2"></i>Items Master</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="categories-tab" data-bs-toggle="tab" data-bs-target="#categoriesContent" type="button" role="tab"><i class="fas fa-tags me-2"></i>Categories & Sub-Categories</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="brands-tab" data-bs-toggle="tab" data-bs-target="#brandsContent" type="button" role="tab"><i class="fas fa-copyright me-2"></i>Brands</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="opening-tab" data-bs-toggle="tab" data-bs-target="#openingContent" type="button" role="tab"><i class="fas fa-balance-scale me-2"></i>Opening Balances</button>
                </li>
            </ul>
        </div>
        
        <div class="card-body p-4">
            <div class="tab-content" id="itemMasterTabsContent">
                <!-- Tab 1: Items List -->
                <div class="tab-pane fade show active" id="itemsContent" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table align-middle table-hover" id="itemsTable">
                            <thead>
                                <tr>
                                    <th>Item Code</th>
                                    <th>Item Name</th>
                                    <th>Type</th>
                                    <th>Category</th>
                                    <th>UOM</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Current Stock</th>
                                    <th>Supplier</th>
                                    <th>Status</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in items %}
                                <tr>
                                    <td class="font-weight-bold text-primary">{{ item.item_code }}</td>
                                    <td>{{ item.item_name }}</td>
                                    <td>{{ item.item_type }}</td>
                                    <td>{{ item.category }}</td>
                                    <td>{{ item.unit_of_measure }}</td>
                                    <td class="text-end">${{ item.unit_price|number_format(2) }}</td>
                                    <td class="text-end font-weight-bold {% if item.current_stock <= item.min_stock_level %}text-danger{% endif %}">{{ item.current_stock }}</td>
                                    <td>{{ item.vendor_name|default('Direct') }}</td>
                                    <td>
                                        {% if item.status == 'active' %}
                                            <span class="badge bg-success rounded-pill">Active</span>
                                        {% else %}
                                            <span class="badge bg-secondary rounded-pill">Inactive</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-center">
                                        <a href="{{ BASE_URL }}/inventory/control/barcode?item_id={{ item.item_id }}" target="_blank" class="btn btn-sm btn-outline-info" title="Print Barcode"><i class="fas fa-barcode"></i></a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tab 2: Categories List -->
                <div class="tab-pane fade" id="categoriesContent" role="tabpanel">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="card border-0 bg-light p-4 rounded mb-4">
                                <h5 class="font-weight-bold mb-3">Add New Category</h5>
                                <form action="{{ BASE_URL }}/inventory/items/category" method="POST">
                                    {{ csrf_field()|raw }}
                                    <div class="mb-3">
                                        <label class="form-label font-weight-bold">Category Name</label>
                                        <input type="text" class="form-control" name="category_name" required placeholder="e.g. Cotton Fabrics">
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label font-weight-bold">Category Code</label>
                                        <input type="text" class="form-control" name="category_code" placeholder="e.g. COT-FAB">
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100 rounded-pill">Save Category</button>
                                </form>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Category Name</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for cat in categories %}
                                    <tr>
                                        <td class="font-weight-bold">{{ cat.category_code }}</td>
                                        <td>{{ cat.category_name }}</td>
                                        <td><span class="badge bg-success rounded-pill">Active</span></td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Tab 3: Brands List -->
                <div class="tab-pane fade" id="brandsContent" role="tabpanel">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Brand ID</th>
                                <th>Brand Name</th>
                                <th>Description</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for brand in brands %}
                            <tr>
                                <td>{{ brand.brand_id }}</td>
                                <td class="font-weight-bold">{{ brand.brand_name }}</td>
                                <td>{{ brand.description|default('No Description') }}</td>
                                <td><span class="badge bg-success rounded-pill">Active</span></td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <!-- Tab 4: Opening Balance -->
                <div class="tab-pane fade" id="openingContent" role="tabpanel">
                    <div class="row justify-content-center">
                        <div class="col-md-6">
                            <div class="card border-0 bg-light p-4 rounded">
                                <h5 class="font-weight-bold mb-4 text-center">Set/Update Item Opening Balance</h5>
                                <form action="{{ BASE_URL }}/inventory/items/opening-balance" method="POST">
                                    {{ csrf_field()|raw }}
                                    <div class="mb-3">
                                        <label class="form-label font-weight-bold">Select Item</label>
                                        <select class="form-select select2" name="item_id" required>
                                            <option value="">-- Choose Item --</option>
                                            {% for item in items %}
                                            <option value="{{ item.item_id }}">{{ item.item_code }} - {{ item.item_name }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label font-weight-bold">Select Target Warehouse</label>
                                        <select class="form-select" name="warehouse_id" required>
                                            <option value="">-- Choose Warehouse --</option>
                                            {% for wh in suppliers %}
                                                <!-- Simplified: use first warehouse mapping dynamically in Controller -->
                                            {% endfor %}
                                            <option value="1">Main Fabric Store (W1)</option>
                                            <option value="2">Accessories Store (W2)</option>
                                            <option value="3">Washing Chemical Room</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label font-weight-bold">Opening Stock Quantity</label>
                                        <input type="number" class="form-control" name="quantity" min="0" required placeholder="0">
                                    </div>
                                    <button type="submit" class="btn btn-success w-100 rounded-pill mt-3">Post Opening Balance</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Add Item -->
<div class="modal fade" id="addItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content premium-glass-card">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title font-weight-bold" id="addItemModalLabel">Add New Master Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="{{ BASE_URL }}/inventory/items/store" method="POST">
                {{ csrf_field()|raw }}
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold">Item Code (Leave blank for auto-gen)</label>
                            <input type="text" class="form-control" name="item_code" placeholder="e.g. ITM-FAB-001">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold">Item Name</label>
                            <input type="text" class="form-control" name="item_name" required placeholder="e.g. 100% Woven Cotton Weft">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold">Category</label>
                            <select class="form-select" name="category" required>
                                <option value="">-- Choose Category --</option>
                                {% for cat in categories %}
                                <option value="{{ cat.category_name }}">{{ cat.category_name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold">Item Type</label>
                            <select class="form-select" name="item_type" required>
                                <option value="Fabric">Fabric</option>
                                <option value="Trims">Trims</option>
                                <option value="Accessories">Accessories</option>
                                <option value="Chemical">Chemical</option>
                                <option value="Spare Parts">Spare Parts</option>
                                <option value="General Store">General Store</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label font-weight-bold">Unit of Measure (UOM)</label>
                            <select class="form-select" name="unit_of_measure" required>
                                {% for uom in uoms %}
                                <option value="{{ uom }}">{{ uom }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label font-weight-bold">Unit Price ($)</label>
                            <input type="number" step="0.01" class="form-control" name="unit_price" required placeholder="0.00">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label font-weight-bold">Opening Balance Qty</label>
                            <input type="number" class="form-control" name="opening_balance" placeholder="0">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold">Min/Safety Stock Level</label>
                            <input type="number" class="form-control" name="min_stock_level" placeholder="100">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold">Max Stock Level</label>
                            <input type="number" class="form-control" name="max_stock_level" placeholder="5000">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold">Preferred Supplier</label>
                            <select class="form-select" name="supplier_id">
                                <option value="">-- Choose Supplier --</option>
                                {% for sup in suppliers %}
                                <option value="{{ sup.vendor_id }}">{{ sup.vendor_name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label font-weight-bold">Status</label>
                            <select class="form-select" name="status">
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Create Item</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<!-- DataTables JS -->
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script>
$(document).ready(function() {
    $('#itemsTable').DataTable({
        order: [[0, 'desc']],
        pageLength: 10
    });
});
</script>
{% endblock %}
