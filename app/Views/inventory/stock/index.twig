{% extends 'layouts/app.twig' %}

{% block title %}Inventory • Stock Management{% endblock %}

{% block content %}
<div class="container-fluid inventory-stock">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Stock Management</h1>
            <p class="text-muted mb-0">Monitor inventory levels, reorder points, and stock movements.</p>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#stockModal">
            <i class="fas fa-plus me-2"></i>Add Stock Record
        </button>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <p class="label">Total Items</p>
                <h2>{{ stats.total_items }}</h2>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card warning">
                <p class="label">Low Stock</p>
                <h2>{{ stats.low_stock }}</h2>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card accent">
                <p class="label">Out of Stock</p>
                <h2>{{ stats.out_of_stock }}</h2>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <p class="label">Total Value</p>
                <h2>${{ stats.total_value|number_format(2, '.', ',') }}</h2>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form class="row g-3" method="get" action="/inventory/stock">
                <div class="col-md-3">
                    <label class="form-label">Search</label>
                    <input type="text" class="form-control" name="search" placeholder="Item name or code" value="{{ filters.search }}">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Warehouse</label>
                    <select class="form-select" name="warehouse_id">
                        <option value="">All warehouses</option>
                        {% for warehouse in dropdowns.warehouses %}
                            <option value="{{ warehouse.warehouse_id }}" {{ filters.warehouse_id == warehouse.warehouse_id ? 'selected' }}>
                                {{ warehouse.warehouse_name }} ({{ warehouse.warehouse_code }})
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Category</label>
                    <select class="form-select" name="category">
                        <option value="">All categories</option>
                        {% for category in dropdowns.categories %}
                            <option value="{{ category }}" {{ filters.category == category ? 'selected' }}>{{ category }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Low Stock Only</label>
                    <select class="form-select" name="low_stock">
                        <option value="">All</option>
                        <option value="1" {{ filters.low_stock == '1' ? 'selected' }}>Yes</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button class="btn btn-outline-primary" type="submit"><i class="fas fa-filter me-1"></i>Filter</button>
                    <a href="/inventory/stock" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Warehouse</th>
                            <th>On Hand</th>
                            <th>Reserved</th>
                            <th>Available</th>
                            <th>Reorder Level</th>
                            <th>Max Level</th>
                            <th>Value</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for stock in stock_items %}
                            <tr>
                                <td>
                                    <strong>{{ stock.item_name }}</strong>
                                    <div class="text-muted small">{{ stock.item_code }} • {{ stock.category }}</div>
                                </td>
                                <td>
                                    {{ stock.warehouse_name }}
                                    <div class="text-muted small">{{ stock.warehouse_code }}</div>
                                </td>
                                <td>{{ stock.quantity_on_hand }} {{ stock.uom }}</td>
                                <td>{{ stock.quantity_reserved }} {{ stock.uom }}</td>
                                <td>{{ stock.quantity_available }} {{ stock.uom }}</td>
                                <td>{{ stock.reorder_level }} {{ stock.uom }}</td>
                                <td>{{ stock.max_level }} {{ stock.uom }}</td>
                                <td>${{ (stock.quantity_on_hand * stock.unit_cost)|number_format(2, '.', ',') }}</td>
                                <td>
                                    {% if stock.quantity_on_hand == 0 %}
                                        <span class="badge bg-danger">Out of Stock</span>
                                    {% elseif stock.quantity_on_hand <= stock.reorder_level %}
                                        <span class="badge bg-warning">Low Stock</span>
                                    {% else %}
                                        <span class="badge bg-success">In Stock</span>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" data-adjust-stock data-stock='{{ stock|json_encode|raw }}'><i class="fas fa-edit"></i></button>
                                        <button class="btn btn-outline-danger" data-delete-stock data-stock-id="{{ stock.stock_id }}"><i class="fas fa-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="10" class="text-center text-muted py-5">No stock records found.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Stock Modal -->
<div class="modal fade" id="stockModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="stockForm">
                <div class="modal-header">
                    <h5 class="modal-title">Add Stock Record</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="stockAlert" class="alert d-none"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Warehouse</label>
                            <select class="form-select" name="warehouse_id" required>
                                <option value="">Select warehouse</option>
                                {% for warehouse in dropdowns.warehouses %}
                                    <option value="{{ warehouse.warehouse_id }}">{{ warehouse.warehouse_name }} ({{ warehouse.warehouse_code }})</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Item</label>
                            <select class="form-select" name="item_id" required>
                                <option value="">Select item</option>
                                {% for item in dropdowns.items %}
                                    <option value="{{ item.item_id }}">{{ item.item_name }} ({{ item.item_code }})</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Quantity On Hand</label>
                            <input type="number" step="0.01" min="0" class="form-control" name="quantity_on_hand" value="0" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Reorder Level</label>
                            <input type="number" step="0.01" min="0" class="form-control" name="reorder_level" value="0">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Max Level</label>
                            <input type="number" step="0.01" min="0" class="form-control" name="max_level" value="0">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Stock</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Adjust Stock Modal -->
<div class="modal fade" id="adjustModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="adjustForm">
                <input type="hidden" name="stock_id" id="adjustStockId">
                <div class="modal-header">
                    <h5 class="modal-title" id="adjustModalTitle">Adjust Stock</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="adjustAlert" class="alert d-none"></div>
                    <div class="mb-3">
                        <strong id="adjustItemName"></strong>
                        <div class="text-muted small" id="adjustWarehouse"></div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Current Quantity</label>
                            <input type="text" class="form-control" id="currentQuantity" readonly>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">New Quantity</label>
                            <input type="number" step="0.01" min="0" class="form-control" name="quantity_on_hand" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Reorder Level</label>
                            <input type="number" step="0.01" min="0" class="form-control" name="reorder_level">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Max Level</label>
                            <input type="number" step="0.01" min="0" class="form-control" name="max_level">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notes</label>
                            <textarea class="form-control" name="notes" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Adjustment</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script>
    (function() {
        const stockForm = document.getElementById('stockForm');
        const stockAlert = document.getElementById('stockAlert');
        const adjustForm = document.getElementById('adjustForm');
        const adjustAlert = document.getElementById('adjustAlert');
        const adjustModalEl = document.getElementById('adjustModal');
        const adjustModal = adjustModalEl ? bootstrap.Modal.getOrCreateInstance(adjustModalEl) : null;

        stockForm?.addEventListener('submit', async (event) => {
            event.preventDefault();
            stockAlert.classList.add('d-none');
            const formData = new FormData(stockForm);
            const payload = Object.fromEntries(formData.entries());

            try {
                const response = await fetch('/inventory/stock', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await response.json();
                if (!response.ok) throw data;
                location.reload();
            } catch (error) {
                stockAlert.className = 'alert alert-danger';
                stockAlert.textContent = error?.message || 'Failed to add stock record.';
                stockAlert.classList.remove('d-none');
            }
        });

        document.querySelectorAll('[data-adjust-stock]').forEach(btn => {
            btn.addEventListener('click', () => {
                const stock = JSON.parse(btn.getAttribute('data-stock'));
                adjustForm.stock_id.value = stock.stock_id;
                document.getElementById('adjustItemName').textContent = stock.item_name;
                document.getElementById('adjustWarehouse').textContent = `${stock.warehouse_name} (${stock.warehouse_code})`;
                document.getElementById('currentQuantity').value = `${stock.quantity_on_hand} ${stock.uom}`;
                adjustForm.quantity_on_hand.value = stock.quantity_on_hand;
                adjustForm.reorder_level.value = stock.reorder_level;
                adjustForm.max_level.value = stock.max_level;
                adjustAlert.classList.add('d-none');
                adjustModal?.show();
            });
        });

        adjustForm?.addEventListener('submit', async (event) => {
            event.preventDefault();
            adjustAlert.classList.add('d-none');
            const formData = new FormData(adjustForm);
            const payload = Object.fromEntries(formData.entries());
            const stockId = payload.stock_id;
            delete payload.stock_id;

            try {
                const response = await fetch(`/inventory/stock/${stockId}/adjust`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await response.json();
                if (!response.ok) throw data;
                location.reload();
            } catch (error) {
                adjustAlert.className = 'alert alert-danger';
                adjustAlert.textContent = error?.message || 'Failed to adjust stock.';
                adjustAlert.classList.remove('d-none');
            }
        });

        document.querySelectorAll('[data-delete-stock]').forEach(btn => {
            btn.addEventListener('click', async () => {
                if (!confirm('Delete this stock record?')) return;
                const response = await fetch(`/inventory/stock/${btn.dataset.stockId}`, { method: 'DELETE' });
                if (response.ok) {
                    location.reload();
                } else {
                    alert('Failed to delete stock record.');
                }
            });
        });
    })();
</script>
{% endblock %}
