{% extends "layouts/app.twig" %}

{% block title %}Store & Inventory Reports Hub{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-1 font-weight-bold text-gray-800">
                <i class="fas fa-warehouse text-primary me-2"></i>Store & Inventory Reports Center
            </h2>
            <p class="text-muted small mb-0">Stock Ledger, Warehouse Item Balances, GRN & Requisitions Log, Inventory Control</p>
        </div>
        <a href="{{ BASE_URL }}/inventory/dashboard" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-left me-1"></i> Inventory Dashboard
        </a>
    </div>

    <div class="row">
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary text-white rounded-circle p-3 me-3">
                            <i class="fas fa-boxes fa-lg"></i>
                        </div>
                        <div>
                            <h5 class="card-title h6 mb-1 font-weight-bold">Item Master Stock Ledger</h5>
                            <span class="badge bg-light text-primary">Stock</span>
                        </div>
                    </div>
                    <p class="card-text small text-muted">Item wise stock balances, minimum order levels, reorder alerts, and safety stock positions.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <a href="{{ BASE_URL }}/inventory/items" class="btn btn-sm btn-outline-primary w-100">Open Stock Ledger Report</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-success text-white rounded-circle p-3 me-3">
                            <i class="fas fa-dolly fa-lg"></i>
                        </div>
                        <div>
                            <h5 class="card-title h6 mb-1 font-weight-bold">GRN & Stock Issue Register</h5>
                            <span class="badge bg-light text-success">Transactions</span>
                        </div>
                    </div>
                    <p class="card-text small text-muted">Goods Received Notes (GRN), store requisitions, material issue slips, and stock adjustments.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <a href="{{ BASE_URL }}/inventory/transactions" class="btn btn-sm btn-outline-success w-100">Open GRN Report</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-info text-white rounded-circle p-3 me-3">
                            <i class="fas fa-clipboard-check fa-lg"></i>
                        </div>
                        <div>
                            <h5 class="card-title h6 mb-1 font-weight-bold">Inventory Control & Gate Passes</h5>
                            <span class="badge bg-light text-info">Control</span>
                        </div>
                    </div>
                    <p class="card-text small text-muted">Returnable / Non-returnable Gate Passes, audit approvals, and physical audit reconciliation.</p>
                </div>
                <div class="card-footer bg-transparent border-0 pb-3">
                    <a href="{{ BASE_URL }}/inventory/control" class="btn btn-sm btn-outline-info w-100">Open Inventory Control Report</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
