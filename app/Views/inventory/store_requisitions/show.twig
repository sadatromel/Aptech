{% extends "layouts/app.twig" %}

{% block title %}View Store Requisition{% endblock %}

{% block styles %}{% endblock %}


{% block content %}
<div class="row mb-4">
    <div class="col-8">
        <h2 class="mb-0">Store Requisition: {{ requisition.requisition_no }}</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb bg-transparent p-0 mb-0">
                <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="{{ BASE_URL }}/store_requisition">Store Requisitions</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ requisition.requisition_no }}</li>
            </ol>
        </nav>
    </div>
    <div class="col-4 text-end">
        <a href="{{ BASE_URL }}/store_requisition" class="btn btn-light rounded-pill px-4">
            <i class="bx bx-arrow-back me-1"></i> Back to List
        </a>
        <button class="btn btn-outline-primary btn-printer rounded-pill px-3 ms-2" onclick="printRequisition()">
            <i class="bx bx-printer"></i> Print
        </button>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-body p-4">
                <div class="row mb-4">
                    <div class="col-md-3 mb-3">
                        <small class="text-muted d-block mb-1">Status</small>
                        {% set badge_class = 'bg-secondary' %}
                        {% if requisition.status == 'approved' or requisition.status == 'completed' %}
                            {% set badge_class = 'bg-success' %}
                        {% elseif requisition.status == 'pending' %}
                            {% set badge_class = 'bg-warning text-dark' %}
                        {% elseif requisition.status == 'rejected' or requisition.status == 'cancelled' %}
                            {% set badge_class = 'bg-danger' %}
                        {% elseif requisition.status == 'partial_issued' %}
                            {% set badge_class = 'bg-info' %}
                        {% endif %}
                        <span class="badge {{ badge_class }} rounded-pill px-3 py-2 fs-6">{{ requisition.status|title }}</span>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-3 col-sm-6 mb-3">
                        <small class="text-muted d-block mb-1">Requisition Date</small>
                        <div class="fw-medium">{{ requisition.requisition_date|date('M d, Y') }}</div>
                    </div>
                    <div class="col-md-3 col-sm-6 mb-3">
                        <small class="text-muted d-block mb-1">Required Date</small>
                        <div class="fw-medium">{{ requisition.required_date ? requisition.required_date|date('M d, Y') : '-' }}</div>
                    </div>
                    <div class="col-md-3 col-sm-6 mb-3">
                        <small class="text-muted d-block mb-1">Location/Warehouse</small>
                        <div class="fw-medium">{{ requisition.location_name }}</div>
                    </div>
                    <div class="col-md-3 col-sm-6 mb-3">
                        <small class="text-muted d-block mb-1">Department</small>
                        <div class="fw-medium">{{ requisition.department_name|default('-') }}</div>
                    </div>
                    <div class="col-md-3 col-sm-6 mb-3">
                        <small class="text-muted d-block mb-1">Requested By</small>
                        <div class="fw-medium">{{ requisition.requested_by_name|default('-') }}</div>
                    </div>
                    <div class="col-md-3 col-sm-6 mb-3">
                        <small class="text-muted d-block mb-1">Reference No.</small>
                        <div class="fw-medium">{{ requisition.reference_no|default('-') }}</div>
                    </div>
                    <div class="col-md-6 col-sm-12 mb-3">
                        <small class="text-muted d-block mb-1">Purpose</small>
                        <div class="fw-medium">{{ requisition.purpose|default('-') }}</div>
                    </div>
                    <div class="col-md-12 mb-3">
                        <small class="text-muted d-block mb-1">Remarks</small>
                        <div class="fw-medium">{{ requisition.remarks|default('-') }}</div>
                    </div>
                </div>

                <h5 class="mb-3 border-bottom pb-2">Requested Items</h5>
                <div class="table-responsive">
                    <table class="table table-bordered table-striped align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width:5%">#</th>
                                <th style="width:18%">Item Code</th>
                                <th style="width:32%">Item Name</th>
                                <th style="width:12%;text-align:center">Req. Qty</th>
                                <th style="width:12%;text-align:center">Iss. Qty</th>
                                <th style="width:21%">Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for line in lines %}
                            <tr>
                                <td>{{ loop.index }}</td>
                                <td>{{ line.item_code }}</td>
                                <td>{{ line.item_name }}</td>
                                <td class="text-center fw-bold">{{ line.quantity_requested }} <small class="text-muted">{{ line.uom|default('pc') }}</small></td>
                                <td class="text-center">{{ line.quantity_issued|default('0') }} <small class="text-muted">{{ line.uom|default('pc') }}</small></td>
                                <td>{{ line.remarks|default('-') }}</td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="6" class="text-center py-3 text-muted">No items requested.</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {% if requisition.approved_by_name %}
                <div class="mt-4 text-end">
                    <small class="text-muted">Approved By:</small> <strong>{{ requisition.approved_by_name }}</strong> on {{ requisition.approved_date|date('M d, Y h:i A') }}
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function printRequisition() {
    // Extract content BEFORE opening new window
    var cardBody = document.querySelector('.card-body');
    var title = document.querySelector('h2').textContent.trim();
    var cardContent = cardBody ? cardBody.innerHTML : '<p>No content found</p>';
    var printDate = new Date().toLocaleDateString('en-GB', {day:'2-digit', month:'short', year:'numeric'});

    var printWindow = window.open('', '_blank', 'width=900,height=700');

    var html = '<!DOCTYPE html>'
        + '<html lang="en"><head>'
        + '<meta charset="UTF-8">'
        + '<title>Print: ' + title + '</title>'
        + '<style>'
        + '* { box-sizing: border-box; margin: 0; padding: 0; }'
        + 'body { font-family: Arial, sans-serif; font-size: 12pt; color: #000; background: #fff; padding: 15mm; }'
        + '.print-header { border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 16px; }'
        + '.print-header h1 { font-size: 18pt; font-weight: bold; }'
        + '.print-header p { font-size: 10pt; color: #555; }'
        /* Metadata grid - Bootstrap row/col helpers */
        + '.row { display: flex; flex-wrap: wrap; width: 100%; margin: 0; }'
        + '.col-md-3, .col-sm-6 { width: 25%; padding: 4px 6px; box-sizing: border-box; }'
        + '.col-md-6 { width: 50%; padding: 4px 6px; box-sizing: border-box; }'
        + '.col-md-12, .col-12 { width: 100%; padding: 4px 6px; box-sizing: border-box; }'
        /* Suppress card styles */
        + '.card { border: none !important; box-shadow: none !important; }'
        + '.card-body { padding: 0 !important; }'
        + '.mb-3, .mb-4 { margin-bottom: 8px; }'
        + 'small, .text-muted { font-size: 8pt; color: #555; display: block; margin-bottom: 2px; }'
        + '.fw-medium { font-size: 11pt; font-weight: 600; }'
        /* Status */
        + '.badge { display: inline-block; border: 1px solid #000; padding: 2px 8px; font-weight: bold; font-size: 11pt; background: #fff !important; color: #000 !important; }'
        /* Section heading */
        + 'h5 { font-size: 13pt; margin: 14px 0 6px 0; padding-bottom: 4px; border-bottom: 1px solid #333; }'
        + '.border-bottom { border-bottom: 1px solid #ccc !important; }'
        /* Table */
        + '.table-responsive { overflow: visible; width: 100%; }'
        + 'table { width: 100%; border-collapse: collapse; font-size: 10pt; table-layout: auto; }'
        + 'thead th { background-color: #eee; border: 1px solid #999; padding: 5px 8px; font-weight: bold; text-align: left; white-space: nowrap; }'
        + 'tbody td { border: 1px solid #bbb; padding: 5px 8px; text-align: left; }'
        + '.text-center { text-align: center; }'
        + '.fw-bold { font-weight: bold; }'
        + '.align-middle td { vertical-align: middle; }'
        + '.table-striped tbody tr:nth-of-type(odd) { background-color: #f9f9f9; }'
        + '@page { size: A4 portrait; margin: 12mm 15mm; }'
        + '</style>'
        + '</head><body>'
        + '<div class="print-header">'
        + '<h1>' + title + '</h1>'
        + '<p>Printed on: ' + printDate + '</p>'
        + '</div>'
        + cardContent
        + '</body></html>';

    printWindow.document.write(html);
    printWindow.document.close();

    setTimeout(function() {
        printWindow.focus();
        printWindow.print();
    }, 500);
}
</script>
{% endblock %}

