{% extends 'layouts/app.twig' %}

{% block title %}Production & RMG Stores{% endblock %}

{% block styles %}
<style>
    .premium-glass-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: 0 8px 32px rgba(31, 38, 135, 0.05);
        border-radius: var(--border-radius);
    }
    [data-theme="dark"] .premium-glass-card {
        background: rgba(30, 41, 59, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }
    .nav-tabs .nav-link {
        border: none;
        color: #718096;
        font-weight: 600;
        padding: 12px 20px;
    }
    .nav-tabs .nav-link.active {
        background: transparent;
        color: var(--primary);
        border-bottom: 3px solid var(--primary);
    }
</style>
{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 bg-transparent px-0">
                <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard" class="text-decoration-none"><i class="fas fa-home"></i> Dashboard</a></li>
                <li class="breadcrumb-item"><a href="{{ BASE_URL }}/inventory/dashboard" class="text-decoration-none">Store & Inventory</a></li>
                <li class="breadcrumb-item active" aria-current="page">Production Stores (RMG)</li>
            </ol>
        </nav>
        <div>
            <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#logInspectionModal">
                <i class="fas fa-microscope me-2"></i> Log 4-Point QC
            </button>
        </div>
    </div>

    <!-- Alert Notifications -->
    {% if session.success_message %}
    <div class="alert alert-success alert-dismissible fade show premium-glass-card mb-4" role="alert">
        <i class="fas fa-check-circle me-2"></i>{{ session.success_message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <!-- Tabs Navigation -->
    <div class="card border-0 premium-glass-card mb-4">
        <div class="card-header bg-transparent border-0 p-0">
            <ul class="nav nav-tabs border-bottom" id="productionStoreTabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" id="fabric-tab" data-bs-toggle="tab" data-bs-target="#fabricContent" type="button" role="tab"><i class="fas fa-scroll me-2"></i>Fabric Store (Rolls)</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="qc4point-tab" data-bs-toggle="tab" data-bs-target="#qc4pointContent" type="button" role="tab"><i class="fas fa-clipboard-check me-2"></i>4-Point Inspection Logs</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="trims-tab" data-bs-toggle="tab" data-bs-target="#trimsContent" type="button" role="tab"><i class="fas fa-ring me-2"></i>Trims & Accessories</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="chemicals-tab" data-bs-toggle="tab" data-bs-target="#chemicalsContent" type="button" role="tab"><i class="fas fa-flask me-2"></i>Chemical & Dye Store</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="spareparts-tab" data-bs-toggle="tab" data-bs-target="#sparepartsContent" type="button" role="tab"><i class="fas fa-cogs me-2"></i>Spare Parts Store</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" id="wip-tab" data-bs-toggle="tab" data-bs-target="#wipContent" type="button" role="tab"><i class="fas fa-sync-alt me-2"></i>WIP & Leftovers</button>
                </li>
            </ul>
        </div>
        
        <div class="card-body p-4">
            <div class="tab-content" id="productionStoreTabsContent">
                <!-- Tab 1: Fabric Store -->
                <div class="tab-pane fade show active" id="fabricContent" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Item Code</th>
                                    <th>Fabric Description</th>
                                    <th>Category</th>
                                    <th class="text-end">Current Balance</th>
                                    <th>UOM</th>
                                    <th>Lot / Shade Code</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for fab in fabrics %}
                                <tr>
                                    <td class="font-weight-bold text-primary">{{ fab.item_code }}</td>
                                    <td>{{ fab.item_name }}</td>
                                    <td>{{ fab.category }}</td>
                                    <td class="text-end font-weight-bold text-success">{{ fab.stock_qty|default(0)|number_format }}</td>
                                    <td>{{ fab.unit_of_measure }}</td>
                                    <td>
                                        <span class="badge bg-secondary-light text-secondary font-weight-bold">LOT-{{ fab.item_id|default('91') }}-A</span>
                                    </td>
                                    <td><span class="badge bg-success rounded-pill">Active</span></td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tab 2: 4-Point QC Logs -->
                <div class="tab-pane fade" id="qc4pointContent" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>QC Date</th>
                                    <th>Roll Number</th>
                                    <th>Fabric Item</th>
                                    <th class="text-end">Length (Yds)</th>
                                    <th class="text-end">Width (In)</th>
                                    <th class="text-end">Total Defect Points</th>
                                    <th class="text-center">QC Grade</th>
                                    <th>QC Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for ins in inspections %}
                                <tr>
                                    <td>{{ ins.date|default('2026-07-12') }}</td>
                                    <td class="font-weight-bold text-dark">{{ ins.roll_no }}</td>
                                    <td>{{ ins.item_name }}</td>
                                    <td class="text-end font-weight-bold">{{ ins.length }}</td>
                                    <td class="text-end">{{ ins.width }}</td>
                                    <td class="text-end text-danger font-weight-bold">{{ ins.points }}</td>
                                    <td class="text-center">
                                        <span class="badge {% if ins.grade == 'A' %}bg-success{% elseif ins.grade == 'B' or ins.grade == 'C' %}bg-warning{% else %}bg-danger{% endif %} rounded-pill px-3">{{ ins.grade }}</span>
                                    </td>
                                    <td>
                                        {% if ins.status == 'Passed' %}
                                            <span class="badge bg-success-light text-success font-weight-bold">Passed</span>
                                        {% else %}
                                            <span class="badge bg-danger-light text-danger font-weight-bold">Failed (Reject)</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tab 3: Trims & Accessories -->
                <div class="tab-pane fade" id="trimsContent" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Item Code</th>
                                    <th>Trims/Accessories Description</th>
                                    <th>Category</th>
                                    <th class="text-end">In Stock</th>
                                    <th>UOM</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for trim in trims %}
                                <tr>
                                    <td class="font-weight-bold text-primary">{{ trim.item_code }}</td>
                                    <td>{{ trim.item_name }}</td>
                                    <td>{{ trim.category }}</td>
                                    <td class="text-end font-weight-bold text-success">{{ trim.stock_qty|default(0)|number_format }}</td>
                                    <td>{{ trim.unit_of_measure }}</td>
                                    <td><span class="badge bg-success rounded-pill">Active</span></td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tab 4: Chemical Store -->
                <div class="tab-pane fade" id="chemicalsContent" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Chemical Code</th>
                                    <th>Chemical / Dye Name</th>
                                    <th class="text-end">Balance In Stock</th>
                                    <th>UOM</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for chm in chemicals %}
                                <tr>
                                    <td class="font-weight-bold text-primary">{{ chm.item_code }}</td>
                                    <td>{{ chm.item_name }}</td>
                                    <td class="text-end font-weight-bold text-success">{{ chm.stock_qty|default(0)|number_format }}</td>
                                    <td>{{ chm.unit_of_measure }}</td>
                                    <td><span class="badge bg-success rounded-pill">Active</span></td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tab 5: Spare Parts -->
                <div class="tab-pane fade" id="sparepartsContent" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Parts Code</th>
                                    <th>Machine Spare Part Name</th>
                                    <th class="text-end">Balance In Stock</th>
                                    <th>UOM</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for part in spareParts %}
                                <tr>
                                    <td class="font-weight-bold text-primary">{{ part.item_code }}</td>
                                    <td>{{ part.item_name }}</td>
                                    <td class="text-end font-weight-bold text-success">{{ part.stock_qty|default(0)|number_format }}</td>
                                    <td>{{ part.unit_of_measure }}</td>
                                    <td><span class="badge bg-success rounded-pill">Active</span></td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tab 6: WIP & Leftovers -->
                <div class="tab-pane fade" id="wipContent" role="tabpanel">
                    <div class="row">
                        <!-- WIP Stores Column -->
                        <div class="col-lg-6 border-end pr-lg-4">
                            <h5 class="font-weight-bold mb-3"><i class="fas fa-industry me-2 text-primary"></i>Active Manufacturing Store WIP</h5>
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Production Stage</th>
                                        <th>Style/Order No</th>
                                        <th class="text-end">Input Qty</th>
                                        <th class="text-end">WIP Qty</th>
                                        <th>Status/Location</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for wip in wipLogs %}
                                    <tr>
                                        <td class="font-weight-bold">{{ wip.stage }}</td>
                                        <td>{{ wip.style }}</td>
                                        <td class="text-end">{{ wip.input_qty|number_format }}</td>
                                        <td class="text-end text-warning font-weight-bold">{{ wip.wip_qty|number_format }}</td>
                                        <td><span class="badge {% if wip.wip_qty == 0 %}bg-success{% else %}bg-warning{% endif %} rounded-pill">{{ wip.balance }}</span></td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        <!-- Leftovers Fabric Column -->
                        <div class="col-lg-6 ps-lg-4">
                            <h5 class="font-weight-bold mb-3 text-success"><i class="fas fa-trash-restore-alt me-2"></i>Leftover & Scrap Fabric Register</h5>
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Style</th>
                                        <th>Buyer</th>
                                        <th>Fabric details</th>
                                        <th class="text-end">Qty Leftover</th>
                                        <th>Bin Location</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for left in leftovers %}
                                    <tr>
                                        <td>{{ left.date }}</td>
                                        <td class="font-weight-bold">{{ left.style }}</td>
                                        <td>{{ left.buyer }}</td>
                                        <td>{{ left.fabric_type }}</td>
                                        <td class="text-end font-weight-bold text-success">{{ left.qty_left }} {{ left.unit }}</td>
                                        <td><span class="badge bg-secondary">{{ left.store_bin }}</span></td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Log 4-Point QC -->
<div class="modal fade" id="logInspectionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content premium-glass-card">
            <div class="modal-header border-0">
                <h5 class="modal-title font-weight-bold">Log Fabric Roll 4-Point Inspection</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="{{ BASE_URL }}/inventory/production/inspection" method="POST">
                {{ csrf_field()|raw }}
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Roll Number / barcode ID</label>
                        <input type="text" class="form-control" name="roll_no" required placeholder="e.g. ROLL-2026-X10">
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Select Fabric Item</label>
                        <select class="form-select" name="item_id" required>
                            <option value="">-- Choose Fabric --</option>
                            {% for item in itemsDropdown %}
                            <option value="{{ item.item_id }}">{{ item.item_code }} - {{ item.item_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label font-weight-bold">Roll Length (Yards)</label>
                            <input type="number" step="0.1" class="form-control" name="length" required placeholder="100.0">
                        </div>
                        <div class="col-6">
                            <label class="form-label font-weight-bold">Roll Width (Inches)</label>
                            <input type="number" step="0.1" class="form-control" name="width" required placeholder="58.0">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Total Defect Points (Sum of 4-Point Penalties)</label>
                        <input type="number" class="form-control" name="points" required placeholder="e.g. 12">
                        <small class="text-muted">4-Point penalizes defects: 1 pt (size &lt; 3"), 2 pt (3-6"), 3 pt (6-9"), 4 pt (&gt; 9").</small>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Analyze & Register Roll</button>
                </div>
            </form>
        </div>
    </div>
</div>

{% endblock %}
