{% extends "layouts/app.twig" %}

{% block title %}QC Tracking{% endblock %}

{% block content %}
<div class="row">
    <!-- Page Header -->
    <div class="col-12 mb-4">
        <div class="page-header d-flex justify-content-between align-items-center p-4 bg-white rounded shadow-sm">
            <div class="page-title">
                <h1 class="h3 text-primary fw-bold mb-1">QC Tracking</h1>
                <p class="text-muted mb-0">Quality control inspections and defect tracking</p>
            </div>
            <div class="page-actions">
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addInspectionModal">
                    <i class="fas fa-plus me-2"></i>New Inspection
                </button>
            </div>
        </div>
    </div>

    <!-- Stats -->
    <div class="col-12 mb-4">
        <div class="stats-grid">
            <div class="stat-card bg-white p-4 rounded shadow-sm text-center">
                <h3 class="fw-bold text-primary mb-0">{{ stats.total_inspections }}</h3>
                <p class="text-muted mb-0">Total Inspections</p>
            </div>
            <div class="stat-card bg-white p-4 rounded shadow-sm text-center">
                <h3 class="fw-bold text-primary mb-0">{{ stats.avg_pass_rate|number_format(1) }}%</h3>
                <p class="text-muted mb-0">Avg Pass Rate</p>
            </div>
            <div class="stat-card bg-white p-4 rounded shadow-sm text-center">
                <h3 class="fw-bold text-primary mb-0">{{ stats.today_inspections }}</h3>
                <p class="text-muted mb-0">Today's Inspections</p>
            </div>
            <div class="stat-card bg-white p-4 rounded shadow-sm text-center">
                <h3 class="fw-bold text-danger mb-0">{{ stats.critical_defects }}</h3>
                <p class="text-muted mb-0">Critical Defects</p>
            </div>
        </div>
    </div>

    <!-- Inspections Table -->
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white p-3 d-flex justify-content-between align-items-center">
                <span class="fw-bold"><i class="fas fa-clipboard-check me-2"></i>QC Inspections</span>
                <input type="text" class="form-control form-control-sm w-auto" id="searchInput" placeholder="Search inspections...">
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="inspectionsTable">
                        <thead class="bg-light">
                            <tr>
                                <th class="p-3 border-0">Inspection #</th>
                                <th class="p-3 border-0">Order/Style</th>
                                <th class="p-3 border-0">Line</th>
                                <th class="p-3 border-0">Type</th>
                                <th class="p-3 border-0">Results</th>
                                <th class="p-3 border-0">Pass Rate</th>
                                <th class="p-3 border-0">Inspector</th>
                                <th class="p-3 border-0">Date</th>
                                <th class="p-3 border-0">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for inspection in inspections %}
                            {% set progress_class = inspection.pass_rate >= 95 ? 'bg-success' : (inspection.pass_rate >= 85 ? 'bg-warning' : 'bg-danger') %}
                            <tr>
                                <td class="p-3">
                                    <div class="fw-bold">{{ inspection.inspection_number }}</div>
                                    <small class="text-muted">{{ inspection.defect_count }} defects</small>
                                </td>
                                <td class="p-3">
                                    <div class="fw-bold">{{ inspection.order_number }}</div>
                                    <small class="text-muted">{{ inspection.style_code }}</small>
                                </td>
                                <td class="p-3">{{ inspection.line_name }}</td>
                                <td class="p-3">
                                    <span class="badge bg-secondary">{{ inspection.inspection_type }}</span>
                                </td>
                                <td class="p-3">
                                    <span class="text-success">{{ inspection.passed_quantity }} OK</span>
                                    <div class="small text-muted">{{ inspection.failed_quantity }} Fail, {{ inspection.rework_quantity }} Rwk</div>
                                </td>
                                <td class="p-3">
                                    {{ inspection.pass_rate|number_format(1) }}%
                                    <div class="progress mt-1" style="height: 6px;">
                                        <div class="progress-bar {{ progress_class }}" style="width:{{ min(inspection.pass_rate, 100) }}%"></div>
                                    </div>
                                </td>
                                <td class="p-3">{{ inspection.inspector_name }}</td>
                                <td class="p-3">{{ inspection.inspection_date|date('M j, Y') }}</td>
                                <td class="p-3">
                                    <button class="btn btn-sm btn-outline-info me-1" onclick="viewInspection({{ inspection.inspection_id }})">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <form action="{{ BASE_URL }}/sewing/qc/{{ inspection.inspection_id }}/delete" method="POST" onsubmit="return confirm('Delete this record?')" style="display:inline;">
    {{ csrf_field() | raw }}
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="9" class="text-center p-4 text-muted">No inspections found.</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addInspectionModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <form action="{{ BASE_URL }}/sewing/qc" method="POST" class="modal-content">
    {{ csrf_field() | raw }}
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">New QC Inspection</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Number</label>
                        <input type="text" class="form-control" name="inspection_number" value="QC-{{ 'now'|date('Y-m-d') }}-001" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Order</label>
                        <select class="form-select" name="order_id" required>
                            <option value="">Select Order</option>
                            {% for order in orders %}
                            <option value="{{ order.order_id }}">{{ order.order_number }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Style</label>
                        <select class="form-select" name="style_id" required>
                            <option value="">Select Style</option>
                            {% for style in styles %}
                            <option value="{{ style.style_id }}">{{ style.style_code }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Line</label>
                        <select class="form-select" name="line_id" required>
                            <option value="">Select Line</option>
                            {% for line in lines %}
                            <option value="{{ line.line_id }}">{{ line.line_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Type</label>
                        <select class="form-select" name="inspection_type" required>
                            <option value="Inline">Inline</option>
                            <option value="Final">Final</option>
                            <option value="Audit">Audit</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Inspector</label>
                        <select class="form-select" name="inspector_id">
                            <option value="">Select Inspector</option>
                            {% for inspector in inspectors %}
                            <option value="{{ inspector.employee_id }}">{{ inspector.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Date</label>
                        <input type="date" class="form-control" name="inspection_date" value="{{ today }}" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Total</label>
                        <input type="number" class="form-control" name="total_inspected" min="0" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Passed</label>
                        <input type="number" class="form-control" name="passed_quantity" min="0" required>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Failed</label>
                        <input type="number" class="form-control" name="failed_quantity" min="0" value="0">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Rework</label>
                        <input type="number" class="form-control" name="rework_quantity" min="0" value="0">
                    </div>
                </div>

                <div class="mt-3">
                    <label class="form-label fw-bold">Defects</label>
                    <div id="defectsContainer">
                         <!-- Defect rows -->
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="addDefect()">
                        <i class="fas fa-plus"></i> Add Defect
                    </button>
                </div>

                <div class="mt-3">
                    <label class="form-label fw-bold">Remarks</label>
                    <textarea class="form-control" name="remarks" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Inspection</button>
            </div>
        </form>
    </div>
</div>

<script>
let defectCount = 0;
function addDefect() {
    const container = document.getElementById('defectsContainer');
    const html = `
        <div class="row g-2 mb-2 defect-row">
            <div class="col-md-4">
                <select class="form-select form-select-sm" name="defects[${defectCount}][defect_type]" required>
                    <option value="">Select Defect</option>
                    <option value="Seam Defect">Seam Defect</option>
                    <option value="Fabric Defect">Fabric Defect</option>
                    <option value="Measurement">Measurement</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            <div class="col-md-3">
                <input type="number" class="form-control form-control-sm" name="defects[${defectCount}][defect_quantity]" placeholder="Qty" min="1" required>
            </div>
            <div class="col-md-3">
                <select class="form-select form-select-sm" name="defects[${defectCount}][severity]" required>
                    <option value="Minor">Minor</option>
                    <option value="Major">Major</option>
                    <option value="Critical">Critical</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('.defect-row').remove()">x</button>
            </div>
        </div>
    `;
    container.insertAdjacentHTML('beforeend', html);
    defectCount++;
}

document.getElementById('searchInput').addEventListener('keyup', function(e) {
    const term = e.target.value.toLowerCase();
    document.querySelectorAll('#inspectionsTable tbody tr').forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(term) ? '' : 'none';
    });
});

function viewInspection(id) {
    fetch(`{{ BASE_URL }}/sewing/qc/${id}/data`)
        .then(r => r.json())
        .then(data => {
            let defects = data.defects.map(d => `- ${d.defect_type}: ${d.defect_quantity} (${d.severity})`).join('\\n');
            alert(`Inspection Details:\\n\\nNumber: ${data.inspection_number}\\nPass Rate: ${data.passed_quantity}/${data.total_inspected}\\n\\nDefects:\\n${defects}`);
        });
}
</script>

{% endblock %}
