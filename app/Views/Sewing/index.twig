    </div>
</div>
<div class="modal fade" id="assignOperatorModal" tabindex="-1">
    <div class="modal-dialog">
        <form method="POST" action="{{ BASE_URL }}/sewing/operator" class="modal-content">
            {{ csrf_field() | raw }}<input type="hidden" name="action" value="assign_operator">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-user-plus me-2"></i>Assign Operator</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label fw-semibold small">Sewing Line <span class="text-danger">*</span></label>
                    <select class="form-select" name="line_id" required>
                        <option value="">— Select —</option>
                        {% for l in lines %}<option value="{{ l.production_line_id }}">{{ l.line_name }}</option>{% endfor %}
                    </select></div>
                <div class="mb-3"><label class="form-label fw-semibold small">Operator Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" name="operator_name" placeholder="Full name" required></div>
                <div class="mb-3"><label class="form-label fw-semibold small">Employee Code</label>
                    <input type="text" class="form-control" name="employee_code" placeholder="EMP-0042"></div>
                <div class="mb-3"><label class="form-label fw-semibold small">Operation</label>
                    <select class="form-select" name="operation">
                        <option>Front Part Assembly</option><option>Back Part Assembly</option>
                        <option>Sleeve Attachment</option><option>Collar Attachment</option>
                        <option>Side Seam</option><option>Hemming</option>
                        <option>Pocket Attach</option><option>Bartack</option><option>Other</option>
                    </select></div>
                <div class="mb-3"><label class="form-label fw-semibold small">Skill Grade</label>
                    <select class="form-select" name="skill_grade">
                        <option value="A">A — Expert (≥90%)</option>
                        <option value="B">B — Skilled (70–89%)</option>
                        <option value="C">C — Trainee (&lt;70%)</option>
                    </select></div>
                <div class="mb-3"><label class="form-label fw-semibold small">SMV (seconds)</label>
                    <input type="number" class="form-control" name="smv" step="0.1" placeholder="45.5"></div>
