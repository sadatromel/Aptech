            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-info text-white"><i class="fas fa-save me-1"></i>Assign</button>
            </div>
        </form>
    </div>
</div>
{% endif %}


