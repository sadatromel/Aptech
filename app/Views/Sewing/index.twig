{% extends "layouts/app.twig" %}

{% block title %}Sewing Control Center{% endblock %}

{% block content %}
<style>
    .glow-card {
        transition: all 0.3s ease-in-out;
        border-radius: 16px;
        background: rgba(255,255,255,0.92);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.4);
        box-shadow: 0 8px 24px rgba(0,0,0,0.05);
    }
    .glow-card:hover { box-shadow: 0 14px 32px rgba(54,185,204,0.13); }
    .nav-pills .nav-link {
        border-radius: 10px; padding: 7px 14px;
        font-weight: 600; font-size: .83rem; color: #5a5c69;
        transition: all 0.25s ease;
    }
    .nav-pills .nav-link.active {
        background: linear-gradient(135deg,#36b9cc 0%,#258391 100%);
        color:#fff!important;
        box-shadow: 0 4px 14px rgba(54,185,204,0.32);
    }
    .nav-pills .nav-link:hover:not(.active) { background:#f0fdff; color:#1a9aab; }
    .metric-icon {
        width:48px; height:48px; border-radius:12px;
        display:flex; align-items:center; justify-content:center; font-size:1.4rem;
    }
    .bg-light-info    { background:rgba(54,185,204,.12); }
    .bg-light-success { background:rgba(28,200,138,.12); }
    .bg-light-warning { background:rgba(246,194,62,.12); }
    .bg-light-primary { background:rgba(78,115,223,.12); }
    .bg-light-danger  { background:rgba(231,74,59,.12); }
    .text-gradient {
        background: linear-gradient(135deg,#36b9cc 0%,#4e73df 100%);
        -webkit-background-clip:text; -webkit-text-fill-color:transparent;
    }
    .bar-wrap { height:8px; background:#e9ecef; border-radius:4px; overflow:hidden; }
    .bar-fill  { height:100%; border-radius:4px; transition:width .6s ease; }
    .tl-dot { width:12px;height:12px;border-radius:50%;display:inline-block;margin-right:5px; }
    .tl-green  { background:#1cc88a; }
    .tl-yellow { background:#f6c23e; }
    .tl-red    { background:#e74a3b; }
    .wip-card { border-left:4px solid #36b9cc; }
    .wip-card.wip-danger  { border-left-color:#e74a3b; }
    .wip-card.wip-warning { border-left-color:#f6c23e; }
    .wip-card.wip-success { border-left-color:#1cc88a; }
    .report-section-title {
        font-size:1rem; font-weight:700; color:#36b9cc;
        border-bottom:2px solid #e3f8fb; padding-bottom:8px; margin-bottom:14px;
    }
    @media print {
        .no-print { display:none!important; }
        .glow-card { box-shadow:none; border:1px solid #ddd; }
    }
</style>

{# ── Flash Messages ── #}
{% if app.session.flash('success_message') %}
<div class="alert alert-success alert-dismissible fade show mx-2">
    <i class="fas fa-check-circle me-2"></i>{{ app.session.flash('success_message') }}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
{% endif %}
{% if app.session.flash('error_message') %}
<div class="alert alert-danger alert-dismissible fade show mx-2">
    <i class="fas fa-exclamation-circle me-2"></i>{{ app.session.flash('error_message') }}
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
{% endif %}

<div class="row">
    {# ── Page Header ── #}
    <div class="col-12 mb-3">
        <div class="page-header d-flex justify-content-between align-items-center p-4 glow-card">
            <div>
                <h1 class="h3 fw-bold text-gradient mb-1">Sewing Control Center</h1>
                <p class="text-muted mb-0 small">Line Management · Hourly Balancing · Operator Skills · Quality Control</p>
            </div>
            <div class="d-flex gap-2 no-print">
                <span class="badge bg-info text-white px-3 py-2"><i class="fas fa-sitemap me-1"></i>{{ lines|length }} Lines</span>
                <span class="badge bg-success text-white px-3 py-2"><i class="fas fa-calendar me-1"></i>{{ "now"|date("d M Y") }}</span>
            </div>
        </div>
    </div>

    {# ── Navigation ── #}
    <div class="col-12 mb-3 no-print">
        <div class="p-2 glow-card">
            <ul class="nav nav-pills gap-1 flex-wrap">
                <li class="nav-item"><a class="nav-link {% if activeTab == 'dashboard' %}active{% endif %}" href="{{ BASE_URL }}/sewing/dashboard"><i class="fas fa-chart-pie me-1"></i>Dashboard</a></li>
                <li class="nav-item"><a class="nav-link {% if activeTab == 'lines' %}active{% endif %}" href="{{ BASE_URL }}/sewing/lines"><i class="fas fa-sitemap me-1"></i>Lines</a></li>
                <li class="nav-item"><a class="nav-link {% if activeTab == 'input' %}active{% endif %}" href="{{ BASE_URL }}/sewing/input"><i class="fas fa-sign-in-alt me-1"></i>Input</a></li>
                <li class="nav-item"><a class="nav-link {% if activeTab == 'production' %}active{% endif %}" href="{{ BASE_URL }}/sewing/production"><i class="fas fa-tshirt me-1"></i>Production</a></li>
                <li class="nav-item"><a class="nav-link {% if activeTab == 'output' %}active{% endif %}" href="{{ BASE_URL }}/sewing/output"><i class="fas fa-sign-out-alt me-1"></i>Output</a></li>
                <li class="nav-item"><a class="nav-link {% if activeTab == 'wip' %}active{% endif %}" href="{{ BASE_URL }}/sewing/wip"><i class="fas fa-spinner me-1"></i>WIP</a></li>
                <li class="nav-item"><a class="nav-link {% if activeTab == 'quality' %}active{% endif %}" href="{{ BASE_URL }}/sewing/quality"><i class="fas fa-tasks me-1"></i>Quality</a></li>
                <li class="nav-item"><a class="nav-link {% if activeTab == 'machine' %}active{% endif %}" href="{{ BASE_URL }}/sewing/machine"><i class="fas fa-tools me-1"></i>Machines</a></li>
                <li class="nav-item"><a class="nav-link {% if activeTab == 'operator' %}active{% endif %}" href="{{ BASE_URL }}/sewing/operator"><i class="fas fa-users-cog me-1"></i>Operators</a></li>
                <li class="nav-item"><a class="nav-link {% if activeTab == 'incentives' %}active{% endif %}" href="{{ BASE_URL }}/sewing/incentives"><i class="fas fa-coins me-1"></i>Incentives</a></li>
                <li class="nav-item"><a class="nav-link {% if activeTab == 'productivity' %}active{% endif %}" href="{{ BASE_URL }}/sewing/productivity"><i class="fas fa-tachometer-alt me-1"></i>Productivity</a></li>
                <li class="nav-item"><a class="nav-link {% if activeTab == 'reports' %}active{% endif %}" href="{{ BASE_URL }}/sewing/reports"><i class="fas fa-file-invoice me-1"></i>Reports</a></li>
            </ul>
        </div>
    </div>

    <div class="col-12">

{# ═══════════════════════════════════════
   1. DASHBOARD
═══════════════════════════════════════ #}
{% if activeTab == 'dashboard' %}
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card glow-card p-3 border-0">
            <div class="d-flex align-items-center justify-content-between">
                <div><h6 class="text-muted fw-bold text-uppercase small mb-1">Active Lines</h6>
                    <h3 class="fw-bold mb-0">{{ lines|length }}</h3>
                    <small class="text-success">Running today</small></div>
                <div class="metric-icon bg-light-info text-info"><i class="fas fa-sitemap"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card glow-card p-3 border-0">
            <div class="d-flex align-items-center justify-content-between">
                <div><h6 class="text-muted fw-bold text-uppercase small mb-1">Avg DHU</h6>
                    <h3 class="fw-bold mb-0">2.1%</h3>
                    <small class="text-success"><i class="fas fa-arrow-down"></i> Target &lt;3%</small></div>
                <div class="metric-icon bg-light-success text-success"><i class="fas fa-check-circle"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card glow-card p-3 border-0">
            <div class="d-flex align-items-center justify-content-between">
                <div><h6 class="text-muted fw-bold text-uppercase small mb-1">Today Output</h6>
                    <h3 class="fw-bold mb-0">{{ totalActual }}</h3>
                    <small class="text-info">pcs logged</small></div>
                <div class="metric-icon bg-light-primary text-primary"><i class="fas fa-tshirt"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card glow-card p-3 border-0">
            <div class="d-flex align-items-center justify-content-between">
                <div><h6 class="text-muted fw-bold text-uppercase small mb-1">Active Styles</h6>
                    <h3 class="fw-bold mb-0">{{ styles|length }}</h3>
                    <small class="text-warning">In production</small></div>
                <div class="metric-icon bg-light-warning text-warning"><i class="fas fa-palette"></i></div>
            </div>
        </div>
    </div>
</div>
<div class="row g-3">
    <div class="col-md-8">
        <div class="card glow-card border-0 p-4">
            <h6 class="fw-bold text-info mb-3"><i class="fas fa-clock me-2"></i>Recent Hourly Performance</h6>
            {% if performance|length > 0 %}
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light"><tr><th>Line</th><th>Hour</th><th>Target</th><th>Actual</th><th>Efficiency</th></tr></thead>
                    <tbody>
                    {% for p in performance|slice(0,8) %}
                    {% set eff = p.hourly_target > 0 ? ((p.hourly_actual / p.hourly_target) * 100)|round : 0 %}
                    {% set effCapped = eff > 100 ? 100 : eff %}
                    <tr>
                        <td><span class="badge bg-light text-dark border">{{ p.line_name ?? '—' }}</span></td>
                        <td>{{ p.recorded_hour ?? '—' }}</td>
                        <td>{{ p.hourly_target ?? 0 }}</td>
                        <td class="fw-bold">{{ p.hourly_actual ?? 0 }}</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="bar-wrap" style="width:80px;">
                                    <div class="bar-fill {% if eff >= 90 %}bg-success{% elseif eff >= 70 %}bg-warning{% else %}bg-danger{% endif %}" style="width:{{ effCapped }}%"></div>
                                </div>
                                <small class="fw-bold {% if eff >= 90 %}text-success{% elseif eff >= 70 %}text-warning{% else %}text-danger{% endif %}">{{ eff }}%</small>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <div class="text-center py-5 text-muted">
                <i class="fas fa-chart-bar fa-3x mb-3 d-block opacity-25"></i>
                No logs yet. Go to <a href="{{ BASE_URL }}/sewing/production">Production</a> to log hourly output.
            </div>
            {% endif %}
        </div>
    </div>
    <div class="col-md-4">
        <div class="card glow-card border-0 p-4">
            <h6 class="fw-bold text-info mb-3"><i class="fas fa-sitemap me-2"></i>Lines at a Glance</h6>
            {% if lines|length > 0 %}
            <div class="d-flex flex-column gap-2">
                {% for line in lines %}
                {% set ls = lineStats[line.line_name] ?? {eff:0,actual:0,target:0} %}
                <div class="d-flex align-items-center justify-content-between p-2 rounded" style="background:#f8feff;">
                    <span class="fw-semibold small">{{ line.line_name }}</span>
                    <div class="d-flex align-items-center gap-2">
                        <div class="bar-wrap" style="width:50px;">
                            <div class="bar-fill {% if ls.eff >= 90 %}bg-success{% elseif ls.eff >= 70 %}bg-warning{% else %}bg-danger{% endif %}" style="width:{{ ls.eff > 100 ? 100 : ls.eff }}%"></div>
                        </div>
                        <small class="fw-bold">{{ ls.eff }}%</small>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <div class="text-center py-3 text-muted small">No lines registered yet.</div>
            {% endif %}
        </div>
    </div>
</div>
{% endif %}


{# ═══════════════════════════════════════
   2. LINE MANAGEMENT
═══════════════════════════════════════ #}
{% if activeTab == 'lines' %}
<div class="card glow-card border-0 p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h5 class="fw-bold text-info mb-0">Line Registry</h5>
            <small class="text-muted">Manage all sewing production lines</small></div>
        <button class="btn btn-info text-white btn-sm no-print" data-bs-toggle="modal" data-bs-target="#createLineModal">
            <i class="fas fa-plus me-1"></i>Register Line
        </button>
    </div>
    {% if lines|length > 0 %}
    <div class="row g-2 mb-3">
        <div class="col-md-3"><div class="p-3 rounded" style="background:#f0fbff;border-left:4px solid #36b9cc;">
            <div class="small text-muted fw-bold">TOTAL LINES</div><div class="h4 fw-bold text-info mb-0">{{ lines|length }}</div></div></div>
        <div class="col-md-3"><div class="p-3 rounded" style="background:#f0fff8;border-left:4px solid #1cc88a;">
            <div class="small text-muted fw-bold">ACTIVE</div><div class="h4 fw-bold text-success mb-0">{{ lines|length }}</div></div></div>
        <div class="col-md-3"><div class="p-3 rounded" style="background:#f0f3ff;border-left:4px solid #4e73df;">
            <div class="small text-muted fw-bold">TOTAL OUTPUT</div><div class="h4 fw-bold text-primary mb-0">{{ totalActual }} pcs</div></div></div>
        <div class="col-md-3"><div class="p-3 rounded" style="background:#fff8e6;border-left:4px solid #f6c23e;">
            <div class="small text-muted fw-bold">OVERALL EFF.</div><div class="h4 fw-bold text-warning mb-0">{{ overallEff }}%</div></div></div>
    </div>
    {% endif %}
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light"><tr><th>#</th><th>Line Name</th><th>Status</th><th>Output Today</th><th>Efficiency</th><th class="no-print">Actions</th></tr></thead>
            <tbody>
            {% for line in lines %}
            {% set ls = lineStats[line.line_name] ?? {eff:0,actual:0,target:0,log_count:0} %}
            <tr>
                <td class="text-muted small">{{ loop.index }}</td>
                <td><strong>{{ line.line_name }}</strong></td>
                <td><span class="badge bg-success">ACTIVE</span></td>
                <td>{{ ls.actual }} pcs</td>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <div class="bar-wrap" style="width:70px;"><div class="bar-fill {% if ls.eff >= 90 %}bg-success{% elseif ls.eff >= 70 %}bg-warning{% else %}bg-info{% endif %}" style="width:{{ ls.eff > 100 ? 100 : ls.eff }}%"></div></div>
                        <span class="fw-bold small">{{ ls.eff }}%</span>
                    </div>
                </td>
                <td class="no-print"><button class="btn btn-outline-info btn-sm"><i class="fas fa-edit"></i></button></td>
            </tr>
            {% else %}
            <tr><td colspan="6" class="text-center text-muted py-5">
                <i class="fas fa-sitemap fa-3x mb-3 d-block opacity-25"></i>No lines registered yet.
            </td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
<div class="modal fade" id="createLineModal" tabindex="-1">
    <div class="modal-dialog">
        <form method="POST" action="{{ BASE_URL }}/sewing/lines" class="modal-content">
            {{ csrf_field() | raw }}<input type="hidden" name="action" value="create_line">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-plus me-2"></i>Register Sewing Line</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Line Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" name="line_name" placeholder="e.g. Line 01 – Polo Shirts" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-info text-white"><i class="fas fa-save me-1"></i>Register Line</button>
            </div>
        </form>
    </div>
</div>
{% endif %}


{# ═══════════════════════════════════════
   3. INPUT MANAGEMENT
═══════════════════════════════════════ #}
{% if activeTab == 'input' %}
<div class="row g-3">
    <div class="col-md-4">
        <div class="card glow-card border-0 p-4">
            <h5 class="fw-bold text-info mb-3"><i class="fas fa-sign-in-alt me-2"></i>Log Bundle Input</h5>
            <form method="POST" action="{{ BASE_URL }}/sewing/input">
                {{ csrf_field() | raw }}<input type="hidden" name="action" value="log_input">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Sewing Line <span class="text-danger">*</span></label>
                    <select class="form-select form-select-sm" name="line_id" required>
                        <option value="">— Select Line —</option>
                        {% for line in lines %}<option value="{{ line.production_line_id }}">{{ line.line_name }}</option>{% endfor %}
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Style</label>
                    <select class="form-select form-select-sm" name="style_id">
                        <option value="">— Select Style —</option>
                        {% for s in styles %}<option value="{{ s.style_id }}">{{ s.style_code }} – {{ s.style_name }}</option>{% endfor %}
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Production Order</label>
                    <select class="form-select form-select-sm" name="order_id">
                        <option value="">— Select Order —</option>
                        {% for o in orders %}<option value="{{ o.id }}">{{ o.po_number }}</option>{% endfor %}
                    </select>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold small">No. of Bundles <span class="text-danger">*</span></label>
                        <input type="number" class="form-control form-control-sm" name="bundle_count" min="1" placeholder="24" required>
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold small">Pcs/Bundle</label>
                        <input type="number" class="form-control form-control-sm" name="pcs_per_bundle" min="1" value="12">
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold small">Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control form-control-sm" name="input_date" value="{{ "now"|date("Y-m-d") }}" required>
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold small">Time</label>
                        <input type="time" class="form-control form-control-sm" name="input_time" value="{{ "now"|date("H:i") }}">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Remarks</label>
                    <textarea class="form-control form-control-sm" name="remarks" rows="2" placeholder="Optional..."></textarea>
                </div>
                <button type="submit" class="btn btn-info text-white w-100"><i class="fas fa-check me-1"></i>Register Bundle Input</button>
            </form>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card glow-card border-0 p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-info mb-0"><i class="fas fa-history me-2"></i>Bundle Input Summary</h5>
            </div>
            <div class="row g-2 mb-3">
                {% for line in lines %}
                <div class="col-md-4">
                    <div class="p-3 rounded" style="background:#f0fbff;border:1px solid #d0f0f8;">
                        <div class="small fw-bold text-info">{{ line.line_name }}</div>
                        <div class="h5 fw-bold mb-0">0 <small class="text-muted fw-normal fs-6">bundles</small></div>
                        <div class="small text-muted">0 pcs input today</div>
                    </div>
                </div>
                {% else %}
                <div class="col-12 text-center text-muted small py-2">No active lines yet.</div>
                {% endfor %}
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr><th>Date/Time</th><th>Line</th><th>Style</th><th>Bundles</th><th>Total Pcs</th></tr>
                    </thead>
                    <tbody>
                        <tr><td colspan="5" class="text-center text-muted py-4">
                            <i class="fas fa-inbox fa-2x mb-2 d-block opacity-25"></i>
                            No input records yet.
                        </td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endif %}


{# ═══════════════════════════════════════
   4. PRODUCTION (Hourly Logs)
═══════════════════════════════════════ #}
{% if activeTab == 'production' %}
<div class="card glow-card border-0 p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h5 class="fw-bold text-info mb-0"><i class="fas fa-tshirt me-2"></i>Hourly Sewing Logs</h5>
            <small class="text-muted">Track actual vs. target output per line per hour</small></div>
        <button class="btn btn-info text-white btn-sm no-print" data-bs-toggle="modal" data-bs-target="#logProductionModal">
            <i class="fas fa-plus me-1"></i>Log Hourly Output
        </button>
    </div>
    <div class="row g-2 mb-3">
        <div class="col-md-3"><div class="p-3 rounded" style="background:#f0fbff;"><div class="small text-muted fw-bold">TOTAL ACTUAL</div><div class="h4 fw-bold text-info mb-0">{{ totalActual }} pcs</div></div></div>
        <div class="col-md-3"><div class="p-3 rounded" style="background:#fff8e6;"><div class="small text-muted fw-bold">TOTAL TARGET</div><div class="h4 fw-bold text-warning mb-0">{{ totalTarget }} pcs</div></div></div>
        <div class="col-md-3"><div class="p-3 rounded" style="background:#f0fff8;"><div class="small text-muted fw-bold">OVERALL EFF.</div><div class="h4 fw-bold text-success mb-0">{{ overallEff }}%</div></div></div>
        <div class="col-md-3"><div class="p-3 rounded" style="background:#fdf0f0;"><div class="small text-muted fw-bold">LOG ENTRIES</div><div class="h4 fw-bold text-danger mb-0">{{ performance|length }}</div></div></div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr><th>#</th><th>Line</th><th>Hour</th><th>Target</th><th>Actual</th><th>Efficiency</th><th>Status</th></tr>
            </thead>
            <tbody>
            {% for p in performance %}
            {% set eff = p.hourly_target > 0 ? ((p.hourly_actual / p.hourly_target) * 100)|round : 0 %}
            {% set effCapped = eff > 100 ? 100 : eff %}
            <tr>
                <td class="text-muted small">{{ loop.index }}</td>
                <td><span class="badge bg-light text-dark border">{{ p.line_name ?? 'Unknown' }}</span></td>
                <td>{{ p.recorded_hour ?? '—' }}</td>
                <td>{{ p.hourly_target ?? 0 }}</td>
                <td class="fw-bold">{{ p.hourly_actual ?? 0 }}</td>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <div class="bar-wrap" style="width:80px;">
                            <div class="bar-fill {% if eff >= 90 %}bg-success{% elseif eff >= 70 %}bg-warning{% else %}bg-danger{% endif %}" style="width:{{ effCapped }}%"></div>
                        </div>
                        <small class="fw-bold">{{ eff }}%</small>
                    </div>
                </td>
                <td>
                    {% if eff >= 90 %}<span class="badge bg-success"><span class="tl-dot tl-green"></span>Excellent</span>
                    {% elseif eff >= 70 %}<span class="badge bg-warning text-dark"><span class="tl-dot tl-yellow"></span>Good</span>
                    {% else %}<span class="badge bg-danger"><span class="tl-dot tl-red"></span>Low</span>{% endif %}
                </td>
            </tr>
            {% else %}
            <tr><td colspan="7" class="text-center text-muted py-5">
                <i class="fas fa-chart-line fa-3x mb-3 d-block opacity-25"></i>
                No hourly logs yet.
            </td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
<div class="modal fade" id="logProductionModal" tabindex="-1">
    <div class="modal-dialog">
        <form method="POST" action="{{ BASE_URL }}/sewing/production" class="modal-content">
            {{ csrf_field() | raw }}<input type="hidden" name="action" value="log_production">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-plus me-2"></i>Log Hourly Output</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Sewing Line <span class="text-danger">*</span></label>
                    <select class="form-select" name="line_id" required>
                        <option value="">— Select Line —</option>
                        {% for l in lines %}<option value="{{ l.production_line_id }}">{{ l.line_name }}</option>{% endfor %}
                    </select>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold small">Hourly Target <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" name="hourly_target" min="1" placeholder="80" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold small">Hourly Actual <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" name="hourly_actual" min="0" placeholder="74" required>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Recorded Hour</label>
                    <input type="time" class="form-control" name="recorded_hour" value="{{ "now"|date("H:i") }}">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-info text-white"><i class="fas fa-save me-1"></i>Save Log</button>
            </div>
        </form>
    </div>
</div>
{% endif %}


{# ═══════════════════════════════════════
   5. OUTPUT MANAGEMENT
═══════════════════════════════════════ #}
{% if activeTab == 'output' %}
<div class="card glow-card border-0 p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h5 class="fw-bold text-info mb-0"><i class="fas fa-sign-out-alt me-2"></i>Output Management</h5>
            <small class="text-muted">Garments completed per line — dispatched to Washing/Finishing</small></div>
        <button class="btn btn-info text-white btn-sm no-print" data-bs-toggle="modal" data-bs-target="#logOutputModal">
            <i class="fas fa-plus me-1"></i>Log Output
        </button>
    </div>
    <div class="row g-3 mb-4">
        {% for line in lines %}
        {% set ls = lineStats[line.line_name] ?? {eff:0,actual:0,target:0,log_count:0} %}
        {% set effCapped = ls.eff > 100 ? 100 : ls.eff %}
        <div class="col-md-4">
            <div class="card border-0 p-3 {% if ls.eff >= 90 %}wip-card wip-success{% elseif ls.eff >= 70 %}wip-card wip-warning{% else %}wip-card{% endif %}">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <strong class="small">{{ line.line_name }}</strong>
                    <span class="badge {% if ls.eff >= 90 %}bg-success{% elseif ls.eff >= 70 %}bg-warning text-dark{% else %}bg-danger{% endif %}">{{ ls.eff }}%</span>
                </div>
                <div class="h5 fw-bold mb-1">{{ ls.actual }} <small class="text-muted fw-normal fs-6">pcs out</small></div>
                <div class="bar-wrap mb-1">
                    <div class="bar-fill {% if ls.eff >= 90 %}bg-success{% elseif ls.eff >= 70 %}bg-warning{% else %}bg-danger{% endif %}" style="width:{{ effCapped }}%"></div>
                </div>
                <div class="small text-muted">Target: {{ ls.target }} pcs · Logged: {{ ls.log_count }} hrs</div>
            </div>
        </div>
        {% else %}
        <div class="col-12 text-center text-muted py-3">No lines registered.</div>
        {% endfor %}
    </div>
    <h6 class="fw-bold text-muted mb-2">Output Log</h6>
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light"><tr><th>Date</th><th>Line</th><th>Output Qty</th><th>Destination</th></tr></thead>
            <tbody>
            {% for p in performance %}
            <tr>
                <td class="small text-muted">{{ p.created_at ?? '—' }}</td>
                <td><span class="badge bg-light text-dark border">{{ p.line_name ?? '—' }}</span></td>
                <td class="fw-bold">{{ p.hourly_actual ?? 0 }} pcs</td>
                <td><span class="badge bg-primary bg-opacity-10 text-primary">Washing</span></td>
            </tr>
            {% else %}
            <tr><td colspan="4" class="text-center text-muted py-4">No output records yet.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
<div class="modal fade" id="logOutputModal" tabindex="-1">
    <div class="modal-dialog">
        <form method="POST" action="{{ BASE_URL }}/sewing/output" class="modal-content">
            {{ csrf_field() | raw }}<input type="hidden" name="action" value="log_output">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">Log Sewing Output</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label fw-semibold small">Line</label>
                    <select class="form-select" name="line_id">
                        <option value="">— Select —</option>
                        {% for l in lines %}<option value="{{ l.production_line_id }}">{{ l.line_name }}</option>{% endfor %}
                    </select></div>
                <div class="mb-3"><label class="form-label fw-semibold small">Output Qty</label>
                    <input type="number" class="form-control" name="output_qty" min="1" required></div>
                <div class="mb-3"><label class="form-label fw-semibold small">Destination</label>
                    <select class="form-select" name="destination">
                        <option>Washing</option><option>Finishing</option><option>QC Inspection</option>
                    </select></div>
                <div class="mb-3"><label class="form-label fw-semibold small">Date</label>
                    <input type="date" class="form-control" name="output_date" value="{{ "now"|date("Y-m-d") }}"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-info text-white">Save</button>
            </div>
        </form>
    </div>
</div>
{% endif %}


{# ═══════════════════════════════════════
   6. WIP — Work In Progress
═══════════════════════════════════════ #}
{% if activeTab == 'wip' %}
<div class="card glow-card border-0 p-4 mb-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h5 class="fw-bold text-info mb-0"><i class="fas fa-spinner me-2"></i>WIP Status Board</h5>
            <small class="text-muted">Real-time panel status inside sewing lines</small></div>
        <span class="badge bg-info bg-opacity-10 text-info px-3 py-2">Updated: {{ "now"|date("H:i") }}</span>
    </div>
    {% if lines|length > 0 %}
    <div class="row g-3">
        {% for line in lines %}
        {% set ls = lineStats[line.line_name] ?? {eff:0,actual:0,target:0,wip:0,wip_pct:0} %}
        <div class="col-md-4">
            <div class="card border-0 p-4 {% if ls.wip_pct > 40 %}wip-card wip-danger{% elseif ls.wip_pct > 20 %}wip-card wip-warning{% else %}wip-card wip-success{% endif %}">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h6 class="fw-bold mb-1">{{ line.line_name }}</h6>
                        <span class="badge {% if ls.wip_pct > 40 %}bg-danger{% elseif ls.wip_pct > 20 %}bg-warning text-dark{% else %}bg-success{% endif %}">
                            {% if ls.wip_pct > 40 %}High WIP{% elseif ls.wip_pct > 20 %}Moderate{% else %}Normal{% endif %}
                        </span>
                    </div>
                    <div class="text-end">
                        <div class="h4 fw-bold mb-0 {% if ls.wip_pct > 40 %}text-danger{% elseif ls.wip_pct > 20 %}text-warning{% else %}text-success{% endif %}">{{ ls.wip }}</div>
                        <small class="text-muted">pcs WIP</small>
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-4 text-center"><div class="small text-muted">Input</div><div class="fw-bold text-primary">{{ ls.target }}</div></div>
                    <div class="col-4 text-center"><div class="small text-muted">Output</div><div class="fw-bold text-success">{{ ls.actual }}</div></div>
                    <div class="col-4 text-center"><div class="small text-muted">Balance</div><div class="fw-bold text-danger">{{ ls.wip }}</div></div>
                </div>
                {% set wipCapped = ls.wip_pct > 100 ? 100 : ls.wip_pct %}
                <div class="bar-wrap">
                    <div class="bar-fill {% if ls.wip_pct > 40 %}bg-danger{% elseif ls.wip_pct > 20 %}bg-warning{% else %}bg-success{% endif %}" style="width:{{ wipCapped }}%"></div>
                </div>
                <div class="d-flex justify-content-between mt-1">
                    <small class="text-muted">WIP %</small>
                    <small class="fw-bold">{{ ls.wip_pct }}%</small>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="text-center py-5 text-muted">
        <i class="fas fa-spinner fa-3x mb-3 d-block opacity-25"></i>No lines registered.
    </div>
    {% endif %}
    <div class="mt-4 p-3 rounded" style="background:#f8f9fa;">
        <h6 class="fw-bold mb-2 small">WIP Legend</h6>
        <div class="d-flex gap-4 flex-wrap small">
            <span><span class="tl-dot tl-green"></span><strong>Normal</strong> — WIP &lt;20%</span>
            <span><span class="tl-dot tl-yellow"></span><strong>Moderate</strong> — WIP 20–40%</span>
            <span><span class="tl-dot tl-red"></span><strong>High</strong> — WIP &gt;40%</span>
        </div>
    </div>
</div>
{% endif %}


