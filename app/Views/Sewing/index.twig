                {{ csrf_field() | raw }}<input type="hidden" name="action" value="log_qc">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Sewing Line <span class="text-danger">*</span></label>
                    <select class="form-select form-select-sm" name="line_id" required>
                        <option value="">— Select Line —</option>
                        {% for l in lines %}<option value="{{ l.production_line_id }}">{{ l.line_name }}</option>{% endfor %}
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Defect Type <span class="text-danger">*</span></label>
                    <select class="form-select form-select-sm" name="defect_type" required>
                        <option value="">— Select —</option>
                        <option>Stitching Break</option><option>Puckering</option>
                        <option>Skip Stitch</option><option>Uneven Seam</option>
                        <option>Shading</option><option>Measurement Error</option>
                        <option>Fabric Damage</option><option>Button/Snap Issue</option><option>Other</option>
                    </select>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold small">Inspected</label>
                        <input type="number" class="form-control form-control-sm" name="qty_inspected" min="1" placeholder="100" required>
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold small">Defects Found</label>
                        <input type="number" class="form-control form-control-sm" name="qty_defects" min="0" placeholder="3" required>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Severity</label>
                    <select class="form-select form-select-sm" name="severity">
                        <option value="minor">Minor</option>
                        <option value="major">Major</option>
                        <option value="critical">Critical</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Inspector</label>
                    <input type="text" class="form-control form-control-sm" name="inspector_name" placeholder="Inspector name">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Inspection Date</label>
                    <input type="date" class="form-control form-control-sm" name="inspection_date" value="{{ "now"|date("Y-m-d") }}">
                </div>
                <button type="submit" class="btn btn-info text-white w-100"><i class="fas fa-save me-1"></i>Save QC Record</button>
            </form>
        </div>
    </div>
    <div class="col-md-8">
        <div class="row g-3 mb-3">
            <div class="col-md-3"><div class="card border-0 p-3 text-center" style="background:#f0fff8;border-top:3px solid #1cc88a;">
                <div class="small text-muted fw-bold">PASS RATE</div><div class="h4 fw-bold text-success mb-0">—</div></div></div>
            <div class="col-md-3"><div class="card border-0 p-3 text-center" style="background:#fdf0f0;border-top:3px solid #e74a3b;">
                <div class="small text-muted fw-bold">AVG DHU</div><div class="h4 fw-bold text-danger mb-0">—</div></div></div>
            <div class="col-md-3"><div class="card border-0 p-3 text-center" style="background:#fff8e6;border-top:3px solid #f6c23e;">
                <div class="small text-muted fw-bold">INSPECTIONS</div><div class="h4 fw-bold text-warning mb-0">0</div></div></div>
            <div class="col-md-3"><div class="card border-0 p-3 text-center" style="background:#f0f3ff;border-top:3px solid #4e73df;">
                <div class="small text-muted fw-bold">CRITICAL</div><div class="h4 fw-bold text-primary mb-0">0</div></div></div>
        </div>
        <div class="card glow-card border-0 p-4">
            <h6 class="fw-bold text-info mb-3">QC Inspection Log — Traffic Light System</h6>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr><th>Date</th><th>Line</th><th>Defect</th><th>Inspected</th><th>Defects</th><th>DHU%</th><th>Severity</th></tr>
                    </thead>
                    <tbody>
                        <tr><td colspan="7" class="text-center text-muted py-5">
                            <i class="fas fa-clipboard-check fa-3x mb-2 d-block opacity-25"></i>
                            No QC records yet. Use the form to log inspections.
                        </td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card border-0 p-3 mt-3" style="background:#fffbf0;">
            <h6 class="fw-bold mb-2 small text-warning"><i class="fas fa-info-circle me-1"></i>DHU Thresholds (RMG Standard)</h6>
            <div class="d-flex gap-3 flex-wrap small">
                <span><span class="tl-dot tl-green"></span><strong>Green</strong> DHU &lt;2.5%</span>
                <span><span class="tl-dot tl-yellow"></span><strong>Yellow</strong> 2.5–5%</span>
                <span><span class="tl-dot tl-red"></span><strong>Red</strong> &gt;5%</span>
            </div>
        </div>
    </div>
</div>
{% endif %}


