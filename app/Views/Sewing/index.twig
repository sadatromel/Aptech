{# ═══════════════════════════════════════
   11. PRODUCTIVITY
═══════════════════════════════════════ #}
{% if activeTab == 'productivity' %}
<div class="card glow-card border-0 p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h5 class="fw-bold text-info mb-0"><i class="fas fa-tachometer-alt me-2"></i>Productivity Dashboard</h5>
            <small class="text-muted">SMV tracking &amp; line efficiency rates</small></div>
    </div>
    <h6 class="fw-bold text-muted mb-3">Line Efficiency Overview</h6>
    <div class="row g-3 mb-4">
        {% for line in lines %}
        {% set ls = lineStats[line.line_name] ?? {eff:0,actual:0,target:0} %}
        {% set effCapped = ls.eff > 100 ? 100 : ls.eff %}
        <div class="col-md-4 col-lg-3">
            <div class="card border-0 p-3 text-center" style="background:#f8f9fa;">
                <div class="fw-bold small text-info mb-2">{{ line.line_name }}</div>
                <div class="position-relative mx-auto mb-2" style="width:100px;height:55px;">
                    <svg viewBox="0 0 100 55" width="100" height="55">
                        <path d="M10,50 A40,40 0 0,1 90,50" fill="none" stroke="#e9ecef" stroke-width="10" stroke-linecap="round"/>
                        <path d="M10,50 A40,40 0 0,1 90,50" fill="none"
                              stroke="{% if ls.eff >= 90 %}#1cc88a{% elseif ls.eff >= 70 %}#f6c23e{% else %}#e74a3b{% endif %}"
                              stroke-width="10" stroke-linecap="round"
                              stroke-dasharray="{{ (effCapped / 100 * 125.66)|round }}, 125.66"/>
                    </svg>
                </div>
                <div class="h4 fw-bold mb-0 {% if ls.eff >= 90 %}text-success{% elseif ls.eff >= 70 %}text-warning{% else %}text-danger{% endif %}">{{ ls.eff }}%</div>
                <div class="small text-muted">{{ ls.actual }} / {{ ls.target }} pcs</div>
                <span class="badge mt-1 {% if ls.eff >= 90 %}bg-success{% elseif ls.eff >= 70 %}bg-warning text-dark{% else %}bg-danger{% endif %}">
                    {% if ls.eff >= 90 %}Excellent{% elseif ls.eff >= 70 %}Good{% else %}Low{% endif %}
                </span>
            </div>
        </div>
        {% else %}
        <div class="col-12 text-center text-muted py-4">
            <i class="fas fa-tachometer-alt fa-3x mb-2 d-block opacity-25"></i>No lines registered.
        </div>
        {% endfor %}
    </div>
    <h6 class="fw-bold text-muted mb-3">SMV Tracker — Line Summary</h6>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr><th>Line</th><th>Log Entries</th><th>Total Target</th><th>Total Actual</th><th>Efficiency</th><th>Variance</th><th>Rating</th></tr>
            </thead>
            <tbody>
            {% for line in lines %}
            {% set ls = lineStats[line.line_name] ?? {eff:0,actual:0,target:0,log_count:0} %}
            {% set effCapped = ls.eff > 100 ? 100 : ls.eff %}
            {% set variance = ls.actual - ls.target %}
            <tr>
                <td><strong>{{ line.line_name }}</strong></td>
                <td>{{ ls.log_count }}</td>
                <td>{{ ls.target }}</td>
                <td>{{ ls.actual }}</td>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <div class="bar-wrap" style="width:80px;"><div class="bar-fill {% if ls.eff >= 90 %}bg-success{% elseif ls.eff >= 70 %}bg-warning{% else %}bg-danger{% endif %}" style="width:{{ effCapped }}%"></div></div>
                        <strong>{{ ls.eff }}%</strong>
                    </div>
                </td>
                <td class="{% if variance >= 0 %}text-success{% else %}text-danger{% endif %} fw-bold">
                    {{ variance >= 0 ? '+' : '' }}{{ variance }}
                </td>
                <td><span class="badge {% if ls.eff >= 90 %}bg-success{% elseif ls.eff >= 70 %}bg-warning text-dark{% else %}bg-danger{% endif %}">
                    {% if ls.eff >= 90 %}Excellent{% elseif ls.eff >= 70 %}Good{% else %}Needs Improvement{% endif %}
                </span></td>
            </tr>
            {% else %}
            <tr><td colspan="7" class="text-center text-muted py-4">Register lines and log production to see SMV tracking.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}


{# ═══════════════════════════════════════
   12. REPORTS
═══════════════════════════════════════ #}
{% if activeTab == 'reports' %}
<div class="row g-3">
    <div class="col-12 no-print">
        <div class="card glow-card border-0 p-3 d-flex flex-row align-items-center justify-content-between">
            <div>
                <h5 class="fw-bold text-info mb-0"><i class="fas fa-file-invoice me-2"></i>Sewing Reports</h5>
                <small class="text-muted">Export efficiency, DHU audits, output &amp; operator logs</small>
            </div>
            <div class="d-flex gap-2">
                <button onclick="window.print()" class="btn btn-outline-info btn-sm"><i class="fas fa-print me-1"></i>Print Report</button>
                <a href="{{ BASE_URL }}/sewing/production" class="btn btn-info text-white btn-sm"><i class="fas fa-plus me-1"></i>Log Data</a>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="card glow-card border-0 p-4">
            <div class="report-section-title"><i class="fas fa-chart-bar me-2"></i>Summary — {{ "now"|date("d M Y") }}</div>
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card border-0 p-3 text-center" style="background:linear-gradient(135deg,#36b9cc,#258391);color:white;border-radius:12px;">
                        <div class="h3 fw-bold mb-0">{{ lines|length }}</div>
                        <div class="small opacity-75">Active Lines</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 p-3 text-center" style="background:linear-gradient(135deg,#1cc88a,#13855c);color:white;border-radius:12px;">
                        <div class="h3 fw-bold mb-0">{{ totalActual }}</div>
                        <div class="small opacity-75">Total Output (pcs)</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 p-3 text-center" style="background:linear-gradient(135deg,{% if overallEff >= 90 %}#1cc88a,#13855c{% elseif overallEff >= 70 %}#f6c23e,#c49a0f{% else %}#e74a3b,#b52b1e{% endif %});color:white;border-radius:12px;">
                        <div class="h3 fw-bold mb-0">{{ overallEff }}%</div>
                        <div class="small opacity-75">Overall Efficiency</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 p-3 text-center" style="background:linear-gradient(135deg,#4e73df,#2e59d9);color:white;border-radius:12px;">
                        <div class="h3 fw-bold mb-0">{{ performance|length }}</div>
                        <div class="small opacity-75">Log Entries</div>
                    </div>
                </div>
            </div>

            <div class="report-section-title"><i class="fas fa-table me-2"></i>Line Efficiency Report</div>
            <div class="table-responsive mb-4">
                <table class="table table-bordered align-middle">
                    <thead class="table-info">
                        <tr><th>Line</th><th>Log Hrs</th><th>Target</th><th>Actual</th><th>Efficiency</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                    {% for line in lines %}
                    {% set ls = lineStats[line.line_name] ?? {eff:0,actual:0,target:0,log_count:0} %}
                    {% set effCapped = ls.eff > 100 ? 100 : ls.eff %}
                    <tr>
                        <td><strong>{{ line.line_name }}</strong></td>
                        <td>{{ ls.log_count }}</td>
                        <td>{{ ls.target }}</td>
                        <td>{{ ls.actual }}</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="bar-wrap" style="width:80px;"><div class="bar-fill {% if ls.eff >= 90 %}bg-success{% elseif ls.eff >= 70 %}bg-warning{% else %}bg-danger{% endif %}" style="width:{{ effCapped }}%"></div></div>
                                <strong>{{ ls.eff }}%</strong>
                            </div>
                        </td>
                        <td><span class="badge {% if ls.eff >= 90 %}bg-success{% elseif ls.eff >= 70 %}bg-warning text-dark{% else %}bg-danger{% endif %}">
                            {% if ls.eff >= 90 %}Excellent{% elseif ls.eff >= 70 %}Good{% else %}Low{% endif %}
                        </span></td>
                    </tr>
                    {% else %}
                    <tr><td colspan="6" class="text-center text-muted py-3">No production data logged yet.</td></tr>
                    {% endfor %}
                    </tbody>
                    {% if lines|length > 0 %}
                    <tfoot class="table-light fw-bold">
                        <tr><td>TOTAL</td><td>{{ performance|length }}</td><td>{{ totalTarget }}</td><td>{{ totalActual }}</td>
                            <td colspan="2"><span class="badge {% if overallEff >= 90 %}bg-success{% elseif overallEff >= 70 %}bg-warning text-dark{% else %}bg-danger{% endif %}">{{ overallEff }}% Overall</span></td></tr>
                    </tfoot>
                    {% endif %}
                </table>
            </div>

            {% if performance|length > 0 %}
            <div class="report-section-title"><i class="fas fa-clock me-2"></i>Hourly Production Detail</div>
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle">
                    <thead class="table-light">
                        <tr><th>#</th><th>Line</th><th>Hour</th><th>Target</th><th>Actual</th><th>Variance</th><th>Efficiency</th></tr>
                    </thead>
                    <tbody>
                    {% for p in performance %}
                    {% set eff = p.hourly_target > 0 ? ((p.hourly_actual / p.hourly_target)*100)|round : 0 %}
                    {% set var = p.hourly_actual - p.hourly_target %}
                    <tr {% if eff < 70 %}class="table-danger"{% elseif eff < 90 %}class="table-warning"{% endif %}>
                        <td class="text-muted small">{{ loop.index }}</td>
                        <td>{{ p.line_name ?? '—' }}</td>
                        <td>{{ p.recorded_hour ?? '—' }}</td>
                        <td>{{ p.hourly_target }}</td>
                        <td class="fw-bold">{{ p.hourly_actual }}</td>
                        <td class="{% if var >= 0 %}text-success{% else %}text-danger{% endif %}">{{ var >= 0 ? '+' : '' }}{{ var }}</td>
                        <td><strong>{{ eff }}%</strong></td>
                    </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}

            <div class="mt-3 p-3 rounded" style="background:#f8f9fa;">
                <div class="row">
                    <div class="col-md-6 small text-muted">
                        <strong>Generated:</strong> {{ "now"|date("d M Y, H:i") }}<br>
                        <strong>Report:</strong> Daily Sewing Efficiency Report
                    </div>
                    <div class="col-md-6 text-end small text-muted">
                        <strong>System:</strong> Aptech RMG ERP<br>
                        <strong>Module:</strong> Sewing Control Center
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}

    </div>{# /col-12 #}
</div>{# /row #}
{% endblock %}
