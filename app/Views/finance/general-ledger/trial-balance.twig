{% extends 'layouts/app.twig' %}

{% block title %}Trial Balance{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Trial Balance Report</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/finance/reports">Financial Reports</a></li>
        <li class="breadcrumb-item active">Trial Balance</li>
    </ol>

    <!-- Multi-Parameter Search Toolbar -->
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 font-weight-bold"><i class="fas fa-filter text-primary me-2"></i>Trial Balance Parameters & Filters</h5>
        </div>
        <div class="card-body bg-light">
            <form method="GET" action="{{ BASE_URL }}/finance/reports/trial-balance" class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-primary mb-1">Company</label>
                    <select name="company" class="form-select form-select-sm">
                        <option value="Big Boss Corporation" {{ filters.company == 'Big Boss Corporation' ? 'selected' : '' }}>Biq Boss Corporation</option>
                        <option value="Aptech Garments Ltd" {{ filters.company == 'Aptech Garments Ltd' ? 'selected' : '' }}>Aptech Garments Ltd</option>
                        <option value="All Companies" {{ filters.company == 'All Companies' ? 'selected' : '' }}>All Companies</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <label class="form-label small fw-bold mb-1">A/C Year</label>
                    <select name="ac_year" class="form-select form-select-sm">
                        <option value="2025-2026" {{ filters.ac_year == '2025-2026' ? 'selected' : '' }}>2025-2026</option>
                        <option value="2026-2027" {{ filters.ac_year == '2026-2027' ? 'selected' : '' }}>2026-2027</option>
                        <option value="2024-2025" {{ filters.ac_year == '2024-2025' ? 'selected' : '' }}>2024-2025</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold mb-1">Main Group</label>
                    <select name="main_group" class="form-select form-select-sm">
                        <option value="">All Main Groups</option>
                        <option value="Asset" {{ filters.main_group == 'Asset' ? 'selected' : '' }}>Asset</option>
                        <option value="Liability" {{ filters.main_group == 'Liability' ? 'selected' : '' }}>Liability</option>
                        <option value="Equity" {{ filters.main_group == 'Equity' ? 'selected' : '' }}>Equity</option>
                        <option value="Income" {{ filters.main_group == 'Income' ? 'selected' : '' }}>Income</option>
                        <option value="Expense" {{ filters.main_group == 'Expense' ? 'selected' : '' }}>Expense</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold mb-1">Sub Group</label>
                    <input type="text" name="sub_group" class="form-control form-control-sm" placeholder="Write/Double Click" value="{{ filters.sub_group }}">
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold mb-1">Sub Sub Group</label>
                    <input type="text" name="sub_sub_group" class="form-control form-control-sm" placeholder="Write/Double Click" value="{{ filters.sub_sub_group }}">
                </div>
                <div class="col-md-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-bold mb-0">A/C Code</label>
                        <label class="small text-muted mb-0"><input type="checkbox" name="with_sub_code" value="1" {{ filters.with_sub_code ? 'checked' : '' }}> With Sub Code</label>
                    </div>
                    <input type="text" name="account_code" class="form-control form-control-sm" placeholder="Write/Double Click" value="{{ filters.account_code }}">
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold mb-1">Balance Type</label>
                    <select name="balance_type" class="form-select form-select-sm">
                        <option value="without_zero" {{ filters.balance_type == 'without_zero' ? 'selected' : '' }}>Without (0) Bal</option>
                        <option value="with_zero" {{ filters.balance_type == 'with_zero' ? 'selected' : '' }}>With (0) Bal</option>
                        <option value="debit_only" {{ filters.balance_type == 'debit_only' ? 'selected' : '' }}>Debit Balances Only</option>
                        <option value="credit_only" {{ filters.balance_type == 'credit_only' ? 'selected' : '' }}>Credit Balances Only</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-primary mb-1">Date Range</label>
                    <div class="input-group input-group-sm">
                        <input type="date" name="date_from" class="form-control" value="{{ filters.date_from }}">
                        <span class="input-group-text bg-white">To</span>
                        <input type="date" name="date_to" class="form-control" value="{{ filters.date_to }}">
                    </div>
                </div>
                <div class="col-md-2 d-flex">
                    <button type="submit" class="btn btn-primary btn-sm me-1 flex-grow-1"><i class="fas fa-search me-1"></i> Filter</button>
                    <a href="{{ BASE_URL }}/finance/reports/trial-balance" class="btn btn-outline-secondary btn-sm me-1" title="Reset"><i class="fas fa-redo"></i></a>
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="window.print()" title="Print"><i class="fas fa-print"></i></button>
                </div>
            </form>
        </div>
    </div>

    <!-- Trial Balance Statement Card -->
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <div>
                <h5 class="mb-0 font-weight-bold">Trial Balance Summary Statement</h5>
                <small class="text-muted">Company: <strong>{{ filters.company }}</strong> | A/C Year: <strong>{{ filters.ac_year }}</strong> | As of {{ as_of_date|date('F j, Y') }}</small>
            </div>
            <span class="badge {{ is_balanced ? 'bg-success' : 'bg-danger' }} fs-6 px-3 py-2">
                {{ is_balanced ? 'Balanced' : 'Imbalanced' }}
            </span>
        </div>
        <div class="card-body p-4">
            {% if not is_balanced %}
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle me-2"></i><strong>Warning:</strong> Trial balance debit & credit amounts are imbalanced by ${{ (total_debits - total_credits)|abs|number_format(2) }}
            </div>
            {% endif %}
            
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr class="text-uppercase font-size-12 text-muted">
                            <th>Account Code</th>
                            <th>Account Name</th>
                            <th>Account Type</th>
                            <th class="text-end">Opening Balance ($)</th>
                            <th class="text-end">Debit Balance ($)</th>
                            <th class="text-end">Credit Balance ($)</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in trial_balance %}
                        <tr>
                            <td class="fw-bold text-primary">{{ row.account_code }}</td>
                            <td class="fw-bold">{{ row.account_name }}</td>
                            <td><span class="badge bg-light text-dark">{{ row.account_type }}</span></td>
                            <td class="text-end font-weight-bold text-dark">
                                {% if row.opening_balance != 0 %}
                                    ${{ row.opening_balance|number_format(2) }}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td class="text-end fw-bold text-success">
                                {% if row.balance > 0 %}
                                    ${{ row.balance|number_format(2) }}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td class="text-end fw-bold text-danger">
                                {% if row.balance < 0 %}
                                    ${{ row.balance|abs|number_format(2) }}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                        </tr>
                        {% else %}
                        <tr><td colspan="6" class="text-center py-4 text-muted">No accounts found matching the search criteria.</td></tr>
                        {% endfor %}
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold table-active fs-6">
                            <td colspan="3" class="text-end text-uppercase">Grand Total</td>
                            <td class="text-end text-dark">${{ total_opening|number_format(2) }}</td>
                            <td class="text-end text-success">${{ total_debits|number_format(2) }}</td>
                            <td class="text-end text-danger">${{ total_credits|number_format(2) }}</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
