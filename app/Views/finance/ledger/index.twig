{% extends "layouts/app.twig" %}

{% block title %}General Ledger{% endblock %}

{% block content %}
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">General Ledger</h1>
        <div class="btn-toolbar mb-2 mb-md-0">
            <a href="{{ BASE_URL }}/finance/transactions/create" class="btn btn-sm btn-primary">
                <i class="fas fa-plus"></i> Journal Entry
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Ref</th>
                    <th>Account</th>
                    <th>Description</th>
                    <th class="text-end">Debit</th>
                    <th class="text-end">Credit</th>
                </tr>
            </thead>
            <tbody>
                {% for t in transactions %}
                <tr>
                    <td>{{ t.transaction_date }}</td>
                    <td>{{ t.reference }}</td>
                    <td>{{ t.account_code }} - {{ t.account_name }}</td>
                    <td>{{ t.description }}</td>
                    <td class="text-end">{{ t.debit != 0 ? t.debit|number_format(2) : '' }}</td>
                    <td class="text-end">{{ t.credit != 0 ? t.credit|number_format(2) : '' }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
