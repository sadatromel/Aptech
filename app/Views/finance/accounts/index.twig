{% extends "layouts/app.twig" %}

{% block content %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="card-title">Chart of Accounts</h4>
                <a href="{{ BASE_URL }}/finance/accounts/create" class="btn btn-primary">+ New Account</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Account Name</th>
                                <th>Type</th>
                                <th>Is Group</th>
                                <th>Status</th>
                                <th>Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for account in accounts %}
                            <tr>
                                <td>{{ account.account_code }}</td>
                                <td>{{ account.account_name }}</td>
                                <td>
                                    {% if account.type == 'Asset' %}<span class="badge bg-success">Asset</span>{% endif %}
                                    {% if account.type == 'Liability' %}<span class="badge bg-warning">Liability</span>{% endif %}
                                    {% if account.type == 'Revenue' %}<span class="badge bg-info">Income</span>{% endif %}
                                    {% if account.type == 'Expense' %}<span class="badge bg-danger">Expense</span>{% endif %}
                                    {% if account.type == 'Equity' %}<span class="badge bg-secondary">Equity</span>{% endif %}
                                </td>
                                <td>
                                    {% if account.is_group %}
                                        <span class="badge bg-dark">Group</span>
                                    {% else %}
                                        Ledger
                                    {% endif %}
                                </td>
                                <td>{{ account.status }}</td>
                                <td>{{ account.created_at|date('d M Y') }}</td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="6" class="text-center">No accounts found.</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
