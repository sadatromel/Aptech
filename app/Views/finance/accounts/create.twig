{% extends "layouts/app.twig" %}

{% block content %}
<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="card-title">Create New Account</h4>
                <a href="{{ BASE_URL }}/finance/accounts" class="btn btn-secondary btn-sm">Back</a>
            </div>
            <div class="card-body">
                {% if error %}
                    <div class="alert alert-danger">{{ error }}</div>
                {% endif %}
                
                <form action="{{ BASE_URL }}/finance/accounts/store" method="POST">
    {{ csrf_field() | raw }}
                    <div class="row mb-3">
                        <label class="form-label">Account Name</label>
                        <input type="text" name="account_name" class="form-control" placeholder="e.g., Office Rent, HDFC Bank" required>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Account Code (Optional)</label>
                             {# Generate random or allow user input #}
                            <input type="text" name="account_code" class="form-control" placeholder="e.g., 2005" required> 
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Type</label>
                            <select name="type" class="form-select" required>
                                <option value="Asset">Asset</option>
                                <option value="Liability">Liability</option>
                                <option value="Revenue">Revenue (Income)</option>
                                <option value="Expense">Expense</option>
                                <option value="Equity">Equity</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Under Group (Parent)</label>
                        <select name="parent_id" class="form-select select2">
                            <option value="">-- Primary --</option>
                            {% for group in groups %}
                                <option value="{{ group.account_id }}">{{ group.account_name }} ({{ group.type }})</option>
                            {% endfor %}
                        </select>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                             <label class="form-label">Opening Balance</label>
                             <input type="number" step="0.01" name="opening_balance" class="form-control" value="0.00">
                        </div>
                        <div class="col-md-6 mb-3 pt-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="is_group" id="isGroup">
                                <label class="form-check-label" for="isGroup">Create as Group (Folder)</label>
                            </div>
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-primary">Create Account</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
