{% extends 'layouts/app.twig' %}

{% block title %}Subledgers, Cost & Profit Centers{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 bg-transparent px-0">
                <li class="breadcrumb-item"><a href="{{ BASE_URL }}/finance/dashboard" class="text-decoration-none">Finance</a></li>
                <li class="breadcrumb-item active" aria-current="page">Subledgers</li>
            </ol>
        </nav>
        <h4 class="mb-0 font-weight-bold">Subledgers, Cost & Profit Centers</h4>
    </div>

    <!-- Alerts -->
    {% if session.success_message %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        {{ session.success_message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}
    {% if session.error_message %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        {{ session.error_message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <!-- Tabs Navigation -->
    <ul class="nav nav-tabs nav-tabs-custom mb-4" id="subledgerTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="receivable-tab" data-bs-toggle="tab" data-bs-target="#receivable-pane" type="button" role="tab"><i class="fas fa-hand-holding-usd me-2"></i>Accounts Receivable (Customer)</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="payable-tab" data-bs-toggle="tab" data-bs-target="#payable-pane" type="button" role="tab"><i class="fas fa-file-invoice-dollar me-2"></i>Accounts Payable (Supplier)</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="centers-tab" data-bs-toggle="tab" data-bs-target="#centers-pane" type="button" role="tab"><i class="fas fa-chart-pie me-2"></i>Cost & Profit Centers</button>
        </li>
    </ul>

    <!-- Tabs Content -->
    <div class="tab-content" id="subledgerTabsContent">
        
        <!-- ACCOUNTS RECEIVABLE (CUSTOMER) -->
        <div class="tab-pane fade show active" id="receivable-pane" role="tabpanel">
            <div class="row g-4">
                <!-- AR Outstanding list -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0 font-weight-bold">Outstanding Customer Receivables</h5>
                            <button class="btn btn-primary btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#invoiceModal">
                                <i class="fas fa-plus me-1"></i> New Sales Invoice
                            </button>
                        </div>
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr class="text-muted font-size-12">
                                        <th>Invoice #</th>
                                        <th>Customer</th>
                                        <th>Bill Date</th>
                                        <th>Due Date</th>
                                        <th class="text-end">Total Amount</th>
                                        <th class="text-end">Paid</th>
                                        <th class="text-end">Due Balance</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for r in receivables %}
                                    <tr>
                                        <td class="font-weight-bold text-primary">{{ r.invoice_number }}</td>
                                        <td>
                                            <span class="font-weight-bold">{{ r.buyer_name }}</span><br>
                                            <small class="text-muted">{{ r.buyer_code }}</small>
                                        </td>
                                        <td>{{ r.invoice_date }}</td>
                                        <td>{{ r.due_date }}</td>
                                        <td class="text-end font-weight-bold text-dark">${{ r.amount|number_format(2) }}</td>
                                        <td class="text-end font-weight-bold text-success">${{ r.paid_amount|number_format(2) }}</td>
                                        <td class="text-end font-weight-bold text-danger">${{ r.due_amount|number_format(2) }}</td>
                                        <td>
                                            <span class="badge {% if r.status == 'paid' %}bg-success{% elseif r.status == 'partial' %}bg-warning text-dark{% else %}bg-danger{% endif %}">
                                                {{ r.status|upper }}
                                            </span>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Customer Statement Generator -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm p-4">
                        <h5 class="mb-3 font-weight-bold"><i class="fas fa-print me-1 text-primary"></i>Customer Statement</h5>
                        <p class="text-muted font-size-13">Generate buyer-wise outstanding ledgers, collections registers and aging schedules.</p>
                        <form onsubmit="alert('Generating buyer statement...'); return false;">
                            <div class="mb-3">
                                <label class="form-label font-weight-bold">Select Customer</label>
                                <select class="form-select" required>
                                    {% for buyer in buyers %}
                                    <option value="{{ buyer.buyer_id }}">{{ buyer.buyer_name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <button type="submit" class="btn btn-outline-primary w-100 rounded-pill"><i class="fas fa-file-pdf me-1"></i>Generate PDF Statement</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- ACCOUNTS PAYABLE (SUPPLIER) -->
        <div class="tab-pane fade" id="payable-pane" role="tabpanel">
            <div class="row g-4">
                <!-- AP Outstanding list -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0 font-weight-bold">Outstanding Supplier Payables</h5>
                            <button class="btn btn-primary btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#billModal">
                                <i class="fas fa-plus me-1"></i> New Supplier Bill
                            </button>
                        </div>
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr class="text-muted font-size-12">
                                        <th>Bill #</th>
                                        <th>Supplier Name</th>
                                        <th>Bill Date</th>
                                        <th>Due Date</th>
                                        <th class="text-end">Bill Amount</th>
                                        <th class="text-end">Paid Amount</th>
                                        <th class="text-end">Due Balance</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for p in payables %}
                                    <tr>
                                        <td class="font-weight-bold text-primary">{{ p.bill_number }}</td>
                                        <td>
                                            <span class="font-weight-bold">{{ p.vendor_name }}</span><br>
                                            <small class="text-muted">{{ p.vendor_code }}</small>
                                        </td>
                                        <td>{{ p.bill_date }}</td>
                                        <td>{{ p.due_date }}</td>
                                        <td class="text-end font-weight-bold text-dark">${{ p.total_amount|number_format(2) }}</td>
                                        <td class="text-end font-weight-bold text-success">${{ p.paid_amount|number_format(2) }}</td>
                                        <td class="text-end font-weight-bold text-danger">${{ p.due_amount|number_format(2) }}</td>
                                        <td>
                                            <span class="badge {% if p.status == 'paid' %}bg-success{% elseif p.status == 'partial' %}bg-warning text-dark{% else %}bg-danger{% endif %}">
                                                {{ p.status|upper }}
                                            </span>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Supplier Statement Generator -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm p-4">
                        <h5 class="mb-3 font-weight-bold"><i class="fas fa-print me-1 text-primary"></i>Supplier Statement</h5>
                        <p class="text-muted font-size-13">Generate supplier aging schedules, ledger balances and payment summaries.</p>
                        <form onsubmit="alert('Generating supplier statement...'); return false;">
                            <div class="mb-3">
                                <label class="form-label font-weight-bold">Select Supplier</label>
                                <select class="form-select" required>
                                    {% for vendor in vendors %}
                                    <option value="{{ vendor.vendor_id }}">{{ vendor.vendor_name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <button type="submit" class="btn btn-outline-primary w-100 rounded-pill"><i class="fas fa-file-pdf me-1"></i>Generate PDF Statement</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- COST & PROFIT CENTERS -->
        <div class="tab-pane fade" id="centers-pane" role="tabpanel">
            <div class="row g-4">
                <!-- Cost Centers -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm p-4 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0 font-weight-bold">Cost Center Masters</h5>
                            <button class="btn btn-outline-primary btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#costCenterModal">
                                <i class="fas fa-plus me-1"></i> Add Cost Center
                            </button>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr class="text-muted">
                                        <th>Code</th>
                                        <th>Cost Center Name</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for cc in costCenters %}
                                    <tr>
                                        <td class="font-weight-bold text-primary">{{ cc.cost_center_code }}</td>
                                        <td>{{ cc.cost_center_name }}</td>
                                        <td><span class="badge bg-success">ACTIVE</span></td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Profit Centers -->
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm p-4 h-100">
                        <h5 class="mb-4 font-weight-bold">Profit Centers (Company Divisions)</h5>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr class="text-muted">
                                        <th>Code</th>
                                        <th>Profit Center Name</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for pc in profitCenters %}
                                    <tr>
                                        <td class="font-weight-bold text-success">{{ pc.profit_center_code }}</td>
                                        <td>{{ pc.profit_center_name }}</td>
                                        <td><span class="badge bg-success">ACTIVE</span></td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: New Invoice -->
<div class="modal fade" id="invoiceModal" tabindex="-1">
    <div class="modal-dialog">
        <form action="{{ BASE_URL }}/finance/subledgers/receipt" method="POST">
            {{ csrf_field() | raw }}
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold">Register Customer Sales Invoice</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Invoice Number</label>
                        <input type="text" class="form-control" name="invoice_number" placeholder="e.g. INV-2026-904" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Select Customer</label>
                        <select class="form-select" name="buyer_id" required>
                            <option value="">-- Choose Buyer --</option>
                            {% for b in buyers %}
                            <option value="{{ b.buyer_id }}">{{ b.buyer_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Amount ($)</label>
                        <input type="number" step="0.01" class="form-control" name="amount" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Register Invoice</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Modal: New Bill -->
<div class="modal fade" id="billModal" tabindex="-1">
    <div class="modal-dialog">
        <form action="{{ BASE_URL }}/finance/subledgers/payment" method="POST">
            {{ csrf_field() | raw }}
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold">Register Supplier Bill</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Bill Reference Number</label>
                        <input type="text" class="form-control" name="bill_number" placeholder="e.g. BIL-YRN-0049" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Select Supplier</label>
                        <select class="form-select" name="vendor_id" required>
                            <option value="">-- Choose Vendor --</option>
                            {% for v in vendors %}
                            <option value="{{ v.vendor_id }}">{{ v.vendor_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Amount ($)</label>
                        <input type="number" step="0.01" class="form-control" name="amount" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Register Bill</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Modal: New Cost Center -->
<div class="modal fade" id="costCenterModal" tabindex="-1">
    <div class="modal-dialog">
        <form action="{{ BASE_URL }}/finance/subledgers/cost-center" method="POST">
            {{ csrf_field() | raw }}
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold">Create Cost Center Master</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Cost Center Code</label>
                        <input type="text" class="form-control" name="cost_center_code" placeholder="e.g. CC-SEW-01" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Cost Center Name</label>
                        <input type="text" class="form-control" name="cost_center_name" placeholder="e.g. Sewing Machine Overhead" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Create Center</button>
                </div>
            </div>
        </form>
    </div>
</div>
{% endblock %}
