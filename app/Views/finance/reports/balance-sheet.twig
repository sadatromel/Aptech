{% extends 'layouts/app.twig' %}

{% block title %}Balance Sheet{% endblock %}

{% block content %}
<div class="container-fluid px-4">
    <h1 class="mt-4">Balance Sheet Statement</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/dashboard">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ BASE_URL }}/finance/reports">Financial Reports</a></li>
        <li class="breadcrumb-item active">Balance Sheet</li>
    </ol>

    <!-- Filter Toolbar & Actions -->
    <div class="card mb-4 border-0 shadow-sm print-hide">
        <div class="card-body bg-light">
            <form method="GET" action="{{ BASE_URL }}/finance/reports/balance-sheet" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small fw-bold text-primary mb-1">Statement As Of Date</label>
                    <input type="date" class="form-control form-control-sm" name="as_of_date" value="{{ as_of_date }}">
                </div>
                <div class="col-md-4 d-flex">
                    <button type="submit" class="btn btn-primary btn-sm me-2 flex-grow-1"><i class="fas fa-filter me-1"></i> Update Statement</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="fas fa-print me-1"></i> Print</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Compute Totals & Equality Check -->
    {% set total_assets = 0 %}
    {% set total_liabilities = 0 %}
    {% set total_equity = 0 %}

    {% for row in data %}
        {% set amt = row.net_amount|abs %}
        {% if row.account_type in ['Asset', 'Current Asset', 'Fixed Asset'] %}
            {% set total_assets = total_assets + row.net_amount %}
        {% elseif row.account_type in ['Liability', 'Current Liability'] %}
            {% set total_liabilities = total_liabilities + amt %}
        {% elseif row.account_type == 'Equity' %}
            {% set total_equity = total_equity + amt %}
        {% endif %}
    {% endfor %}

    {% set total_liabilities_equity = total_liabilities + total_equity %}
    {% set is_balanced = (total_assets - total_liabilities_equity)|abs < 0.01 %}

    <!-- Financial KPI Summary Header Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-success text-white p-3">
                <div class="small text-uppercase fw-bold text-white-50"><i class="fas fa-coins me-1"></i>Total Assets</div>
                <div class="fs-4 fw-bold mt-1">${{ total_assets|number_format(2) }}</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-warning text-dark p-3">
                <div class="small text-uppercase fw-bold text-muted"><i class="fas fa-file-invoice-dollar me-1"></i>Total Liabilities</div>
                <div class="fs-4 fw-bold mt-1">${{ total_liabilities|number_format(2) }}</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-info text-white p-3">
                <div class="small text-uppercase fw-bold text-white-50"><i class="fas fa-chart-line me-1"></i>Total Equity</div>
                <div class="fs-4 fw-bold mt-1">${{ total_equity|number_format(2) }}</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm {{ is_balanced ? 'bg-primary' : 'bg-danger' }} text-white p-3">
                <div class="small text-uppercase fw-bold text-white-50"><i class="fas fa-balance-scale me-1"></i>Balance Status</div>
                <div class="fs-5 fw-bold mt-1">
                    {% if is_balanced %}
                        <i class="fas fa-check-circle me-1"></i> Balanced
                    {% else %}
                        <i class="fas fa-exclamation-triangle me-1"></i> Diff: ${{ (total_assets - total_liabilities_equity)|abs|number_format(2) }}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Main Balance Sheet Statement Card -->
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-header text-center bg-white border-bottom py-4">
            <h3 class="mb-1 font-weight-bold">CONSOLIDATED STATEMENT OF FINANCIAL POSITION</h3>
            <p class="text-muted mb-0">As of <strong>{{ as_of_date|date('F j, Y') }}</strong></p>
        </div>
        <div class="card-body p-4">
            <div class="row g-4">
                
                <!-- ASSETS SIDE -->
                <div class="col-md-6 border-end pe-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-2 border-success">
                        <h5 class="mb-0 fw-bold text-success text-uppercase"><i class="fas fa-wallet me-2"></i>Assets</h5>
                        <span class="badge bg-success">Total: ${{ total_assets|number_format(2) }}</span>
                    </div>

                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="small text-uppercase text-muted">
                                <th>Code</th>
                                <th>Account Description</th>
                                <th class="text-end">Balance ($)</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% set has_assets = false %}
                            {% for row in data %}
                                {% if row.account_type in ['Asset', 'Current Asset', 'Fixed Asset'] %}
                                    {% set has_assets = true %}
                                    <tr>
                                        <td class="fw-bold text-primary">{{ row.account_code }}</td>
                                        <td class="fw-bold">{{ row.account_name }}</td>
                                        <td class="text-end fw-bold text-success">${{ row.net_amount|number_format(2) }}</td>
                                    </tr>
                                {% endif %}
                            {% endfor %}
                            {% if not has_assets %}
                                <tr><td colspan="3" class="text-muted text-center py-3">No asset balances recorded.</td></tr>
                            {% endif %}
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold table-success fs-6">
                                <td colspan="2" class="text-uppercase">Total Assets</td>
                                <td class="text-end text-success">${{ total_assets|number_format(2) }}</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- LIABILITIES & EQUITY SIDE -->
                <div class="col-md-6 ps-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-2 border-danger">
                        <h5 class="mb-0 fw-bold text-danger text-uppercase"><i class="fas fa-scale-balanced me-2"></i>Liabilities & Equity</h5>
                        <span class="badge bg-danger">Total: ${{ total_liabilities_equity|number_format(2) }}</span>
                    </div>

                    <!-- Liabilities Sub-Section -->
                    <h6 class="fw-bold text-uppercase text-muted mt-2 mb-2"><i class="fas fa-file-invoice-dollar me-1"></i>Liabilities</h6>
                    <table class="table table-hover align-middle mb-3">
                        <thead class="table-light">
                            <tr class="small text-uppercase text-muted">
                                <th>Code</th>
                                <th>Account Description</th>
                                <th class="text-end">Balance ($)</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% set has_liab = false %}
                            {% for row in data %}
                                {% if row.account_type in ['Liability', 'Current Liability'] %}
                                    {% set has_liab = true %}
                                    <tr>
                                        <td class="fw-bold text-primary">{{ row.account_code }}</td>
                                        <td>{{ row.account_name }}</td>
                                        <td class="text-end fw-bold text-danger">${{ row.net_amount|abs|number_format(2) }}</td>
                                    </tr>
                                {% endif %}
                            {% endfor %}
                            {% if not has_liab %}
                                <tr><td colspan="3" class="text-muted text-center py-2">No liability balances recorded.</td></tr>
                            {% endif %}
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold bg-light">
                                <td colspan="2" class="text-uppercase">Total Liabilities</td>
                                <td class="text-end text-danger">${{ total_liabilities|number_format(2) }}</td>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- Equity Sub-Section -->
                    <h6 class="fw-bold text-uppercase text-muted mt-4 mb-2"><i class="fas fa-chart-pie me-1"></i>Shareholders' Equity</h6>
                    <table class="table table-hover align-middle mb-3">
                        <thead class="table-light">
                            <tr class="small text-uppercase text-muted">
                                <th>Code</th>
                                <th>Account Description</th>
                                <th class="text-end">Balance ($)</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% set has_eq = false %}
                            {% for row in data %}
                                {% if row.account_type == 'Equity' %}
                                    {% set has_eq = true %}
                                    <tr>
                                        <td class="fw-bold text-primary">{{ row.account_code }}</td>
                                        <td class="fw-bold">{{ row.account_name }}</td>
                                        <td class="text-end fw-bold text-info">${{ row.net_amount|abs|number_format(2) }}</td>
                                    </tr>
                                {% endif %}
                            {% endfor %}
                            {% if not has_eq %}
                                <tr><td colspan="3" class="text-muted text-center py-2">No equity balances recorded.</td></tr>
                            {% endif %}
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold bg-light">
                                <td colspan="2" class="text-uppercase">Total Shareholders' Equity</td>
                                <td class="text-end text-info">${{ total_equity|number_format(2) }}</td>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- Total Liabilities & Equity Summary -->
                    <div class="p-3 bg-danger text-white rounded d-flex justify-content-between align-items-center fw-bold fs-6 mt-3">
                        <span class="text-uppercase">Total Liabilities & Equity</span>
                        <span>${{ total_liabilities_equity|number_format(2) }}</span>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
@media print {
    .print-hide, .navbar, .sb-sidenav { display: none !important; }
    #layoutSidenav_content { margin-left: 0 !important; top: 0 !important; }
    .card { border: none !important; }
}
</style>
{% endblock %}
