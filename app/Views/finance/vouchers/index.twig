{% extends "layouts/app.twig" %}

{% block content %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="card-title">Daybook (Voucher Register)</h4>
                <a href="{{ BASE_URL }}/finance/vouchers/create" class="btn btn-primary">+ New Voucher</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Voucher No</th>
                                <th>Type</th>
                                <th>Narration</th>
                                <th class="text-end">Amount</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for v in vouchers %}
                            <tr>
                                <td>{{ v.transaction_date|date('d-M-Y') }}</td>
                                <td>{{ v.voucher_number }}</td>
                                <td><span class="badge bg-info">{{ v.voucher_type }}</span></td>
                                <td>{{ v.narration }}</td>
                                <td class="text-end">{{ v.total_amount|number_format(2) }}</td>
                                <td>
                                    <a href="#" class="btn btn-sm btn-outline-danger">View</a>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="6" class="text-center">No transactions found.</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
