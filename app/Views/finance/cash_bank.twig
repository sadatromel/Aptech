{% extends 'layouts/app.twig' %}

{% block title %}Cash, Bank & Exchange Rates{% endblock %}

{% block content %}
<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 bg-transparent px-0">
                <li class="breadcrumb-item"><a href="{{ BASE_URL }}/finance/dashboard" class="text-decoration-none">Finance</a></li>
                <li class="breadcrumb-item active" aria-current="page">Cash & Bank Book</li>
            </ol>
        </nav>
        <h4 class="mb-0 font-weight-bold">Cash, Bank & Multi-Currency</h4>
    </div>

    <!-- Alerts -->
    {% if session.success_message %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        {{ session.success_message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}
    {% if session.error_message %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        {{ session.error_message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    {% endif %}

    <!-- Tabs Navigation -->
    <ul class="nav nav-tabs nav-tabs-custom mb-4" id="cashBankTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="bank-tab" data-bs-toggle="tab" data-bs-target="#bank-pane" type="button" role="tab"><i class="fas fa-university me-2"></i>Bank Accounts & Cheques</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="cash-tab" data-bs-toggle="tab" data-bs-target="#cash-pane" type="button" role="tab"><i class="fas fa-wallet me-2"></i>Cash Book & Transfers</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="currency-tab" data-bs-toggle="tab" data-bs-target="#currency-pane" type="button" role="tab"><i class="fas fa-globe-asia me-2"></i>Multi-Currency Exchange Rates</button>
        </li>
    </ul>

    <!-- Tabs Content -->
    <div class="tab-content" id="cashBankTabsContent">
        
        <!-- BANK ACCOUNTS & CHEQUES -->
        <div class="tab-pane fade show active" id="bank-pane" role="tabpanel">
            <div class="row g-4">
                <!-- Bank Information List -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm p-4 mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0 font-weight-bold">Bank Accounts Register</h5>
                            <span class="badge bg-primary">{{ bankAccounts|length }} Active Accounts</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr class="text-muted font-size-12 text-uppercase">
                                        <th>Bank Name</th>
                                        <th>Account #</th>
                                        <th>Branch</th>
                                        <th>SWIFT Code</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% if bankAccounts is empty %}
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">No bank accounts registered.</td>
                                    </tr>
                                    {% else %}
                                        {% for bank in bankAccounts %}
                                        <tr>
                                            <td class="font-weight-bold">{{ bank.bank_name }}</td>
                                            <td>{{ bank.account_number ?: '-' }}</td>
                                            <td>{{ bank.branch_name ?: '-' }}</td>
                                            <td><code class="text-secondary">{{ bank.swift_code ?: '-' }}</code></td>
                                            <td>
                                                <span class="badge {% if bank.status == 'Active' %}bg-success{% else %}bg-secondary{% endif %}">
                                                    {{ bank.status }}
                                                </span>
                                            </td>
                                        </tr>
                                        {% endfor %}
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Cheques Register -->
                    <div class="card border-0 shadow-sm p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0 font-weight-bold">Cheque Registry & Clearance Log</h5>
                            <button class="btn btn-outline-primary btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#chequeModal">
                                <i class="fas fa-plus me-1"></i> Register Cheque
                            </button>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr class="text-muted">
                                        <th>Cheque #</th>
                                        <th>Bank</th>
                                        <th>Amount</th>
                                        <th>Issue Date</th>
                                        <th>Clearance</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for chq in cheques %}
                                    <tr>
                                        <td class="font-weight-bold text-primary">{{ chq.cheque_no }}</td>
                                        <td>{{ chq.bank_name }}</td>
                                        <td class="font-weight-bold text-success">${{ chq.amount|number_format(2) }}</td>
                                        <td>{{ chq.issue_date }}</td>
                                        <td>{{ chq.clearance_date ?: 'Pending' }}</td>
                                        <td>
                                            <span class="badge {% if chq.status == 'Cleared' %}bg-success{% else %}bg-warning text-dark{% endif %}">
                                                {{ chq.status }}
                                            </span>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Bank Reconciliation Panel -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm p-4">
                        <h5 class="mb-3 font-weight-bold">Bank Reconciliation</h5>
                        <p class="text-muted font-size-13">Verify bank statement ledger transactions matches actual bank deposits.</p>
                        <form action="{{ BASE_URL }}/finance/cash-bank/reconciliation" method="POST">
                            {{ csrf_field() | raw }}
                            <div class="mb-3">
                                <label class="form-label font-weight-bold">Select Bank</label>
                                <select class="form-select" required>
                                    {% for bank in bankAccounts %}
                                    <option value="{{ bank.bank_id }}">{{ bank.bank_name }} - {{ bank.account_number }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label font-weight-bold">Statement Closing Date</label>
                                <input type="date" class="form-control" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label font-weight-bold">Statement Closing Balance ($)</label>
                                <input type="number" step="0.01" class="form-control" required>
                            </div>
                            <button type="submit" class="btn btn-success w-100 rounded-pill"><i class="fas fa-check-circle me-1"></i>Reconcile Bank</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- CASH BOOK & TRANSFERS -->
        <div class="tab-pane fade" id="cash-pane" role="tabpanel">
            <div class="row g-4">
                <!-- Cash Books -->
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm p-4">
                        <h5 class="mb-4 font-weight-bold">Active Cash Registers</h5>
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr class="text-muted">
                                        <th>Cash Book</th>
                                        <th>Custodian</th>
                                        <th>Petty Cash Limit</th>
                                        <th class="text-end">Current Balance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for cash in cashBalances %}
                                    <tr>
                                        <td class="font-weight-bold">{{ cash.cash_book }}</td>
                                        <td>{{ cash.custodian }}</td>
                                        <td class="font-weight-bold text-secondary">${{ cash.limit|number_format(2) }}</td>
                                        <td class="text-end font-weight-bold text-success">${{ cash.balance|number_format(2) }}</td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Cash Transfer Panel -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm p-4">
                        <h5 class="mb-3 font-weight-bold">Cash/Vault Transfer</h5>
                        <p class="text-muted font-size-13">Transfer petty cash funds between office safes and vaults.</p>
                        <form action="{{ BASE_URL }}/finance/cash-bank/transfer" method="POST">
                            {{ csrf_field() | raw }}
                            <div class="mb-3">
                                <label class="form-label font-weight-bold">From Source</label>
                                <select class="form-select" name="from_source" required>
                                    <option value="Head Office General Cash">Head Office General Cash</option>
                                    <option value="Factory Petty Cash">Factory Petty Cash</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label font-weight-bold">To Destination</label>
                                <select class="form-select" name="to_destination" required>
                                    <option value="Factory Petty Cash">Factory Petty Cash</option>
                                    <option value="Head Office General Cash">Head Office General Cash</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label font-weight-bold">Amount ($)</label>
                                <input type="number" step="0.01" class="form-control" name="amount" required>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 rounded-pill"><i class="fas fa-exchange-alt me-1"></i>Transfer Cash</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- MULTI-CURRENCY EXCHANGE RATES -->
        <div class="tab-pane fade" id="currency-pane" role="tabpanel">
            <div class="card border-0 shadow-sm p-4">
                <h5 class="mb-4 font-weight-bold">Corporate Foreign Currency Exchange Matrix</h5>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr class="text-muted">
                                <th>Currency Code</th>
                                <th>Currency Name</th>
                                <th>Symbol</th>
                                <th>Exchange Rate (vs USD)</th>
                                <th>Base Currency</th>
                                <th>Status</th>
                                <th>Last Updated</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if exchangeRates is empty %}
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">No currencies registered.</td>
                            </tr>
                            {% else %}
                                {% for rate in exchangeRates %}
                                <tr>
                                    <td class="font-weight-bold text-primary">{{ rate.currency_code }}</td>
                                    <td>{{ rate.currency_name }}</td>
                                    <td class="font-weight-bold">{{ rate.symbol ?: '$' }}</td>
                                    <td class="font-weight-bold text-success">{{ rate.exchange_rate }}</td>
                                    <td>
                                        <span class="badge {% if rate.is_base_currency == 1 %}bg-success{% else %}bg-secondary{% endif %}">
                                            {% if rate.is_base_currency == 1 %}YES{% else %}NO{% endif %}
                                        </span>
                                    </td>
                                    <td><span class="badge bg-light text-dark">{{ rate.status|upper }}</span></td>
                                    <td>{{ rate.updated_at ?: '-' }}</td>
                                </tr>
                                {% endfor %}
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Register Cheque -->
<div class="modal fade" id="chequeModal" tabindex="-1">
    <div class="modal-dialog">
        <form action="{{ BASE_URL }}/finance/cash-bank/cheque" method="POST">
            {{ csrf_field() | raw }}
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold">Register Issued Cheque</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Cheque Number</label>
                        <input type="text" class="form-control" name="cheque_no" placeholder="e.g. CHQ-10029" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Bank Account Details</label>
                        <input type="text" class="form-control" name="bank_name" placeholder="e.g. Standard Chartered Bank" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Amount ($)</label>
                        <input type="number" step="0.01" class="form-control" name="amount" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Register Cheque</button>
                </div>
            </div>
        </form>
    </div>
</div>
{% endblock %}
