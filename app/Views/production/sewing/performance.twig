{% extends "layouts/app.twig" %}

{% block title %}Line Performance{% endblock %}

{% block content %}
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Line Performance</h1>
        <div class="btn-toolbar mb-2 mb-md-0">
            <a href="{{ BASE_URL }}/sewing/performance/record" class="btn btn-sm btn-primary">
                <i class="fas fa-plus"></i> Record Output
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Hour</th>
                    <th>Line</th>
                    <th>Style</th>
                    <th>Produced</th>
                    <th>Target</th>
                    <th>Defects</th>
                </tr>
            </thead>
            <tbody>
                {% for p in performance %}
                <tr>
                    <td>{{ p.date }}</td>
                    <td>{{ p.hour }}</td>
                    <td>{{ p.line_name }}</td>
                    <td>{{ p.style_code }}</td>
                    <td>{{ p.produced_quantity }}</td>
                    <td>{{ p.target_quantity }}</td>
                    <td>{{ p.defects }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
