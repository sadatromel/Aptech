{% extends "layouts/app.twig" %}

{% block title %}New Cutting Plan{% endblock %}

{% block content %}
    <div class="pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Create Cutting Plan</h1>
    </div>

    <form action="{{ BASE_URL }}/production/cutting/store" method="POST">
    {{ csrf_field() | raw }}
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Plan Number</label>
                <input type="text" class="form-control" name="plan_number" required>
            </div>
            <div class="col-md-6">
                <label class="form-label">Style</label>
                <select class="form-select" name="style_id" required>
                    <option value="">Select Style</option>
                    {% for style in styles %}
                    <option value="{{ style.style_id }}">{{ style.style_code }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
        <!-- More fields omitted for brevity -->
        <button type="submit" class="btn btn-primary">Save Plan</button>
    </form>
{% endblock %}
