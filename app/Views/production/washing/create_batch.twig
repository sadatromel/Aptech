{% extends "layouts/app.twig" %}

{% block title %}Create Washing Batch{% endblock %}

{% block content %}
    <div class="pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Create Washing Batch</h1>
    </div>

    <form action="{{ BASE_URL }}/washing/batches/store" method="POST">
    {{ csrf_field() | raw }}
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Batch No</label>
                <input type="text" class="form-control" name="batch_no" required>
            </div>
            <div class="col-md-6">
                <label class="form-label">Style</label>
                <select class="form-select" name="style_id" required>
                    <option value="">Select Style</option>
                    {% for style in styles %}
                    <option value="{{ style.style_id }}">{{ style.style_code }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
         <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Quantity</label>
                <input type="number" class="form-control" name="quantity" required>
            </div>
            <div class="col-md-4">
                <label class="form-label">Machine No</label>
                <input type="text" class="form-control" name="machine_no" required>
            </div>
             <div class="col-md-4">
                <label class="form-label">Start Time</label>
                <input type="datetime-local" class="form-control" name="start_time" required>
            </div>
         </div>
        <button type="submit" class="btn btn-primary">Save Batch</button>
    </form>
{% endblock %}
