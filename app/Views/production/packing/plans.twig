{% extends "layouts/app.twig" %}

{% block title %}Packing Plans{% endblock %}

{% block content %}
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Packing Plans</h1>
        <div class="btn-toolbar mb-2 mb-md-0">
            <a href="{{ BASE_URL }}/packing/plans/create" class="btn btn-sm btn-primary">
                <i class="fas fa-plus"></i> New Plan
            </a>
            <a href="{{ BASE_URL }}/packing/cartons" class="btn btn-sm btn-outline-secondary ms-2">View Cartons</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Plan Code</th>
                    <th>Style</th>
                    <th>Target Date</th>
                    <th>Cartons</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {% for p in plans %}
                <tr>
                    <td>{{ p.plan_code }}</td>
                    <td>{{ p.style_code }}</td>
                    <td>{{ p.target_date }}</td>
                    <td>{{ p.total_cartons }}</td>
                    <td><span class="badge bg-secondary">{{ p.status|capitalize }}</span></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
