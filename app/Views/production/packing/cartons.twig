{% extends "layouts/app.twig" %}

{% block title %}Carton Management{% endblock %}

{% block content %}
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Cartons</h1>
        <div class="btn-toolbar mb-2 mb-md-0">
            <button class="btn btn-sm btn-primary">
                <i class="fas fa-plus"></i> Manual Carton
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Carton #</th>
                    <th>Style</th>
                    <th>Size Breakdown</th>
                    <th>Total Qty</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {% for c in cartons %}
                <tr>
                    <td>{{ c.carton_number }}</td>
                    <td>{{ c.style_code }}</td>
                    <td>{{ c.size_breakdown }}</td>
                    <td>{{ c.total_quantity }}</td>
                    <td><span class="badge bg-success">{{ c.status|capitalize }}</span></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
