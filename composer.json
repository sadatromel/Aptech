{
    "name": "aptech/erp-system",
    "description": "Modern ERP System with MVC Architecture",
    "type": "project",
    "require": {
        "php": "^8.0",
        "monolog/monolog": "^3.0",
        "nikic/fast-route": "^1.3",
        "php-di/php-di": "^7.0",
        "phpoffice/phpspreadsheet": "^5.8",
        "psr/container": "^2.0",
        "psr/http-message": "^1.1",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/",
            "Config\\": "config/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs --standard=PSR12 app/ core/",
        "cs-fix": "phpcbf --standard=PSR12 app/ core/"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
