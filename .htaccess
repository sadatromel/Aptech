# Ensure index.php works as directory index
DirectoryIndex index.php

# Enable Rewrite Engine
RewriteEngine On

# Enforce HTTPS behind reverse proxy (Traefik / Coolify / Cloudflare)
RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Allow direct access to index.php with parameters
<Files "index.php">
    AcceptPathInfo On
</Files>

# Security - Prevent access to sensitive files
<Files ~ "^\.">
    Order allow,deny
    Deny from all
</Files>

<FilesMatch "^(config|composer|\.env)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Route everything to index.php
# RewriteRule ^merchandising/(.*)$ merchandising.php [L,QSA] - Removed to use central router

# Route everything else to index.php if it's not a real file/dir
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?page=$1 [L,QSA]
